WITH REPORT; USE REPORT;
PROCEDURE FLTATT2 IS
     TYPE F5 IS DIGITS 5;
     TYPE F15 IS DIGITS 15;
     SUBTYPE S3 IS F5 DIGITS 3;
     TYPE FW IS DIGITS 5 RANGE -1.0E300 .. 1.0E300;
     GENERIC
          TYPE T IS DIGITS <>;
     PROCEDURE P (NOM : STRING; D, B, SE, BD, BB : INTEGER; EPS, SM, LG, SSM, SLG, BEPS : T);
     PROCEDURE P (NOM : STRING; D, B, SE, BD, BB : INTEGER; EPS, SM, LG, SSM, SLG, BEPS : T) IS
     BEGIN
          IF T'DIGITS /= D OR T'MANTISSA /= B OR T'EMAX /= 4 * B THEN FAILED (NOM & " : ENTIERS"); END IF;
          IF T'EPSILON /= EPS OR T'SMALL /= SM OR T'LARGE /= LG THEN FAILED (NOM & " : REELS"); END IF;
          IF T'SAFE_EMAX /= SE OR T'SAFE_SMALL /= SSM OR T'SAFE_LARGE /= SLG THEN FAILED (NOM & " : SURS"); END IF;
          IF T'BASE'DIGITS /= BD OR T'BASE'MANTISSA /= BB OR T'BASE'EMAX /= 4 * BB OR T'BASE'EPSILON /= BEPS
             OR T'BASE'SAFE_EMAX /= SE THEN
               FAILED (NOM & " : 'BASE");
          END IF;
     END P;
     PROCEDURE P5 IS NEW P (F5);
     PROCEDURE P15 IS NEW P (F15);
     PROCEDURE P3 IS NEW P (S3);
     PROCEDURE PF IS NEW P (FLOAT);
     PROCEDURE PL IS NEW P (LONG_FLOAT);
     PROCEDURE PW IS NEW P (FW);
BEGIN
     TEST ("FLTATT2", "ATTRIBUTS DU MODELE FLOTTANT D'UN FORMEL DIGITS <>");
     P5 ("F5", 5, 18, 125, 6, 21, 16#0.8#E-4, 16#0.8#E-18, 16#0.FFFFC#E18, 2#1.0#E-126, 2#0.111111111111111111111#E125, 2#1.0#E-20);
     P15 ("F15", 15, 51, 1021, 15, 51, 2#1.0#E-50, 2#1.0#E-205, 2#0.111111111111111111111111111111111111111111111111111#E204, 2#1.0#E-1022, 2#0.111111111111111111111111111111111111111111111111111#E1021, 2#1.0#E-50);
     P3 ("S3", 3, 11, 125, 6, 21, 2#1.0#E-10, 2#1.0#E-45, 2#0.11111111111#E44, 2#1.0#E-126, 2#0.111111111111111111111#E125, 2#1.0#E-20);
     PF ("FLOAT", 6, 21, 125, 6, 21, 2#1.0#E-20, 2#1.0#E-85, 2#0.111111111111111111111#E84, 2#1.0#E-126, 2#0.111111111111111111111#E125, 2#1.0#E-20);
     PL ("LONG_FLOAT", 15, 51, 1021, 15, 51, 2#1.0#E-50, 2#1.0#E-205, 2#0.111111111111111111111111111111111111111111111111111#E204, 2#1.0#E-1022, 2#0.111111111111111111111111111111111111111111111111111#E1021, 2#1.0#E-50);
     PW ("FW", 5, 18, 1021, 15, 51, 16#0.8#E-4, 16#0.8#E-18, 2#0.111111111111111111#E72, 2#1.0#E-1022, 2#0.111111111111111111111111111111111111111111111111111#E1021, 2#1.0#E-50);
     RESULT;
END FLTATT2;
