WITH REPORT; USE REPORT;
PROCEDURE DISCR9 IS
     SUBTYPE INT IS INTEGER RANGE 0..10;
     TYPE REC (N : INT := 0) IS RECORD A : STRING (1..N); END RECORD;
     SUBTYPE SREC IS REC(N=>3);
     TYPE S (K : INTEGER) IS RECORD V : INTEGER; END RECORD;
     SUBTYPE S5 IS S (5);
     TYPE TAB IS ARRAY (1 .. 2) OF S5;
     T : TAB := (OTHERS => (5, 7));
     NB : INTEGER := 0;
     PROCEDURE P1 (R : IN SREC) IS BEGIN NB := NB + R.N; END P1;
     PROCEDURE P2 (R : IN OUT SREC) IS BEGIN NB := NB + 1; END P2;
     PROCEDURE P3 (R : OUT SREC) IS BEGIN NB := NB + 1; END P3;
     PROCEDURE Q (X : IN S5) IS BEGIN NB := NB + X.V; END Q;
     PROCEDURE PASSE (R : IN REC) IS BEGIN P1 (R); END PASSE;
BEGIN
     TEST ("DISCR9", "CONTROLE DES DISCRIMINANTS DES PARAMETRES");
     BEGIN P1 ((2,"AA")); FAILED ("A"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN P1 ((IDENT_INT(2), "AA")); FAILED ("B"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     DECLARE R : REC := (IDENT_INT(2), "AA");
     BEGIN P1 (R); FAILED ("C"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     DECLARE R : REC := (IDENT_INT(2), "AA");
     BEGIN P2 (R); FAILED ("D"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     DECLARE R : REC;
     BEGIN P3 (R); FAILED ("E"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN PASSE ((1, "X")); FAILED ("F"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     NB := 0;
     DECLARE R : REC := (3, "ABC"); R3 : SREC;
     BEGIN P1 (R); P2 (R); P3 (R); P1 ((3, "XYZ")); P2 (R3); PASSE (R);
          Q (T (1)); Q ((5, 10)); Q (T (IDENT_INT (2)));
     EXCEPTION WHEN OTHERS => FAILED ("EXCEPTION INATTENDUE");
     END;
     IF NB /= 3 + 1 + 1 + 3 + 1 + 3 + 7 + 10 + 7 THEN FAILED ("NB =" & INTEGER'IMAGE (NB)); END IF;
     RESULT;
END DISCR9;
