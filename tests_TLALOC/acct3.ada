WITH REPORT; USE REPORT;
PROCEDURE ACCT3 IS
     TYPE AS IS ACCESS STRING;
     SUBTYPE AS5 IS AS (1 .. 5);
     X : AS5 := NEW STRING'("ABCDE");
     Y : AS := NEW STRING'("ABC");
     Z : AS (2 .. 3) := NEW STRING (2 .. 3);
     FUNCTION F (S : AS5) RETURN CHARACTER IS BEGIN RETURN S (5); END F;
BEGIN
     TEST ("ACCT3", "SOUS-TYPE D'ACCES CONTRAINT A DESIGNE TABLEAU");
     IF F (X) /= 'E' THEN FAILED ("F"); END IF;
     BEGIN X := Y; FAILED ("AFFECTATION NON CONTROLEE"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN IF F (Y) = 'C' THEN NULL; END IF; FAILED ("PARAMETRE NON CONTROLE"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN X := NEW STRING'("ABCDEF"); FAILED ("ALLOCATEUR NON CONTROLE"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN Z := NEW STRING (1 .. 2); FAILED ("BORNES NON CONTROLEES"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     Y := NEW STRING'("VWXYZ");
     X := AS5 (Y);
     X := NULL; Y := NULL; X := Y;
     Z (3) := 'Q';
     IF Z.ALL (3) /= 'Q' THEN FAILED ("Z"); END IF;
     RESULT;
END ACCT3;
