WITH REPORT; USE REPORT;
WITH TEXT_IO; USE TEXT_IO;
PROCEDURE TMPFIC1 IS
     F, G, H : FILE_TYPE;
     S : STRING (1 .. 10);
     L : NATURAL;
BEGIN
     TEST ("TMPFIC1", "CREATE SANS NOM : FICHIER TEMPORAIRE (LRM 14.2.1)");
     BEGIN
          CREATE (F);
          CREATE (G, OUT_FILE, "");
     EXCEPTION
          WHEN USE_ERROR => FAILED ("USE_ERROR SUR CREATE SANS NOM");
     END;
     IF NOT IS_OPEN (F) OR NOT IS_OPEN (G) THEN FAILED ("NON OUVERTS"); END IF;
     IF NAME (F)'LENGTH = 0 OR NAME (F) = NAME (G) THEN FAILED ("NOMS"); END IF;
     PUT_LINE (F, "ABC");
     PUT_LINE (G, "DEFGH");
     RESET (F, IN_FILE);
     RESET (G, IN_FILE);
     GET_LINE (G, S, L);
     IF S (1 .. L) /= "DEFGH" THEN FAILED ("RELECTURE G"); END IF;
     GET_LINE (F, S, L);
     IF S (1 .. L) /= "ABC" THEN FAILED ("RELECTURE F"); END IF;
     CLOSE (F);
     DELETE (G);
     IF IS_OPEN (F) OR IS_OPEN (G) THEN FAILED ("ENCORE OUVERTS"); END IF;
     CREATE (H, OUT_FILE, "tmpfic1.txt");
     PUT (H, 'X');
     RESET (H, IN_FILE);
     GET (H, S (1));
     IF S (1) /= 'X' THEN FAILED ("FICHIER NOMME"); END IF;
     DELETE (H);
     RESULT;
END TMPFIC1;
