WITH REPORT; USE REPORT;
PROCEDURE DERFST2 IS
     TYPE PARENT IS ARRAY (INTEGER RANGE <>) OF INTEGER;
     TYPE T IS NEW PARENT (IDENT_INT (5) .. IDENT_INT (7));
     TYPE M IS ARRAY (INTEGER RANGE <>, INTEGER RANGE <>) OF INTEGER;
     TYPE TM IS NEW M (1 .. IDENT_INT (2), IDENT_INT (3) .. 6);
     TYPE I IS NEW INTEGER RANGE IDENT_INT (2) .. IDENT_INT (9);
     TYPE J IS RANGE 1 .. 10;
BEGIN
     TEST ("DERFST2", "'FIRST / 'LAST DE TYPES DERIVES A CONTRAINTE DYNAMIQUE");
     IF T'FIRST /= 5 OR T'LAST /= 7 THEN FAILED ("T"); END IF;
     IF TM'FIRST (2) /= 3 OR TM'LAST (2) /= 6 OR TM'LAST /= 2 THEN FAILED ("TM"); END IF;
     IF I'FIRST /= 2 OR I'LAST /= 9 THEN FAILED ("I"); END IF;
     IF J'FIRST /= 1 OR J'LAST /= 10 THEN FAILED ("J"); END IF;
     RESULT;
END DERFST2;
