WITH REPORT; USE REPORT;
PROCEDURE SMALLSUB1 IS
     TYPE LIKE_DURATION IS DELTA 0.020 RANGE -86_400.0 .. 86_400.0;
     SUBTYPE F  IS LIKE_DURATION DELTA 0.25 RANGE -1000.0 .. 1000.0;
     SUBTYPE G  IS LIKE_DURATION DELTA 1.0 / 16 RANGE -13.0 / 16 .. 5.0 + 1.0 / 16;
     TIERS  : CONSTANT := 2.0 / 3;
     MOINS1 : CONSTANT := -1.5;
     MOINS2 : CONSTANT := -0.5;
     X : F := 0.0;
BEGIN
     TEST ("SMALLSUB1", "'SMALL D'UN SOUS-TYPE A DELTA PROPRE ; OPERATIONS UNIVERSELLES MIXTES");
     IF F'SMALL /= 0.25 THEN FAILED ("F'SMALL"); END IF;
     IF G'SMALL /= 0.0625 THEN FAILED ("G'SMALL"); END IF;
     IF LIKE_DURATION'SMALL /= 1.0 / 64 THEN FAILED ("LIKE_DURATION'SMALL"); END IF;
     IF F'MANTISSA /= 12 THEN FAILED ("F'MANTISSA" & INTEGER'IMAGE (F'MANTISSA)); END IF;
     IF F'LARGE /= 1023.75 THEN FAILED ("F'LARGE"); END IF;
     IF EQUAL (3, 3) THEN X := 100.75; END IF;
     IF X + F'SMALL /= 101.0 THEN FAILED ("100.75 + F'SMALL"); END IF;
     IF TIERS + F'SMALL NOT IN 0.75 .. 1.0 THEN FAILED ("(2.0 / 3) + F'SMALL"); END IF;
     IF TIERS * 3 /= 2.0 OR 3 * TIERS /= 2.0 THEN FAILED ("TIERS * 3"); END IF;
     IF NOT (MOINS1 < MOINS2) OR MOINS1 >= MOINS2 THEN FAILED ("COMPARAISON UNIVERSELLE NEGATIVE"); END IF;
     RESULT;
END SMALLSUB1;
