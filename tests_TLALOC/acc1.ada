WITH REPORT; USE REPORT;
PROCEDURE ACC1 IS
     TYPE REC (D : INTEGER := 1) IS RECORD V : INTEGER := 7; END RECORD;
     TYPE ACC IS ACCESS REC;
     SUBTYPE ACC3 IS ACC (3);
     X : ACC (3);
     Y : ACC3 := NEW REC'(3, 9);
     Z : ACC;
     FUNCTION F (P : ACC3) RETURN INTEGER IS BEGIN RETURN P.V; END F;
     FUNCTION G (B : BOOLEAN) RETURN ACC3 IS
     BEGIN
          IF B THEN RETURN NEW REC'(3, 1); ELSE RETURN NEW REC'(4, 1); END IF;
     END G;
BEGIN
     TEST ("ACC1", "SOUS-TYPES D'ACCES CONTRAINTS");
     IF X /= NULL THEN FAILED ("X NON NUL"); END IF;
     IF Y.D /= 3 OR Y.V /= 9 THEN FAILED ("Y"); END IF;
     X := NEW REC (3);
     IF X.D /= 3 THEN FAILED ("X"); END IF;
     IF F (Y) /= 9 THEN FAILED ("F"); END IF;
     Z := NEW REC'(4, 2);
     BEGIN X := Z; FAILED ("AFFECTATION NON CONTROLEE"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN IF F (Z) = 2 THEN FAILED ("PARAMETRE NON CONTROLE 1"); END IF; FAILED ("PARAMETRE NON CONTROLE");
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN X := ACC3 (Z); FAILED ("CONVERSION NON CONTROLEE"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN X := G (FALSE); FAILED ("RETOUR NON CONTROLE"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN
          DECLARE W : ACC3 := Z; BEGIN FAILED ("INIT NON CONTROLEE"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL;
     END;
     X := NULL; Z := NULL; X := Z;
     X := G (TRUE);
     IF X.D /= 3 THEN FAILED ("G"); END IF;
     RESULT;
END ACC1;
