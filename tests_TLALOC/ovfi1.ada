WITH REPORT; USE REPORT;
PROCEDURE OVFI1 IS
     TYPE T IS RANGE 1 .. 100;
     TYPE COULEUR IS (ROUGE, VERT, BLEU);
     I : INTEGER := INTEGER'LAST;
     J : INTEGER := INTEGER'FIRST;
     S : SHORT_INTEGER := SHORT_INTEGER'LAST;
     A : T := 50;
     B : T := 60;
     C : COULEUR := BLEU;
     K : INTEGER;
     COMPTE : INTEGER := 0;
     PROCEDURE ATTENDU (M : STRING) IS
     BEGIN
          FAILED ("PAS D'EXCEPTION : " & M);
     END ATTENDU;
BEGIN
     TEST ("OVFI1", "TYPE DE BASE DES ENTIERS ETROITS (LRM 4.5, 3.5.5 ; LLIR V8)");
     IF EQUAL (3, 3) THEN I := INTEGER'LAST; J := INTEGER'FIRST; END IF;
     BEGIN K := I + 1;                 ATTENDU ("INTEGER + 1"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN K := J - IDENT_INT (1);     ATTENDU ("INTEGER - 1"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN K := I * IDENT_INT (2);     ATTENDU ("INTEGER * 2"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN K := -J;                    ATTENDU ("- INTEGER'FIRST"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN K := ABS J;                 ATTENDU ("ABS INTEGER'FIRST"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN K := J / IDENT_INT (-1);    ATTENDU ("INTEGER'FIRST / -1"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN K := IDENT_INT (2) ** 31;   ATTENDU ("2 ** 31"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN S := S + 1;                 ATTENDU ("SHORT_INTEGER + 1"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN K := INTEGER'SUCC (I);      ATTENDU ("INTEGER'SUCC"); EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN K := INTEGER'PRED (J);      ATTENDU ("INTEGER'PRED"); EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN C := COULEUR'SUCC (C);      ATTENDU ("COULEUR'SUCC"); EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN C := COULEUR'VAL (IDENT_INT (3)); ATTENDU ("COULEUR'VAL (3)"); EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN K := CHARACTER'POS (CHARACTER'PRED (IDENT_CHAR (ASCII.NUL))); ATTENDU ("CHARACTER'PRED (NUL)"); EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     IF COMPTE /= 13 THEN FAILED ("EXCEPTIONS :" & INTEGER'IMAGE (COMPTE)); END IF;
     -- RESULTATS INTERMEDIAIRES HORS DU SOUS-TYPE MAIS DANS LE TYPE DE BASE : PAS D'EXCEPTION
     IF A + B - B /= A THEN FAILED ("T : A + B - B"); END IF;
     IF (I - 1) + 1 /= INTEGER'LAST THEN FAILED ("INTEGER'LAST - 1 + 1"); END IF;
     IF INTEGER'SUCC (I - 1) /= I OR COULEUR'PRED (C) /= VERT OR COULEUR'VAL (IDENT_INT (0)) /= ROUGE THEN
          FAILED ("SUCC / PRED / VAL DANS LES BORNES");
     END IF;
     IF CHARACTER'POS (CHARACTER'VAL (IDENT_INT (65))) /= 65 THEN FAILED ("CHARACTER'VAL (65)"); END IF;
     RESULT;
END OVFI1;
