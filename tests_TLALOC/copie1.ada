WITH REPORT; USE REPORT;
PROCEDURE COPIE1 IS
     SUBTYPE DIGIT IS INTEGER RANGE 0 .. 9;
     SUBTYPE PETIT IS INTEGER RANGE 1 .. 5;
     TYPE TAB IS ARRAY (1 .. 3) OF INTEGER;
     TYPE REC IS RECORD A, B : INTEGER; END RECORD;
     TYPE AI IS ACCESS INTEGER;
     PACKAGE P IS
          TYPE T IS PRIVATE;
          FUNCTION MK (I : INTEGER) RETURN T;
          FUNCTION VAL (X : T) RETURN INTEGER;
     PRIVATE
          TYPE T IS NEW INTEGER;
     END P;
     USE P;
     I : INTEGER := 0;
     S : PETIT := 1;
     V : TAB := (1, 2, 3);
     R : REC := (4, 5);
     X : T;
     Q : AI := NEW INTEGER'(7);
     E : EXCEPTION;
     PACKAGE BODY P IS
          FUNCTION MK (I : INTEGER) RETURN T IS BEGIN RETURN T (I); END MK;
          FUNCTION VAL (X : T) RETURN INTEGER IS BEGIN RETURN INTEGER (X); END VAL;
     END P;
     PROCEDURE ALIAS (PO : OUT INTEGER; PIO : IN OUT INTEGER) IS
     BEGIN
          PO := 10; PIO := PIO + 100; I := I + 1;
          IF PIO /= 100 THEN FAILED ("PIO VOIT LA GLOBALE"); END IF;
          RAISE E;
     END ALIAS;
     PROCEDURE INC (PIO : IN OUT INTEGER) IS BEGIN PIO := PIO + 1; END INC;
     PROCEDURE SET (PO : OUT INTEGER; N : INTEGER) IS BEGIN PO := N; END SET;
     PROCEDURE PD (PIO : IN OUT DIGIT) IS BEGIN NULL; END PD;
     PROCEDURE RELAIS (PO : OUT INTEGER) IS BEGIN SET (PO, 42); END RELAIS;
     PROCEDURE PT (PIO : IN OUT T) IS BEGIN PIO := MK (VAL (PIO) + 1); END PT;
     PROCEDURE PA (PIO : IN OUT AI) IS BEGIN PIO := NEW INTEGER'(PIO.ALL + 1); END PA;
BEGIN
     TEST ("COPIE1", "SCALAIRES ET ACCES OUT / IN OUT PAR COPIE (LRM 6.2, 6.4.1)");
     BEGIN ALIAS (I, I); FAILED ("PAS D'EXCEPTION");
     EXCEPTION WHEN E => IF I /= 1 THEN FAILED ("ACTUEL MODIFIE MALGRE L'EXCEPTION :" & INTEGER'IMAGE (I)); END IF;
     END;
     INC (I); IF I /= 2 THEN FAILED ("INC"); END IF;
     INC (V (2)); INC (R.B); IF V (2) /= 3 OR R.B /= 6 THEN FAILED ("COMPOSANTS"); END IF;
     RELAIS (I); IF I /= 42 THEN FAILED ("RELAIS"); END IF;
     I := IDENT_INT (10);
     BEGIN PD (I); FAILED ("PAS DE CONTROLE A L'ENTREE");
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL;
     END;
     BEGIN SET (S, IDENT_INT (6)); FAILED ("PAS DE CONTROLE AU RETOUR");
     EXCEPTION WHEN CONSTRAINT_ERROR => IF S /= 1 THEN FAILED ("S MODIFIE"); END IF;
     END;
     SET (S, 5); IF S /= 5 THEN FAILED ("SET S"); END IF;
     X := MK (3); PT (X); IF VAL (X) /= 4 THEN FAILED ("PRIVE"); END IF;
     PA (Q); IF Q.ALL /= 8 THEN FAILED ("ACCES"); END IF;
     RESULT;
END COPIE1;
