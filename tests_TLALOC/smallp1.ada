WITH REPORT; USE REPORT;
WITH SYSTEM;
PROCEDURE SMALLP1 IS
     TYPE D2  IS DELTA 2.0 RANGE -(2.0 ** (SYSTEM.MAX_MANTISSA + 1)) .. 2.0 ** (SYSTEM.MAX_MANTISSA + 1);
     TYPE D16 IS DELTA 2.0 ** (-4) RANGE -100.0 .. 100.0;
     TYPE D10 IS DELTA 0.1 RANGE -100.0 .. 100.0;
     P63 : CONSTANT := 2.0 ** SYSTEM.MAX_MANTISSA;
     X : D2 := 2.0;
     Y : D16 := D16'SMALL;
BEGIN
     TEST ("SMALLP1", "SMALL D'UN DELTA PUISSANCE DE 2 : LE DELTA LUI-MEME (LRM 3.5.9(5))");
     IF D2'SMALL /= 2.0 THEN FAILED ("D2'SMALL"); END IF;
     IF D16'SMALL /= 0.0625 THEN FAILED ("D16'SMALL"); END IF;
     IF D10'SMALL /= 0.0625 THEN FAILED ("D10'SMALL"); END IF;
     IF Y /= D16'DELTA THEN FAILED ("D16'SMALL /= D16'DELTA"); END IF;
     FOR I IN 1 .. SYSTEM.MAX_MANTISSA - 1 LOOP
          X := X * IDENT_INT (2);
     END LOOP;
     IF X /= P63 THEN FAILED ("D2 : 2**MAX_MANTISSA"); END IF;
     IF INTEGER (Y * 16) /= 1 OR INTEGER (D16 (Y * IDENT_INT (24))) /= 2 THEN FAILED ("D16 : VALEURS"); END IF;
     RESULT;
END SMALLP1;
