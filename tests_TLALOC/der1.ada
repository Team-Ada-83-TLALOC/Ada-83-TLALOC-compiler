WITH REPORT; USE REPORT;
PROCEDURE DER1 IS
     PACKAGE P IS
          TYPE T IS RANGE 0 .. 100;
          FUNCTION MK (I : INTEGER) RETURN T;
     END P;
     TYPE D IS NEW P.T;
     X : D;
     PACKAGE BODY P IS
          FUNCTION MK (I : INTEGER) RETURN T IS BEGIN RETURN T (I); END MK;
     END P;
BEGIN
     TEST ("DER1", "SOUS-PROGRAMME DERIVE, TYPE PUBLIC, DERIVATION HORS DU PAQUETAGE");
     X := MK (IDENT_INT (7));
     IF X /= 7 THEN FAILED ("MK"); END IF;
     RESULT;
END DER1;
