WITH REPORT; USE REPORT;
PROCEDURE FLTATT1 IS
     TYPE F5 IS DIGITS 5;
     TYPE F15 IS DIGITS 15;
     SUBTYPE S3 IS F5 DIGITS 3;
     TYPE FW IS DIGITS 5 RANGE -1.0E300 .. 1.0E300;
     TYPE R1 IS RANGE 0 .. F5'EMAX;
     TYPE R2 IS RANGE 0 .. F5'SAFE_EMAX;
     TYPE R3 IS RANGE 0 .. FLOAT'MACHINE_MANTISSA;
     TYPE R4 IS RANGE 0 .. FW'SAFE_EMAX;
     TYPE G IS DIGITS F5'MANTISSA / 4;
     M5   : CONSTANT := F5'MANTISSA;
     E5   : CONSTANT := F5'EMAX;
     EP5  : CONSTANT := F5'EPSILON;
     SE5  : CONSTANT := F5'SAFE_EMAX;
     SE15 : CONSTANT := F15'SAFE_EMAX;
     SS5  : CONSTANT := F5'SAFE_SMALL;
     MM   : CONSTANT := FLOAT'MACHINE_MANTISSA;
     ME   : CONSTANT := LONG_FLOAT'MACHINE_EMAX;
BEGIN
     TEST ("FLTATT1", "ATTRIBUTS DU MODELE FLOTTANT (LRM 3.5.7, 3.5.8), TYPES NON FORMELS");
     IF F5'DIGITS /= 5 OR F5'MANTISSA /= 18 OR F5'EMAX /= 72 THEN FAILED ("F5 : ENTIERS"); END IF;
     IF F5'EPSILON /= 16#0.8#E-4 OR F5'SMALL /= 16#0.8#E-18 OR F5'LARGE /= 16#0.FFFFC#E18 THEN
          FAILED ("F5 : REELS");
     END IF;
     IF F5'SAFE_EMAX /= 125 OR F5'SAFE_SMALL /= 2#1.0#E-126 OR F5'SAFE_LARGE /= 2#0.111111111111111111111#E125 THEN
          FAILED ("F5 : NOMBRES SURS");
     END IF;
     IF F5'BASE'DIGITS /= 6 OR F5'BASE'MANTISSA /= 21 OR F5'BASE'EMAX /= 84 OR F5'BASE'EPSILON /= 2#1.0#E-20 THEN
          FAILED ("F5'BASE");
     END IF;
     IF F15'DIGITS /= 15 OR F15'MANTISSA /= 51 OR F15'EMAX /= 204 OR F15'SAFE_EMAX /= 1021 THEN
          FAILED ("F15 : ENTIERS");
     END IF;
     IF F15'EPSILON /= 2#1.0#E-50 OR F15'SMALL /= 2#1.0#E-205 OR F15'LARGE /= 2#0.111111111111111111111111111111111111111111111111111#E204 THEN
          FAILED ("F15 : REELS");
     END IF;
     IF F15'SAFE_SMALL /= 2#1.0#E-1022 OR F15'SAFE_LARGE /= 2#0.111111111111111111111111111111111111111111111111111#E1021 THEN FAILED ("F15 : NOMBRES SURS"); END IF;
     IF S3'DIGITS /= 3 OR S3'MANTISSA /= 11 OR S3'EMAX /= 44 OR S3'EPSILON /= 2#1.0#E-10 OR S3'BASE'DIGITS /= 6 THEN
          FAILED ("S3");
     END IF;
     IF FLOAT'MANTISSA /= 21 OR LONG_FLOAT'MANTISSA /= 51 THEN FAILED ("FLOAT, LONG_FLOAT"); END IF;
     IF FLOAT'MACHINE_MANTISSA /= 24 OR FLOAT'MACHINE_EMAX /= 128 OR LONG_FLOAT'MACHINE_MANTISSA /= 53
        OR LONG_FLOAT'MACHINE_EMAX /= 1024 OR LONG_FLOAT'MACHINE_EMIN /= -1021 THEN
          FAILED ("MACHINE_*");
     END IF;
     IF M5 /= 18 OR E5 /= 72 OR EP5 /= 2#1.0#E-17 OR SE5 /= 125 OR SE15 /= 1021 OR SS5 /= 2#1.0#E-126 THEN
          FAILED ("PLIAGE STATIQUE : MODELE");
     END IF;
     IF MM /= 24 OR ME /= 1024 THEN FAILED ("PLIAGE STATIQUE : MACHINE_*"); END IF;
     IF R1'LAST /= 72 OR R2'LAST /= 125 OR R3'LAST /= 24 OR R4'LAST /= 1021 OR G'DIGITS /= 4 THEN
          FAILED ("PLIAGE STATIQUE : BORNES ET PRECISION");
     END IF;
     IF FW'MANTISSA /= 18 OR FW'BASE'DIGITS /= 15 OR FW'SAFE_EMAX /= 1021 OR FW'SAFE_SMALL /= 2#1.0#E-1022 THEN
          FAILED ("FW : BASE LONG_FLOAT");
     END IF;
     RESULT;
END FLTATT1;
