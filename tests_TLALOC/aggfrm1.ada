WITH REPORT; USE REPORT;
PROCEDURE AGGFRM1 IS
     TYPE ARR_T IS ARRAY (INTEGER RANGE <>) OF INTEGER;
     A : ARR_T (IDENT_INT (3) .. 5) := (OTHERS => 0);
     PROCEDURE P2 (ARR : IN OUT ARR_T) IS
     BEGIN
          ARR := (ARR'RANGE => 10);
     END P2;
BEGIN
     TEST ("AGGFRM1", "AGREGAT ARR'RANGE AFFECTE A UN FORMEL NON CONTRAINT");
     P2 (A);
     IF A /= (10, 10, 10) THEN FAILED ("A"); END IF;
     RESULT;
END AGGFRM1;
