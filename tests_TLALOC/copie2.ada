WITH REPORT; USE REPORT;
PROCEDURE COPIE2 IS
     TYPE T1 IS RECORD A : INTEGER; B, C : BOOLEAN; END RECORD;
     TYPE T5 IS RECORD I : INTEGER; J : T1; END RECORD;
     PROCEDURE P1 (X : IN BOOLEAN; Y : IN OUT INTEGER; Z : OUT BOOLEAN) IS
     BEGIN
          IF NOT X OR Y /= 1 THEN FAILED ("ENTREE"); END IF;
          Y := 10; Z := TRUE;
     END P1;
BEGIN
     TEST ("COPIE2", "COMPOSANT DE COMPOSANT EN ACTUEL OUT / IN OUT");
     DECLARE
          X5 : T5 := (I => 5, J => (1, TRUE, FALSE));
     BEGIN
     X5 := (I => 5, J => (A=>1, B=>TRUE, C=>FALSE));
     P1 (X5.J.B, X5.J.A, X5.J.C);
     IF X5 /= (5, (10, TRUE, TRUE)) THEN FAILED ("EGALITE GLOBALE"); END IF;
     IF X5.I /= 5 THEN FAILED ("I =" & INTEGER'IMAGE (X5.I)); END IF;
     IF X5.J.A /= 10 THEN FAILED ("A =" & INTEGER'IMAGE (X5.J.A)); END IF;
     IF NOT X5.J.C THEN FAILED ("C"); END IF;
     END;
     RESULT;
END COPIE2;
