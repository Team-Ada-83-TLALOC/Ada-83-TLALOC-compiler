WITH REPORT; USE REPORT;
PROCEDURE COMPAT1 IS
     SUBTYPE SM IS INTEGER RANGE 1 .. 10;
     TYPE REC (D1, D2 : SM) IS RECORD NULL; END RECORD;
     NB_DEF : INTEGER := 0;
     FUNCTION DEF RETURN INTEGER;
     -- C1 DEPEND DE D3 ; N A UN DEFAUT A EFFET DE BORD, JAMAIS EVALUE A L'ELABORATION
     TYPE CONS (D3 : INTEGER) IS
          RECORD
               C1 : REC (D3, IDENT_INT (1));
               N  : INTEGER := DEF;
          END RECORD;
     TYPE VAR (B : BOOLEAN; D : INTEGER) IS
          RECORD
               CASE B IS
                    WHEN TRUE  => V1 : REC (D, 2);
                    WHEN FALSE => V2 : INTEGER;
               END CASE;
          END RECORD;
     COMPTE : INTEGER := 0;
     FUNCTION DEF RETURN INTEGER IS
     BEGIN
          NB_DEF := NB_DEF + 1;
          RETURN 5;
     END DEF;
     PROCEDURE ATTENDU (M : STRING) IS
     BEGIN
          FAILED ("PAS D'EXCEPTION : " & M);
     END ATTENDU;
BEGIN
     TEST ("COMPAT1", "COMPATIBILITE DES CONTRAINTES DE RECORDS STATIQUES A L'ELABORATION (LRM 3.7.2)");
     -- 1. SOUS-TYPE
     BEGIN
          DECLARE SUBTYPE S IS CONS (IDENT_INT (11)); BEGIN ATTENDU ("SUBTYPE"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     -- 2. TYPE DERIVE CONTRAINT
     BEGIN
          DECLARE TYPE N IS NEW CONS (0); BEGIN ATTENDU ("NEW CONS (0)"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     -- 3. COMPOSANT DE TABLEAU
     BEGIN
          DECLARE TYPE A IS ARRAY (1 .. 2) OF CONS (IDENT_INT (11)); BEGIN ATTENDU ("ARRAY"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     -- 4. COMPOSANT DE RECORD
     BEGIN
          DECLARE TYPE R IS RECORD C : CONS (IDENT_INT (0)); END RECORD; BEGIN ATTENDU ("RECORD"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     -- 5. TYPE D'ACCES
     BEGIN
          DECLARE TYPE P IS ACCESS CONS (IDENT_INT (11)); BEGIN ATTENDU ("ACCESS"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     -- 6. VARIANTE CHOISIE
     BEGIN
          DECLARE SUBTYPE S IS VAR (IDENT_BOOL (TRUE), 0); BEGIN ATTENDU ("VARIANTE TRUE"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     -- 7. ALLOCATEUR
     DECLARE
          TYPE P IS ACCESS CONS;
          X : P;
     BEGIN
          X := NEW CONS (IDENT_INT (0));
          ATTENDU ("NEW CONS (0)");
     EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1;
     END;
     IF COMPTE /= 7 THEN FAILED ("EXCEPTIONS :" & INTEGER'IMAGE (COMPTE)); END IF;
     IF NB_DEF /= 0 THEN FAILED ("DEFAUT EVALUE A L'ELABORATION :" & INTEGER'IMAGE (NB_DEF)); END IF;
     -- SANS EXCEPTION
     DECLARE
          SUBTYPE S IS CONS (IDENT_INT (3));
          TYPE N IS NEW CONS (4);
          TYPE A IS ARRAY (1 .. 2) OF CONS (IDENT_INT (5));
          TYPE R IS RECORD C : CONS (IDENT_INT (6)); END RECORD;
          TYPE P IS ACCESS CONS (7);
          SUBTYPE SV IS VAR (IDENT_BOOL (FALSE), 0);      -- VARIANTE ABSENTE : PAS DE CONTROLE
          X : S;
          Y : N;
     BEGIN
          IF NB_DEF /= 2 THEN FAILED ("DEFAUTS DES OBJETS :" & INTEGER'IMAGE (NB_DEF)); END IF;
          IF X /= (3, (3, 1), 5) OR Y /= (4, (4, 1), 5) THEN FAILED ("VALEURS"); END IF;
     EXCEPTION WHEN OTHERS => FAILED ("EXCEPTION INATTENDUE");
     END;
     RESULT;
END COMPAT1;
