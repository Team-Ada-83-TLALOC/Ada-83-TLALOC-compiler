WITH REPORT; USE REPORT;
PROCEDURE CONVNC1 IS
     SUBTYPE SUBINT IS INTEGER RANGE IDENT_INT (0) .. IDENT_INT (9);
     SUBTYPE NOINT IS INTEGER RANGE IDENT_INT (1) .. IDENT_INT (0);
     SUBTYPE C1 IS INTEGER RANGE -8 .. 0;
     SUBTYPE C2 IS INTEGER RANGE -8 .. 1;
     SUBTYPE D1 IS INTEGER RANGE -8 .. IDENT_INT (1);
     SUBTYPE D2 IS INTEGER RANGE -8 .. IDENT_INT (1);
     SUBTYPE D3 IS INTEGER RANGE -8 .. IDENT_INT (2);
     TYPE ARR1 IS ARRAY (INTEGER RANGE <>) OF INTEGER;
     TYPE ARR2 IS ARRAY (SUBINT RANGE <>) OF INTEGER;
     TYPE DER IS NEW ARR1;
     TYPE M1 IS ARRAY (INTEGER RANGE <>, INTEGER RANGE <>) OF INTEGER;
     TYPE M2 IS ARRAY (SUBINT RANGE <>, INTEGER RANGE <>) OF INTEGER;
     TYPE M3 IS ARRAY (SUBINT RANGE <>, NOINT RANGE <>) OF INTEGER;
     TYPE TC1 IS ARRAY (INTEGER RANGE <>) OF C1;
     TYPE TC2 IS ARRAY (INTEGER RANGE <>) OF C2;
     TYPE TD1 IS ARRAY (INTEGER RANGE <>) OF D1;
     TYPE TD2 IS ARRAY (INTEGER RANGE <>) OF D2;
     TYPE TD3 IS ARRAY (INTEGER RANGE <>) OF D3;
     TYPE COULEUR IS (ROUGE, VERT, BLEU, NOIR);
     TYPE COUL2 IS NEW COULEUR;
     SUBTYPE CLAIR IS COUL2 RANGE ROUGE .. BLEU;
     TYPE TCOUL IS ARRAY (COULEUR RANGE <>) OF INTEGER;
     TYPE TCLAIR IS ARRAY (CLAIR RANGE <>) OF INTEGER;
     A : ARR1 (IDENT_INT (1) .. IDENT_INT (10)) := (OTHERS => 0);
     B : ARR1 (IDENT_INT (3) .. IDENT_INT (5)) := (7, 8, 9);
     Z : ARR1 (IDENT_INT (10) .. IDENT_INT (9));
     MA : M1 (IDENT_INT (1) .. IDENT_INT (10), 1 .. 1) := (OTHERS => (OTHERS => 0));
     MN : M1 (IDENT_INT (1) .. IDENT_INT (10), IDENT_INT (1) .. IDENT_INT (0));
     MB : M1 (2 .. 3, 5 .. 6) := ((1, 2), (3, 4));
     XC1 : TC1 (1 .. 2) := (0, -1);
     XD1 : TD1 (1 .. 2) := (0, 1);
     CA : TCOUL (VERT .. NOIR) := (1, 2, 3);
     CB : TCOUL (ROUGE .. VERT) := (4, 5);
     N : INTEGER := 0;
     PROCEDURE P2 (V : ARR2; F, L, X : INTEGER) IS
     BEGIN
          IF V'FIRST /= F OR V'LAST /= L THEN FAILED ("BORNES ARR2" & INTEGER'IMAGE (V'FIRST)); END IF;
          IF V'LENGTH > 0 AND THEN V (V'FIRST + 1) /= X THEN FAILED ("VALEUR ARR2"); END IF;
          N := N + 1;
     END P2;
     PROCEDURE PM (V : M2) IS BEGIN N := N + 1; END PM;
     PROCEDURE PM3 (V : M3) IS BEGIN N := N + 1; END PM3;
     PROCEDURE PD (V : DER) IS
     BEGIN
          IF V'FIRST /= 3 OR V (5) /= 9 THEN FAILED ("DER"); END IF;
          N := N + 1;
     END PD;
     PROCEDURE PTC2 (V : TC2) IS BEGIN N := N + 1; END PTC2;
     PROCEDURE PTD2 (V : TD2) IS BEGIN IF V (2) /= 1 THEN FAILED ("TD2"); END IF; N := N + 1; END PTD2;
     PROCEDURE PTD3 (V : TD3) IS BEGIN N := N + 1; END PTD3;
     PROCEDURE PCL (V : TCLAIR; F : CLAIR) IS
     BEGIN
          IF V'FIRST /= F THEN FAILED ("TCLAIR BORNES"); END IF;
          N := N + 1;
     END PCL;
     FUNCTION F (L : INTEGER) RETURN ARR1 IS
          R : ARR1 (IDENT_INT (L) .. IDENT_INT (L + 2)) := (11, 12, 13);
     BEGIN
          RETURN R;
     END F;
     PROCEDURE RELAIS (V : ARR1) IS
     BEGIN
          P2 (ARR2 (V), 3, 5, 8);
     END RELAIS;
     PROCEDURE ERREUR (MSG : STRING) IS BEGIN FAILED ("PAS DE CONSTRAINT_ERROR : " & MSG); END ERREUR;
BEGIN
     TEST ("CONVNC1", "CONVERSION VERS UN TYPE TABLEAU NON CONTRAINT (LRM 4.6, AI83-00313)");
     BEGIN P2 (ARR2 (A), 1, 10, 0); ERREUR ("1 DIMENSION"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN PM (M2 (MA)); ERREUR ("2 DIMENSIONS"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN PM (M2 (MN)); ERREUR ("DIMENSION NULLE, L'AUTRE HORS BORNES"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN PM3 (M3 (MN)); ERREUR ("M3"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN PTC2 (TC2 (XC1)); ERREUR ("COMPOSANTS STATIQUES"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN PTD3 (TD3 (XD1)); ERREUR ("COMPOSANTS DYNAMIQUES"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN PCL (TCLAIR (CA), VERT); ERREUR ("INDICE ENUMERE"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     IF N /= 0 THEN FAILED ("CORPS EXECUTE SANS CONTROLE"); END IF;
     P2 (ARR2 (B), 3, 5, 8);
     P2 (ARR2 (Z), 10, 9, 0);
     P2 (ARR2 (F (IDENT_INT (4))), 4, 6, 12);
     RELAIS (B);
     PD (DER (B));
     PTD2 (TD2 (XD1));
     PM (M2 (MB));
     PCL (TCLAIR (CB), ROUGE);
     IF N /= 8 THEN FAILED ("CONVERSIONS LICITES :" & INTEGER'IMAGE (N)); END IF;
     RESULT;
END CONVNC1;
