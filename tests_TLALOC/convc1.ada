WITH REPORT; USE REPORT;
PROCEDURE CONVC1 IS
     TYPE ARR IS ARRAY (INTEGER RANGE <>) OF INTEGER;
     SUBTYPE A10 IS ARR (10 .. 12);
     SUBTYPE AD IS ARR (IDENT_INT (5) .. 7);
     SUBTYPE A0 IS ARR (5 .. 4);
     TYPE CT IS ARRAY (1 .. 3) OF INTEGER;
     TYPE M IS ARRAY (INTEGER RANGE <>, INTEGER RANGE <>) OF INTEGER;
     SUBTYPE M23 IS M (1 .. 2, 4 .. 6);
     SUBTYPE M03 IS M (1 .. 0, 1 .. 3);
     SUBTYPE C1 IS INTEGER RANGE -8 .. 0;
     SUBTYPE C2 IS INTEGER RANGE -8 .. 1;
     SUBTYPE D1 IS INTEGER RANGE -8 .. IDENT_INT (1);
     SUBTYPE D2 IS INTEGER RANGE -8 .. IDENT_INT (1);
     TYPE TC1 IS ARRAY (1 .. 2) OF C1;
     TYPE TC2 IS ARRAY (1 .. 2) OF C2;
     TYPE TD1 IS ARRAY (1 .. 2) OF D1;
     TYPE TD2 IS ARRAY (1 .. 2) OF D2;
     X : ARR (1 .. 3) := (7, 8, 9);
     X4 : ARR (1 .. 4) := (OTHERS => 0);
     X0 : ARR (IDENT_INT (1) .. IDENT_INT (0));
     MX : M (2 .. 3, 1 .. 3) := ((1, 2, 3), (4, 5, 6));
     MY : M (1 .. 2, 1 .. 2) := ((1, 2), (3, 4));
     MN : M (1 .. 0, 1 .. 5);
     XC1 : TC1 := (0, -1);
     XD1 : TD1 := (0, 1);
     Y : A10;
     N : INTEGER := 0;
     PROCEDURE P (V : ARR; F, L : INTEGER) IS
     BEGIN
          IF V'FIRST /= F OR V'LAST /= L THEN FAILED ("BORNES" & INTEGER'IMAGE (V'FIRST)); END IF;
          IF V'LENGTH = 3 AND THEN V (F) /= 7 AND THEN V (F) /= 11 THEN FAILED ("VALEUR" & INTEGER'IMAGE (V (F))); END IF;
          N := N + 1;
     END P;
     PROCEDURE Q (V : CT) IS BEGIN IF V'FIRST /= 1 OR V (3) /= 9 THEN FAILED ("CT"); END IF; N := N + 1; END Q;
     PROCEDURE PM (V : M; F1, F2 : INTEGER) IS
     BEGIN
          IF V'FIRST (1) /= F1 OR V'FIRST (2) /= F2 THEN FAILED ("BORNES M"); END IF;
          IF V'LENGTH (1) > 0 AND THEN V (F1 + 1, F2 + 2) /= 6 THEN FAILED ("VALEUR M"); END IF;
          N := N + 1;
     END PM;
     PROCEDURE PTC2 (V : TC2) IS BEGIN N := N + 1; END PTC2;
     PROCEDURE PTD2 (V : TD2) IS BEGIN IF V (2) /= 1 THEN FAILED ("TD2"); END IF; N := N + 1; END PTD2;
     PROCEDURE INC (V : IN OUT A10) IS
     BEGIN
          IF V'FIRST /= 10 THEN FAILED ("IN OUT BORNES"); END IF;
          V (11) := V (11) + 100;
          N := N + 1;
     END INC;
     FUNCTION F RETURN ARR IS
          R : ARR (IDENT_INT (21) .. IDENT_INT (23)) := (11, 12, 13);
     BEGIN
          RETURN R;
     END F;
     PROCEDURE ERREUR (MSG : STRING) IS BEGIN FAILED ("PAS DE CONSTRAINT_ERROR : " & MSG); END ERREUR;
BEGIN
     TEST ("CONVC1", "CONVERSION VERS UN SOUS-TYPE TABLEAU CONTRAINT (LRM 4.6) : GLISSEMENT ET CONTROLES");
     BEGIN P (A10 (X4), 10, 12); ERREUR ("LONGUEUR"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN P (AD (X4), 5, 7); ERREUR ("LONGUEUR, SOUS-TYPE DYNAMIQUE"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN PM (M23 (MY), 1, 4); ERREUR ("LONGUEUR 2 DIMENSIONS"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN P (A0 (X), 5, 4); ERREUR ("CIBLE NULLE, OPERANDE NON NUL"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN P (A10 (X0), 10, 12); ERREUR ("OPERANDE NUL, CIBLE NON NULLE"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN PTC2 (TC2 (XC1)); ERREUR ("COMPOSANTS"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     IF N /= 0 THEN FAILED ("CORPS EXECUTE SANS CONTROLE"); END IF;
     P (A10 (X), 10, 12);
     P (AD (X), 5, 7);
     P (A10 (F), 10, 12);
     Q (CT (X));
     PM (M23 (MX), 1, 4);
     P (A0 (X0), 5, 4);
     PM (M03 (MN), 1, 1);
     PTD2 (TD2 (XD1));
     Y := A10 (X);
     IF Y (10) /= 7 OR Y (12) /= 9 THEN FAILED ("AFFECTATION"); END IF;
     INC (A10 (X));
     IF X (2) /= 108 THEN FAILED ("IN OUT : X (2) =" & INTEGER'IMAGE (X (2))); END IF;
     IF N /= 9 THEN FAILED ("CONVERSIONS LICITES :" & INTEGER'IMAGE (N)); END IF;
     RESULT;
END CONVC1;
