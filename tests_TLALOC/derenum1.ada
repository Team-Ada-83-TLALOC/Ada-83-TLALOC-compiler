WITH REPORT; USE REPORT;
PROCEDURE DERENUM1 IS
     TYPE PARENT IS (E1, E2, E3, 'A', E4, E5, E6);
     SUBTYPE SUBPARENT IS PARENT RANGE
               PARENT'VAL (IDENT_INT (PARENT'POS (E2))) ..
               PARENT'VAL (IDENT_INT (PARENT'POS (E5)));
     TYPE T IS NEW SUBPARENT RANGE
               PARENT'VAL (IDENT_INT (PARENT'POS (E3))) ..
               PARENT'VAL (IDENT_INT (PARENT'POS (E4)));
     TYPE U IS NEW PARENT;
     SUBTYPE S IS PARENT RANGE E2 .. E5;
     TYPE B IS NEW BOOLEAN RANGE FALSE .. FALSE;
     TYPE I IS NEW INTEGER RANGE IDENT_INT (2) .. IDENT_INT (9);
     X : T := E3;
     Y : U := E6;
     Z : S := E2;
     W : B := FALSE;
BEGIN
     TEST ("DERENUM1", "ENUMERATION DERIVEE CONTRAINTE");
     IF T'FIRST /= E3 OR T'LAST /= E4 THEN FAILED ("T'FIRST / T'LAST"); END IF;
     IF T'IMAGE (X) /= "E3" OR T'IMAGE (T'LAST) /= "E4" THEN FAILED ("T'IMAGE"); END IF;
     IF U'IMAGE (Y) /= "E6" OR S'IMAGE (Z) /= "E2" THEN FAILED ("U, S'IMAGE"); END IF;
     IF NOT (X IN T) OR T'POS (X) /= 2 THEN FAILED ("APPARTENANCE / POS"); END IF;
     X := T'SUCC (X);
     IF X /= 'A' THEN FAILED ("SUCC"); END IF;
     BEGIN
          X := T (Y);
          FAILED ("PAS DE CONTROLE SUR X := E6");
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL;
     END;
     IF B'LAST /= FALSE OR B'IMAGE (W) /= "FALSE" THEN FAILED ("B"); END IF;
     BEGIN
          W := B (IDENT_BOOL (TRUE));
          FAILED ("PAS DE CONTROLE SUR W");
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL;
     END;
     IF T'BASE'FIRST /= E1 OR T'BASE'LAST /= E6 THEN FAILED ("T'BASE"); END IF;
     IF S'BASE'FIRST /= E1 OR S'BASE'LAST /= E6 THEN FAILED ("S'BASE"); END IF;
     IF INTEGER (I'BASE'FIRST) /= INTEGER'FIRST OR I'FIRST /= 2 THEN FAILED ("I'BASE"); END IF;
     RESULT;
END DERENUM1;
