WITH REPORT; USE REPORT;
PROCEDURE DFLT1 IS
     TYPE R (P : POSITIVE) IS RECORD NULL; END RECORD;
BEGIN
     TEST ("DFLT1", "CONTROLES DES DEFAUTS");
     DECLARE
          SUBTYPE SMALL IS INTEGER RANGE -5 .. 5;
          TYPE REC IS RECORD B : SMALL := IDENT_INT(-10); END RECORD;
     BEGIN
          DECLARE X : REC; BEGIN FAILED ("PAS D'EXCEPTION (B)"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL;
     END;
     DECLARE
          TYPE REC2 (D : INTEGER := IDENT_INT (-1)) IS RECORD A : R (P => D); END RECORD;
     BEGIN
          DECLARE R2 : REC2; BEGIN FAILED ("PAS D'EXCEPTION R2"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL;
     END;
     DECLARE
          TYPE REC3 (D : INTEGER := 4) IS RECORD A : R (P => D); END RECORD;
          R3 : REC3;
     BEGIN
          IF R3.A.P /= 4 THEN FAILED ("R3.A.P FAUX"); END IF;
     END;
     RESULT;
END DFLT1;
