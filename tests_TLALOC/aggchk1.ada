WITH REPORT; USE REPORT;
PROCEDURE AGGCHK1 IS
     SUBTYPE I1_7 IS INTEGER RANGE IDENT_INT (1) .. IDENT_INT (7);
     SUBTYPE I2_9 IS INTEGER RANGE IDENT_INT (2) .. IDENT_INT (9);
     SUBTYPE I1_10 IS INTEGER RANGE IDENT_INT (1) .. IDENT_INT (10);
     SUBTYPE PETIT IS INTEGER RANGE 0 .. 9;
     TYPE TB (A : I1_7) IS RECORD R : PETIT; END RECORD;
     TYPE REC (A : I2_9) IS RECORD NULL; END RECORD;
     TYPE T_REC (C : I1_10) IS RECORD D : REC (C); END RECORD;
     TYPE T_RR (A : I1_10) IS RECORD B : T_REC (A); END RECORD;
     TYPE ATB IS ACCESS TB;
     TYPE ATR IS ACCESS T_RR;
     VB : ATB;
     VR : ATR;
     COMPTE : INTEGER := 0;
BEGIN
     TEST ("AGGCHK1", "AGREGATS DE RECORDS : SOUS-TYPES DES COMPOSANTS ET CONTRAINTES (LRM 4.3, 4.3.1)");
     BEGIN VB := NEW TB'(A => IDENT_INT (0), R => 1); FAILED ("DISCRIMINANT 0"); EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN VB := NEW TB'(A => 8, R => 1); FAILED ("DISCRIMINANT 8"); EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN DECLARE X : TB := (A => IDENT_INT (0), R => 1); BEGIN FAILED ("OBJET"); END; EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN IF TB'(IDENT_INT (8), 1) = TB'(8, 1) THEN FAILED ("QUALIFIE"); END IF; FAILED ("QUALIFIE 2"); EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN VB := NEW TB'(A => 3, R => IDENT_INT (10)); FAILED ("COMPOSANT 10"); EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN VR := NEW T_RR'(1, (1, (A => 1))); FAILED ("SOUS-AGREGAT A => 1"); EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN VR := NEW T_RR'(IDENT_INT (3), (IDENT_INT (4), (A => 4))); FAILED ("CONTRAINTE 3 /= 4"); EXCEPTION WHEN CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     IF COMPTE /= 7 THEN FAILED ("EXCEPTIONS :" & INTEGER'IMAGE (COMPTE)); END IF;
     BEGIN
          VB := NEW TB'(A => IDENT_INT (7), R => 9);
          VR := NEW T_RR'(IDENT_INT (3), (IDENT_INT (3), (A => 3)));
          IF VB.R /= 9 OR VR.B.D.A /= 3 THEN FAILED ("VALEURS"); END IF;
     EXCEPTION WHEN OTHERS => FAILED ("EXCEPTION INATTENDUE");
     END;
     RESULT;
END AGGCHK1;
