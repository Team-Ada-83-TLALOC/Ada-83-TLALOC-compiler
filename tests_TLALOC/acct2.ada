WITH REPORT; USE REPORT;
PROCEDURE ACCT2 IS
     TYPE AS IS ACCESS STRING;
     X : AS := NEW STRING'("BONJOUR");
     Y : AS := NEW STRING'("BON");
     Z : AS;
     PROCEDURE P (S : STRING; L : INTEGER) IS
     BEGIN
          IF S'LENGTH /= L THEN FAILED ("PARAMETRE S'LENGTH"); END IF;
     END P;
     PROCEDURE Q (S : IN OUT STRING) IS
     BEGIN
          S (S'FIRST) := 'b';
     END Q;
BEGIN
     TEST ("ACCT2", "ACCES A TABLEAU NON CONTRAINT : X.ALL OBJET ENTIER");
     IF "-> " & X.ALL /= "-> BONJOUR" THEN FAILED ("CONCATENATION"); END IF;
     IF X.ALL (1 .. 3) /= Y.ALL THEN FAILED ("EGALITE TRANCHE"); END IF;
     IF X.ALL = Y.ALL THEN FAILED ("EGALITE"); END IF;
     P (X.ALL, 7);
     P (Y.ALL, 3);
     Q (X.ALL);
     IF X (1) /= 'b' THEN FAILED ("IN OUT"); END IF;
     X.ALL := "ABCDEFG";
     IF X (7) /= 'G' THEN FAILED ("AFFECTATION"); END IF;
     X.ALL (1 .. 3) := Y.ALL;
     IF X.ALL /= "BONDEFG" THEN FAILED ("AFFECTATION TRANCHE"); END IF;
     BEGIN X.ALL := "ABC"; FAILED ("LONGUEUR NON CONTROLEE"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     Z := NEW STRING'(X.ALL & Y.ALL);
     IF Z'LENGTH /= 10 OR Z (10) /= 'N' THEN FAILED ("COPIE"); END IF;
     RESULT;
END ACCT2;
