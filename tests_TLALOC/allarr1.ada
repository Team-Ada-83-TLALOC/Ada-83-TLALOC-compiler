WITH REPORT; USE REPORT;
PROCEDURE ALLARR1 IS
     TYPE ARR IS ARRAY (1 .. 3) OF INTEGER;
     SUBTYPE STR4 IS STRING (1 .. 4);
     TYPE ACC_ARR IS ACCESS ARR;
     TYPE ACC_STR IS ACCESS STR4;
     C : CONSTANT ARR := (7, 8, 9);
     S : STRING (1 .. 6) := "ABCDEF";
     P : ACC_ARR := NEW ARR'(0, 0, 0);
     Q : ACC_STR := NEW STR4'("WXYZ");
BEGIN
     TEST ("ALLARR1", "AFFECTATION A X.ALL TABLEAU CONTRAINT, SOURCE NON AGREGAT");
     P.ALL := C;
     IF P.ALL /= (7, 8, 9) THEN FAILED ("P.ALL := C"); END IF;
     Q.ALL := S (2 .. 5);
     IF Q.ALL /= "BCDE" THEN FAILED ("Q.ALL := TRANCHE"); END IF;
     Q.ALL := "PQRS";
     IF Q (4) /= 'S' THEN FAILED ("Q.ALL := LITTERAL"); END IF;
     RESULT;
END ALLARR1;
