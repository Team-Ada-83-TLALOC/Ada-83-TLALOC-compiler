WITH REPORT; USE REPORT;
PROCEDURE LONG1 IS
     S : CONSTANT STRING := "4294967296";
     A : LONG_INTEGER := LONG_INTEGER'VALUE (S);
     B : LONG_INTEGER := 4294967296;
     C : LONG_INTEGER := LONG_INTEGER (IDENT_INT (65536));
BEGIN
     TEST ("LONG1", "LONG_INTEGER 64 BITS : 'VALUE, PRODUIT, 'IMAGE");
     IF A /= B THEN FAILED ("'VALUE"); END IF;
     IF C * C /= B THEN FAILED ("PRODUIT"); END IF;
     IF LONG_INTEGER'IMAGE (B) /= " 4294967296" THEN FAILED ("'IMAGE : " & LONG_INTEGER'IMAGE (B)); END IF;
     IF LONG_INTEGER'IMAGE (A * 1) /= " 4294967296" THEN FAILED ("'IMAGE (A * 1) : " & LONG_INTEGER'IMAGE (A * 1)); END IF;
     RESULT;
END LONG1;
