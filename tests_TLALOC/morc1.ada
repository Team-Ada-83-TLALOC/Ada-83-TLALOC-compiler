WITH REPORT; USE REPORT;
PROCEDURE MORC1 IS
     TYPE R (D : INTEGER := 1) IS RECORD V : INTEGER := 0; END RECORD;
     SUBTYPE R3 IS R (3);
     TYPE AR IS ACCESS R;
     SUBTYPE AR3 IS AR (3);
     TYPE AAR IS ACCESS AR;
     TYPE ARR IS ARRAY (INTEGER RANGE <>) OF INTEGER;
     SUBTYPE A25 IS ARR (2 .. 5);
     TYPE AS IS ACCESS STRING;
     SUBTYPE AS4 IS AS (1 .. 4);
     TYPE TAR IS ARRAY (1 .. 2) OF AR;
     X : R := (3, 7);
     Y : R := (4, 8);
     P : AR := NEW R'(3, 1);
     Q : AR := NEW R'(5, 2);
     Z : AAR := NEW AR'(NEW R'(3, 4));
     T : TAR := (NEW R'(1, 10), NEW R'(2, 20));
     A : ARR (2 .. 5) := (OTHERS => 0);
     B : ARR (1 .. 4) := (OTHERS => 0);
     S : AS := NEW STRING'("ABCD");
     N : INTEGER := 0;
     FUNCTION F RETURN AR IS BEGIN RETURN Q; END F;
     PROCEDURE PT (V : ARR; F, L : INTEGER) IS
     BEGIN
          IF V'FIRST /= F OR V'LAST /= L THEN FAILED ("BORNES DE L'AGREGAT" & INTEGER'IMAGE (V'FIRST)); END IF;
     END PT;
BEGIN
     TEST ("MORC1", "APPARTENANCE NON SCALAIRE, DEREFERENCES, AGREGAT EN PARAMETRE");
     IF NOT (X IN R3) OR Y IN R3 OR NOT (Y IN R) THEN FAILED ("RECORD"); END IF;
     IF NOT (P IN AR3) OR Q IN AR3 OR NOT (NULL IN AR3) THEN FAILED ("ACCES CONTRAINT"); END IF;
     IF NOT (A IN A25) OR B IN A25 THEN FAILED ("TABLEAU"); END IF;
     IF NOT (S IN AS4) OR S NOT IN AS THEN FAILED ("ACCES TABLEAU"); END IF;
     IF Z.ALL.V /= 4 OR Z.ALL.D /= 3 THEN FAILED ("Z.ALL.V"); END IF;
     IF T (2).V /= 20 THEN FAILED ("T (2).V"); END IF;
     IF F.V /= 2 THEN FAILED ("F.V"); END IF;
     PT ((5 .. 6 => 9), 5, 6);
     PT ((1, 2, 3), INTEGER'FIRST, INTEGER'FIRST + 2);
     PT ((3 => 1, 4 => 2), 3, 4);
     RESULT;
END MORC1;
