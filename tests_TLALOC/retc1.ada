WITH REPORT; USE REPORT;
PROCEDURE RETC1 IS
     SUBTYPE STC IS INTEGER RANGE -2 .. 10;
     TYPE STR IS ARRAY (STC RANGE IDENT_INT (3) .. 5) OF CHARACTER;
     TYPE BASE IS ARRAY (STC RANGE <>, STC RANGE <>) OF CHARACTER;
     SUBTYPE TC IS BASE (IDENT_INT (-1) .. 0, 7 .. IDENT_INT (9));
     SUBTYPE S4 IS STRING (2 .. 5);
     ABC : CONSTANT STRING := "XABCDEFY";
     X : STR;
     FUNCTION F1 RETURN STR IS BEGIN RETURN "WHO"; END F1;
     FUNCTION F2 RETURN TC IS BEGIN RETURN ("WHO", "WHY"); END F2;
     FUNCTION F3 (N : INTEGER) RETURN S4 IS BEGIN RETURN ABC (N .. N + 3); END F3;
     FUNCTION F4 RETURN S4 IS BEGIN RETURN "AB" & "CD"; END F4;
     FUNCTION F5 (N : INTEGER) RETURN S4 IS BEGIN RETURN ABC (1 .. N); END F5;
     FUNCTION F6 RETURN STR IS V : STR := "XYZ"; BEGIN RETURN V; END F6;
BEGIN
     TEST ("RETC1", "RETURN VERS UN SOUS-TYPE RESULTAT CONTRAINT : CONVERSION (LRM 5.8, 4.6)");
     IF F1'FIRST /= 3 OR F1'LAST /= 5 OR F1 /= "WHO" THEN FAILED ("F1 : LITTERAL GLISSE"); END IF;
     IF STR'FIRST /= 3 OR STR'LAST /= 5 THEN FAILED ("BORNES DU SOUS-TYPE ECRASEES"); END IF;
     IF F2'FIRST (1) /= -1 OR F2'LAST (1) /= 0 OR F2'FIRST (2) /= 7 OR F2'LAST (2) /= 9 THEN
          FAILED ("F2 : AGREGAT 2-D GLISSE");
     END IF;
     IF F2 /= ("WHO", "WHY") THEN FAILED ("F2 : VALEUR"); END IF;
     IF F3 (2)'FIRST /= 2 OR F3 (2) /= "ABCD" THEN FAILED ("F3 : TRANCHE GLISSEE"); END IF;
     IF F4'FIRST /= 2 OR F4 (5) /= 'D' THEN FAILED ("F4 : CONCATENATION GLISSEE"); END IF;
     X := F6;
     IF X /= "XYZ" OR F6'FIRST /= 3 THEN FAILED ("F6 : OBJET DU SOUS-TYPE"); END IF;
     BEGIN
          IF F5 (IDENT_INT (3)) = "ABC " THEN NULL; END IF;
          FAILED ("PAS DE CONSTRAINT_ERROR (LONGUEUR 3 POUR 4)");
     EXCEPTION
          WHEN CONSTRAINT_ERROR => NULL;
     END;
     IF F5 (IDENT_INT (4)) /= "XABC" THEN FAILED ("F5 (4)"); END IF;
     RESULT;
END RETC1;
