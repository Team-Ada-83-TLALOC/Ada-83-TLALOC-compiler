WITH REPORT; USE REPORT;
PROCEDURE CMPBOOL1 IS
     TYPE TAB IS ARRAY (BOOLEAN) OF INTEGER;
     T : CONSTANT TAB := (FALSE => 10, TRUE => 20);
     I : INTEGER := IDENT_INT (-5);
     J : INTEGER := IDENT_INT (-7);
     X : FLOAT := FLOAT (IDENT_INT (-3)) / 2.0;
     Y : FLOAT := FLOAT (IDENT_INT (-9)) / 4.0;
     FUNCTION F (N : INTEGER) RETURN INTEGER IS
     BEGIN
          RETURN N - 1;
     END F;
BEGIN
     TEST ("CMPBOOL1", "VALEUR D'UN BOOLEEN ISSU D'UNE COMPARAISON (OPERANDE GAUCHE NEGATIF)");
     IF BOOLEAN'IMAGE (F (IDENT_INT (0)) <= 0) /= "TRUE" THEN FAILED ("IMAGE (F (0) <= 0)"); END IF;
     IF BOOLEAN'IMAGE (I < J) /= "FALSE" THEN FAILED ("IMAGE (I < J)"); END IF;
     IF BOOLEAN'POS (I > J) /= 1 THEN FAILED ("POS (I > J)"); END IF;
     IF BOOLEAN'POS (I = J) /= 0 THEN FAILED ("POS (I = J)"); END IF;
     IF T (I >= J) /= 20 OR T (I /= I) /= 10 THEN FAILED ("INDICE BOOLEEN ENTIER"); END IF;
     IF (I < 0) /= (J < 0) THEN FAILED ("EGALITE DE DEUX COMPARAISONS ENTIERES"); END IF;
     IF BOOLEAN'IMAGE (X < 0.0) /= "TRUE" THEN FAILED ("IMAGE (X < 0.0)"); END IF;
     IF BOOLEAN'POS (X <= Y) /= 0 OR BOOLEAN'POS (X > Y) /= 1 THEN FAILED ("POS FLOTTANT"); END IF;
     IF T (X = X) /= 20 OR T (X /= X) /= 10 OR T (X >= Y) /= 20 THEN FAILED ("INDICE BOOLEEN FLOTTANT"); END IF;
     IF (X < 0.0) /= (Y < 0.0) THEN FAILED ("EGALITE DE DEUX COMPARAISONS FLOTTANTES"); END IF;
     RESULT;
END CMPBOOL1;
