WITH REPORT; USE REPORT;
PROCEDURE PRMIN1 IS
     TYPE INT IS RANGE 1 .. 100;
     SUBTYPE PETIT IS INTEGER RANGE 1 .. 10;
     N : INTEGER := 0;
     A : INT := 51;
     PROCEDURE P (X : INT) IS BEGIN N := N + 1; END P;
     PROCEDURE Q (X : PETIT) IS BEGIN N := N + 1; END Q;
     FUNCTION "+" (L, R : INT) RETURN INT IS BEGIN RETURN L; END "+";
     FUNCTION F (X : INT) RETURN INT IS BEGIN RETURN X; END F;
BEGIN
     TEST ("PRMIN1", "CONTROLE DES PARAMETRES IN SCALAIRES A L'APPEL");
     BEGIN P (INT (IDENT_INT (0))); FAILED ("P CONVERSION"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN P (0); FAILED ("P LITTERAL"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN Q (IDENT_INT (11)); FAILED ("Q"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN A := A + 0; FAILED ("A + 0"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN A := F (0); FAILED ("F (0)"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     IF N /= 0 THEN FAILED ("CORPS EXECUTE"); END IF;
     RESULT;
END PRMIN1;
