WITH REPORT; USE REPORT;
PROCEDURE GEN1 IS
     GENERIC
          TYPE T IS RANGE <>;
     FUNCTION G RETURN T;
     GENERIC
          TYPE T IS RANGE <>;
     FUNCTION G2 (X : T) RETURN T;
     TYPE QT IS RANGE -100 .. 100;
     FUNCTION G RETURN T IS BEGIN RETURN T (IDENT_INT (2)); END G;
     FUNCTION G2 (X : T) RETURN T IS BEGIN RETURN X + T (IDENT_INT (3)); END G2;
     FUNCTION F IS NEW G (QT);
     FUNCTION F2 IS NEW G2 (QT);
BEGIN
     TEST ("GEN1", "INSTANCES DE FONCTIONS GENERIQUES");
     IF F /= 2 THEN FAILED ("F =" & QT'IMAGE (F)); END IF;
     IF F2 (4) /= 7 THEN FAILED ("F2 =" & QT'IMAGE (F2 (4))); END IF;
     RESULT;
END GEN1;
