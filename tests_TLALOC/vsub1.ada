WITH REPORT; USE REPORT;
PROCEDURE VSUB1 IS
     TYPE SARR IS ARRAY (1 .. 3) OF FLOAT;
     F1 : SARR := (OTHERS => 1.0);
     B : BOOLEAN;
BEGIN
     TEST ("VSUB1", "ARITHMETIQUE UNIVERSELLE : SOUSTRACTION DE VALEURS EGALES");
     B := F1 /= (1 .. 3 => 6.5) OR TRUE;
     IF NOT B THEN FAILED ("B"); END IF;
     IF F1 /= (1 .. 3 => 1.0) THEN FAILED ("F1"); END IF;
     RESULT;
END VSUB1;
