WITH REPORT; USE REPORT;
PROCEDURE ACCSUB1 IS
     TYPE UR (A : INTEGER) IS RECORD NULL; END RECORD;
     TYPE A_UR IS ACCESS UR;
     SUBTYPE CA_UR IS A_UR (2);
     TYPE A_CA_UR IS ACCESS CA_UR;
     V : A_CA_UR;
BEGIN
     TEST ("ACCSUB1", "ALLOCATEUR D'UN SOUS-TYPE D'ACCES CONTRAINT");
     V := NEW CA_UR'(NEW UR'(A => IDENT_INT (2)));
     IF V.ALL.A /= 2 THEN FAILED ("V"); END IF;
     BEGIN
          V := NEW CA_UR'(NEW UR'(A => IDENT_INT (3)));
          FAILED ("PAS DE CONSTRAINT_ERROR");
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL;
     END;
     RESULT;
END ACCSUB1;
