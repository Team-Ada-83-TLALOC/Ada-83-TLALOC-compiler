WITH REPORT; USE REPORT;
PROCEDURE STRFRM1 IS
     SUBTYPE STA1 IS STRING (IDENT_INT (11) .. 15);
     PROCEDURE P (A : STA1; M : STRING) IS
     BEGIN
          IF A'FIRST /= 11 OR A'LAST /= 15 THEN FAILED ("BORNES " & M); END IF;
          IF A (11) /= 'A' OR A (15) /= 'E' OR A /= "ABCDE" THEN FAILED ("VALEURS " & M); END IF;
     END P;
BEGIN
     TEST ("STRFRM1", "LITTERAL CHAINE ACTUEL D'UN FORMEL TABLEAU CONTRAINT (LRM 6.4.1)");
     P ("ABCDE", "LITTERAL");
     BEGIN
          P ("ABCD", "COURT");
          FAILED ("PAS D'EXCEPTION, LONGUEUR 4");
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL;
     END;
     RESULT;
END STRFRM1;
