WITH REPORT; USE REPORT;
PROCEDURE STRSUB1 IS
     SUBTYPE STR IS STRING;
     ALF : CONSTANT STR (IDENT_INT (1) .. IDENT_INT (5)) := "ABCDE";
     ARF : STR (5 .. 9) := ALF;
BEGIN
     TEST ("STRSUB1", "SOUS-TYPE NON CONTRAINT RENOMMANT STRING");
     IF ARF'FIRST /= 5 OR ARF (9) /= 'E' OR ALF'LAST /= 5 THEN FAILED ("ARF"); END IF;
     RESULT;
END STRSUB1;
