WITH REPORT; USE REPORT;
PROCEDURE ACC3 IS
     SUBTYPE PETIT IS INTEGER RANGE 1 .. 10;
     TYPE AI IS ACCESS PETIT;
     TYPE R IS RECORD A, B : INTEGER; END RECORD;
     TYPE AR IS ACCESS R;
     TYPE AAR IS ACCESS AR;
     TYPE T IS ARRAY (1 .. 3) OF INTEGER;
     TYPE ATAB IS ACCESS T;
     X : AI := NEW PETIT'(IDENT_INT (7));
     V : R := (1, 2);
     Y : AR := NEW R'(V);
     Z : AAR := NEW AR'(NEW R'(3, 4));
     W : T := (5, 6, 7);
     U : ATAB := NEW T'(W);
BEGIN
     TEST ("ACC3", "ALLOCATEURS QUALIFIES NON AGREGATS");
     IF X.ALL /= 7 THEN FAILED ("X"); END IF;
     IF Y.B /= 2 THEN FAILED ("Y"); END IF;
     Y := Z.ALL;
     IF Y.A /= 3 THEN FAILED ("Z"); END IF;
     IF U (3) /= 7 THEN FAILED ("U"); END IF;
     BEGIN X := NEW PETIT'(IDENT_INT (11)); FAILED ("PAS DE CONTROLE");
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     RESULT;
END ACC3;
