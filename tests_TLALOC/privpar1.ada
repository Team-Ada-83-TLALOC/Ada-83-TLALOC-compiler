WITH REPORT; USE REPORT;
PROCEDURE PRIVPAR1 IS
     PACKAGE P IS
          TYPE T IS PRIVATE;
          FUNCTION MK (I : INTEGER) RETURN T;
          FUNCTION VAL (X : T) RETURN INTEGER;
     PRIVATE
          TYPE T IS RANGE 0 .. 100;
     END P;
     TYPE R IS RECORD C : P.T := P.MK (3); END RECORD;
     Z : R;
     PACKAGE BODY P IS
          FUNCTION MK (I : INTEGER) RETURN T IS BEGIN RETURN T (I); END MK;
          FUNCTION VAL (X : T) RETURN INTEGER IS BEGIN RETURN INTEGER (X); END VAL;
     END P;
BEGIN
     TEST ("PRIVPAR1", "COMPOSANT DE TYPE PRIVE SCALAIRE PASSE EN PARAMETRE IN");
     IF P.VAL (Z.C) /= 3 THEN FAILED ("ADRESSE PASSEE AU LIEU DE LA VALEUR"); END IF;
     RESULT;
END PRIVPAR1;
