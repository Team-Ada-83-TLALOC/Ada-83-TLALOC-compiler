WITH REPORT; USE REPORT;
WITH SYSTEM;
PROCEDURE OVF1 IS
     TYPE LI IS RANGE -16#7FFF_FFFF_FFFF_FFFF# - 1 .. 16#7FFF_FFFF_FFFF_FFFF#;
     TYPE FIN IS DELTA SYSTEM.FINE_DELTA RANGE -1.0 .. 1.0;
     TYPE F4  IS DELTA 0.25 RANGE -10.0 .. 10.0;
     BIG  : LI := LI'LAST;
     MIN  : LI := LI'FIRST;
     M1   : LI := -1;
     ZERO : LI := 0;
     A    : FIN := 0.5;
     R    : LI;
     X    : F4;
     N    : INTEGER;
     COMPTE : INTEGER := 0;
     PROCEDURE ATTENDU (S : STRING) IS
     BEGIN
          FAILED ("PAS D'EXCEPTION : " & S);
     END ATTENDU;
BEGIN
     TEST ("OVF1", "DEBORDEMENTS 64 BITS : NUMERIC_ERROR (LLIR V8, FAUTES 128 ET 129)");
     IF EQUAL (3, 3) THEN BIG := LI'LAST; MIN := LI'FIRST; M1 := -1; ZERO := 0; END IF;
     BEGIN R := BIG + 1;          ATTENDU ("+"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN R := MIN - 1;          ATTENDU ("-"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN R := BIG * 2;          ATTENDU ("*"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN R := -MIN;             ATTENDU ("- UNAIRE"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN R := ABS MIN;          ATTENDU ("ABS"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN R := MIN / M1;         ATTENDU ("-2**63 / -1"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN R := BIG / ZERO;       ATTENDU ("/ 0"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN R := BIG REM ZERO;     ATTENDU ("REM 0"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     BEGIN A := A * IDENT_INT (75); ATTENDU ("FIX * INT"); EXCEPTION WHEN NUMERIC_ERROR | CONSTRAINT_ERROR => COMPTE := COMPTE + 1; END;
     IF COMPTE /= 9 THEN FAILED ("EXCEPTIONS :" & INTEGER'IMAGE (COMPTE)); END IF;
     -- SANS DEBORDEMENT : VALEURS EXACTES
     IF MIN REM M1 /= 0 OR MIN MOD M1 /= 0 THEN FAILED ("-2**63 REM / MOD -1 /= 0"); END IF;
     IF BIG / M1 /= -BIG OR (MIN + 1) / M1 /= BIG THEN FAILED ("/ -1"); END IF;
     IF BIG - 1 + 1 /= BIG OR MIN + BIG /= -1 THEN FAILED ("+ -"); END IF;
     IF LI (-7) REM 2 /= -1 OR LI (-7) MOD 2 /= 1 OR LI (7) MOD (-2) /= -1 THEN FAILED ("REM / MOD"); END IF;
     IF EQUAL (3, 3) THEN X := 2.5; END IF;
     N := INTEGER (X);
     IF N /= 3 THEN FAILED ("INTEGER (2.5) /=" & INTEGER'IMAGE (N)); END IF;
     N := INTEGER (-X);
     IF N /= -3 THEN FAILED ("INTEGER (-2.5) /=" & INTEGER'IMAGE (N)); END IF;
     X := X - 0.25;
     IF INTEGER (X) /= 2 OR INTEGER (-X) /= -2 THEN FAILED ("INTEGER (2.25)"); END IF;
     X := F4 (IDENT_INT (7)) / IDENT_INT (2);
     IF X /= 3.5 THEN FAILED ("F4 (7) / 2"); END IF;
     IF A /= 0.5 THEN FAILED ("A MODIFIE"); END IF;
     RESULT;
END OVF1;
