WITH REPORT; USE REPORT;
WITH TEXT_IO; USE TEXT_IO;
PROCEDURE CONCAT1 IS
     TYPE COULEUR IS (ROUGE, VERT, BLEU, NOIR);
     SUBTYPE CLAIR IS COULEUR RANGE VERT .. BLEU;
     S5 : STRING (3 .. 7) := "ABCDE";
     VIDE : STRING (5 .. 4);
     C : CHARACTER := 'Z';
     X : CLAIR := VERT;
     L : POSITIVE;
     FUNCTION F (N : NATURAL) RETURN STRING IS
     BEGIN
          IF N = 0 THEN RETURN ""; END IF;
          RETURN F (N - 1) & CHARACTER'VAL (CHARACTER'POS ('0') + N);
     END F;
     PACKAGE CIO IS NEW ENUMERATION_IO (CLAIR);
BEGIN
     TEST ("CONCAT1", "CONCATENATION HORS LIGNE (STANDARD.CONCAT_STRING), ENUMERATION_IO D'UN SOUS-TYPE");
     DECLARE
          R : CONSTANT STRING := S5 & "FG";
     BEGIN
          IF R'FIRST /= 1 OR R'LAST /= 7 OR R /= "ABCDEFG" THEN FAILED ("S5 & ""FG"""); END IF;
     END;
     IF C & S5 /= "ZABCDE" OR S5 & C /= "ABCDEZ" OR C & C /= "ZZ" THEN FAILED ("CARACTERES"); END IF;
     DECLARE
          V2 : CONSTANT STRING := VIDE & S5;
     BEGIN
          IF VIDE & VIDE /= "" OR V2'LENGTH /= 5 OR V2'FIRST /= 1 OR S5 & VIDE /= "ABCDE" THEN FAILED ("CHAINES VIDES"); END IF;
     END;
     IF "A" & "B" & "C" & S5 /= "ABCABCDE" THEN FAILED ("CHAINE DE CONCATENATIONS"); END IF;
     IF F (IDENT_INT (5)) /= "12345" THEN FAILED ("RECURSION : " & F (5)); END IF;
     FOR I IN 1 .. 200 LOOP
          DECLARE
               B : CONSTANT STRING := S5 & INTEGER'IMAGE (I);
          BEGIN
               IF B'LENGTH /= 5 + INTEGER'IMAGE (I)'LENGTH OR B (1 .. 5) /= "ABCDE" THEN FAILED ("BOUCLE"); END IF;
          END;
     END LOOP;
     CIO.GET ("BLEU", X, L);
     IF X /= BLEU OR L /= 4 THEN FAILED ("GET BLEU"); END IF;
     BEGIN
          CIO.GET ("NOIR", X, L);
          FAILED ("GET NOIR : PAS DE DATA_ERROR");
     EXCEPTION
          WHEN DATA_ERROR => NULL;
          WHEN OTHERS => FAILED ("GET NOIR : AUTRE EXCEPTION");
     END;
     IF X /= BLEU THEN FAILED ("X MODIFIE"); END IF;
     RESULT;
END CONCAT1;
