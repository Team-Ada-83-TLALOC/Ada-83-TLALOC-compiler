WITH REPORT; USE REPORT;
PROCEDURE PRIV1 IS
     PACKAGE P IS
          TYPE T IS PRIVATE;
          FUNCTION MK (I : INTEGER) RETURN T;
          FUNCTION VAL (X : T) RETURN INTEGER;
     PRIVATE
          TYPE T IS RANGE 0 .. 100;
     END P;
     TYPE D IS NEW P.T;
     X : D := D (P.MK (IDENT_INT (7)));
     Y : D;
     PACKAGE BODY P IS
          FUNCTION MK (I : INTEGER) RETURN T IS BEGIN RETURN T (I); END MK;
          FUNCTION VAL (X : T) RETURN INTEGER IS BEGIN RETURN INTEGER (X); END VAL;
     END P;
BEGIN
     TEST ("PRIV1", "TYPE PRIVE DERIVE HORS DE SON PAQUETAGE : OBJETS");
     Y := X;
     IF P.VAL (P.T (Y)) /= 7 THEN FAILED ("Y := X"); END IF;
     RESULT;
END PRIV1;
