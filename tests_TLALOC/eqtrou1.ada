WITH REPORT; USE REPORT;
PROCEDURE EQTROU1 IS
     TYPE T1 IS RECORD A : INTEGER; B, C : BOOLEAN; END RECORD;
     TYPE T5 IS RECORD I : INTEGER; J : T1; END RECORD;
     TYPE V3 IS ARRAY (1 .. 3) OF CHARACTER;
     TYPE T6 IS RECORD C : CHARACTER; F : FLOAT; V : V3; P : T5; END RECORD;
     PROCEDURE SALIR IS
          G : ARRAY (1 .. 64) OF INTEGER := (OTHERS => -1);
     BEGIN
          IF G (IDENT_INT (3)) /= -1 THEN FAILED ("G"); END IF;
     END SALIR;
     PROCEDURE ESSAI IS
          X : T5;
          Y : T6;
     BEGIN
          X := (I => 5, J => (1, TRUE, FALSE));
          IF X /= (5, (1, TRUE, FALSE)) THEN FAILED ("X /= AGREGAT EGAL"); END IF;
          IF X = (5, (1, TRUE, TRUE)) THEN FAILED ("X = AGREGAT DIFFERENT"); END IF;
          Y := ('A', 2.5, "XYZ", X);
          IF Y /= ('A', 2.5, "XYZ", (5, (1, TRUE, FALSE))) THEN FAILED ("Y /= AGREGAT EGAL"); END IF;
          IF Y = ('A', 2.5, "XYW", X) THEN FAILED ("Y = AGREGAT DIFFERENT (V)"); END IF;
          IF Y = ('B', 2.5, "XYZ", X) THEN FAILED ("Y = AGREGAT DIFFERENT (C)"); END IF;
     END ESSAI;
BEGIN
     TEST ("EQTROU1", "EGALITE DE RECORDS A REMPLISSAGE D'ALIGNEMENT NON INITIALISE");
     SALIR;
     ESSAI;
     RESULT;
END EQTROU1;
