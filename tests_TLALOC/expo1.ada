WITH REPORT; USE REPORT;
PROCEDURE EXPO1 IS
     TYPE T IS RANGE -1000 .. 1000;
     TYPE FIX IS DELTA 0.25 RANGE -100.0 .. 100.0;
     N : INTEGER := IDENT_INT (3);
     E : CONSTANT INTEGER := 2;
     I : INTEGER := IDENT_INT (2);
     X : T := 2;
     F : FLOAT := 2.0;
     A : FIX := 1.5;
BEGIN
     TEST ("EXPO1", "EXPOSANT ET OPERANDE ENTIER DE TYPE INTEGER (LRM 4.5.5, 4.5.6)");
     IF I ** N /= 8 OR I ** E /= 4 THEN FAILED ("INTEGER ** INTEGER"); END IF;
     IF X ** N /= 8 THEN FAILED ("T ** INTEGER"); END IF;
     IF F ** N /= 8.0 OR F ** (-N) /= 0.125 THEN FAILED ("FLOAT ** INTEGER"); END IF;
     BEGIN
          I := I ** (-N);
          FAILED ("PAS D'EXCEPTION POUR UN EXPOSANT NEGATIF");
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL;
     END;
     IF A * N /= 4.5 OR N * A /= 4.5 OR A / N /= 0.5 THEN FAILED ("FIXE ET INTEGER"); END IF;
     RESULT;
END EXPO1;
