WITH REPORT; USE REPORT;
PROCEDURE BORNES1 IS
     TYPE ARR IS ARRAY (INTEGER RANGE <>) OF INTEGER;
     TYPE M IS ARRAY (INTEGER RANGE <>, INTEGER RANGE <>) OF INTEGER;
     SUBTYPE ST IS STRING (3 .. 7);
     T3 : STRING (1 .. IDENT_INT (3)) := "ABC";
     T5 : STRING (1 .. 5) := "ABCDE";
     S5 : STRING (3 .. 7) := "ABCDE";
     S6 : STRING (IDENT_INT (3) .. 7) := "ABCDE";
     C8 : CONSTANT STRING (3 .. 7) := "ABCDE";
     S9 : ST := "ABCDE";
     S10 : STRING (2 .. 6) := T5;
     S11 : STRING (4 .. 6) := T5 (IDENT_INT (2) .. 4);
     A1 : ARR (5 .. 7) := (1, 2, 3);
     B1 : ARR (IDENT_INT (11) .. 13) := A1;
     N : INTEGER := 0;
     FUNCTION F (L : INTEGER) RETURN STRING IS BEGIN RETURN T5 (1 .. L); END F;
     PROCEDURE P IS
          S : STRING := "ABC";
          K : CONSTANT STRING := "XYZ";
     BEGIN
          IF S /= "ABC" OR K /= "XYZ" OR S'FIRST /= 1 THEN FAILED ("LITTERAL MODIFIE"); END IF;
          S (1) := 'Z';
          N := N + 1;
     END P;
     PROCEDURE Q (X : IN OUT STRING) IS BEGIN X := "PQR"; END Q;
     PROCEDURE CE (NOM : STRING) IS BEGIN FAILED ("PAS DE CONSTRAINT_ERROR : " & NOM); END CE;
BEGIN
     TEST ("BORNES1", "OBJET TABLEAU CONTRAINT INITIALISE OU AFFECTE : BORNES, LONGUEURS (LRM 3.2.1, 5.2.1)");
     IF S5'FIRST /= 3 OR S5'LAST /= 7 OR S5 (3) /= 'A' OR S5 (7) /= 'E' THEN FAILED ("S5"); END IF;
     IF S6'FIRST /= 3 OR S6 (7) /= 'E' THEN FAILED ("S6 : BORNE DYNAMIQUE"); END IF;
     IF C8'FIRST /= 3 OR C8 (3) /= 'A' OR C8 (7) /= 'E' THEN FAILED ("C8 : CONSTANTE"); END IF;
     IF S9'FIRST /= 3 OR S9 (5) /= 'C' THEN FAILED ("S9 : SOUS-TYPE NOMME"); END IF;
     IF S10'FIRST /= 2 OR S10 (2) /= 'A' OR S10 (6) /= 'E' THEN FAILED ("S10 : OBJET"); END IF;
     IF S11'FIRST /= 4 OR S11 /= "BCD" THEN FAILED ("S11 : TRANCHE"); END IF;
     IF B1'FIRST /= 11 OR B1 (13) /= 3 THEN FAILED ("B1 : TABLEAU D'ENTIERS"); END IF;
     P; P;
     IF N /= 2 THEN FAILED ("P"); END IF;
     DECLARE S : STRING (2 .. 6) := F (5);
     BEGIN IF S'FIRST /= 2 OR S (2) /= 'A' OR S (6) /= 'E' THEN FAILED ("APPEL : GLISSEMENT"); END IF;
     END;
     BEGIN DECLARE S : STRING (1 .. 5) := "ABC"; BEGIN CE ("INIT LITTERAL"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN DECLARE S : STRING (1 .. IDENT_INT (5)) := "ABC"; BEGIN CE ("INIT LITTERAL, BORNE DYNAMIQUE"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN DECLARE S : STRING (1 .. 5) := T3; BEGIN CE ("INIT OBJET"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN DECLARE S : STRING (1 .. 5) := T5 (1 .. IDENT_INT (3)); BEGIN CE ("INIT TRANCHE"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     BEGIN DECLARE S : STRING (1 .. 5) := F (3); BEGIN CE ("INIT APPEL"); END;
     EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     DECLARE
          S : STRING (1 .. 5) := "-----";
          MA : M (1 .. 2, 1 .. 3) := ((1, 2, 3), (4, 5, 6));
          MB : M (1 .. 3, 1 .. 2) := ((1, 2), (3, 4), (5, 6));
          MC : M (5 .. 6, 0 .. 2);
          N1 : M (1 .. 0, 1 .. 3);
          N2 : M (1 .. 0, 1 .. IDENT_INT (4));
     BEGIN
          BEGIN S := T3; CE ("AFFECTATION OBJET"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
          BEGIN S := F (3); CE ("AFFECTATION APPEL"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
          BEGIN S := T5 (1 .. IDENT_INT (3)); CE ("AFFECTATION TRANCHE"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
          BEGIN Q (S); CE ("AFFECTATION FORMEL"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
          IF S /= "-----" THEN FAILED ("S MODIFIE MALGRE LES CONTROLES"); END IF;
          S := F (5);
          IF S /= "ABCDE" THEN FAILED ("S := F (5)"); END IF;
          Q (S (2 .. 4));
          IF S /= "APQRE" THEN FAILED ("Q (TRANCHE)"); END IF;
          BEGIN MA := MB; CE ("2 DIMENSIONS"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
          MC := MA;
          IF MC (5, 0) /= 1 OR MC (6, 2) /= 6 THEN FAILED ("MC := MA : GLISSEMENT"); END IF;
          N1 := N2;
     EXCEPTION WHEN CONSTRAINT_ERROR => FAILED ("CONSTRAINT_ERROR INATTENDUE");
     END;
     RESULT;
END BORNES1;
