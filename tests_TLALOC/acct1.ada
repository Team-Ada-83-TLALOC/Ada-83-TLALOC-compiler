WITH REPORT; USE REPORT;
PROCEDURE ACCT1 IS
     TYPE AS IS ACCESS STRING;
     TYPE ARR IS ARRAY (INTEGER RANGE <>) OF INTEGER;
     TYPE AA IS ACCESS ARR;
     TYPE M IS ARRAY (INTEGER RANGE <>, INTEGER RANGE <>) OF INTEGER;
     TYPE AM IS ACCESS M;
     X : AS := NEW STRING'("BONJOUR");
     Y : AS;
     A : AA := NEW ARR (IDENT_INT (3) .. IDENT_INT (7));
     B : AA;
     P : AM := NEW M (1 .. 2, IDENT_INT (5) .. 7);
     S : STRING (1 .. 4) := "ABCD";
     N : INTEGER := 0;
     FUNCTION F (K : INTEGER) RETURN STRING IS
     BEGIN
          RETURN (1 .. K => 'Z');
     END F;
BEGIN
     TEST ("ACCT1", "ACCES A TABLEAU NON CONTRAINT : ALLOCATEURS, LECTURES");
     IF X'FIRST /= 1 OR X'LAST /= 7 OR X'LENGTH /= 7 THEN FAILED ("X BORNES"); END IF;
     IF X (4) /= 'J' OR X.ALL (7) /= 'R' THEN FAILED ("X (I)"); END IF;
     IF X (2 .. 3) /= "ON" THEN FAILED ("X (L .. H)"); END IF;
     X (1) := 'b';
     IF X (1) /= 'b' THEN FAILED ("X (1) :="); END IF;
     IF A'FIRST /= 3 OR A'LAST /= 7 OR A.ALL'LENGTH /= 5 THEN FAILED ("A BORNES"); END IF;
     FOR I IN A'RANGE LOOP A (I) := I * 10; END LOOP;
     FOR I IN A.ALL'RANGE LOOP N := N + A (I); END LOOP;
     IF N /= 250 THEN FAILED ("A SOMME"); END IF;
     IF P'FIRST (2) /= 5 OR P'LAST (2) /= 7 OR P'LAST /= 2 OR P'LENGTH (2) /= 3 THEN FAILED ("P BORNES"); END IF;
     FOR I IN 1 .. 2 LOOP FOR J IN 5 .. 7 LOOP P (I, J) := 10 * I + J; END LOOP; END LOOP;
     IF P (2, 6) /= 26 OR P (1, 7) /= 17 THEN FAILED ("P (I, J)"); END IF;
     Y := NEW STRING'(S);
     IF Y'LAST /= 4 OR Y (3) /= 'C' THEN FAILED ("Y COPIE OBJET"); END IF;
     Y := NEW STRING'(S (2 .. 3));
     IF Y'FIRST /= 2 OR Y (3) /= 'C' THEN FAILED ("Y COPIE TRANCHE"); END IF;
     Y := NEW STRING'(F (IDENT_INT (3)));
     IF Y'LENGTH /= 3 OR Y (2) /= 'Z' THEN FAILED ("Y COPIE APPEL"); END IF;
     Y := NEW STRING'(S & "EF");
     IF Y'LENGTH /= 6 OR Y (6) /= 'F' THEN FAILED ("Y CONCATENATION"); END IF;
     B := NEW ARR'(1, 2, 3);
     IF B'LAST - B'FIRST /= 2 OR B (B'LAST) /= 3 THEN FAILED ("B AGREGAT"); END IF;
     B := NEW ARR'(5 .. 6 => 9);
     IF B'FIRST /= 5 OR B (6) /= 9 THEN FAILED ("B AGREGAT NOMME"); END IF;
     BEGIN IF X (IDENT_INT (8)) = 'A' THEN NULL; END IF; FAILED ("INDICE NON CONTROLE"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     Y := NULL;
     BEGIN N := Y'LENGTH; FAILED ("NULL NON CONTROLE"); EXCEPTION WHEN CONSTRAINT_ERROR => NULL; END;
     RESULT;
END ACCT1;
