ELB 2
 hexa_show 'var elab OLD_NAME ', $
VAR OLD_NAME_disp, Q
VAR OLD_NAME__u, Q
VAR OLD_NAME__dat, STANDARD.IDL._TREE.size
	LVA	2, OLD_NAME__dat
	SA	2, OLD_NAME_disp
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, OLD_NAME__u
	LA  2, OLD_NAME_disp
	LI	STANDARD.IDL._TREE.size
	LA  2,	-SOURCE_NAME_ofs
	LA
	BLKMOV

