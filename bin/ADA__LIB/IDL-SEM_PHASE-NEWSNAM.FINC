	SA	2, H_disp
	LVA	2, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.SIZ__
	SA	2, H__u
	LA  2, H_disp
	LI	STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.size
	LA  2,	-H_IN_ofs
	LA
	BLKMOV

