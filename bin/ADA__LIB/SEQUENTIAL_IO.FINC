begin:

	LA 1, -FILE_ofs
	ULIB	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.IS_OPENED
	BF	L7
	LCA	STANDARD.IO_EXCEPTIONS.STATUS_ERROR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L6
L7:
L6:
	LI	0
	LA  1,	-GFP_ofs
	LA  1,	-NAME_ofs
	CALL	STANDARD.SEQUENTIAL_IO.CREATE_L1. ,CREATE_SYSTEM_CALL_L1
	SD  1,	ERR_OR_ID_disp

	LD 1,	ERR_OR_ID_disp
	LI	0
	CGE
	BF	L9
	LA 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.ID
	LD 1,	ERR_OR_ID_disp
	SD
	LA 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.NAME
	LI	1
	LD	 0, STANDARD.SEQUENTIAL_IO._FILE_NAME_BUFFER._FST_1
	SUB
	LI	1
	MUL
	ADD
	LVA	1, -NAME_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -NAME_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	LI	1
	SUB
	INC
	CLAMP0
	LI	1
	MUL
	LA  1,	-NAME_ofs
	LA
	BLKMOV
	LA 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.NAME_LEN
	LVA	1, -NAME_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -NAME_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SD
	LA 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.IS_OPENED
	LI	1
	SB
	LA 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.MODE
	ULB  1,	-MODE_ofs
	SB
	LA 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.AT_END_OF_FILE
	LI	0
	SB
	BRA	L8
L9:
L8:
ret_lbl:
	UNLINKR 1
	RTD	prm_siz
excep:
endPRO
end if

