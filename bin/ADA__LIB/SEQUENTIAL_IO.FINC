SEQUENTIAL_IO = 'SEQUENTIAL_IO'
namespace SEQUENTIAL_IO
 hexa_show 'SEQUENTIAL_IO body ', $
PRMS
	PRM ELEMENT_TYPE__u_ofs
	PRM ELEMENT_TYPE__ld_ofs
	PRM ELEMENT_TYPE__st_ofs
	PRM ELEMENT_TYPE__inadr_ofs
	PRM ELEMENT_TYPE__outadr_ofs
endPRMS


 hexa_show ' spec ', $
_FILE_MODE = '_FILE_MODE'
namespace _FILE_MODE
VAR use__info, Q
BEGIN_BLOC_DEF
db 0, 7, "IN_FILE"
db 1, 8, "OUT_FILE"
END_BLOC_DEF 8, 0, 1

	LCA	SIZ
	SA	0, use__info
end namespace













_FILE_NAME_BUFFER = '_FILE_NAME_BUFFER'
namespace _FILE_NAME_BUFFER
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	8
	SD	0, _COMP_SIZ
	LD	0, _COMP_SIZ
	LI	1
	SD	0, _FST_1
	LI	256
	SD	0, _LST_1
	LD	0, _LST_1
	LD	0, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	0, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
_FILE_TYPE = '_FILE_TYPE'
namespace _FILE_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
USEINFO 0, ID, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 0, NAME, 	LA 0, STANDARD.SEQUENTIAL_IO._FILE_NAME_BUFFER.use__info
USEINFO 0, NAME_LEN, 	LA 0, STANDARD._POSITIVE.use__info
USEINFO 0, IS_OPENED, 	LA 0, STANDARD._BOOLEAN.use__info
USEINFO 0, MODE, 	LA 0, STANDARD.SEQUENTIAL_IO._FILE_MODE.use__info
USEINFO 0, AT_END_OF_FILE, 	LA 0, STANDARD._BOOLEAN.use__info
virtual at 0
STATOFS ID, 4, 4
STATOFS NAME, 256, 1
STATOFS NAME_LEN, 4, 4
STATOFS IS_OPENED, 1, 1
STATOFS MODE, 1, 1
STATOFS AT_END_OF_FILE, 1, 1
size = $
end virtual
	LI	 size*8
	SD	0, SIZ__
end namespace



