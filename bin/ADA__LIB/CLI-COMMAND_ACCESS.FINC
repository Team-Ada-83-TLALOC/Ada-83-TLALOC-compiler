	LI	3
	SAR
	MUL
	ADD
	LD	, STANDARD.CLI._ENTRY_RECORD.VALUES_FOUND
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
