COMMAND_ACCESS = 'COMMAND_ACCESS'
namespace COMMAND_ACCESS


if defined LOOKUP_L1_
PRO	LOOKUP_L1
 hexa_show 'LOOKUP_L1 ', $
PRMS
	PRM NAME_ofs
	PRM result__ofs
endPRMS
ELB 1
 hexa_show 'var elab I ', $
VAR I_disp, D
	LI	0
	LD 0,	STANDARD.CLI.CURRENT_VERB_disp
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	LA  1,	-NAME_ofs
	CALL	STANDARD.CLI. ,FIND_ENTRY_L19
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	I_disp

 hexa_show ' disp ', I_disp

begin:

	LD 1,	I_disp
	LI	0
	CEQ
	BF	L5
	LCA	STANDARD.CLI.COMMAND_ACCESS.NO_SUCH_NAME__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L4
L5:
L4:
	LD 1,	I_disp
	DUP
	LD	0, STANDARD._POSITIVE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._POSITIVE.LST
	CGT
	BT	STANDARD.ce_raise_
	SQ  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 1
	RTD	prm_siz-8
excep:
endPRO
end if

if defined TOOL_NAME_L13_
PRO	TOOL_NAME_L13
 hexa_show 'TOOL_NAME_L13 ', $
PRMS
	PRM result__ofs
endPRMS
ELB 1

begin:
VAR	ANON_32_12_disp, Q
VAR	ANON_32_12__u,   Q
namespace ANON_32_12_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
	LVA 1, ANON_32_12_info.SIZ__
	SA  1, ANON_32_12__u
	LVA 1, ANON_32_12_disp
	LVA 0,	STANDARD.CLI.TOOL_disp
	CALL	STANDARD.CLI. ,DEFINITION_TEXT_L11
VAR	RET_INFO_L8, Q
	DUP
	LA  ,  0
	SIQ   1, -result__ofs,  0
	DUP
	LA  ,  8
	SA   1, RET_INFO_L8
	DROP
	LA   1, -result__ofs
	LA  ,  8
	LI	16
	LA   1, RET_INFO_L8
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO
end if

if defined GET_VERB_L14_
PRO	GET_VERB_L14
 hexa_show 'GET_VERB_L14 ', $
PRMS
	PRM result__ofs
endPRMS
ELB 1

begin:

	LD 0,	STANDARD.CLI.CURRENT_VERB_disp
	LI	0
	CEQ
	BF	L12
STR RET_STR_L13, ""
	LCA	RET_STR_L13.data_ptr
VAR	RET_INFO_L14, Q
	DUP
	LA  ,  0
	SIQ   1, -result__ofs,  0
	DUP
	LA  ,  8
	SA   1, RET_INFO_L14
	DROP
	LA   1, -result__ofs
	LA  ,  8
	LI	16
	LA   1, RET_INFO_L14
	BLKMOV
	BRA ret_lbl
	BRA	L11
L12:
L11:
VAR	ANON_45_13_disp, Q
VAR	ANON_45_13__u,   Q
namespace ANON_45_13_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
	LVA 1, ANON_45_13_info.SIZ__
	SA  1, ANON_45_13__u
	LVA 1, ANON_45_13_disp
	VAR SELARG_L15_disp, q
	VAR SELARG_L15__u, q
	LA	 0, STANDARD.CLI.ENTRIES_disp
	LD 0,	STANDARD.CLI.CURRENT_VERB_disp
	DUP
	LID	0, STANDARD.CLI.ENTRIES__u, STANDARD.CLI._ENTRIES__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	0, STANDARD.CLI.ENTRIES__u, STANDARD.CLI._ENTRIES__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	0, STANDARD.CLI.ENTRIES__u, STANDARD.CLI._ENTRIES__type.FST_1
	SUB
	LID	0, STANDARD.CLI.ENTRIES__u, STANDARD.CLI._ENTRIES__type.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	LVA	, STANDARD.CLI._ENTRY_RECORD.NAME
	SA	1, SELARG_L15_disp
	LA 0, STANDARD.CLI._SPAN.use__info
	SA	1, SELARG_L15__u
	LVA 1, SELARG_L15_disp
	CALL	STANDARD.CLI. ,DEFINITION_TEXT_L11
VAR	RET_INFO_L16, Q
	DUP
	LA  ,  0
	SIQ   1, -result__ofs,  0
	DUP
	LA  ,  8
	SA   1, RET_INFO_L16
	DROP
	LA   1, -result__ofs
	LA  ,  8
	LI	16
	LA   1, RET_INFO_L16
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO
end if

if defined IS_PRESENT_L15_
PRO	IS_PRESENT_L15
 hexa_show 'IS_PRESENT_L15 ', $
PRMS
	PRM NAME_ofs
	PRM result__ofs
endPRMS
ELB 1

begin:
	LA	 0, STANDARD.CLI.ENTRIES_disp
	LI	0
	LA  1,	-NAME_ofs
	CALL	STANDARD.CLI.COMMAND_ACCESS. ,LOOKUP_L1
	DUP
	LID	0, STANDARD.CLI.ENTRIES__u, STANDARD.CLI._ENTRIES__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	0, STANDARD.CLI.ENTRIES__u, STANDARD.CLI._ENTRIES__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	0, STANDARD.CLI.ENTRIES__u, STANDARD.CLI._ENTRIES__type.FST_1
	SUB
	LID	0, STANDARD.CLI.ENTRIES__u, STANDARD.CLI._ENTRIES__type.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	ULB	, STANDARD.CLI._ENTRY_RECORD.STATUS
	LI	1
	CEQ
	SQ  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 1
	RTD	prm_siz-8
excep:
endPRO
end if

