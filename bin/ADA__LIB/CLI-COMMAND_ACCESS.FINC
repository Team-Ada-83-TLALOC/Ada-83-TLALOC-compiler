if defined GET_VALUE_L18_
PRO	GET_VALUE_L18
 hexa_show 'GET_VALUE_L18 ', $
PRMS
	PRM NAME_ofs
	PRM INDEX_ofs
	PRM result__ofs
endPRMS
ELB 1
 hexa_show 'var elab I ', $
VAR I_disp, D
	LI	0
	LA  1,	-NAME_ofs
	CALL	STANDARD.CLI.COMMAND_ACCESS. ,LOOKUP_L1
	DUP
	LD	0, STANDARD._POSITIVE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._POSITIVE.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	I_disp

 hexa_show ' disp ', I_disp
 hexa_show 'var elab N ', $
VAR N_disp, D
	LI	0
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	N_disp

 hexa_show ' disp ', N_disp

begin:

	LD  1,	-INDEX_ofs
	LA	 0, STANDARD.CLI.ENTRIES_disp
	LD 1,	I_disp
	DUP
	LID	0, STANDARD.CLI.ENTRIES__u, STANDARD.CLI._ENTRIES__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	0, STANDARD.CLI.ENTRIES__u, STANDARD.CLI._ENTRIES__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	0, STANDARD.CLI.ENTRIES__u, STANDARD.CLI._ENTRIES__type.FST_1
	SUB
	LID	0, STANDARD.CLI.ENTRIES__u, STANDARD.CLI._ENTRIES__type.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	LD	, STANDARD.CLI._ENTRY_RECORD.VALUES_FOUND
	CGT
	BF	L26
	LCA	STANDARD.CLI.COMMAND_ACCESS.NO_VALUE__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L25
L26:
L25:
VAR	VL28_disp, D
	LI	1
	SD  1,	VL28_disp
VAR	LMT_VL28_disp, D
	LD 0,	STANDARD.CLI.VALUE_TOP_disp
	SD  1,	LMT_VL28_disp
	LD  1,	VL28_disp
	LD  1,	LMT_VL28_disp
	CGT
	BT	L27
LOOP__1:

	LA	 0, STANDARD.CLI.VALUES_disp
	LD 1,	VL28_disp
	DUP
	LID	0, STANDARD.CLI.VALUES__u, STANDARD.CLI._VALUES__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	0, STANDARD.CLI.VALUES__u, STANDARD.CLI._VALUES__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	0, STANDARD.CLI.VALUES__u, STANDARD.CLI._VALUES__type.FST_1
	SUB
	LID	0, STANDARD.CLI.VALUES__u, STANDARD.CLI._VALUES__type.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	LD	, STANDARD.CLI._VALUE_RECORD.OWNER
	LD 1,	I_disp
	CEQ
	BF	L30
	LD 1,	N_disp
	LI	1
	ADD
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	N_disp

	LD 1,	N_disp
	LD  1,	-INDEX_ofs
	CEQ
	BF	L32
VAR	ANON_97_12_disp, Q
VAR	ANON_97_12__u,   Q
namespace ANON_97_12_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
	LVA 1, ANON_97_12_info.SIZ__
	SA  1, ANON_97_12__u
	LVA 1, ANON_97_12_disp
	VAR SELARG_L33_disp, q
	VAR SELARG_L33__u, q
	LA	 0, STANDARD.CLI.VALUES_disp
	LD 1,	VL28_disp
	DUP
	LID	0, STANDARD.CLI.VALUES__u, STANDARD.CLI._VALUES__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	0, STANDARD.CLI.VALUES__u, STANDARD.CLI._VALUES__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	0, STANDARD.CLI.VALUES__u, STANDARD.CLI._VALUES__type.FST_1
	SUB
	LID	0, STANDARD.CLI.VALUES__u, STANDARD.CLI._VALUES__type.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	LVA	, STANDARD.CLI._VALUE_RECORD.TEXT
	SA	1, SELARG_L33_disp
	LA 0, STANDARD.CLI._SPAN.use__info
	SA	1, SELARG_L33__u
	LVA 1, SELARG_L33_disp
	CALL	STANDARD.CLI. ,COMMAND_TEXT_L15
VAR	RET_INFO_L34, Q
	DUP
	LA  ,  0
	SIQ   1, -result__ofs,  0
	DUP
	LA  ,  8
	SA   1, RET_INFO_L34
	DROP
	LA   1, -result__ofs
	LA  ,  8
	LI	16
	LA   1, RET_INFO_L34
	BLKMOV
	BRA ret_lbl
	BRA	L31
L32:
L31:
	BRA	L29
L30:
L29:
	LD  1,	VL28_disp
	LD  1,	LMT_VL28_disp
	CEQ
	BT	L27
	LD  1,	VL28_disp
	INC
	SD  1,	VL28_disp
	BRA	LOOP__1
L27:
	LCA	STANDARD.CLI.COMMAND_ACCESS.NO_VALUE__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO
end if
begin:
end namespace 
