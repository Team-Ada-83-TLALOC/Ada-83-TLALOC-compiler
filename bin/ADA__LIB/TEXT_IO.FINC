if defined WRITE_RAW_L1_
PRO	WRITE_RAW_L1
 hexa_show 'WRITE_RAW_L1 ', $
PRMS
	PRM ID_ofs
	PRM ITEM_ofs
endPRMS
ELB 1
 hexa_show 'var elab ERR_CODE ', $
VAR ERR_CODE_disp, D

 hexa_show ' disp ', ERR_CODE_disp

if defined WRITE_SYSTEM_CALL_L2_
PRO	WRITE_SYSTEM_CALL_L2
 hexa_show 'WRITE_SYSTEM_CALL_L2 ', $
PRMS
	PRM FILE_ID_ofs
	PRM LENGTH_ofs
	PRM result__ofs
endPRMS
ELB 2

begin:
	LD 2 ,	-16
	LIA 1 ,	-16
	LD 2 ,	-8
	SYS_FILE_WRITE
	SD 2 ,	-24
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

begin:

	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	LI	0
	CEQ
	BF	L8
	BRA ret_lbl
	BRA	L7
L8:
L7:
	LI	0
	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	DUP
	LD	0, STANDARD._POSITIVE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._POSITIVE.LST
	CGT
	BT	STANDARD.ce_raise_
	LD  1,	-ID_ofs
	CALL	STANDARD.TEXT_IO.WRITE_RAW_L1. ,WRITE_SYSTEM_CALL_L2
	SD  1,	ERR_CODE_disp
ret_lbl:
	UNLINKR 1
	RTD	prm_siz
excep:
endPRO
end if

