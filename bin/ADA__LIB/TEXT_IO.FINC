 hexa_show 'READ_SYSTEM_CALL_L10 ', $
PRMS
	PRM FILE_ID_ofs
	PRM LENGTH_ofs
	PRM result__ofs
endPRMS
ELB 2

begin:
	LD 2 ,	-16
	LIA 1 ,	-16
	LD 2 ,	-8
	SYS_FILE_READ
	SD 2 ,	-24
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

begin:
	LI	0
	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	DUP
	LD	0, STANDARD._POSITIVE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._POSITIVE.LST
	CGT
	BT	STANDARD.ce_raise_
	LD  1,	-ID_ofs
	CALL	STANDARD.TEXT_IO.READ_RAW_L9. ,READ_SYSTEM_CALL_L10
	SQ  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 1
	RTD	prm_siz-8
excep:
endPRO
end if

if defined FLUSH_OUT_L15_
PRO	FLUSH_OUT_L15
 hexa_show 'FLUSH_OUT_L15 ', $
PRMS
	PRM ID_ofs
endPRMS
ELB 1

begin:

	LD  1,	-ID_ofs
	LI	0
	CLT
	DUP
	BT	L20
	DROP
	LD  1,	-ID_ofs
	LI	15
	CGT
L20:
	BF	L19
	BRA ret_lbl
	BRA	L18
L19:
L18:

	LA	 0, STANDARD.TEXT_IO.BUFS_disp
	LD  1,	-ID_ofs
	DUP
	LID	0, STANDARD.TEXT_IO.BUFS__u, STANDARD.TEXT_IO._BUFS__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	0, STANDARD.TEXT_IO.BUFS__u, STANDARD.TEXT_IO._BUFS__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	0, STANDARD.TEXT_IO.BUFS__u, STANDARD.TEXT_IO._BUFS__type.FST_1
	SUB
	LID	0, STANDARD.TEXT_IO.BUFS__u, STANDARD.TEXT_IO._BUFS__type.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	LD	, STANDARD.TEXT_IO._IO_BUFFER.OUT_LEN
	LI	0
	CGT
	BF	L22
	LA	 0, STANDARD.TEXT_IO.BUFS_disp
