_BUF_LEN = '_BUF_LEN'
namespace _BUF_LEN
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR FST, D
VAR LST, D
	LI	32
	SD	0, SIZ__
	LI	0
	SD	0, FST
	LI	16384
	SD	0, LST
VAR PARENT__u, Q
	LA	0, STANDARD._INTEGER.use__info
	SA	0, PARENT__u
end namespace
_IO_BUFFER = '_IO_BUFFER'
namespace _IO_BUFFER
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
_DATA__type = '_DATA__type'
 namespace _DATA__type
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	8
	SD	0, _COMP_SIZ
	LD	0, _COMP_SIZ
	LI	1
	SD	0, _FST_1
	LI	16384
	SD	0, _LST_1
	LD	0, _LST_1
	LD	0, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	0, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
USEINFO 0, DATA, 	LA 0, _DATA__type.use__info
USEINFO 0, OUT_LEN, 	LA 0, STANDARD.TEXT_IO._BUF_LEN.use__info
USEINFO 0, IN_POS, 	LA 0, STANDARD.TEXT_IO._BUF_LEN.use__info
USEINFO 0, IN_LEN, 	LA 0, STANDARD.TEXT_IO._BUF_LEN.use__info
virtual at 0
STATOFS DATA, 16384, 1
STATOFS OUT_LEN, 4, 4
STATOFS IN_POS, 4, 4
STATOFS IN_LEN, 4, 4
size = $
end virtual
	LI	 size*8
	SD	0, SIZ__
end namespace
 hexa_show 'var elab BUFS ', $
_BUFS__type = '_BUFS__type'
namespace _BUFS__type
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	131168
	SD	0, _COMP_SIZ
	LD	0, _COMP_SIZ
	LI	0
	SD	0, _FST_1
	LI	15
	SD	0, _LST_1
	LD	0, _LST_1
	LD	0, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	0, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR BUFS_disp, Q
VAR BUFS__u, Q
	LA 0, _BUFS__type.use__info
	SA	0, BUFS__u
	LD	0, _BUFS__type.SIZ__
	LI	8
	DIV
	CO_VAR
	SA	0, BUFS_disp

 hexa_show ' disp ', BUFS_disp

if defined WRITE_RAW_L1_
PRO	WRITE_RAW_L1
 hexa_show 'WRITE_RAW_L1 ', $
PRMS
	PRM ID_ofs
	PRM ITEM_ofs
endPRMS
ELB 1
 hexa_show 'var elab ERR_CODE ', $
VAR ERR_CODE_disp, D

 hexa_show ' disp ', ERR_CODE_disp

if defined WRITE_SYSTEM_CALL_L2_
PRO	WRITE_SYSTEM_CALL_L2
 hexa_show 'WRITE_SYSTEM_CALL_L2 ', $
PRMS
	PRM FILE_ID_ofs
	PRM LENGTH_ofs
	PRM result__ofs
endPRMS
ELB 2

begin:
	LD 2 ,	-16
	LIA 1 ,	-16
	LD 2 ,	-8
	SYS_FILE_WRITE
	SD 2 ,	-24
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

begin:

	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	LI	0
	CEQ
	BF	L8
	BRA ret_lbl
	BRA	L7
L8:
L7:
	LI	0
	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	DUP
	LD	0, STANDARD._POSITIVE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._POSITIVE.LST
	CGT
	BT	STANDARD.ce_raise_
	LD  1,	-ID_ofs
	CALL	STANDARD.TEXT_IO.WRITE_RAW_L1. ,WRITE_SYSTEM_CALL_L2
	SD  1,	ERR_CODE_disp
ret_lbl:
	UNLINKR 1
	RTD	prm_siz
excep:
endPRO
end if

if defined READ_RAW_L9_
PRO	READ_RAW_L9
 hexa_show 'READ_RAW_L9 ', $
PRMS
	PRM ID_ofs
	PRM ITEM_ofs
	PRM result__ofs
endPRMS
ELB 1

if defined READ_SYSTEM_CALL_L10_
