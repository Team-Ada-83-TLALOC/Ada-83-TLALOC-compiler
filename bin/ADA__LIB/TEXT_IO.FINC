elab_spec:

 hexa_show ' spec ', $
_FILE_MODE = '_FILE_MODE'
namespace _FILE_MODE
VAR use__info, Q
BEGIN_BLOC_DEF
db 0, 7, "IN_FILE"
db 1, 8, "OUT_FILE"
END_BLOC_DEF 8, 0, 1

	LCA	SIZ
	SA	0, use__info
end namespace
_COUNT = '_COUNT'
namespace _COUNT
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR FST, D
VAR LST, D
	LI	32
	SD	0, SIZ__
	LI	0
	SD	0, FST
	LI	002147483647
	SD	0, LST
end namespace
_POSITIVE_COUNT = '_POSITIVE_COUNT'
namespace _POSITIVE_COUNT
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR FST, D
VAR LST, D
	LI	32
	SD	0, SIZ__
	LI	1
	SD	0, FST
	LI	002147483647
	SD	0, LST
VAR PARENT__u, Q
	LA	0, STANDARD.TEXT_IO._COUNT.use__info
	SA	0, PARENT__u
end namespace
