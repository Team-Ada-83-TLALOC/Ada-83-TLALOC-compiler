	LD 2 ,	-16
	LIA 1 ,	-16
	LD 2 ,	-8
	SYS_FILE_WRITE
	SD 2 ,	-24
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

begin:

	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	LI	0
	CEQ
	BF	L8
	BRA ret_lbl
	BRA	L7
L8:
L7:
	LI	0
	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	DUP
	LD	0, STANDARD._POSITIVE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._POSITIVE.LST
