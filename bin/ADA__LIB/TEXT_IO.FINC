_BUF_LEN = '_BUF_LEN'
namespace _BUF_LEN
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR FST, D
VAR LST, D
	LI	32
	SD	0, SIZ__
	LI	0
	SD	0, FST
	LI	16384
	SD	0, LST
VAR PARENT__u, Q
	LA	0, STANDARD._INTEGER.use__info
	SA	0, PARENT__u
end namespace
_IO_BUFFER = '_IO_BUFFER'
namespace _IO_BUFFER
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
_DATA__type = '_DATA__type'
 namespace _DATA__type
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	8
	SD	0, _COMP_SIZ
	LD	0, _COMP_SIZ
	LI	1
	SD	0, _FST_1
	LI	16384
	SD	0, _LST_1
	LD	0, _LST_1
	LD	0, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	0, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
USEINFO 0, DATA, 	LA 0, _DATA__type.use__info
USEINFO 0, OUT_LEN, 	LA 0, STANDARD.TEXT_IO._BUF_LEN.use__info
USEINFO 0, IN_POS, 	LA 0, STANDARD.TEXT_IO._BUF_LEN.use__info
USEINFO 0, IN_LEN, 	LA 0, STANDARD.TEXT_IO._BUF_LEN.use__info
virtual at 0
STATOFS DATA, 16384, 1
STATOFS OUT_LEN, 4, 4
STATOFS IN_POS, 4, 4
STATOFS IN_LEN, 4, 4
size = $
end virtual
	LI	 size*8
	SD	0, SIZ__
end namespace
