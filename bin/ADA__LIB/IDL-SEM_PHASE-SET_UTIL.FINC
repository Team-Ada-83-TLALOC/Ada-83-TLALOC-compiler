VAR DEFTREE__dat, STANDARD.IDL._TREE.size
	LVA	2, DEFTREE__dat
	SA	2, DEFTREE_disp
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, DEFTREE__u
	LA  2, DEFTREE_disp
	DUP
	LD
	LI	0
