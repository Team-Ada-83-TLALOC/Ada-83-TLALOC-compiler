	LI  230
	CALL	STANDARD.IDL. ,MAKE_L15
	LA
	BLKMOV
	LA  2,	-DEF_ofs
	LVA 2,	DEFTREE_disp
	LI  167
	CALL	STANDARD.IDL. ,D_L16
	BRA	L43
L45:
	LVA 2,	DEFTREE_disp
	LA
	LI	STANDARD.IDL._TREE.size
	LA  2,	-DEF_ofs
	LA
	BLKMOV
L43:
	LVA 2,	DEFLIST_disp
	LA
	LI	STANDARD.IDL._SEQ_TYPE.size
