ELB 2

begin:

	LA 2, -DEFINTERP_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	LI	229
	CEQ
	BF	L14
namespace	BLOCK__1
ELB 3
 hexa_show 'var elab S1 ', $
VAR S1_disp, Q
VAR S1__u, Q
VAR S1__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	3, S1__dat
	SA	3, S1_disp
	LVA	3, STANDARD.IDL._SEQ_TYPE.SIZ__
	SA	3, S1__u
	LA  3, S1_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_45_26_disp, Q
VAR	ANON_45_26__u,    Q
VAR	ANON_45_26__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 3, ANON_45_26__dat
	SA  3, ANON_45_26_disp
	LA  0, STANDARD.IDL._SEQ_TYPE.use__info
	SA  3, ANON_45_26__u
	LVA 3, ANON_45_26_disp

	LA  2,	-DEFINTERP_ofs
	CALL	STANDARD.IDL. ,LIST_L22
	LA
	BLKMOV

 hexa_show ' disp ', S1_disp

begin:
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
	LVA 3,	S1_disp
	LA
	BLKMOV
	UNLINK 3
	BRA ret_lbl
	UNLINKR 3
endPRO
	BRA	L13
L14:
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.NULL_EXTRAINFO_disp
	LA
	BLKMOV
	BRA ret_lbl
L13:
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

