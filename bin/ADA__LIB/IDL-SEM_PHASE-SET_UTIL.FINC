	LI  229
	CALL	STANDARD.IDL. ,MAKE_L15
	LA
	BLKMOV
	LA  2,	-DEF_ofs
	LVA 2,	DEFTREE_disp
	LI  167
	CALL	STANDARD.IDL. ,D_L16
	LA  2,	-EXTRAINFO_ofs
	LVA 2,	DEFTREE_disp
	CALL	STANDARD.IDL.IDL_MAN. ,LIST_L36
	BRA	L43
L44:
	ULB  2,	-IS_NULLARY_ofs
	BF	L45
	LVA 2,	DEFTREE_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_150_18_disp, Q
VAR	ANON_150_18__u,    Q
VAR	ANON_150_18__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_150_18__dat
	SA  2, ANON_150_18_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_150_18__u
