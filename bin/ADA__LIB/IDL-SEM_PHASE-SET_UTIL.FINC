	LI	2
	BFI
	SD

 hexa_show ' disp ', DEFTREE_disp

begin:

	LI	0
	LA  2,	-EXTRAINFO_ofs
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L44
	LVA 2,	DEFTREE_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_146_18_disp, Q
VAR	ANON_146_18__u,    Q
VAR	ANON_146_18__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_146_18__dat
	SA  2, ANON_146_18_disp
