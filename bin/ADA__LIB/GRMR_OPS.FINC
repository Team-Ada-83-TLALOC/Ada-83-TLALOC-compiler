	DUP
	LID	0, STANDARD.GRMR_OPS.HTABLE__u, STANDARD.GRMR_OPS._HTABLE__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	0, STANDARD.GRMR_OPS.HTABLE__u, STANDARD.GRMR_OPS._HTABLE__type.FST_1
	SUB
	LID	0, STANDARD.GRMR_OPS.HTABLE__u, STANDARD.GRMR_OPS._HTABLE__type.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	LVA	, STANDARD.GRMR_OPS._HTABLE_TYPE.HN
	SA  1, ANON_39_20_L10_D_disp
	LI	1
	SD  1, ANON_39_20_L10_D_info._FST_1
	LI	17
	SD  1, ANON_39_20_L10_D_info._LST_1
	LI	8
	SD  1, ANON_39_20_L10_D_info._COMP_SIZ
	LD  1, ANON_39_20_L10_D_info._LST_1
	LD  1, ANON_39_20_L10_D_info._FST_1
	SUB
	INC
	CLAMP0
	LI	8
	MUL
	SD  1, ANON_39_20_L10_D_info.SIZ__
	LVA 1, ANON_39_20_L10_D_info.SIZ__
	SA  1, ANON_39_20_L10_D__u
	LVA 1, ANON_39_20_L10_D_disp
	DUP
	LA  ,  0
	SA  1, ANON_39_20_L10_D_data
	LA  ,  8
	SA  1, ANON_39_20_L10_D_info
	LID 1, ANON_39_20_L10_D_info, STANDARD._STRING.LST_1
	LID 1, ANON_39_20_L10_D_info, STANDARD._STRING.FST_1
	SUB
	INC
