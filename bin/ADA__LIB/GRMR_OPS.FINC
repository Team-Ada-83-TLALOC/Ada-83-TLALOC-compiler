begin:

	LVA	1, -S_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -S_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	LI	17
	CLE
	BF	L7
	LA 1, STANDARD.GRMR_OPS.HASH_SEARCH_L1.A_17_disp
	LI	1
	LID 1, STANDARD.GRMR_OPS.HASH_SEARCH_L1.A_17__u, STANDARD._STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
	LVA	1, -S_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -S_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	LI	1
	SUB
	INC
	CLAMP0
	LI	1
	MUL
	LA  1,	-S_ofs
	LA
	BLKMOV
	BRA	L6
L7:
L6:
	LVA	1, -S_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -S_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	LVA	1, -S_ofs
	LIA	, , 0
	LVA	1, -S_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	DUP
	LVA	1, -S_ofs
	LIA	, 0,  8
	LD	, STANDARD._STRING.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LVA	1, -S_ofs
	LIA	, 0,  8
	LD	, STANDARD._STRING.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LVA	1, -S_ofs
	LIA	, 0,  8
	LD	, STANDARD._STRING.FST_1
	SUB
	LVA	1, -S_ofs
	LIA	, , 8
	LD	, STANDARD._STRING.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	ULB
	ADD
	LI	37
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	SD  0,	STANDARD.GRMR_OPS.HCODE_disp
