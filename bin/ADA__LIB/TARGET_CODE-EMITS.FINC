	BF	L47
STR STR_L49, "flottant hors du corpus (denormal ou infini)"
	LCA	STR_L49.data_ptr
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,FAULT_L14
	BRA	L46
L47:
L46:
	LQ 2,	A_disp
	LIF	1.0
	FSUB
	SQ  2,	A_disp
VAR	IL51_disp, D
	LI	1
	SD  2,	IL51_disp
VAR	LMT_IL51_disp, D
	LI	52
	SD  2,	LMT_IL51_disp
	LD  2,	IL51_disp
	LD  2,	LMT_IL51_disp
	CGT
	BT	L50
LOOP__5:
	LQ 2,	A_disp
	LIF	2.0
	FMUL
	SQ  2,	A_disp
