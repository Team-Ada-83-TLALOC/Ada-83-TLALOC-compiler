 hexa_show ' disp ', TR_disp
_BYTE = '_BYTE'
namespace _BYTE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR FST, D
VAR LST, D
	LI	32
	SD	1, SIZ__
	LI	0
	SD	1, FST
	LI	255
	SD	1, LST
VAR PARENT__u, Q
	LA	0, STANDARD._INTEGER.use__info
	SA	1, PARENT__u
end namespace
 hexa_show 'var elab BIN ', $
_BIN__type = '_BIN__type'
namespace _BIN__type
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	32
	SD	1, _COMP_SIZ
	LD	1, _COMP_SIZ
	LI	0
	SD	1, _FST_1
	LI	32000000
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR BIN_disp, Q
VAR BIN__u, Q
	LA 1, _BIN__type.use__info
	SA	1, BIN__u
	LD	1, _BIN__type.SIZ__
	LI	8
	DIV
	CO_VAR
	SA	1, BIN_disp

 hexa_show ' disp ', BIN_disp
 hexa_show 'var elab TOP ', $
