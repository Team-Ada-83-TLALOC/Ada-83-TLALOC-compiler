L40:

	LQ 2,	A_disp
	LIF	0.0
	FCLT
	BF	L43
	LI	1
	SB  2,	SGN_disp
	LQ 2,	A_disp
	FNEG
	SQ  2,	A_disp
	BRA	L42
L43:
L42:
LOOP__3:
	LQ 2,	A_disp
