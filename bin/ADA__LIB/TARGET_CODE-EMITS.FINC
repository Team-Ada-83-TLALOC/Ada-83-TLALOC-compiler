if defined FAULT_L14_
PRO	FAULT_L14
 hexa_show 'FAULT_L14 ', $
PRMS
	PRM MSG_ofs
endPRMS
ELB 2

begin:
VAR	ANON_77_15_L17_G_data, Q
VAR	ANON_77_15_L17_G_info, Q
VAR	ANON_77_40_L17_D_data, Q
VAR	ANON_77_40_L17_D_info, Q
VAR	ANON_77_15_L17_G_len,  Q
VAR	ANON_77_40_L17_D_len,  Q
VAR	ANON_77_15_L17_R_disp, Q
VAR	ANON_77_15_L17_R__u,   Q
namespace ANON_77_15_L17_R_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
STR ANON_77_15_L17_G, "TARGET_CODE.EMITS : "
	LCA	ANON_77_15_L17_G.data_ptr
	DUP
	LA  ,  0
	SA  2, ANON_77_15_L17_G_data
	LA  ,  8
	SA  2, ANON_77_15_L17_G_info
	LID 2, ANON_77_15_L17_G_info, _STRING.LST_1
	LID 2, ANON_77_15_L17_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  2, ANON_77_15_L17_G_len
	LA  2,	-MSG_ofs
	DUP
	LA  ,  0
	SA  2, ANON_77_40_L17_D_data
	LA  ,  8
	SA  2, ANON_77_40_L17_D_info
	LID 2, ANON_77_40_L17_D_info, _STRING.LST_1
	LID 2, ANON_77_40_L17_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  2, ANON_77_40_L17_D_len
	LA  2, ANON_77_15_L17_G_len
	LA  2, ANON_77_40_L17_D_len
	ADD
	CO_VAR
	SA  2, ANON_77_15_L17_R_disp
	LI	1
	SD  2, ANON_77_15_L17_R_info._FST_1
	LA  2, ANON_77_15_L17_G_len
	LA  2, ANON_77_40_L17_D_len
	ADD
	SD  2, ANON_77_15_L17_R_info._LST_1
	LI	8
	SD  2, ANON_77_15_L17_R_info._COMP_SIZ
	LA  2, ANON_77_15_L17_G_len
	LA  2, ANON_77_40_L17_D_len
	ADD
	LI	8
	MUL
	SD  2, ANON_77_15_L17_R_info.SIZ__
	LVA 2, ANON_77_15_L17_R_info.SIZ__
	SA  2, ANON_77_15_L17_R__u
	LA  2, ANON_77_15_L17_R_disp
	LA  2, ANON_77_15_L17_G_len
	LA  2, ANON_77_15_L17_G_data
	BLKMOV
	LA  2, ANON_77_15_L17_R_disp
	LA  2, ANON_77_15_L17_G_len
	ADD
	LA  2, ANON_77_40_L17_D_len
	LA  2, ANON_77_40_L17_D_data
	BLKMOV
	LVA 2, ANON_77_15_L17_R_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.TARGET_CODE_L1.EMITS.EMIT_FAULT__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO
end if

if defined B_L18_
PRO	B_L18
 hexa_show 'B_L18 ', $
PRMS
	PRM V_ofs
endPRMS
ELB 2

begin:

	LD 1,	STANDARD.TARGET_CODE_L1.EMITS.TOP_disp
	LI	32000000
	CGT
	BF	L22
STR STR_L23, "tampon binaire plein (BIN_MAX)"
	LCA	STR_L23.data_ptr
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,FAULT_L14
	BRA	L21
L22:
L21:
	LA	 1, STANDARD.TARGET_CODE_L1.EMITS.BIN_disp
	LD 1,	STANDARD.TARGET_CODE_L1.EMITS.TOP_disp
	DUP
	LID	1, STANDARD.TARGET_CODE_L1.EMITS.BIN__u, STANDARD.TARGET_CODE_L1.EMITS._BIN__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	1, STANDARD.TARGET_CODE_L1.EMITS.BIN__u, STANDARD.TARGET_CODE_L1.EMITS._BIN__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	1, STANDARD.TARGET_CODE_L1.EMITS.BIN__u, STANDARD.TARGET_CODE_L1.EMITS._BIN__type.FST_1
	SUB
	LID	1, STANDARD.TARGET_CODE_L1.EMITS.BIN__u, STANDARD.TARGET_CODE_L1.EMITS._BIN__type.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	LD  2,	-V_ofs
	LI	256
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	SD
	LD 1,	STANDARD.TARGET_CODE_L1.EMITS.TOP_disp
	LI	1
	ADD
	SD  1,	STANDARD.TARGET_CODE_L1.EMITS.TOP_disp
