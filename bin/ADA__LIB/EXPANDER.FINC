namespace ANON_89_57_aga
  VAR _FST_1, D
  VAR _LST_1, D
  VAR _LEN_1, D
  VAR _STR_1, D
  VAR _PTR_1, Q
  VAR _CNT_1, D
  VAR _EMIS_1, D
  VAR _LO_1, D
  VAR _AF_1, D
  VAR _VU_1, D
  VAR _HI_1, D
  VAR _BAS_1, Q
  VAR _IX_1, D
end namespace
	LI	0
	SD  1, ANON_89_57_aga._FST_1
	LI	2
	LI	5
	DEC
	SHL
	LI	1
	SUB
	SD  1, ANON_89_57_aga._LST_1
	LD  1, ANON_89_57_aga._LST_1
	LD  1, ANON_89_57_aga._FST_1
	SUB
	INC
	CLAMP0
	SD  1, ANON_89_57_aga._LEN_1
	LI	1
	SD  1, ANON_89_57_aga._STR_1
	SA  1, ANON_89_57_aga._PTR_1
	LA  1, ANON_89_57_aga._PTR_1
	SA  1, ANON_89_57_aga._BAS_1
	LI	0
	SD  1, ANON_89_57_aga._EMIS_1
	LD  1, ANON_89_57_aga._FST_1
	SD  1, ANON_89_57_aga._IX_1
	LA  1, ANON_89_57_aga._BAS_1
	SA  1, ANON_89_57_aga._PTR_1
L3:
	LD  1, ANON_89_57_aga._IX_1
	LD  1, ANON_89_57_aga._LST_1
	CGT
	BT  L4
	LI	0
	SIB  1, ANON_89_57_aga._PTR_1, 0
	LA  1, ANON_89_57_aga._PTR_1
	LD  1, ANON_89_57_aga._STR_1
	ADD
	SA  1, ANON_89_57_aga._PTR_1
	LD  1, ANON_89_57_aga._EMIS_1
	INC
	SD  1, ANON_89_57_aga._EMIS_1
	BRA L6
L5:
	LA  1, ANON_89_57_aga._PTR_1
	LD  1, ANON_89_57_aga._STR_1
	ADD
	SA  1, ANON_89_57_aga._PTR_1
L6:
	LD  1, ANON_89_57_aga._IX_1
	INC
	SD  1, ANON_89_57_aga._IX_1
	BRA L3
L4:

