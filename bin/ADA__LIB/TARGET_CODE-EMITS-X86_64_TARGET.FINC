if defined E_MODRM_DISP_L43_
PRO	E_MODRM_DISP_L43
 hexa_show 'E_MODRM_DISP_L43 ', $
PRMS
	PRM M0_ofs
	PRM M8_ofs
	PRM M32_ofs
	PRM D_ofs
endPRMS
ELB 2

begin:

	LQ  2,	-D_ofs
	LI	0
	CEQ
	BF	L47
	LD  2,	-M0_ofs
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,B_L18
	BRA	L46
L47:
	LQ  2,	-D_ofs
	LI	128
	NEG
	CGE
	DUP
	BF	L49
	DROP
	LQ  2,	-D_ofs
	LI	128
	CLT
L49:
	BF	L48
	LD  2,	-M8_ofs
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,B_L18
	LQ  2,	-D_ofs
	LI	256
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,B_L18
	BRA	L46
L48:
	LD  2,	-M32_ofs
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,B_L18
	LQ  2,	-D_ofs
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,D32_L27
L46:
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO
end if

