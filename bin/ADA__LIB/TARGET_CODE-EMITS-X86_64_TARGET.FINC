if defined E_JCC_NE_L31_
PRO	E_JCC_NE_L31
 hexa_show 'E_JCC_NE_L31 ', $
PRMS
	PRM CC_ofs
endPRMS
ELB 2
 hexa_show 'var elab V ', $
VAR V_disp, Q
	LI	0
	LI	0
STR STR_L32, "STANDARD.ne_raise_"
	LCA	STR_L32.data_ptr
	CALL	STANDARD.TARGET_CODE_L1.SYMBOLS. ,RESOLVE_L15
	DUP
	ULD	1, STANDARD.TARGET_CODE_L1.SYMBOLS._SYM_ID.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	1, STANDARD.TARGET_CODE_L1.SYMBOLS._SYM_ID.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TARGET_CODE_L1.SYMBOLS. ,VALUE_OF_L19
	SQ  2,	V_disp

 hexa_show ' disp ', V_disp

begin:
	LI	15
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,B_L18
	LD  2,	-CC_ofs
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,B_L18
	LQ 2,	V_disp
	LI	04194304
	LD 1,	STANDARD.TARGET_CODE_L1.EMITS.TOP_disp
	ADD
	LI	4
	ADD
	SUB
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,D32_L27
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO
end if

