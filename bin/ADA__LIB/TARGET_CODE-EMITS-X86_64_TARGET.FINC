	LI	3
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L11
L12:
	LQ  2,	-LVL_ofs
	LI	15
	CLE
	BF	L13
	LI	4
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L11
L13:
L11:
	LI	7
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
