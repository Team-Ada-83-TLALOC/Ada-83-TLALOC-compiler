X86_64_TARGET = 'X86_64_TARGET'
namespace X86_64_TARGET


if defined S_DISP_L1_
PRO	S_DISP_L1
 hexa_show 'S_DISP_L1 ', $
PRMS
	PRM D_ofs
	PRM W0_ofs
	PRM result__ofs
endPRMS
ELB 2

begin:

	LQ  2,	-D_ofs
	LI	0
	CEQ
	BF	L5
	LQ  2,	-W0_ofs
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L4
L5:
	LQ  2,	-D_ofs
	LI	128
	NEG
	CGE
	DUP
	BF	L7
	DROP
	LQ  2,	-D_ofs
	LI	128
	CLT
L7:
	BF	L6
	LQ  2,	-W0_ofs
	LI	1
	ADD
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L4
L6:
L4:
	LQ  2,	-W0_ofs
	LI	4
	ADD
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

if defined S_FPA_L8_
PRO	S_FPA_L8
 hexa_show 'S_FPA_L8 ', $
PRMS
	PRM LVL_ofs
	PRM result__ofs
endPRMS
ELB 2

begin:

	LQ  2,	-LVL_ofs
	LI	0
	CEQ
	BF	L12
	LI	3
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L11
L12:
	LQ  2,	-LVL_ofs
	LI	15
	CLE
	BF	L13
	LI	4
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L11
L13:
L11:
	LI	7
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

if defined S_BASE_L14_
PRO	S_BASE_L14
 hexa_show 'S_BASE_L14 ', $
PRMS
	PRM LVL_ofs
	PRM result__ofs
endPRMS
ELB 2

begin:

	LQ  2,	-LVL_ofs
	LI	1
	NEG
	CEQ
	BF	L18
	LI	8
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L17
L18:
L17:
	LI	0
	LQ  2,	-LVL_ofs
	CALL	STANDARD.TARGET_CODE_L1.EMITS.X86_64_TARGET. ,S_FPA_L8
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

