if defined S_DISP_L1_
PRO	S_DISP_L1
 hexa_show 'S_DISP_L1 ', $
PRMS
	PRM D_ofs
	PRM W0_ofs
	PRM result__ofs
endPRMS
ELB 2

begin:

	LQ  2,	-D_ofs
	LI	0
	CEQ
	BF	L5
	LQ  2,	-W0_ofs
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L4
L5:
	LQ  2,	-D_ofs
	LI	128
	NEG
	CGE
	DUP
	BF	L7
	DROP
	LQ  2,	-D_ofs
	LI	128
	CLT
L7:
	BF	L6
	LQ  2,	-W0_ofs
	LI	1
	ADD
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L4
L6:
L4:
	LQ  2,	-W0_ofs
	LI	4
	ADD
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

if defined S_FPA_L8_
