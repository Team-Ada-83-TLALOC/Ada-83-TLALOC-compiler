	ADD
	ULB
	CGE
	ET
	LI	1
	OUX
L19:
	BF	L18
	LI	0
	SQ  1,	-result__ofs
	BRA ret_lbl
	BRA	L17
L18:
L17:
VAR	IL21_disp, D
