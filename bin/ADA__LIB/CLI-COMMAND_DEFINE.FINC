	LVA	1, -NAME_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	SD  1,	LMT_IL21_disp
	LD  1,	IL21_disp
	LD  1,	LMT_IL21_disp
	CGT
	BT	L20
LOOP__1:
	LVA	1, -NAME_ofs
	LIA	, , 0
	LD 1,	IL21_disp
	DUP
	LVA	1, -NAME_ofs
	LIA	, 0,  8
	LD	, STANDARD._STRING.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LVA	1, -NAME_ofs
	LIA	, 0,  8
	LD	, STANDARD._STRING.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LVA	1, -NAME_ofs
	LIA	, 0,  8
	LD	, STANDARD._STRING.FST_1
	SUB
	LVA	1, -NAME_ofs
	LIA	, , 8
	LD	, STANDARD._STRING.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	ULB
	DUP
	LI	65
	CGE
	BF	L25
	DUP
	LI	90
	CGT
	BF	L23
L25:
	DUP
	LI	48
	CGE
	BF	L26
	DUP
	LI	57
	CGT
	BF	L23
L26:
	DUP
	LI	95
	CEQ
	BT	L23
	DROP
	BRA	L24
L23:
	DROP
	BRA	L22
L24:
	LI	0
	SQ  1,	-result__ofs
	BRA ret_lbl
	BRA	L22
L22:
	LD  1,	IL21_disp
	LD  1,	LMT_IL21_disp
	CEQ
	BT	L20
	LD  1,	IL21_disp
