COMMAND_DEFINE = 'COMMAND_DEFINE'
namespace COMMAND_DEFINE


if defined RAISE_DEFINITION_ERROR_L1_
PRO	RAISE_DEFINITION_ERROR_L1
 hexa_show 'RAISE_DEFINITION_ERROR_L1 ', $
PRMS
	PRM MESSAGE_ofs
endPRMS
ELB 1

begin:
	LVA	1, -MESSAGE_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -MESSAGE_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  0,	STANDARD.CLI.ERROR_LENGTH_disp

	LD 0,	STANDARD.CLI.ERROR_LENGTH_disp
	LI	256
	CGT
	BF	L5
	LI	256
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  0,	STANDARD.CLI.ERROR_LENGTH_disp
	BRA	L4
L5:
L4:
	LA 0, STANDARD.CLI.ERROR_TEXT_disp
	LI	1
	LID 0, STANDARD.CLI.ERROR_TEXT__u, STANDARD._STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
	LD 0,	STANDARD.CLI.ERROR_LENGTH_disp
	LI	1
	SUB
	INC
	CLAMP0
	LI	1
	MUL
	LVA	1, -MESSAGE_ofs
	LIA	, , 0
	LVA	1, -MESSAGE_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	LVA	1, -MESSAGE_ofs
	LIA	, , 8
	LD	, STANDARD._STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
	LVA	1, -MESSAGE_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	LD 0,	STANDARD.CLI.ERROR_LENGTH_disp
	ADD
	LI	1
	SUB
	LVA	1, -MESSAGE_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	LI	1
	MUL
	DROP
	BLKMOV
	LCA	STANDARD.CLI.COMMAND_DEFINE.DEFINITION_ERROR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
ret_lbl:
	UNLINKR 1
	RTD	prm_siz
excep:
endPRO
end if

if defined STORE_L6_
PRO	STORE_L6
 hexa_show 'STORE_L6 ', $
PRMS
	PRM TEXT_ofs
	PRM result__ofs
endPRMS
ELB 1
 hexa_show 'var elab S ', $
VAR S_disp, Q
VAR S__u, Q
VAR S__dat, STANDARD.CLI._SPAN.size
	LVA	1, S__dat
	SA	1, S_disp
	LVA	1, STANDARD.CLI._SPAN.SIZ__
	SA	1, S__u
	LIVA 1, S_disp, STANDARD.CLI._SPAN.FIRST
	LI	1
	DUP
	LD	0, STANDARD._POSITIVE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._POSITIVE.LST
	CGT
	BT	STANDARD.ce_raise_
	SD
	LIVA 1, S_disp, STANDARD.CLI._SPAN.LAST
	LI	0
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD

 hexa_show ' disp ', S_disp

begin:

	LVA	1, -TEXT_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -TEXT_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	LI	0
	CEQ
	BF	L10
	LA   1,	-result__ofs
	LA  ,  0
	LI	STANDARD.CLI._SPAN.size
	LVA 1,	S_disp
	LA
	BLKMOV
	BRA ret_lbl
	BRA	L9
L10:
L9:

	LD 0,	STANDARD.CLI.DEFINITION_TOP_disp
	LVA	1, -TEXT_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -TEXT_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	ADD
	LI	4096
	CGT
	BF	L12
STR STR_L13, "Definition pool full"
	LCA	STR_L13.data_ptr
	CALL	STANDARD.CLI.COMMAND_DEFINE. ,RAISE_DEFINITION_ERROR_L1
	BRA	L11
L12:
L11:
	LIVA 	1, STANDARD.CLI.COMMAND_DEFINE.STORE_L6.S_disp, STANDARD.CLI._SPAN.FIRST
	LD 0,	STANDARD.CLI.DEFINITION_TOP_disp
	LI	1
	ADD
	SD
	LIVA 	1, STANDARD.CLI.COMMAND_DEFINE.STORE_L6.S_disp, STANDARD.CLI._SPAN.LAST
	LD 0,	STANDARD.CLI.DEFINITION_TOP_disp
	LVA	1, -TEXT_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -TEXT_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	ADD
	SD
	LA 0, STANDARD.CLI.DEFINITION_POOL_disp
	LID	1, STANDARD.CLI.COMMAND_DEFINE.STORE_L6.S_disp, STANDARD.CLI._SPAN.FIRST
	LID 0, STANDARD.CLI.DEFINITION_POOL__u, STANDARD._STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
	LID	1, STANDARD.CLI.COMMAND_DEFINE.STORE_L6.S_disp, STANDARD.CLI._SPAN.LAST
	LID	1, STANDARD.CLI.COMMAND_DEFINE.STORE_L6.S_disp, STANDARD.CLI._SPAN.FIRST
	SUB
	INC
	CLAMP0
	LI	1
	MUL
	LA  1,	-TEXT_ofs
	LA
	BLKMOV
	LID	1, STANDARD.CLI.COMMAND_DEFINE.STORE_L6.S_disp, STANDARD.CLI._SPAN.LAST
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  0,	STANDARD.CLI.DEFINITION_TOP_disp
	LA   1,	-result__ofs
	LA  ,  0
	LI	STANDARD.CLI._SPAN.size
	LVA 1,	S_disp
	LA
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINKR 1
	RTD	prm_siz-8
excep:
endPRO
end if

