if defined CHECK_L8_
PRO	CHECK_L8
 hexa_show 'CHECK_L8 ', $
PRMS
	PRM OK_ofs
	PRM SECTION_ofs
	PRM NUMERO_ofs
endPRMS
ELB 2

begin:

	ULB  2,	-OK_ofs
	BF	L12
	LD 1,	STANDARD.EXC_TEST1_L1.NB_OK_disp
	LI	1
	ADD
	SD  1,	STANDARD.EXC_TEST1_L1.NB_OK_disp
	BRA	L11
L12:
	LD 1,	STANDARD.EXC_TEST1_L1.NB_ECHECS_disp
	LI	1
	ADD
	SD  1,	STANDARD.EXC_TEST1_L1.NB_ECHECS_disp
STR STR_L13, "* ECHEC section"
	LCA	STR_L13.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	LD 1,	STANDARD.EXC_TEST1_L1.IO_ENT.DEFAULT_BASE_disp
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	3
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LD  2,	-SECTION_ofs
	CALL	STANDARD.EXC_TEST1_L1.IO_ENT. ,PUT_L64
STR STR_L14, " test"
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	LD 1,	STANDARD.EXC_TEST1_L1.IO_ENT.DEFAULT_BASE_disp
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	3
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LD  2,	-NUMERO_ofs
	CALL	STANDARD.EXC_TEST1_L1.IO_ENT. ,PUT_L64
	LI	1
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
L11:
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO
end if

