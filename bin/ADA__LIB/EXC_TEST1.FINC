EXC_TEST1 = 'EXC_TEST1'
PRO	EXC_TEST1_L1
 hexa_show 'EXC_TEST1_L1 ', $
ELB 1
STR E1__exc, "E1"
STR E2__exc, "E2"
 hexa_show 'var elab NB_OK ', $
VAR NB_OK_disp, D
	LI	0
	SD  1,	NB_OK_disp

 hexa_show ' disp ', NB_OK_disp
 hexa_show 'var elab NB_ECHECS ', $
