  VAR _FST_1, D
  VAR _LST_1, D
end namespace
STR ANON_31_17_L8_G, "; REPRESENTED_ITEMS.STATIC_INTEGER_VALUE : EXP.TY inattendu "
	LCA	ANON_31_17_L8_G.data_ptr
	DUP
	LA  ,  0
	SA  2, ANON_31_17_L8_G_data
	LA  ,  8
	SA  2, ANON_31_17_L8_G_info
	LID 2, ANON_31_17_L8_G_info, _STRING.LST_1
	LID 2, ANON_31_17_L8_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  2, ANON_31_17_L8_G_len
VAR	ANON_31_82_disp, Q
VAR	ANON_31_82__u,   Q
namespace ANON_31_82_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
	LVA 2, ANON_31_82_info.SIZ__
	SA  2, ANON_31_82__u
	LVA 2, ANON_31_82_disp
	LA 2, -EXP_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	LA 0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._NODE_NAME.use__info
	LI	16
	ADD
	CALL	STANDARD. ,ENUM_IMAGE_L31
	DUP
	LA  ,  0
	SA  2, ANON_31_82_L8_D_data
	LA  ,  8
	SA  2, ANON_31_82_L8_D_info
	LID 2, ANON_31_82_L8_D_info, _STRING.LST_1
	LID 2, ANON_31_82_L8_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  2, ANON_31_82_L8_D_len
	LA  2, ANON_31_17_L8_G_len
	LA  2, ANON_31_82_L8_D_len
	ADD
	CO_VAR
	SA  2, ANON_31_17_L8_R_disp
	LI	1
	SD  2, ANON_31_17_L8_R_info._FST_1
	LA  2, ANON_31_17_L8_G_len
	LA  2, ANON_31_82_L8_D_len
	ADD
	SD  2, ANON_31_17_L8_R_info._LST_1
	LI	8
	SD  2, ANON_31_17_L8_R_info._COMP_SIZ
	LA  2, ANON_31_17_L8_G_len
	LA  2, ANON_31_82_L8_D_len
	ADD
	LI	8
	MUL
	SD  2, ANON_31_17_L8_R_info.SIZ__
	LVA 2, ANON_31_17_L8_R_info.SIZ__
	SA  2, ANON_31_17_L8_R__u
	LA  2, ANON_31_17_L8_R_disp
	LA  2, ANON_31_17_L8_G_len
	LA  2, ANON_31_17_L8_G_data
	BLKMOV
	LA  2, ANON_31_17_L8_R_disp
	LA  2, ANON_31_17_L8_G_len
	ADD
	LA  2, ANON_31_82_L8_D_len
	LA  2, ANON_31_82_L8_D_data
	BLKMOV
	LVA 2, ANON_31_17_L8_R_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
L5:
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

