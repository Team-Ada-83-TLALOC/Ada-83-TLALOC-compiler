if defined STATIC_INTEGER_VALUE_L2_
PRO	STATIC_INTEGER_VALUE_L2
 hexa_show 'STATIC_INTEGER_VALUE_L2 ', $
PRMS
	PRM EXP_ofs
	PRM result__ofs
endPRMS
ELB 2

begin:

	LA 2, -EXP_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	LI	143
	CEQ
	DUP
	BT	L7
	DROP
	LA 2, -EXP_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	ULB	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_EXP.FST
	CGE
	ULB	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_EXP.LST
	LA 2, -EXP_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	CGE
	ET
L7:
	BF	L6
	LI	0
	LA  2,	-EXP_ofs
	LI  88
	CALL	STANDARD.IDL. ,DI_L21
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L5
L6:
VAR	ANON_31_17_L8_G_data, Q
VAR	ANON_31_17_L8_G_info, Q
VAR	ANON_31_82_L8_D_data, Q
VAR	ANON_31_82_L8_D_info, Q
