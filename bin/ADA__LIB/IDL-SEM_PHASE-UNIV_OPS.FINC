UNIV_OPS = 'UNIV_OPS'
namespace UNIV_OPS

 hexa_show 'var elab NUM_VAL ', $
VAR NUM_VAL_disp, D
	LI	2
	SD  1,	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.NUM_VAL_disp

 hexa_show ' disp ', NUM_VAL_disp
_UDIGIT_PAIR_TYPE = '_UDIGIT_PAIR_TYPE'
namespace _UDIGIT_PAIR_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, U1, 	LA 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._UDIGIT.use__info
USEINFO 1, U2, 	LA 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._UDIGIT.use__info
virtual at 0
STATOFS U1, 2, 2
STATOFS U2, 2, 2
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace
_VECTOR_DIGITS_PAIRS = '_VECTOR_DIGITS_PAIRS'
namespace _VECTOR_DIGITS_PAIRS
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	32
	SD	1, _COMP_SIZ
	LD	1, _COMP_SIZ
	LI	1
	SD	1, _FST_1
	LI	126
	DUP
	ULB	0, STANDARD.IDL._ATTR_NBR.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULB	0, STANDARD.IDL._ATTR_NBR.LST
	CGT
	BT	STANDARD.ce_raise_
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
_VECTOR_PAIRS = '_VECTOR_PAIRS'
namespace _VECTOR_PAIRS
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, L, 	LA 0, STANDARD._NATURAL.use__info
USEINFO 1, S, 	LA 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._UDIGIT.use__info
USEINFO 1, P, 	LA 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._VECTOR_DIGITS_PAIRS.use__info
virtual at 0
STATOFS L, 4, 4
STATOFS S, 2, 2
STATOFS P, 504, 1
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace

if defined DIGIT_MUL_L1_
PRO	DIGIT_MUL_L1
 hexa_show 'DIGIT_MUL_L1 ', $
PRMS
	PRM A_ofs
	PRM B_ofs
	PRM HIGH_ofs
	PRM LOW_ofs
endPRMS
ELB 2
 hexa_show 'var elab A1 ', $
VAR A1_disp, W
	LW  2,	-A_ofs
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SW  2,	A1_disp

 hexa_show ' disp ', A1_disp
 hexa_show 'var elab B1 ', $
VAR B1_disp, W
	LW  2,	-B_ofs
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SW  2,	B1_disp

 hexa_show ' disp ', B1_disp
 hexa_show 'var elab A2 ', $
VAR A2_disp, W
	LW  2,	-A_ofs
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	SW  2,	A2_disp

 hexa_show ' disp ', A2_disp
 hexa_show 'var elab B2 ', $
VAR B2_disp, W
	LW  2,	-B_ofs
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	SW  2,	B2_disp

 hexa_show ' disp ', B2_disp
 hexa_show 'var elab XX ', $
VAR XX_disp, W
	LW 2,	A1_disp
	LW 2,	B2_disp
	MUL
	LW 2,	A2_disp
	LW 2,	B1_disp
	MUL
	ADD
	SW  2,	XX_disp

 hexa_show ' disp ', XX_disp
 hexa_show 'var elab LL ', $
VAR LL_disp, W
	LW 2,	A2_disp
	LW 2,	B2_disp
	MUL
	LW 2,	XX_disp
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	LI	100
	MUL
	ADD
	SW  2,	LL_disp

 hexa_show ' disp ', LL_disp

begin:
	LW 2,	LL_disp
	LI	10000
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	SIW  2,	-LOW_ofs
	LW 2,	A1_disp
	LW 2,	B1_disp
	MUL
	LW 2,	LL_disp
	LI	10000
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	LW 2,	XX_disp
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	SIW  2,	-HIGH_ofs
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO
end if

if defined DIGIT_DIV_L4_
PRO	DIGIT_DIV_L4
 hexa_show 'DIGIT_DIV_L4 ', $
PRMS
	PRM H_ofs
	PRM L_ofs
	PRM A_ofs
	PRM result__ofs
endPRMS
ELB 2
 hexa_show 'var elab QUO ', $
VAR QUO_disp, W

 hexa_show ' disp ', QUO_disp
 hexa_show 'var elab PH ', $
VAR PH_disp, W

 hexa_show ' disp ', PH_disp
 hexa_show 'var elab PL ', $
VAR PL_disp, W

 hexa_show ' disp ', PL_disp

begin:

	LW  2,	-H_ofs
	LI	0
	CEQ
	BF	L8
	LW  2,	-L_ofs
	LW  2,	-A_ofs
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L7
L8:
	LW  2,	-A_ofs
	LI	100
	CLT
	BF	L9
	LI	0
	LW  2,	-A_ofs
	LI	100
	MUL
	LW  2,	-L_ofs
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	LI	100
	MUL
	LW  2,	-H_ofs
	LI	100
	MUL
	LW  2,	-L_ofs
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_DIV_L4
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L7
L9:

	LW  2,	-H_ofs
	LI	100
	CGE
	BF	L11
	LW  2,	-H_ofs
	LW  2,	-A_ofs
	LI	99
	ADD
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	LI	100
	MUL
	SW  2,	QUO_disp
	BRA	L10
L11:
	LW  2,	-H_ofs
	LI	100
	MUL
	LW  2,	-L_ofs
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	LW  2,	-A_ofs
	LI	99
	ADD
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SW  2,	QUO_disp
L10:
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.DIGIT_DIV_L4.PL_disp
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.DIGIT_DIV_L4.PH_disp
	LW 2,	QUO_disp
	LW  2,	-A_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_MUL_L1

	LW  2,	-L_ofs
	LW 2,	PL_disp
	CGE
	BF	L13
	LW 2,	QUO_disp
	LI	0
	LW  2,	-A_ofs
	LW  2,	-L_ofs
	LW 2,	PL_disp
	SUB
	LW  2,	-H_ofs
	LW 2,	PH_disp
	SUB
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_DIV_L4
	ADD
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L12
L13:
	LW 2,	QUO_disp
	LI	0
	LW  2,	-A_ofs
	LW  2,	-L_ofs
	LI	10000
	ADD
	LW 2,	PL_disp
	SUB
	LW  2,	-H_ofs
	LI	1
	SUB
	LW 2,	PH_disp
	SUB
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_DIV_L4
	ADD
	SQ  2,	-result__ofs
	BRA ret_lbl
L12:
L7:
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

