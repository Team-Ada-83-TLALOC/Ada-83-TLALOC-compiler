	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.LST
	CGT
	BT	STANDARD.ce_raise_
	SW  2,	B1_disp

 hexa_show ' disp ', B1_disp
 hexa_show 'var elab A2 ', $
VAR A2_disp, W
	LW  2,	-A_ofs
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	DUP
	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.LST
	CGT
	BT	STANDARD.ce_raise_
	SW  2,	A2_disp

 hexa_show ' disp ', A2_disp
 hexa_show 'var elab B2 ', $
VAR B2_disp, W
	LW  2,	-B_ofs
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	DUP
	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.LST
	CGT
	BT	STANDARD.ce_raise_
	SW  2,	B2_disp

 hexa_show ' disp ', B2_disp
 hexa_show 'var elab XX ', $
VAR XX_disp, W
	LW 2,	A1_disp
	LW 2,	B2_disp
	MUL
	LW 2,	A2_disp
	LW 2,	B1_disp
	MUL
	ADD
	DUP
	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.LST
	CGT
	BT	STANDARD.ce_raise_
	SW  2,	XX_disp

 hexa_show ' disp ', XX_disp
 hexa_show 'var elab LL ', $
VAR LL_disp, W
	LW 2,	A2_disp
	LW 2,	B2_disp
	MUL
	LW 2,	XX_disp
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	LI	100
	MUL
	ADD
	DUP
	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.LST
	CGT
	BT	STANDARD.ce_raise_
	SW  2,	LL_disp

 hexa_show ' disp ', LL_disp

begin:
	LW 2,	LL_disp
	LI	10000
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	DUP
	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.LST
	CGT
	BT	STANDARD.ce_raise_
	SIW  2,	-LOW_ofs
	LW 2,	A1_disp
	LW 2,	B1_disp
	MUL
	LW 2,	LL_disp
	LI	10000
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	LW 2,	XX_disp
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	DUP
	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.LST
	CGT
	BT	STANDARD.ce_raise_
	SIW  2,	-HIGH_ofs
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO
end if

