	LD	 1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._VECTOR_DIGITS._COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	LW
	CLT
	SQ  2,	-result__ofs
