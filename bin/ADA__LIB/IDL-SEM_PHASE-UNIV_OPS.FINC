	LD	 1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._VECTOR_DIGITS._LST_1
	CGT
	BT	STANDARD.ce_raise_
	LD	 1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._VECTOR_DIGITS._FST_1
