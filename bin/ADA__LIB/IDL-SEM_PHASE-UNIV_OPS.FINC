UNIV_OPS = 'UNIV_OPS'
namespace UNIV_OPS

 hexa_show 'var elab NUM_VAL ', $
VAR NUM_VAL_disp, D
	LI	2
	SD  1,	STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS.NUM_VAL_disp

 hexa_show ' disp ', NUM_VAL_disp
_UDIGIT_PAIR_TYPE = '_UDIGIT_PAIR_TYPE'
namespace _UDIGIT_PAIR_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, U1, 	LA 1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.use__info
USEINFO 1, U2, 	LA 1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.use__info
virtual at 0
STATOFS U1, 2, 2
STATOFS U2, 2, 2
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace
_VECTOR_DIGITS_PAIRS = '_VECTOR_DIGITS_PAIRS'
namespace _VECTOR_DIGITS_PAIRS
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	32
	SD	1, _COMP_SIZ
	LD	1, _COMP_SIZ
	LI	1
	SD	1, _FST_1
	LI	126
	DUP
	ULB	0, STANDARD.IDL._ATTR_NBR.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULB	0, STANDARD.IDL._ATTR_NBR.LST
	CGT
	BT	STANDARD.ce_raise_
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
_VECTOR_PAIRS = '_VECTOR_PAIRS'
namespace _VECTOR_PAIRS
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, L, 	LA 0, STANDARD._NATURAL.use__info
USEINFO 1, S, 	LA 1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.use__info
USEINFO 1, P, 	LA 1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._VECTOR_DIGITS_PAIRS.use__info
virtual at 0
STATOFS L, 4, 4
STATOFS S, 2, 2
STATOFS P, 504, 1
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace

if defined DIGIT_MUL_L1_
PRO	DIGIT_MUL_L1
 hexa_show 'DIGIT_MUL_L1 ', $
PRMS
	PRM A_ofs
	PRM B_ofs
	PRM HIGH_ofs
	PRM LOW_ofs
endPRMS
ELB 2
 hexa_show 'var elab A1 ', $
VAR A1_disp, W
	LW  2,	-A_ofs
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	DUP
	LW	1, STANDARD.IDL.SEM_PHASE_L14.UNIV_OPS._UDIGIT.FST
