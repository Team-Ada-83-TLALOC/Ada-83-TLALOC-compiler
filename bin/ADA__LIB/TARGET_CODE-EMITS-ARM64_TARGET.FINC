ARM64_TARGET = 'ARM64_TARGET'
namespace ARM64_TARGET


if defined DD_L1_
PRO	DD_L1
 hexa_show 'DD_L1 ', $
PRMS
	PRM V_ofs
endPRMS
ELB 2
 hexa_show 'var elab U ', $
VAR U_disp, Q
	LQ  2,	-V_ofs
	SQ  2,	U_disp

 hexa_show ' disp ', U_disp

begin:
VAR	IL5_disp, D
	LI	1
	SD  2,	IL5_disp
VAR	LMT_IL5_disp, D
	LI	4
	SD  2,	LMT_IL5_disp
	LD  2,	IL5_disp
	LD  2,	LMT_IL5_disp
	CGT
	BT	L4
LOOP__1:
	LQ 2,	U_disp
	LI	256
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,B_L18
	LQ 2,	U_disp
	LQ 2,	U_disp
	LI	256
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	SUB
	LI	256
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SQ  2,	U_disp
	LD  2,	IL5_disp
	LD  2,	LMT_IL5_disp
	CEQ
	BT	L4
	LD  2,	IL5_disp
	INC
	SD  2,	IL5_disp
	BRA	LOOP__1
L4:
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO
end if

