	LQ 2,	C_disp
	LI	0
	CNE
	BF	L22
	LQ 2,	NZ_disp
	LI	1
	ADD
	SQ  2,	NZ_disp
	BRA	L21
L22:
L21:

	LQ 2,	C_disp
	LI	00065535
	CNE
	BF	L24
	LQ 2,	NF_disp
	LI	1
	ADD
	SQ  2,	NF_disp
	BRA	L23
L24:
L23:
	LD  2,	IDXL20_disp
	LD  2,	LMT_IDXL20_disp
	CEQ
	BT	L19
	LD  2,	IDXL20_disp
	INC
	SD  2,	IDXL20_disp
	BRA	LOOP__3
L19:

	LQ 2,	NZ_disp
	LQ 2,	NF_disp
	CLT
	BF	L26
	LQ 2,	NZ_disp
	SQ  2,	NF_disp
	BRA	L25
L26:
L25:

	LQ 2,	NF_disp
	LI	1
	CLT
	BF	L28
	LI	1
	SQ  2,	NF_disp
	BRA	L27
L28:
L27:
	LI	4
	LQ 2,	NF_disp
	MUL
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
