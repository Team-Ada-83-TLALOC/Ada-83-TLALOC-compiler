	LA  2,	-LIST_ofs
	LA
	BLKMOV

 hexa_show ' disp ', LIST_TAIL_disp
 hexa_show 'var elab COUNT ', $
VAR COUNT_disp, D
	LI	0
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  2,	COUNT_disp

 hexa_show ' disp ', COUNT_disp

begin:
LOOP__1:
	LI	0
	LVA 2,	LIST_TAIL_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L17
	LVA 2,	LIST_TAIL_disp
	LA
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_55_20_disp, Q
VAR	ANON_55_20__u,    Q
VAR	ANON_55_20__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 2, ANON_55_20__dat
	SA  2, ANON_55_20_disp
	LA  0, STANDARD.IDL._SEQ_TYPE.use__info
	SA  2, ANON_55_20__u
	LVA 2, ANON_55_20_disp

	LVA 2,	LIST_TAIL_disp
	CALL	STANDARD.IDL.IDL_MAN. ,TAIL_L32
	LA
	BLKMOV
	LD 2,	COUNT_disp
	LI	1
	ADD
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  2,	COUNT_disp
	BRA	LOOP__1
L17:
	LD 2,	COUNT_disp
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

