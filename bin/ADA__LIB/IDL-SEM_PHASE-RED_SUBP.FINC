_ACTUAL_TYPE = '_ACTUAL_TYPE'
namespace _ACTUAL_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, SYM, 	LA 0, STANDARD.IDL._TREE.use__info
USEINFO 1, EXP, 	LA 0, STANDARD.IDL._TREE.use__info
USEINFO 1, TYPESET, 	LA 1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.use__info
virtual at 0
STATOFS SYM, 4, 8
STATOFS EXP, 4, 8
STATOFS TYPESET, 12, 8
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace
_ACTUAL_ARRAY_TYPE = '_ACTUAL_ARRAY_TYPE'
namespace _ACTUAL_ARRAY_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
	LI	1
	NEG
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace















