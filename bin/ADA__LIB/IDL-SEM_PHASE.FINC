 hexa_show ' spec ', $
_SU_TYPE = '_SU_TYPE'
namespace _SU_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, USED_PACKAGE_LIST, 	LA 0, STANDARD.IDL._SEQ_TYPE.use__info
USEINFO 1, INCOMPLETE_TYPE_LIST, 	LA 0, STANDARD.IDL._SEQ_TYPE.use__info
USEINFO 1, PRIVATE_TYPE_LIST, 	LA 0, STANDARD.IDL._SEQ_TYPE.use__info
virtual at 0
STATOFS USED_PACKAGE_LIST, 12, 8
STATOFS INCOMPLETE_TYPE_LIST, 12, 8
STATOFS PRIVATE_TYPE_LIST, 12, 8
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace
_H_TYPE = '_H_TYPE'
namespace _H_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, REGION_DEF, 	LA 0, STANDARD.IDL._TREE.use__info
USEINFO 1, LEX_LEVEL, 	LA 0, STANDARD._NATURAL.use__info
USEINFO 1, IS_IN_SPEC, 	LA 0, STANDARD._BOOLEAN.use__info
USEINFO 1, IS_IN_BODY, 	LA 0, STANDARD._BOOLEAN.use__info
USEINFO 1, SUBP_SYMREP, 	LA 0, STANDARD.IDL._TREE.use__info
USEINFO 1, RETURN_TYPE, 	LA 0, STANDARD.IDL._TREE.use__info
USEINFO 1, ENCLOSING_LOOP_ID, 	LA 0, STANDARD.IDL._TREE.use__info
virtual at 0
STATOFS REGION_DEF, 4, 8
STATOFS LEX_LEVEL, 4, 4
STATOFS IS_IN_SPEC, 1, 1
STATOFS IS_IN_BODY, 1, 1
STATOFS SUBP_SYMREP, 4, 8
STATOFS RETURN_TYPE, 4, 8
STATOFS ENCLOSING_LOOP_ID, 4, 8
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace
