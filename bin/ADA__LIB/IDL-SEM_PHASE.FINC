UNIV_OPS = 'UNIV_OPS'
namespace UNIV_OPS

 hexa_show ' spec ', $
_UDIGIT = '_UDIGIT'
namespace _UDIGIT
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR FST, W
VAR LST, W
	LI	16
	SD	1, SIZ__
	LI	00032768
	NEG
	SW	1, FST
	LI	32767
	SW	1, LST
end namespace
_VECTOR_DIGITS = '_VECTOR_DIGITS'
namespace _VECTOR_DIGITS
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	16
	SD	1, _COMP_SIZ
	LD	1, _COMP_SIZ
	LI	1
	SD	1, _FST_1
	LI	252
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
_VECTOR = '_VECTOR'
namespace _VECTOR
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, L, 	LA 0, STANDARD._NATURAL.use__info
USEINFO 1, S, 	LA 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._UDIGIT.use__info
USEINFO 1, D, 	LA 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._VECTOR_DIGITS.use__info
virtual at 0
STATOFS L, 4, 4
STATOFS S, 2, 2
STATOFS D, 504, 1
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace
















; EXC_LBL	L20
