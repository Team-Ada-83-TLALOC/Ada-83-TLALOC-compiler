	LI	8
	MUL
	SD  2, ANON_86_15_L10_R_info.SIZ__
	LVA 2, ANON_86_15_L10_R_info.SIZ__
	SA  2, ANON_86_15_L10_R__u
	LA  2, ANON_86_15_L10_R_disp
	LA  2, ANON_86_15_L10_G_len
	LA  2, ANON_86_15_L10_G_data
