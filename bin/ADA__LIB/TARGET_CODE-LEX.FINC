	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.TARGET_CODE_L1.LEX.FIO.DEFAULT_EXP_disp

 hexa_show ' disp ', DEFAULT_EXP_disp

if defined GET_L67_
PRO	GET_L67
 hexa_show 'GET_L67 ', $
PRMS
	PRM FILE_ofs
	PRM ITEM_ofs
	PRM WIDTH_ofs
endPRMS
ELB 2
begin:
	LVA	 1, GFP_disp
	LD	 2, -WIDTH_ofs
	LA 	 2, -ITEM_ofs
	LA 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,GET_L67
	UNLINKR	 2
	RTD	prm_siz
endPRO
end if

