VAR	ANON_86_15_L10_G_data, Q
VAR	ANON_86_15_L10_G_info, Q
VAR	ANON_86_38_L10_D_data, Q
VAR	ANON_86_38_L10_D_info, Q
VAR	ANON_86_15_L10_G_len,  Q
VAR	ANON_86_38_L10_D_len,  Q
VAR	ANON_86_15_L10_R_disp, Q
VAR	ANON_86_15_L10_R__u,   Q
namespace ANON_86_15_L10_R_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
STR ANON_86_15_L10_G, "TARGET_CODE.LEX : "
	LCA	ANON_86_15_L10_G.data_ptr
	DUP
	LA  ,  0
	SA  2, ANON_86_15_L10_G_data
	LA  ,  8
	SA  2, ANON_86_15_L10_G_info
	LID 2, ANON_86_15_L10_G_info, _STRING.LST_1
	LID 2, ANON_86_15_L10_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  2, ANON_86_15_L10_G_len
	LA  2,	-MSG_ofs
	DUP
	LA  ,  0
	SA  2, ANON_86_38_L10_D_data
	LA  ,  8
	SA  2, ANON_86_38_L10_D_info
	LID 2, ANON_86_38_L10_D_info, _STRING.LST_1
	LID 2, ANON_86_38_L10_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  2, ANON_86_38_L10_D_len
	LA  2, ANON_86_15_L10_G_len
	LA  2, ANON_86_38_L10_D_len
	ADD
	CO_VAR
	SA  2, ANON_86_15_L10_R_disp
	LI	1
	SD  2, ANON_86_15_L10_R_info._FST_1
	LA  2, ANON_86_15_L10_G_len
	LA  2, ANON_86_38_L10_D_len
	ADD
	SD  2, ANON_86_15_L10_R_info._LST_1
	LI	8
	SD  2, ANON_86_15_L10_R_info._COMP_SIZ
	LA  2, ANON_86_15_L10_G_len
	LA  2, ANON_86_38_L10_D_len
	ADD
	LI	8
	MUL
	SD  2, ANON_86_15_L10_R_info.SIZ__
	LVA 2, ANON_86_15_L10_R_info.SIZ__
	SA  2, ANON_86_15_L10_R__u
	LA  2, ANON_86_15_L10_R_disp
	LA  2, ANON_86_15_L10_G_len
	LA  2, ANON_86_15_L10_G_data
	BLKMOV
	LA  2, ANON_86_15_L10_R_disp
	LA  2, ANON_86_15_L10_G_len
	ADD
	LA  2, ANON_86_38_L10_D_len
	LA  2, ANON_86_38_L10_D_data
	BLKMOV
	LVA 2, ANON_86_15_L10_R_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60

	LD 1,	STANDARD.TARGET_CODE_L1.LEX.LEN_disp
	LI	0
	CGT
	BF	L12
