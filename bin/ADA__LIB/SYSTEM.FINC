SYSTEM = 'SYSTEM'
namespace SYSTEM

 hexa_show ' spec ', $
_NAME = '_NAME'
namespace _NAME
VAR use__info, Q
BEGIN_BLOC_DEF
db 0, 6, "X86_64"
END_BLOC_DEF 8, 0, 0

	LCA	SIZ
	SA	0, use__info
end namespace
 hexa_show 'var elab SYSTEM_NAME ', $
VAR SYSTEM_NAME_disp, B
	LI	0
	SB  0,	STANDARD.SYSTEM.SYSTEM_NAME_disp

 hexa_show ' disp ', SYSTEM_NAME_disp
_PRIORITY = '_PRIORITY'
namespace _PRIORITY
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR FST, D
VAR LST, D
	LI	32
	SD	0, SIZ__
	LI	0
	SD	0, FST
	LI	10
	SD	0, LST
VAR PARENT__u, Q
	LA	0, STANDARD._INTEGER.use__info
	SA	0, PARENT__u
end namespace
_ADDRESS = '_ADDRESS'
namespace _ADDRESS
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR FST, Q
VAR LST, Q
	LI	64
	SD	0, SIZ__
	LI	2
	LI	63
	DEC
	SHL
	NEG
	SQ	0, FST
	LI	2
	LI	63
	DEC
	SHL
	LI	1
	SUB
	SQ	0, LST
VAR PARENT__u, Q
	LA	0, STANDARD.SYSTEM._ADDRESS.use__info
	SA	0, PARENT__u
end namespace
 hexa_show 'var elab NULL_ADDRESS ', $
VAR NULL_ADDRESS_disp, Q
	LI	0
	SQ  0,	STANDARD.SYSTEM.NULL_ADDRESS_disp

 hexa_show ' disp ', NULL_ADDRESS_disp
; EXC_LBL	L1
end namespace
