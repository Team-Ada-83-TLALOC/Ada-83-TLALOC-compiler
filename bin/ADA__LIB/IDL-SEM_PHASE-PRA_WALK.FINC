PRMS
	PRM USED_NAME_ID_ofs
	PRM GEN_ASSOC_S_ofs
	PRM H_ofs
endPRMS
ELB 2
 hexa_show 'var elab DEFLIST ', $
VAR DEFLIST_disp, Q
VAR DEFLIST__u, Q
VAR DEFLIST__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	2, DEFLIST__dat
	SA	2, DEFLIST_disp
	LVA	2, STANDARD.IDL._SEQ_TYPE.SIZ__
