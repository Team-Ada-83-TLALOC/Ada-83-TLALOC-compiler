	LA  2, DEF_disp
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', DEF_disp
 hexa_show 'var elab PRAGMA_DEFN ', $
VAR PRAGMA_DEFN_disp, Q
VAR PRAGMA_DEFN__u, Q
VAR PRAGMA_DEFN__dat, STANDARD.IDL._TREE.size
