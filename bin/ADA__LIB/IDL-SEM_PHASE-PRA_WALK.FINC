	SA	2, PRAGMA_DEFN__u
	LA  2, PRAGMA_DEFN_disp
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	BLKMOV

 hexa_show ' disp ', PRAGMA_DEFN_disp

begin:
VAR	exc_ctx_L6, q, 10
	LA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	SA  2,	exc_ctx_L6
	LCA	L6
	SA  2,	exc_ctx_L6 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  2,	exc_ctx_L6
	LVA  2,	exc_ctx_L6
	SA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
LOOP__1:
	LI	0
	LVA 2,	DEFLIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L8
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.PRA_WALK.WALK_PRAGMA_L205.DEF_disp
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.PRA_WALK.WALK_PRAGMA_L205.DEFLIST_disp
	CALL	STANDARD.IDL. ,POP_L24
	LVA 2,	PRAGMA_DEFN_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_42_22_disp, Q
VAR	ANON_42_22__u,    Q
VAR	ANON_42_22__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_42_22__dat
	SA  2, ANON_42_22_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_42_22__u
	LVA 2, ANON_42_22_disp

	LVA 2,	DEF_disp
	LI  35
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV

	LA	2, STANDARD.IDL.SEM_PHASE_L11.PRA_WALK.WALK_PRAGMA_L205.PRAGMA_DEFN_disp
	LD
	LI	24
	LI	8
	UBFX
	LI	38
	CEQ
	BF	L10
	BRA	L8
	BRA	L9
L10:
	LVA 2,	PRAGMA_DEFN_disp
	LA
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	BLKMOV
L9:
	BRA	LOOP__1
L8:
	LVA 2,	PRAGMA_DEFN_disp
	LA  2,	-USED_NAME_ID_ofs
	LI  89
	CALL	STANDARD.IDL. ,D_L16

	LVA 2,	PRAGMA_DEFN_disp
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	LI	1
	OUX
	BF	L13
	LVA 0,	STANDARD.IDL.IDL_MAN.PRAGMA_CONTEXT_disp
	LA
	LI	STANDARD.IDL._TREE.size
	LA  2,	-USED_NAME_ID_ofs
	LA
	BLKMOV
	LA  2,	-H_ofs
	LA  2,	-GEN_ASSOC_S_ofs
	LA  2,	-USED_NAME_ID_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.PRA_WALK. ,WALK_PRAGMA_ARGUMENTS_L1
	LVA 0,	STANDARD.IDL.IDL_MAN.PRAGMA_CONTEXT_disp
	LA
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	BLKMOV

