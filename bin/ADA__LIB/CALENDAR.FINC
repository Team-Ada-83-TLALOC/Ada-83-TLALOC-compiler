ELB 1
 hexa_show 'var elab D ', $
VAR D_disp, Q
	LA  1,	-DATE_ofs
	SQ  1,	D_disp

 hexa_show ' disp ', D_disp

begin:

	LQ 1,	D_disp
	LI	 0
	LI	000536870912
	LI	 1
	CVTIX
	CEQ
	BF	L24
	LI	0
	SQ  1,	-result__ofs
	BRA ret_lbl
	BRA	L23
L24:
	LQ 1,	D_disp
	LI	 1
	LI	000536870912
	LI	 2
	CVTIX
	SUB
	LI	 1
	LI	 536870912
	CVTXI
	SQ  1,	-result__ofs
	BRA ret_lbl
L23:
ret_lbl:
	UNLINKR 1
	RTD	prm_siz-8
excep:
endPRO
end if

