	SD	0, SIZ__
	LI	1901
	SD	0, FST
	LI	2099
	SD	0, LST
VAR PARENT__u, Q
	LA	0, STANDARD._INTEGER.use__info
	SA	0, PARENT__u
end namespace
_MONTH_NUMBER = '_MONTH_NUMBER'
