if defined DAYS_FROM_CIVIL_L1_
PRO	DAYS_FROM_CIVIL_L1
 hexa_show 'DAYS_FROM_CIVIL_L1 ', $
PRMS
	PRM Y_IN_ofs
	PRM M_IN_ofs
	PRM D_IN_ofs
	PRM result__ofs
endPRMS
ELB 1
 hexa_show 'var elab Y ', $
VAR Y_disp, Q

 hexa_show ' disp ', Y_disp
 hexa_show 'var elab M_ADJ ', $
VAR M_ADJ_disp, Q

 hexa_show ' disp ', M_ADJ_disp
 hexa_show 'var elab ERA ', $
VAR ERA_disp, Q

 hexa_show ' disp ', ERA_disp
 hexa_show 'var elab YOE ', $
VAR YOE_disp, Q

 hexa_show ' disp ', YOE_disp
 hexa_show 'var elab DOY ', $
VAR DOY_disp, Q

 hexa_show ' disp ', DOY_disp
 hexa_show 'var elab DOE ', $
VAR DOE_disp, Q

 hexa_show ' disp ', DOE_disp

begin:

	LQ  1,	-M_IN_ofs
	LI	2
	CLE
	BF	L5
	LQ  1,	-Y_IN_ofs
	LI	1
	SUB
	SQ  1,	Y_disp
	LQ  1,	-M_IN_ofs
	LI	9
	ADD
	SQ  1,	M_ADJ_disp
	BRA	L4
L5:
	LQ  1,	-Y_IN_ofs
	SQ  1,	Y_disp
	LQ  1,	-M_IN_ofs
	LI	3
	SUB
	SQ  1,	M_ADJ_disp
L4:

	LQ 1,	Y_disp
	LI	0
	CGE
	BF	L7
	LQ 1,	Y_disp
	LI	400
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SQ  1,	ERA_disp
	BRA	L6
L7:
	LQ 1,	Y_disp
	LI	399
	SUB
	LI	400
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SQ  1,	ERA_disp
L6:
	LQ 1,	Y_disp
	LQ 1,	ERA_disp
	LI	400
	MUL
	SUB
	SQ  1,	YOE_disp
	LI	153
	LQ 1,	M_ADJ_disp
	MUL
	LI	2
	ADD
	LI	5
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	LQ  1,	-D_IN_ofs
	ADD
	LI	1
	SUB
	SQ  1,	DOY_disp
	LQ 1,	YOE_disp
	LI	365
	MUL
	LQ 1,	YOE_disp
	LI	4
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	LQ 1,	YOE_disp
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SUB
	LQ 1,	DOY_disp
	ADD
	SQ  1,	DOE_disp
	LQ 1,	ERA_disp
	LI	00146097
	MUL
	LQ 1,	DOE_disp
	ADD
	SQ  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 1
	RTD	prm_siz-8
excep:
endPRO
end if

if defined CIVIL_FROM_DAYS_L8_
PRO	CIVIL_FROM_DAYS_L8
 hexa_show 'CIVIL_FROM_DAYS_L8 ', $
PRMS
	PRM DAYS_ofs
	PRM Y_ofs
	PRM M_ofs
	PRM D_ofs
endPRMS
ELB 1
 hexa_show 'var elab ERA ', $
VAR ERA_disp, Q

 hexa_show ' disp ', ERA_disp
 hexa_show 'var elab DOE ', $
VAR DOE_disp, Q

 hexa_show ' disp ', DOE_disp
 hexa_show 'var elab YOE ', $
VAR YOE_disp, Q

 hexa_show ' disp ', YOE_disp
 hexa_show 'var elab Y_OUT ', $
VAR Y_OUT_disp, Q

 hexa_show ' disp ', Y_OUT_disp
 hexa_show 'var elab DOY ', $
VAR DOY_disp, Q

 hexa_show ' disp ', DOY_disp
 hexa_show 'var elab MP ', $
VAR MP_disp, Q

 hexa_show ' disp ', MP_disp
 hexa_show 'var elab M_OUT ', $
VAR M_OUT_disp, Q

 hexa_show ' disp ', M_OUT_disp
 hexa_show 'var elab D_OUT ', $
VAR D_OUT_disp, Q

 hexa_show ' disp ', D_OUT_disp
 hexa_show 'var elab TMP ', $
VAR TMP_disp, Q

 hexa_show ' disp ', TMP_disp

begin:

	LQ  1,	-DAYS_ofs
	LI	0
	CGE
	BF	L12
	LQ  1,	-DAYS_ofs
	SQ  1,	TMP_disp
	BRA	L11
L12:
	LQ  1,	-DAYS_ofs
	LI	00146096
	SUB
	SQ  1,	TMP_disp
L11:
	LQ 1,	TMP_disp
	LI	00146097
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SQ  1,	ERA_disp
	LQ  1,	-DAYS_ofs
	LQ 1,	ERA_disp
	LI	00146097
	MUL
	SUB
	SQ  1,	DOE_disp
	LQ 1,	DOE_disp
	LQ 1,	DOE_disp
	LI	1460
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SUB
	LQ 1,	DOE_disp
	LI	00036524
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	LQ 1,	DOE_disp
	LI	00146096
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SUB
	LI	365
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SQ  1,	YOE_disp
	LQ 1,	YOE_disp
	LQ 1,	ERA_disp
	LI	400
	MUL
	ADD
	SQ  1,	Y_OUT_disp
	LQ 1,	DOE_disp
	LI	365
	LQ 1,	YOE_disp
	MUL
	LQ 1,	YOE_disp
	LI	4
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	LQ 1,	YOE_disp
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SUB
	SUB
	SQ  1,	DOY_disp
	LI	5
	LQ 1,	DOY_disp
	MUL
	LI	2
	ADD
	LI	153
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SQ  1,	MP_disp
	LQ 1,	DOY_disp
	LI	153
	LQ 1,	MP_disp
	MUL
	LI	2
	ADD
	LI	5
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SUB
	LI	1
	ADD
	SQ  1,	D_OUT_disp

	LQ 1,	MP_disp
	LI	10
	CLT
	BF	L14
	LQ 1,	MP_disp
	LI	3
	ADD
	SQ  1,	M_OUT_disp
	BRA	L13
L14:
	LQ 1,	MP_disp
	LI	9
	SUB
	SQ  1,	M_OUT_disp
	LQ 1,	Y_OUT_disp
	LI	1
	ADD
	SQ  1,	Y_OUT_disp
L13:
	LQ 1,	Y_OUT_disp
	SIQ  1,	-Y_ofs
	LQ 1,	M_OUT_disp
	SIQ  1,	-M_ofs
	LQ 1,	D_OUT_disp
	SIQ  1,	-D_ofs
ret_lbl:
	UNLINKR 1
	RTD	prm_siz
excep:
endPRO
end if

