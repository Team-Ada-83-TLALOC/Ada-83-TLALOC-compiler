	ADD
	SQ  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 1
	RTD	prm_siz-8
excep:
endPRO
end if

if defined SPLIT_L6_
PRO	SPLIT_L6
 hexa_show 'SPLIT_L6 ', $
PRMS
	PRM DATE_ofs
	PRM YEAR_ofs
	PRM MONTH_ofs
	PRM DAY_ofs
	PRM SECONDS_ofs
endPRMS
ELB 1
 hexa_show 'var elab SEC_TOTAL ', $
VAR SEC_TOTAL_disp, Q
	LI	0
	LA  1,	-DATE_ofs
	CALL	STANDARD.CALENDAR. ,WHOLE_SECONDS_L20
	SQ  1,	SEC_TOTAL_disp

 hexa_show ' disp ', SEC_TOTAL_disp
 hexa_show 'var elab DAYS_FROM_1900 ', $
VAR DAYS_FROM_1900_disp, Q
	LQ 1,	SEC_TOTAL_disp
	LQ 0,	STANDARD.CALENDAR.SECONDS_PER_DAY_disp
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SQ  1,	DAYS_FROM_1900_disp

 hexa_show ' disp ', DAYS_FROM_1900_disp
 hexa_show 'var elab SEC_OF_DAY ', $
VAR SEC_OF_DAY_disp, Q
	LQ 1,	SEC_TOTAL_disp
	LQ 0,	STANDARD.CALENDAR.SECONDS_PER_DAY_disp
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	REMI
	SQ  1,	SEC_OF_DAY_disp

 hexa_show ' disp ', SEC_OF_DAY_disp
 hexa_show 'var elab FRAC_PART ', $
VAR FRAC_PART_disp, Q
	LA  1,	-DATE_ofs
	LQ 1,	SEC_TOTAL_disp
	LI	000536870912
	LI	 1
	CVTIX
	SUB
	SQ  1,	FRAC_PART_disp

 hexa_show ' disp ', FRAC_PART_disp
 hexa_show 'var elab Y ', $
VAR Y_disp, Q

 hexa_show ' disp ', Y_disp
 hexa_show 'var elab M ', $
VAR M_disp, Q

 hexa_show ' disp ', M_disp
 hexa_show 'var elab D ', $
VAR D_disp, Q

 hexa_show ' disp ', D_disp

begin:
	LVA  1,	STANDARD.CALENDAR.SPLIT_L6.D_disp
	LVA  1,	STANDARD.CALENDAR.SPLIT_L6.M_disp
	LVA  1,	STANDARD.CALENDAR.SPLIT_L6.Y_disp
	LQ 1,	DAYS_FROM_1900_disp
	LQ 0,	STANDARD.CALENDAR.DAYS_1900_disp
	ADD
	CALL	STANDARD.CALENDAR. ,CIVIL_FROM_DAYS_L8
	LQ 1,	Y_disp
	DUP
	LD	0, STANDARD.CALENDAR._YEAR_NUMBER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.CALENDAR._YEAR_NUMBER.LST
	CGT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.CALENDAR._YEAR_NUMBER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.CALENDAR._YEAR_NUMBER.LST
	CGT
	BT	STANDARD.ce_raise_
	SID  1,	-YEAR_ofs
	LQ 1,	M_disp
	DUP
	LD	0, STANDARD.CALENDAR._MONTH_NUMBER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.CALENDAR._MONTH_NUMBER.LST
	CGT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.CALENDAR._MONTH_NUMBER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.CALENDAR._MONTH_NUMBER.LST
	CGT
	BT	STANDARD.ce_raise_
	SID  1,	-MONTH_ofs
	LQ 1,	D_disp
	DUP
	LD	0, STANDARD.CALENDAR._DAY_NUMBER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.CALENDAR._DAY_NUMBER.LST
	CGT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.CALENDAR._DAY_NUMBER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.CALENDAR._DAY_NUMBER.LST
	CGT
	BT	STANDARD.ce_raise_
	SID  1,	-DAY_ofs
	LQ 1,	SEC_OF_DAY_disp
	LI	000536870912
	LI	 1
	CVTIX
	LQ 1,	FRAC_PART_disp
	ADD
	SIQ  1,	-SECONDS_ofs
ret_lbl:
	UNLINKR 1
	RTD	prm_siz
excep:
endPRO
end if

if defined TIME_OF_L7_
PRO	TIME_OF_L7
 hexa_show 'TIME_OF_L7 ', $
PRMS
	PRM YEAR_ofs
	PRM MONTH_ofs
	PRM DAY_ofs
	PRM SECONDS_ofs
	PRM result__ofs
endPRMS
ELB 1
 hexa_show 'var elab DAYS_FROM_HINNANT ', $
VAR DAYS_FROM_HINNANT_disp, Q
	LI	0
	LD  1,	-DAY_ofs
	LD  1,	-MONTH_ofs
	LD  1,	-YEAR_ofs
	CALL	STANDARD.CALENDAR. ,DAYS_FROM_CIVIL_L1
	SQ  1,	DAYS_FROM_HINNANT_disp

 hexa_show ' disp ', DAYS_FROM_HINNANT_disp
 hexa_show 'var elab DAYS_FROM_1900_LOCAL ', $
VAR DAYS_FROM_1900_LOCAL_disp, Q
	LQ 1,	DAYS_FROM_HINNANT_disp
	LQ 0,	STANDARD.CALENDAR.DAYS_1900_disp
	SUB
	SQ  1,	DAYS_FROM_1900_LOCAL_disp

 hexa_show ' disp ', DAYS_FROM_1900_LOCAL_disp

begin:
	LI	0
	LQ  1,	-SECONDS_ofs
	LQ 1,	DAYS_FROM_1900_LOCAL_disp
	LQ 0,	STANDARD.CALENDAR.SECONDS_PER_DAY_disp
	MUL
	LI	000536870912
	LI	 1
	CVTIX
	CALL	STANDARD.CALENDAR. ,_PLUS__L8
	SQ  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 1
	RTD	prm_siz-8
excep:
endPRO
end if

