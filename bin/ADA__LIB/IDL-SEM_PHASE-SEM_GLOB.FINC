VAR	ANON_67_42__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_67_42__dat
	SA  3, ANON_67_42_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  3, ANON_67_42__u
	LVA 3, ANON_67_42_disp

	LVA 3,	RANGE_NODE_disp
	LI  50
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXPRESO. ,GET_STATIC_VALUE_L157
	LA
	BLKMOV
	LA  3,	-HIGH_ofs
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_68_17_disp, Q
VAR	ANON_68_17__u,    Q
VAR	ANON_68_17__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_68_17__dat
	SA  3, ANON_68_17_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  3, ANON_68_17__u
	LVA 3, ANON_68_17_disp

VAR	ANON_68_43_disp, Q
VAR	ANON_68_43__u,    Q
VAR	ANON_68_43__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_68_43__dat
	SA  3, ANON_68_43_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  3, ANON_68_43__u
	LVA 3, ANON_68_43_disp

	LVA 3,	RANGE_NODE_disp
	LI  51
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXPRESO. ,GET_STATIC_VALUE_L157
	LA
	BLKMOV
	BRA	L12
L13:
	LA  3,	-LOW_ofs
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_70_16_disp, Q
VAR	ANON_70_16__u,    Q
VAR	ANON_70_16__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_70_16__dat
	SA  3, ANON_70_16_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  3, ANON_70_16__u
	LVA 3, ANON_70_16_disp

	LI	0
	CALL	STANDARD.IDL.SEM_PHASE_L11.UARITH. ,U_VAL_L21
	LA
	BLKMOV
	LA  3,	-HIGH_ofs
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_71_17_disp, Q
VAR	ANON_71_17__u,    Q
VAR	ANON_71_17__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_71_17__dat
	SA  3, ANON_71_17_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  3, ANON_71_17__u
	LVA 3, ANON_71_17_disp

	LI	0
	CALL	STANDARD.IDL.SEM_PHASE_L11.UARITH. ,U_VAL_L21
	LA
	BLKMOV
L12:
ret_lbl:
	UNLINKR 3
	RTD	prm_siz
excep:
endPRO
end if

