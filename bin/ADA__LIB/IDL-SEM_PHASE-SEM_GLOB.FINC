	LA  3,	-TYPE_NODE_ofs
	LI  39
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV
	LA  3,	-LOW_ofs
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_67_16_disp, Q
VAR	ANON_67_16__u,    Q
