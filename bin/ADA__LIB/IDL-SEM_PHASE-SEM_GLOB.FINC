begin:

	LA  3,	-TYPE_NODE_ofs
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	LI	1
	OUX
	BF	L13
	LVA 3,	RANGE_NODE_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_66_23_disp, Q
VAR	ANON_66_23__u,    Q
VAR	ANON_66_23__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_66_23__dat
	SA  3, ANON_66_23_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  3, ANON_66_23__u
