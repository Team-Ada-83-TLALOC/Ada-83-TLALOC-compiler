MAKE_NOD = 'MAKE_NOD'
namespace MAKE_NOD


if defined MAKE_VARIABLE_ID_L227_
PRO	MAKE_VARIABLE_ID_L227
 hexa_show 'MAKE_VARIABLE_ID_L227 ', $
PRMS
	PRM LX_SRCPOS_ofs
	PRM LX_SYMREP_ofs
	PRM SM_OBJ_TYPE_ofs
	PRM SM_INIT_EXP_ofs
	PRM SM_RENAMES_OBJ_ofs
	PRM SM_ADDRESS_ofs
	PRM SM_IS_SHARED_ofs
	PRM XD_REGION_ofs
	PRM result__ofs
endPRMS
ELB 2
 hexa_show 'var elab NODE ', $
VAR NODE_disp, Q
VAR NODE__u, Q
VAR NODE__dat, STANDARD.IDL._TREE.size
	LVA	2, NODE__dat
	SA	2, NODE_disp
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, NODE__u
	LA  2, NODE_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_25_22_disp, Q
VAR	ANON_25_22__u,    Q
VAR	ANON_25_22__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_25_22__dat
	SA  2, ANON_25_22_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_25_22__u
	LVA 2, ANON_25_22_disp

	LI  12
	CALL	STANDARD.IDL. ,MAKE_L15
	LA
	BLKMOV

 hexa_show ' disp ', NODE_disp

begin:
	LA  2,	-LX_SRCPOS_ofs
	LVA 2,	NODE_disp
	LI	 154
	CALL	STANDARD.IDL. ,D_L16
	LA  2,	-LX_SYMREP_ofs
	LVA 2,	NODE_disp
	LI	 13
	CALL	STANDARD.IDL. ,D_L16
	LA  2,	-SM_OBJ_TYPE_ofs
	LVA 2,	NODE_disp
	LI	 15
	CALL	STANDARD.IDL. ,D_L16
	LA  2,	-SM_INIT_EXP_ofs
	LVA 2,	NODE_disp
	LI	 24
	CALL	STANDARD.IDL. ,D_L16
	ULB  2,	-SM_RENAMES_OBJ_ofs
	LVA 2,	NODE_disp
	LI	 25
	CALL	STANDARD.IDL. ,DB_L18
	LA  2,	-SM_ADDRESS_ofs
	LVA 2,	NODE_disp
	LI	 26
	CALL	STANDARD.IDL. ,D_L16
	ULB  2,	-SM_IS_SHARED_ofs
	LVA 2,	NODE_disp
	LI	 31
	CALL	STANDARD.IDL. ,DB_L18
	LA  2,	-XD_REGION_ofs
	LVA 2,	NODE_disp
	LI	 14
	CALL	STANDARD.IDL. ,D_L16
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL._TREE.size
	LVA 2,	NODE_disp
	LA
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

