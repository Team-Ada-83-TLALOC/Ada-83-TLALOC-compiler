	LI	0
	LVA 2,	INDEX_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.CHK_STAT. ,IS_STATIC_DISCRETE_RANGE_L209
	LI	1
	OUX
	BF	L34
	LI	0
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L33
