if defined IS_STATIC_INDEX_CONSTRAINT_L210_
PRO	IS_STATIC_INDEX_CONSTRAINT_L210
 hexa_show 'IS_STATIC_INDEX_CONSTRAINT_L210 ', $
PRMS
	PRM ARRAY_TYPE_ofs
	PRM INDEX_CONSTRAINT_ofs
	PRM result__ofs
endPRMS
ELB 2
 hexa_show 'var elab INDEX_LIST ', $
