	LA  2,	-INDEX_CONSTRAINT_ofs
	LI  59
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL. ,LIST_L22
	LA
	BLKMOV

 hexa_show ' disp ', INDEX_LIST_disp
 hexa_show 'var elab INDEX ', $
VAR INDEX_disp, Q
VAR INDEX__u, Q
VAR INDEX__dat, STANDARD.IDL._TREE.size
	LVA	2, INDEX__dat
	SA	2, INDEX_disp
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, INDEX__u
	LA  2, INDEX_disp
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', INDEX_disp
 hexa_show 'var elab ARRAY_TYPE_SPEC ', $
VAR ARRAY_TYPE_SPEC_disp, Q
VAR ARRAY_TYPE_SPEC__u, Q
VAR ARRAY_TYPE_SPEC__dat, STANDARD.IDL._TREE.size
