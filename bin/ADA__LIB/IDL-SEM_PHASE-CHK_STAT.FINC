L33:
	BRA	LOOP__1
L32:

	LA	2, STANDARD.IDL.SEM_PHASE_L11.CHK_STAT.IS_STATIC_INDEX_CONSTRAINT_L210.ARRAY_TYPE_SPEC_disp
	LD
	LI	24
	LI	8
	UBFX
	ULB	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_PRIVATE_SPEC.FST
