	SA	2, ARRAY_TYPE_SPEC_disp
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, ARRAY_TYPE_SPEC__u
	LA  2, ARRAY_TYPE_SPEC_disp
	LI	STANDARD.IDL._TREE.size
	LA  2,	-ARRAY_TYPE_ofs
	LA
	BLKMOV

 hexa_show ' disp ', ARRAY_TYPE_SPEC_disp

begin:
LOOP__1:
	LI	0
	LVA 2,	INDEX_LIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L32
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.CHK_STAT.IS_STATIC_INDEX_CONSTRAINT_L210.INDEX_disp
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.CHK_STAT.IS_STATIC_INDEX_CONSTRAINT_L210.INDEX_LIST_disp
