_SPAN = '_SPAN'
namespace _SPAN
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
USEINFO 0, FIRST, 	LA 0, STANDARD._POSITIVE.use__info
USEINFO 0, LAST, 	LA 0, STANDARD._NATURAL.use__info
virtual at 0
STATOFS FIRST, 4, 4
STATOFS LAST, 4, 4
size = $
end virtual
	LI	 size*8
	SD	0, SIZ__
end namespace
_ENTRY_KIND = '_ENTRY_KIND'
namespace _ENTRY_KIND
VAR use__info, Q
BEGIN_BLOC_DEF
db 0, 4, "VERB"
db 1, 9, "PARAMETER"
db 2, 14, "FLAG_QUALIFIER"
db 3, 14, "LIST_QUALIFIER"
db 4, 14, "FREE_QUALIFIER"
END_BLOC_DEF 8, 0, 4

	LCA	SIZ
	SA	0, use__info
end namespace
_ENTRY_RECORD = '_ENTRY_RECORD'
namespace _ENTRY_RECORD
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
USEINFO 0, KIND, 	LA 0, STANDARD.CLI._ENTRY_KIND.use__info
USEINFO 0, NAME, 	LA 0, STANDARD.CLI._SPAN.use__info
USEINFO 0, VERB_INDEX, 	LA 0, STANDARD._NATURAL.use__info
USEINFO 0, REQUIRED, 	LA 0, STANDARD._BOOLEAN.use__info
USEINFO 0, MULTIPLE, 	LA 0, STANDARD._BOOLEAN.use__info
USEINFO 0, NEGATABLE, 	LA 0, STANDARD._BOOLEAN.use__info
USEINFO 0, IMPLICIT_FIRST, 	LA 0, STANDARD._BOOLEAN.use__info
USEINFO 0, VALUES_LIST, 	LA 0, STANDARD.CLI._SPAN.use__info
USEINFO 0, DEFAULT, 	LA 0, STANDARD.CLI._SPAN.use__info
USEINFO 0, STATUS, 	LA 0, STANDARD.CLI.COMMAND_ACCESS._QUALIFIER_STATUS.use__info
USEINFO 0, VALUES_FOUND, 	LA 0, STANDARD._NATURAL.use__info
virtual at 0
STATOFS KIND, 1, 1
STATOFS NAME, 8, 8
STATOFS VERB_INDEX, 4, 4
STATOFS REQUIRED, 1, 1
STATOFS MULTIPLE, 1, 1
STATOFS NEGATABLE, 1, 1
STATOFS IMPLICIT_FIRST, 1, 1
STATOFS VALUES_LIST, 8, 8
STATOFS DEFAULT, 8, 8
STATOFS STATUS, 1, 1
STATOFS VALUES_FOUND, 4, 4
size = $
end virtual
	LI	 size*8
	SD	0, SIZ__
end namespace
