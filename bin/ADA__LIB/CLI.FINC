	LI	0
	SB
	LIVA 0, __INTL3, STANDARD.CLI._ENTRY_RECORD.MULTIPLE
	LI	0
	SB
	LIVA 0, __INTL3, STANDARD.CLI._ENTRY_RECORD.NEGATABLE
