begin:
VAR	IL7_disp, D
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.FST_1
	SD  1,	IL7_disp
VAR	LMT_IL7_disp, D
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.LST_1
	SD  1,	LMT_IL7_disp
	LD  1,	IL7_disp
	LD  1,	LMT_IL7_disp
	CGT
	BT	L6
LOOP__1:

	LA	 1, STANDARD.CLI.TO_UPPER_L3.R_disp
	LD 1,	IL7_disp
	DUP
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.FST_1
	SUB
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	ULB
	LI	97
	CGE
	LI	122
	LA	 1, STANDARD.CLI.TO_UPPER_L3.R_disp
	LD 1,	IL7_disp
	DUP
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.FST_1
	SUB
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	ULB
	CGE
	ET
	BF	L9
	LA	 1, STANDARD.CLI.TO_UPPER_L3.R_disp
	LD 1,	IL7_disp
	DUP
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.FST_1
	SUB
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	LA	 1, STANDARD.CLI.TO_UPPER_L3.R_disp
	LD 1,	IL7_disp
	DUP
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.FST_1
	SUB
	LID	1, STANDARD.CLI.TO_UPPER_L3.R__u, STANDARD._STRING.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	ULB
	LI	32
	SUB
	SB
	BRA	L8
L9:
L8:
	LD  1,	IL7_disp
	LD  1,	LMT_IL7_disp
	CEQ
	BT	L6
	LD  1,	IL7_disp
	INC
	SD  1,	IL7_disp
	BRA	LOOP__1
L6:
	LVA 1,	R_disp
VAR	RET_INFO_L10, Q
	DUP
	LA  ,  0
	SIQ   1, -result__ofs,  0
	DUP
	LA  ,  8
	SA   1, RET_INFO_L10
	DROP
	LA   1, -result__ofs
	LA  ,  8
	LI	16
	LA   1, RET_INFO_L10
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO
