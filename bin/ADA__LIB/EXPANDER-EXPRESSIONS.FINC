  VAR _LST_1, D
end namespace
	LVA 4, ANON_8277_40_info.SIZ__
	SA  4, ANON_8277_40__u
	LVA 4, ANON_8277_40_disp
VAR	ANON_8277_52_disp, Q
VAR	ANON_8277_52__u,    Q
VAR	ANON_8277_52__dat, STANDARD.IDL._TREE.size
	LVA 4, ANON_8277_52__dat
	SA  4, ANON_8277_52_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  4, ANON_8277_52__u
	LVA 4, ANON_8277_52_disp

	LVA 4,	TYPE_NAME_disp
	LI  13
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL. ,PRINT_NAME_L25
	DUP
	LA
	SA	4, TARGET_TYPE_STR_disp
	LA , 8
	SA	4, TARGET_TYPE_STR__u

 hexa_show ' disp ', TARGET_TYPE_STR_disp

