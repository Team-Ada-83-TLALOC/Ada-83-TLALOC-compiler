if defined GCD_L8084_
PRO	GCD_L8084
 hexa_show 'GCD_L8084 ', $
PRMS
	PRM A_ofs
	PRM B_ofs
	PRM result__ofs
endPRMS
ELB 2
 hexa_show 'var elab X ', $
VAR X_disp, Q
	LQ  2,	-A_ofs
	ABS
	SQ  2,	X_disp

 hexa_show ' disp ', X_disp
 hexa_show 'var elab Y ', $
VAR Y_disp, Q
	LQ  2,	-B_ofs
	ABS
	SQ  2,	Y_disp

 hexa_show ' disp ', Y_disp
 hexa_show 'var elab T ', $
VAR T_disp, Q

 hexa_show ' disp ', T_disp

begin:
LOOP__298:
	LQ 2,	Y_disp
	LI	0
	CNE
	BF	L8087
	LQ 2,	Y_disp
	SQ  2,	T_disp
	LQ 2,	X_disp
	LQ 2,	Y_disp
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	SQ  2,	Y_disp
	LQ 2,	T_disp
	SQ  2,	X_disp
	BRA	LOOP__298
L8087:
	LQ 2,	X_disp
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

