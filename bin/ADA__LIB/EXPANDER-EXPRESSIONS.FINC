	SD  2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3645.NB_DIMS_disp
	LVA 3,	FST_disp
	LA
	LI	STANDARD.IDL._TREE.size
