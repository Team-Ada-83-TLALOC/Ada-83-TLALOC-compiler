	LD	1, STANDARD.EXPANDER_L1.UTILS.CUR_LEVEL_disp
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.EXPANDER_L1.UTILS. ,IMAGE_L39
	DUP
	LA
	SA	2, LVL_disp
	LA , 8
	SA	2, LVL__u

 hexa_show ' disp ', LVL_disp
 hexa_show 'var elab IDX_S ', $
VAR IDX_S_disp, Q
VAR IDX_S__u, Q
VAR IDX_S__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	2, IDX_S__dat
	SA	2, IDX_S_disp
	LVA	2, STANDARD.IDL._SEQ_TYPE.SIZ__
	SA	2, IDX_S__u
	LA  2, IDX_S_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_10023_26_disp, Q
VAR	ANON_10023_26__u,    Q
VAR	ANON_10023_26__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 2, ANON_10023_26__dat
	SA  2, ANON_10023_26_disp
	LA  0, STANDARD.IDL._SEQ_TYPE.use__info
	SA  2, ANON_10023_26__u
	LVA 2, ANON_10023_26_disp

