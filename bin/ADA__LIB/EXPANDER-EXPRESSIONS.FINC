 hexa_show 'var elab TYPE_NAME ', $
VAR TYPE_NAME_disp, Q
VAR TYPE_NAME__u, Q
VAR TYPE_NAME__dat, STANDARD.IDL._TREE.size
	LVA	4, TYPE_NAME__dat
	SA	4, TYPE_NAME_disp
	LVA	4, STANDARD.IDL._TREE.SIZ__
	SA	4, TYPE_NAME__u
	LA  4, TYPE_NAME_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_8276_25_disp, Q
VAR	ANON_8276_25__u,    Q
VAR	ANON_8276_25__dat, STANDARD.IDL._TREE.size
	LVA 4, ANON_8276_25__dat
	SA  4, ANON_8276_25_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  4, ANON_8276_25__u
	LVA 4, ANON_8276_25_disp

	LVA 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_CONVERSION_L96.TARGET_TYPE_disp
	LI  35
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV

 hexa_show ' disp ', TYPE_NAME_disp
 hexa_show 'var elab TARGET_TYPE_STR ', $
VAR TARGET_TYPE_STR_disp, Q
VAR TARGET_TYPE_STR__u, Q
	LA 0, STANDARD._STRING.use__info
	SA	4, TARGET_TYPE_STR__u
VAR	ANON_8277_40_disp, Q
VAR	ANON_8277_40__u,   Q
namespace ANON_8277_40_info
