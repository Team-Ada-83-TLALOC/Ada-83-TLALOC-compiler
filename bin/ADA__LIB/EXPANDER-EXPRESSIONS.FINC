	SA	2, IDX_disp
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, IDX__u
	LA  2, IDX_disp
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

