begin:

	LA  3,	-RNG_ofs
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	BF	L4154
STR STR_L4155, "; CODE_ARRAY_AGGREGATE : range de dimension absente"
	LCA	STR_L4155.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L4153
L4154:
L4153:

	LD 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104.NB_DIMS_disp
	LD 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104.MAX_DIMS_disp
	CEQ
	BF	L4157
STR STR_L4158, "; CODE_ARRAY_AGGREGATE : plus de 8 dimensions"
	LCA	STR_L4158.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L4156
L4157:
L4156:
	LD 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104.NB_DIMS_disp
	LI	1
	ADD
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104.NB_DIMS_disp
	LVA 3,	FST_disp
	LA
	LI	STANDARD.IDL._TREE.size
