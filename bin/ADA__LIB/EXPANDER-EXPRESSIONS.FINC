ELB 3
 hexa_show 'var elab CUMUL ', $
VAR CUMUL_disp, D
	LI	0
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  3,	CUMUL_disp

