VAR	ANON_5590_14__u,    Q
VAR	ANON_5590_14__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_5590_14__dat
	SA  3, ANON_5590_14_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  3, ANON_5590_14__u
	LVA 3, ANON_5590_14_disp

	LA  3,	-RNG_ofs
	LI  50
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV
	LVA 3,	LST_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_5591_14_disp, Q
