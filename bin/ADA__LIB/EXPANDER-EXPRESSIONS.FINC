	LA
	BLKMOV
	LA	 2, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104.DIM_TBL_disp
	LD 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104.NB_DIMS_disp
	DUP
	LID	2, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104.DIM_TBL__u, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104._DIM_TBL__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	2, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104.DIM_TBL__u, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104._DIM_TBL__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	2, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104.DIM_TBL__u, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104._DIM_TBL__type.FST_1
	SUB
	LID	2, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104.DIM_TBL__u, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L4104._DIM_TBL__type.COMP_SIZ
	LI	3
