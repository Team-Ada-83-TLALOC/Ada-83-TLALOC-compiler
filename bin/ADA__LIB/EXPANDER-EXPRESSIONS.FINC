VAR ID_S__u, Q
VAR ID_S__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	4, ID_S__dat
	SA	4, ID_S_disp
	LVA	4, STANDARD.IDL._SEQ_TYPE.SIZ__
	SA	4, ID_S__u

 hexa_show ' disp ', ID_S_disp
