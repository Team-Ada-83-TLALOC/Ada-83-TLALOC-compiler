 hexa_show 'var elab TROU ', $
VAR TROU_disp, B
	LI	0
	SB  3,	TROU_disp

 hexa_show ' disp ', TROU_disp
 hexa_show 'var elab OK ', $
VAR OK_disp, B
	LI	1
	SB  3,	OK_disp

 hexa_show ' disp ', OK_disp
 hexa_show 'var elab DECL_S ', $
VAR DECL_S_disp, Q
VAR DECL_S__u, Q
VAR DECL_S__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	3, DECL_S__dat
	SA	3, DECL_S_disp
	LVA	3, STANDARD.IDL._SEQ_TYPE.SIZ__
	SA	3, DECL_S__u

 hexa_show ' disp ', DECL_S_disp
 hexa_show 'var elab DECL ', $
VAR DECL_disp, Q
VAR DECL__u, Q
VAR DECL__dat, STANDARD.IDL._TREE.size
	LVA	3, DECL__dat
	SA	3, DECL_disp
	LVA	3, STANDARD.IDL._TREE.SIZ__
	SA	3, DECL__u
	LA  3, DECL_disp
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', DECL_disp

