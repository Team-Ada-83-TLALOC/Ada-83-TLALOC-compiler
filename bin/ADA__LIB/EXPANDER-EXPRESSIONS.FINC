VAR ID_disp, Q
VAR ID__u, Q
VAR ID__dat, STANDARD.IDL._TREE.size
	LVA	4, ID__dat
	SA	4, ID_disp
	LVA	4, STANDARD.IDL._TREE.SIZ__
	SA	4, ID__u
	LA  4, ID_disp
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', ID_disp

if defined CMP_CHAMP_L3202_
PRO	CMP_CHAMP_L3202
 hexa_show 'CMP_CHAMP_L3202 ', $
PRMS
	PRM COMP_ID_ofs
endPRMS
