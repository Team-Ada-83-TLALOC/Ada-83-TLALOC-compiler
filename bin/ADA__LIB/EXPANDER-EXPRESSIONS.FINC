if defined OFS_BORNE_L6553_
PRO	OFS_BORNE_L6553
 hexa_show 'OFS_BORNE_L6553 ', $
PRMS
	PRM N_ofs
	PRM K_ofs
	PRM IS_LAST_ofs
	PRM result__ofs
endPRMS
ELB 3
 hexa_show 'var elab OFS ', $
VAR OFS_disp, D

 hexa_show ' disp ', OFS_disp

begin:

	LD  3,	-K_ofs
	LD  3,	-N_ofs
	CEQ
	BF	L6557
	LI	8
	SD  3,	OFS_disp
	BRA	L6556
L6557:
	LI	20
	LI	12
	LD  3,	-N_ofs
	LI	1
	SUB
	LD  3,	-K_ofs
	SUB
	MUL
	ADD
	SD  3,	OFS_disp
L6556:

	ULB  3,	-IS_LAST_ofs
	BF	L6559
	LD 3,	OFS_disp
	LI	4
	ADD
	SD  3,	OFS_disp
	BRA	L6558
L6559:
L6558:
	LD 3,	OFS_disp
	SQ  3,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 3
	RTD	prm_siz-8
excep:
endPRO
end if

