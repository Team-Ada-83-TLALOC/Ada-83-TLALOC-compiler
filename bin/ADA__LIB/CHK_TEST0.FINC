if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
display 'including withed unit TEXT_IO.FINC', 10
end if
if ~ definite IO_EXCEPTIONS
include 'IO_EXCEPTIONS.FINC'
display 'including trans withed unit IO_EXCEPTIONS.FINC', 10
end if
if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
display 'including trans withed unit TEXT_IO.FINC', 10
end if
CHK_TEST0 = 'CHK_TEST0'
PRO	CHK_TEST0_L1
 hexa_show 'CHK_TEST0_L1 ', $
ELB 1
_SMALL = '_SMALL'
namespace _SMALL
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR FST, D
VAR LST, D
	LI	32
	SD	1, SIZ__
	LI	1
	SD	1, FST
	LI	10
	SD	1, LST
VAR PARENT__u, Q
	LA	0, STANDARD._INTEGER.use__info
	SA	1, PARENT__u
end namespace
_UPPER = '_UPPER'
namespace _UPPER
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR FST, B
VAR LST, B
	LI	8
	SD	1, SIZ__
	LI	65
	SB	1, FST
	LI	90
	SB	1, LST
VAR PARENT__u, Q
	LA 0	, STANDARD._CHARACTER.use__info
	SA	1, PARENT__u
end namespace
 hexa_show 'var elab S ', $
VAR S_disp, D
	LI	5
	DUP
	LD	1, _SMALL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	1, _SMALL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	S_disp

 hexa_show ' disp ', S_disp
 hexa_show 'var elab C ', $
VAR C_disp, B
	LI	65
	DUP
	ULB	1, _UPPER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULB	1, _UPPER.LST
	CGT
	BT	STANDARD.ce_raise_
	SB  1,	C_disp

 hexa_show ' disp ', C_disp
 hexa_show 'var elab I ', $
VAR I_disp, D
	LI	7
	SD  1,	I_disp

 hexa_show ' disp ', I_disp
 hexa_show 'var elab NEGV ', $
VAR NEGV_disp, D
	LI	3
	NEG
	SD  1,	NEGV_disp

 hexa_show ' disp ', NEGV_disp
 hexa_show 'var elab CH ', $
VAR CH_disp, B
	LI	113
	SB  1,	CH_disp

 hexa_show ' disp ', CH_disp

begin:
	LD 1,	I_disp
	DUP
	LD	1, _SMALL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	1, _SMALL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	S_disp
STR STR_L4, "CHK_TEST0 1 OK affectation dans les bornes"
	LCA	STR_L4.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
namespace	BLOCK__1
ELB 2

begin:
VAR	exc_ctx_L5, q, 10
	LA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	SA  2,	exc_ctx_L5
	LCA	L5
	SA  2,	exc_ctx_L5 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  2,	exc_ctx_L5
	LVA  2,	exc_ctx_L5
	SA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	LD 1,	STANDARD.CHK_TEST0_L1.NEGV_disp
	DUP
	LD	1, STANDARD.CHK_TEST0_L1._SMALL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	1, STANDARD.CHK_TEST0_L1._SMALL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.CHK_TEST0_L1.S_disp
STR STR_L7, "CHK_TEST0 2 KO pas de levee"
	LCA	STR_L7.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LA 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	LA , 0
	SA 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	BRA	L6
L5:
	LA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	SA  2,	exc_ctx_L5
	LA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.CONSTRAINT_ERROR__exc.data_ptr
	CEQ
	BT	L9
	BRA	L10
L9:
STR STR_L11, "CHK_TEST0 2 OK CONSTRAINT_ERROR rattrapee (borne basse, negatif)"
	LCA	STR_L11.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L8
L10:
	BRA	STANDARD.exc_raise_
L8:
L6:
	UNLINKR 2
endPRO
namespace	BLOCK__2
ELB 2

begin:
VAR	exc_ctx_L12, q, 10
	LA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	SA  2,	exc_ctx_L12
	LCA	L12
	SA  2,	exc_ctx_L12 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  2,	exc_ctx_L12
	LVA  2,	exc_ctx_L12
	SA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	LD 1,	STANDARD.CHK_TEST0_L1.I_disp
	LD 1,	STANDARD.CHK_TEST0_L1.I_disp
	ADD
	DUP
	LD	1, STANDARD.CHK_TEST0_L1._SMALL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	1, STANDARD.CHK_TEST0_L1._SMALL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.CHK_TEST0_L1.S_disp
STR STR_L14, "CHK_TEST0 3 KO pas de levee"
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LA 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	LA , 0
	SA 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	BRA	L13
L12:
	LA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	SA  2,	exc_ctx_L12
	LA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.CONSTRAINT_ERROR__exc.data_ptr
	CEQ
	BT	L16
	BRA	L17
L16:
STR STR_L18, "CHK_TEST0 3 OK CONSTRAINT_ERROR rattrapee (borne haute)"
	LCA	STR_L18.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L15
L17:
	BRA	STANDARD.exc_raise_
L15:
L13:
	UNLINKR 2
endPRO
namespace	BLOCK__3
ELB 2

begin:
VAR	exc_ctx_L19, q, 10
	LA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	SA  2,	exc_ctx_L19
	LCA	L19
	SA  2,	exc_ctx_L19 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  2,	exc_ctx_L19
	LVA  2,	exc_ctx_L19
	SA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	ULB 1,	STANDARD.CHK_TEST0_L1.CH_disp
	DUP
	ULB	1, STANDARD.CHK_TEST0_L1._UPPER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULB	1, STANDARD.CHK_TEST0_L1._UPPER.LST
	CGT
	BT	STANDARD.ce_raise_
	SB  1,	STANDARD.CHK_TEST0_L1.C_disp
STR STR_L21, "CHK_TEST0 4 KO pas de levee"
	LCA	STR_L21.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LA 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	LA , 0
	SA 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	BRA	L20
L19:
	LA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	SA  2,	exc_ctx_L19
	LA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.CONSTRAINT_ERROR__exc.data_ptr
	CEQ
	BT	L23
	BRA	L24
L23:
STR STR_L25, "CHK_TEST0 4 OK CONSTRAINT_ERROR rattrapee (enumere)"
	LCA	STR_L25.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L22
L24:
	BRA	STANDARD.exc_raise_
L22:
L20:
	UNLINKR 2
endPRO

	LD 1,	S_disp
	LI	7
	CEQ
	BF	L27
STR STR_L28, "CHK_TEST0 5 OK valeur preservee"
	LCA	STR_L28.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L26
L27:
STR STR_L29, "CHK_TEST0 5 KO valeur alteree"
	LCA	STR_L29.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
L26:
STR STR_L30, "CHK_TEST0 6 attendu : EXCEPTION NON RATTRAPEE : CONSTRAINT_ERROR, $? = 1"
	LCA	STR_L30.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LD 1,	NEGV_disp
	DUP
	LD	1, _SMALL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	1, _SMALL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	S_disp
STR STR_L31, "CHK_TEST0 6 KO ligne atteinte apres violation"
	LCA	STR_L31.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
ret_lbl:
	UNLINKR 1
	RTD
excep:
endPRO
