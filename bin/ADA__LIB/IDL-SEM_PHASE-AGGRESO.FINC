begin:
VAR	ANON_135_38_disp, Q
VAR	ANON_135_38__u,    Q
VAR	ANON_135_38__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 2, ANON_135_38__dat
	SA  2, ANON_135_38_disp
	LA  0, STANDARD.IDL._SEQ_TYPE.use__info
	SA  2, ANON_135_38__u
	LVA 2, ANON_135_38_disp

	LA  2,	-ASSOC_S_ofs
	CALL	STANDARD.IDL. ,LIST_L22
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.AGGRESO.SPREAD_ASSOC_S_L149.ASSOC_CURSOR_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.AGGRESO. ,INIT_ASSOC_CURSOR_L1
VAR	IL42_disp, D
	LVA	2, -AGGREGATE_ARRAY_ofs
	LIA	, , 8
	LD	, _AGGREGATE_ARRAY_TYPE.FST_1
	SD  2,	IL42_disp
VAR	LMT_IL42_disp, D
	LVA	2, -AGGREGATE_ARRAY_ofs
