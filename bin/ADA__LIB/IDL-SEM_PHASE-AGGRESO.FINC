	CALL	STANDARD.IDL.SEM_PHASE_L11.AGGRESO. ,ADVANCE_ASSOC_CURSOR_L2
	LVA	2, -AGGREGATE_ARRAY_ofs
	LIA	, , 0
	LD 2,	IL42_disp
	DUP
	LVA	2, -AGGREGATE_ARRAY_ofs
	LIA	, 0,  8
	LD	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._AGGREGATE_ARRAY_TYPE.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LVA	2, -AGGREGATE_ARRAY_ofs
	LIA	, 0,  8
	LD	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._AGGREGATE_ARRAY_TYPE.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LVA	2, -AGGREGATE_ARRAY_ofs
	LIA	, 0,  8
	LD	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._AGGREGATE_ARRAY_TYPE.FST_1
	SUB
	LVA	2, -AGGREGATE_ARRAY_ofs
	LIA	, , 8
	LD	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	LVA	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._AGGREGATE_ITEM_TYPE.FIRST
	LID	2, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.SPREAD_ASSOC_S_L149.ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.FIRST_COUNT
	SD
	LVA	2, -AGGREGATE_ARRAY_ofs
	LIA	, , 0
	LD 2,	IL42_disp
	DUP
	LVA	2, -AGGREGATE_ARRAY_ofs
	LIA	, 0,  8
	LD	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._AGGREGATE_ARRAY_TYPE.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LVA	2, -AGGREGATE_ARRAY_ofs
	LIA	, 0,  8
	LD	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._AGGREGATE_ARRAY_TYPE.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LVA	2, -AGGREGATE_ARRAY_ofs
	LIA	, 0,  8
	LD	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._AGGREGATE_ARRAY_TYPE.FST_1
	SUB
