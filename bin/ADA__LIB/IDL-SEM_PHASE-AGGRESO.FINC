	LIVA 	2, STANDARD.IDL.SEM_PHASE_L14.AGGRESO.COUNT_AGGREGATE_CHOICES_L151.ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L14.AGGRESO._ASSOC_CURSOR_TYPE.ASSOC
