if defined COUNT_AGGREGATE_CHOICES_L148_
PRO	COUNT_AGGREGATE_CHOICES_L148
 hexa_show 'COUNT_AGGREGATE_CHOICES_L148 ', $
PRMS
	PRM ASSOC_S_ofs
	PRM result__ofs
endPRMS
ELB 2
 hexa_show 'var elab ASSOC_CURSOR ', $
VAR ASSOC_CURSOR_disp, Q
VAR ASSOC_CURSOR__u, Q
VAR ASSOC_CURSOR__dat, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.size
	LVA	2, ASSOC_CURSOR__dat
	SA	2, ASSOC_CURSOR_disp
	LVA	2, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.SIZ__
	SA	2, ASSOC_CURSOR__u

 hexa_show ' disp ', ASSOC_CURSOR_disp

begin:
VAR	ANON_116_38_disp, Q
VAR	ANON_116_38__u,    Q
VAR	ANON_116_38__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 2, ANON_116_38__dat
	SA  2, ANON_116_38_disp
	LA  0, STANDARD.IDL._SEQ_TYPE.use__info
	SA  2, ANON_116_38__u
	LVA 2, ANON_116_38_disp

	LA  2,	-ASSOC_S_ofs
	CALL	STANDARD.IDL. ,LIST_L22
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.AGGRESO.COUNT_AGGREGATE_CHOICES_L148.ASSOC_CURSOR_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.AGGRESO. ,INIT_ASSOC_CURSOR_L1
LOOP__1:
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.AGGRESO.COUNT_AGGREGATE_CHOICES_L148.ASSOC_CURSOR_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.AGGRESO. ,ADVANCE_ASSOC_CURSOR_L2
	LIVA 	2, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.COUNT_AGGREGATE_CHOICES_L148.ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.ASSOC
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	BT	L37
	BRA	LOOP__1
L37:
	LID	2, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.COUNT_AGGREGATE_CHOICES_L148.ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.COUNT
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

if defined SPREAD_ASSOC_S_L149_
