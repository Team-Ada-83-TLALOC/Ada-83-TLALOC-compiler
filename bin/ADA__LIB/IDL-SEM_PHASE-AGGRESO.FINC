	LA 2, -ASSOC_CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L14.AGGRESO._ASSOC_CURSOR_TYPE.CHOICE_LIST
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.FIRST
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	LA
	BLKMOV
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.NEXT
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	LA
	BLKMOV
	DROP
	LA 2, -ASSOC_CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L14.AGGRESO._ASSOC_CURSOR_TYPE.COUNT
	LI	0
	SD
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO
end if

