	BRA	LOOP__1
L38:
	LID	2, STANDARD.IDL.SEM_PHASE_L14.AGGRESO.COUNT_AGGREGATE_CHOICES_L151.ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L14.AGGRESO._ASSOC_CURSOR_TYPE.COUNT
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
