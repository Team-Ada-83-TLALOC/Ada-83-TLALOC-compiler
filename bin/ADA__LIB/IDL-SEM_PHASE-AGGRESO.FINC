AGGRESO = 'AGGRESO'
namespace AGGRESO

_ASSOC_CURSOR_TYPE = '_ASSOC_CURSOR_TYPE'
namespace _ASSOC_CURSOR_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, ASSOC_LIST, 	LA 0, STANDARD.IDL._SEQ_TYPE.use__info
USEINFO 1, ASSOC, 	LA 0, STANDARD.IDL._TREE.use__info
USEINFO 1, EXP, 	LA 0, STANDARD.IDL._TREE.use__info
USEINFO 1, CHOICE_LIST, 	LA 0, STANDARD.IDL._SEQ_TYPE.use__info
USEINFO 1, CHOICE, 	LA 0, STANDARD.IDL._TREE.use__info
USEINFO 1, COUNT, 	LA 0, STANDARD._NATURAL.use__info
USEINFO 1, FIRST_COUNT, 	LA 0, STANDARD._POSITIVE.use__info
virtual at 0
STATOFS ASSOC_LIST, 12, 8
STATOFS ASSOC, 4, 8
STATOFS EXP, 4, 8
STATOFS CHOICE_LIST, 12, 8
STATOFS CHOICE, 4, 8
STATOFS COUNT, 4, 4
STATOFS FIRST_COUNT, 4, 4
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace









if defined GET_SUBTYPE_OF_ID_L9_
PRO	GET_SUBTYPE_OF_ID_L9
 hexa_show 'GET_SUBTYPE_OF_ID_L9 ', $
PRMS
	PRM ID_ofs
	PRM result__ofs
endPRMS
ELB 2
 hexa_show 'var elab RESULT ', $
VAR RESULT_disp, Q
VAR RESULT__u, Q
VAR RESULT__dat, STANDARD.IDL._TREE.size
	LVA	2, RESULT__dat
	SA	2, RESULT_disp
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, RESULT__u
	LA  2, RESULT_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_39_22_disp, Q
VAR	ANON_39_22__u,    Q
VAR	ANON_39_22__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_39_22__dat
	SA  2, ANON_39_22_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_39_22__u
	LVA 2, ANON_39_22_disp

	LA  2,	-ID_ofs
	LI  15
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV

 hexa_show ' disp ', RESULT_disp

begin:

	LA	2, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.GET_SUBTYPE_OF_ID_L9.RESULT_disp
	LD
	LI	24
	LI	8
	UBFX
	LI	212
	CGE
	LI	213
	LA	2, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.GET_SUBTYPE_OF_ID_L9.RESULT_disp
	LD
	LI	24
	LI	8
	UBFX
	CGE
	ET
	BF	L13
	LVA 2,	RESULT_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_42_17_disp, Q
VAR	ANON_42_17__u,    Q
VAR	ANON_42_17__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_42_17__dat
	SA  2, ANON_42_17_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_42_17__u
	LVA 2, ANON_42_17_disp

	LVA 2,	RESULT_disp
	LI  33
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV
	BRA	L12
L13:
	LA	2, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.GET_SUBTYPE_OF_ID_L9.RESULT_disp
	LD
	LI	24
	LI	8
	UBFX
	LI	214
	CEQ
	DUP
	BF	L15
	DROP
VAR	ANON_43_46_disp, Q
VAR	ANON_43_46__u,    Q
VAR	ANON_43_46__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_43_46__dat
	SA  2, ANON_43_46_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_43_46__u
	LVA 2, ANON_43_46_disp

	LVA 2,	RESULT_disp
	LI  84
	CALL	STANDARD.IDL. ,D_L17
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	LI	1
	OUX
L15:
	BF	L14
	LVA 2,	RESULT_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_44_17_disp, Q
VAR	ANON_44_17__u,    Q
VAR	ANON_44_17__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_44_17__dat
	SA  2, ANON_44_17_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_44_17__u
	LVA 2, ANON_44_17_disp

	LVA 2,	RESULT_disp
	LI  84
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV
	BRA	L12
L14:
L12:
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL._TREE.size
	LVA 2,	RESULT_disp
	LA
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

if defined INIT_ASSOC_CURSOR_L1_
PRO	INIT_ASSOC_CURSOR_L1
 hexa_show 'INIT_ASSOC_CURSOR_L1 ', $
PRMS
	PRM ASSOC_CURSOR_ofs
	PRM ASSOC_LIST_ofs
endPRMS
ELB 2

begin:
	LA 2, -ASSOC_CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.ASSOC_LIST
	LI	STANDARD.IDL._SEQ_TYPE.size
	LA  2,	-ASSOC_LIST_ofs
	LA
	BLKMOV
	LA 2, -ASSOC_CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.CHOICE_LIST
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.FIRST
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	LA
	BLKMOV
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.NEXT
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	LA
	BLKMOV
	DROP
	LA 2, -ASSOC_CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.COUNT
	LI	0
	SD
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO
end if

