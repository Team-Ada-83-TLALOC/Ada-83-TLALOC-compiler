	LA 1, _GA_ACTUAL__type.use__info
	SA	1, GA_ACTUAL__u
	LD	1, _GA_ACTUAL__type.SIZ__
	LI	8
	DIV
	CO_VAR
	SA	1, GA_ACTUAL_disp

 hexa_show ' disp ', GA_ACTUAL_disp
 hexa_show 'var elab GA_COUNT ', $
VAR GA_COUNT_disp, D
	LI	0
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.EXPANDER_L1.UTILS.GA_COUNT_disp

 hexa_show ' disp ', GA_COUNT_disp

if defined TROU_L2_
PRO	TROU_L2
 hexa_show 'TROU_L2 ', $
PRMS
	PRM SITE_ofs
	PRM NOEUD_ofs
endPRMS
ELB 2

if defined MSG_L1_
PRO	MSG_L1
 hexa_show 'MSG_L1 ', $
PRMS
	PRM result__ofs
endPRMS
ELB 3

begin:

	LA  2,	-NOEUD_ofs
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	BF	L5
