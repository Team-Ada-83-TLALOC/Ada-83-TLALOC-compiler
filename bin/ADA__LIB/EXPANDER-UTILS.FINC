if defined EXCEPTION_ID_OF_L36_
PRO	EXCEPTION_ID_OF_L36
 hexa_show 'EXCEPTION_ID_OF_L36 ', $
PRMS
	PRM NAME_ofs
	PRM result__ofs
endPRMS
ELB 2
 hexa_show 'var elab N ', $
VAR N_disp, Q
VAR N__u, Q
VAR N__dat, STANDARD.IDL._TREE.size
	LVA	2, N__dat
	SA	2, N_disp
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, N__u
	LA  2, N_disp
	LI	STANDARD.IDL._TREE.size
	LA  2,	-NAME_ofs
	LA
	BLKMOV

 hexa_show ' disp ', N_disp
 hexa_show 'var elab RESULT ', $
VAR RESULT_disp, Q
VAR RESULT__u, Q
VAR RESULT__dat, STANDARD.IDL._TREE.size
	LVA	2, RESULT__dat
	SA	2, RESULT_disp
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, RESULT__u
	LA  2, RESULT_disp
	LI	STANDARD.IDL._TREE.size
	LA  2,	-NAME_ofs
	LA
	BLKMOV

 hexa_show ' disp ', RESULT_disp

