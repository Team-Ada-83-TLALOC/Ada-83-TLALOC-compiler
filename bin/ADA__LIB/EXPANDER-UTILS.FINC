UTILS = 'UTILS'
namespace UTILS

 hexa_show 'var elab INT_LABEL ', $
VAR INT_LABEL_disp, D
	LI	1
	DUP
	ULD	1, STANDARD.EXPANDER_L1.UTILS._LABEL_TYPE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	1, STANDARD.EXPANDER_L1.UTILS._LABEL_TYPE.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.EXPANDER_L1.UTILS.INT_LABEL_disp

 hexa_show ' disp ', INT_LABEL_disp
 hexa_show 'var elab FS ', $
VAR FS_disp, Q
VAR FS__u, Q
VAR FS__dat, STANDARD.TEXT_IO._FILE_TYPE.size
	LVA	1, FS__dat
	SA	1, FS_disp
	LVA	1, STANDARD.TEXT_IO._FILE_TYPE.SIZ__
	SA	1, FS__u
	LIVA 1, FS_disp, STANDARD.TEXT_IO._FILE_TYPE.ID
	LI	1
	NEG
	SD
	LIVA 1, FS_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_OPENED
	LI	0
	SB
	LIVA 1, FS_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE_LENGTH
	ULD 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	DUP
	ULD	0, STANDARD.TEXT_IO._COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	SD
	LIVA 1, FS_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE_LENGTH
	ULD 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	DUP
	ULD	0, STANDARD.TEXT_IO._COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	SD
	LIVA 1, FS_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE
	LI	1
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	SD
	LIVA 1, FS_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE
	LI	1
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	SD
	LIVA 1, FS_disp, STANDARD.TEXT_IO._FILE_TYPE.COL
	LI	1
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	SD
	LIVA 1, FS_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_DEFAULT_IO
	LI	0
	SB
	LIVA 1, FS_disp, STANDARD.TEXT_IO._FILE_TYPE.LOOK_AHEAD
	LI	 0
	SB
	LIVA 1, FS_disp, STANDARD.TEXT_IO._FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	SB
	LIVA 1, FS_disp, STANDARD.TEXT_IO._FILE_TYPE.AT_END_OF_FILE
	LI	0
	SB

 hexa_show ' disp ', FS_disp
 hexa_show 'var elab GA_NAME ', $
_GA_NAME__type = '_GA_NAME__type'
namespace _GA_NAME__type
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	256
	SD	1, _COMP_SIZ
	LD	1, _COMP_SIZ
	LI	1
	SD	1, _FST_1
	LI	8
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR GA_NAME_disp, Q
VAR GA_NAME__u, Q
	LA 1, _GA_NAME__type.use__info
	SA	1, GA_NAME__u
	LD	1, _GA_NAME__type.SIZ__
	LI	8
	DIV
	CO_VAR
	SA	1, GA_NAME_disp

