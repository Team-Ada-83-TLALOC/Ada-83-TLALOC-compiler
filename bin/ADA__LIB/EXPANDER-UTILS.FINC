	LA  ,  0
	SIQ   3, -result__ofs,  0
	DUP
	LA  ,  8
	SA   3, RET_INFO_L7
	DROP
	LA   3, -result__ofs
	LA  ,  8
	LI	16
	LA   3, RET_INFO_L7
	BLKMOV
	BRA ret_lbl
	BRA	L4
L5:
