UTILS = 'UTILS'
namespace UTILS

 hexa_show 'var elab INT_LABEL ', $
VAR INT_LABEL_disp, D
	LI	1
	DUP
	ULD	1, STANDARD.EXPANDER_L1.UTILS._LABEL_TYPE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	1, STANDARD.EXPANDER_L1.UTILS._LABEL_TYPE.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.EXPANDER_L1.UTILS.INT_LABEL_disp

 hexa_show ' disp ', INT_LABEL_disp
 hexa_show 'var elab FS ', $
VAR FS_disp, Q
VAR FS__u, Q
VAR FS__dat, STANDARD.TEXT_IO._FILE_TYPE.size
	LVA	1, FS__dat
	SA	1, FS_disp
	LVA	1, STANDARD.TEXT_IO._FILE_TYPE.SIZ__
	SA	1, FS__u
	LIVA 1, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.ID
	LI	1
	NEG
	SD
	LIVA 1, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_OPENED
	LI	0
	SB
	LIVA 1, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE_LENGTH
	ULD 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	DUP
	ULD	0, STANDARD.TEXT_IO._COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	SD
	LIVA 1, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE_LENGTH
	ULD 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	DUP
	ULD	0, STANDARD.TEXT_IO._COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	SD
	LIVA 1, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE
	LI	1
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	SD
	LIVA 1, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE
	LI	1
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	SD
	LIVA 1, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.COL
	LI	1
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	SD
	LIVA 1, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_DEFAULT_IO
