ATT_WALK = 'ATT_WALK'
namespace ATT_WALK




if defined PRINT_TREE_L3_
PRO	PRINT_TREE_L3
 hexa_show 'PRINT_TREE_L3 ', $
PRMS
	PRM T_ofs
endPRMS
ELB 2

begin:

	LA 2, -T_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	LI	219
	CEQ
	BF	L7
VAR	ANON_32_29_disp, Q
VAR	ANON_32_29__u,    Q
VAR	ANON_32_29__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_32_29__dat
	SA  2, ANON_32_29_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_32_29__u
	LVA 2, ANON_32_29_disp

	LA  2,	-T_ofs
	LI  160
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.PRINT_NOD. ,PRINT_TREE_L32
	LI	47
	CALL	STANDARD.TEXT_IO. ,PUT_L52
VAR	ANON_34_29_disp, Q
VAR	ANON_34_29__u,    Q
VAR	ANON_34_29__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_34_29__dat
	SA  2, ANON_34_29_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_34_29__u
	LVA 2, ANON_34_29_disp

	LA  2,	-T_ofs
	LI  161
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.PRINT_NOD. ,PRINT_TREE_L32
	BRA	L6
L7:
	LA  2,	-T_ofs
	CALL	STANDARD.IDL.PRINT_NOD. ,PRINT_TREE_L32
L6:
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO
end if

if defined U_REAL_L8_
PRO	U_REAL_L8
 hexa_show 'U_REAL_L8 ', $
PRMS
	PRM NUMER_ofs
	PRM DENOM_ofs
	PRM result__ofs
endPRMS
ELB 2
 hexa_show 'var elab REAL ', $
VAR REAL_disp, Q
VAR REAL__u, Q
VAR REAL__dat, STANDARD.IDL._TREE.size
	LVA	2, REAL__dat
	SA	2, REAL_disp
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, REAL__u
	LA  2, REAL_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_42_20_disp, Q
VAR	ANON_42_20__u,    Q
VAR	ANON_42_20__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_42_20__dat
	SA  2, ANON_42_20_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_42_20__u
	LVA 2, ANON_42_20_disp

	LI  219
	CALL	STANDARD.IDL. ,MAKE_L15
	LA
	BLKMOV

 hexa_show ' disp ', REAL_disp

begin:
VAR	ANON_44_24_disp, Q
VAR	ANON_44_24__u,    Q
VAR	ANON_44_24__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_44_24__dat
	SA  2, ANON_44_24_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_44_24__u
	LVA 2, ANON_44_24_disp

	LD  2,	-NUMER_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.UARITH. ,U_VAL_L21
	LVA 2,	REAL_disp
	LI  160
	CALL	STANDARD.IDL. ,D_L16
VAR	ANON_45_24_disp, Q
VAR	ANON_45_24__u,    Q
VAR	ANON_45_24__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_45_24__dat
	SA  2, ANON_45_24_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_45_24__u
	LVA 2, ANON_45_24_disp

	LI	1
	CALL	STANDARD.IDL.SEM_PHASE_L11.UARITH. ,U_VAL_L21
	LVA 2,	REAL_disp
	LI  161
	CALL	STANDARD.IDL. ,D_L16
	LVA 2,	REAL_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_46_13_L11_disp, Q
VAR	ANON_46_13_L11__u,    Q
VAR	ANON_46_13_L11__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_46_13_L11__dat
	SA  2, ANON_46_13_L11_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_46_13_L11__u
	LVA 2, ANON_46_13_L11_disp

VAR	ANON_46_20_disp, Q
VAR	ANON_46_20__u,    Q
VAR	ANON_46_20__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_46_20__dat
	SA  2, ANON_46_20_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_46_20__u
	LVA 2, ANON_46_20_disp

	LD  2,	-DENOM_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.UARITH. ,U_VAL_L21
	LVA 2,	REAL_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.UARITH. ,_DIV__L44
	LA
	BLKMOV
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL._TREE.size
	LVA 2,	REAL_disp
	LA
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

if defined _LT__L12_
