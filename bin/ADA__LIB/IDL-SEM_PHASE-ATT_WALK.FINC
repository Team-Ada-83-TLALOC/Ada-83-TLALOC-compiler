	SQ  2, POWX_L43
	LI	0
	LQ  2, POWN_L42
	LQ  2, POWX_L43
	CALL	STANDARD. ,INTEGER_POW_L63
	CALL	STANDARD.IDL.SEM_PHASE_L11.ATT_WALK. ,U_REAL_L8
	LVA 2,	TEMP_disp
