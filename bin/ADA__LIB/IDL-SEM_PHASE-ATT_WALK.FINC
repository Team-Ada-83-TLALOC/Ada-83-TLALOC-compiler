if defined PRINT_TREE_L3_
PRO	PRINT_TREE_L3
 hexa_show 'PRINT_TREE_L3 ', $
PRMS
	PRM T_ofs
endPRMS
ELB 2

begin:

	LA 2, -T_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	LI	219
	CEQ
	BF	L7
VAR	ANON_32_29_disp, Q
VAR	ANON_32_29__u,    Q
VAR	ANON_32_29__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_32_29__dat
	SA  2, ANON_32_29_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_32_29__u
	LVA 2, ANON_32_29_disp

	LA  2,	-T_ofs
	LI  160
	CALL	STANDARD.IDL. ,D_L22
	CALL	STANDARD.IDL.PRINT_NOD. ,PRINT_TREE_L37
	LI	47
	CALL	STANDARD.TEXT_IO. ,PUT_L52
VAR	ANON_34_29_disp, Q
VAR	ANON_34_29__u,    Q
VAR	ANON_34_29__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_34_29__dat
	SA  2, ANON_34_29_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_34_29__u
	LVA 2, ANON_34_29_disp

	LA  2,	-T_ofs
	LI  161
	CALL	STANDARD.IDL. ,D_L22
	CALL	STANDARD.IDL.PRINT_NOD. ,PRINT_TREE_L37
	BRA	L6
L7:
	LA  2,	-T_ofs
	CALL	STANDARD.IDL.PRINT_NOD. ,PRINT_TREE_L37
L6:
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO
end if

