	LA  2,	-TYPE_SPEC_ofs
	LI  33
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV
	BRA ret_lbl
	BRA	L21
L22:
	LA 2, -TYPE_SPEC_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	LI	214
	CEQ
	DUP
	BF	L25
