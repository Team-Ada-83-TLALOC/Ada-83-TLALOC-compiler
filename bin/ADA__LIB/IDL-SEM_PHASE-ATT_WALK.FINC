if defined GET_APPROPRIATE_BASE_L26_
PRO	GET_APPROPRIATE_BASE_L26
 hexa_show 'GET_APPROPRIATE_BASE_L26 ', $
PRMS
	PRM TYPE_SPEC_ofs
	PRM result__ofs
endPRMS
ELB 2
 hexa_show 'var elab BASE_TYPE ', $
VAR BASE_TYPE_disp, Q
VAR BASE_TYPE__u, Q
VAR BASE_TYPE__dat, STANDARD.IDL._TREE.size
	LVA	2, BASE_TYPE__dat
	SA	2, BASE_TYPE_disp
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, BASE_TYPE__u
	LA  2, BASE_TYPE_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_75_25_disp, Q
VAR	ANON_75_25__u,    Q
VAR	ANON_75_25__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_75_25__dat
