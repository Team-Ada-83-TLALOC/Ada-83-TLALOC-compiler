	LA  2,	-TYPE_SPEC_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,GET_BASE_TYPE_L71
	LA
	BLKMOV

 hexa_show ' disp ', BASE_TYPE_disp

begin:

	LA	2, STANDARD.IDL.SEM_PHASE_L11.ATT_WALK.GET_APPROPRIATE_BASE_L26.BASE_TYPE_disp
	LD
	LI	24
	LI	8
	UBFX
	LI	208
	CEQ
	BF	L30
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL._TREE.size
VAR	ANON_78_14_disp, Q
VAR	ANON_78_14__u,    Q
