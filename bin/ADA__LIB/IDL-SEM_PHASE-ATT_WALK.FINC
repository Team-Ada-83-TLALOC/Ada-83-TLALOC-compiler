if defined BITS_IN_INTEGER_PART_L31_
PRO	BITS_IN_INTEGER_PART_L31
 hexa_show 'BITS_IN_INTEGER_PART_L31 ', $
PRMS
	PRM REAL_ofs
	PRM result__ofs
endPRMS
ELB 2
 hexa_show 'var elab TEMP ', $
VAR TEMP_disp, Q
VAR TEMP__u, Q
VAR TEMP__dat, STANDARD.IDL._TREE.size
	LVA	2, TEMP__dat
	SA	2, TEMP_disp
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, TEMP__u
	LA  2, TEMP_disp
	LI	STANDARD.IDL._TREE.size
	LA  2,	-REAL_ofs
	LA
	BLKMOV

 hexa_show ' disp ', TEMP_disp
 hexa_show 'var elab RESULT ', $
VAR RESULT_disp, D
	LI	0
	SD  2,	RESULT_disp

 hexa_show ' disp ', RESULT_disp

begin:
LOOP__1:
	LI	0
VAR	ANON_88_18_disp, Q
VAR	ANON_88_18__u,    Q
VAR	ANON_88_18__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_88_18__dat
	SA  2, ANON_88_18_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_88_18__u
	LVA 2, ANON_88_18_disp

	LI	1
	LI	2
	LI	14
	DEC
	SHL
	CALL	STANDARD.IDL.SEM_PHASE_L11.ATT_WALK. ,U_REAL_L8
	LVA 2,	TEMP_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.ATT_WALK. ,_GT__L15
	BF	L34
	LVA 2,	TEMP_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_89_17_L35_disp, Q
VAR	ANON_89_17_L35__u,    Q
VAR	ANON_89_17_L35__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_89_17_L35__dat
	SA  2, ANON_89_17_L35_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_89_17_L35__u
	LVA 2, ANON_89_17_L35_disp

VAR	ANON_89_24_disp, Q
VAR	ANON_89_24__u,    Q
VAR	ANON_89_24__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_89_24__dat
	SA  2, ANON_89_24_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_89_24__u
	LVA 2, ANON_89_24_disp

	LI	2
	LI	14
	DEC
	SHL
	CALL	STANDARD.IDL.SEM_PHASE_L11.UARITH. ,U_VAL_L21
	LVA 2,	TEMP_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.UARITH. ,_DIV__L44
	LA
	BLKMOV
	LD 2,	RESULT_disp
	LI	14
	ADD
	SD  2,	RESULT_disp
	BRA	LOOP__1
L34:
LOOP__2:
	LI	0
VAR	ANON_92_18_disp, Q
VAR	ANON_92_18__u,    Q
VAR	ANON_92_18__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_92_18__dat
	SA  2, ANON_92_18_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_92_18__u
	LVA 2, ANON_92_18_disp

	LI	1
	LI	1
	CALL	STANDARD.IDL.SEM_PHASE_L11.ATT_WALK. ,U_REAL_L8
	LVA 2,	TEMP_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.ATT_WALK. ,_GT__L15
	BF	L36
	LVA 2,	TEMP_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_93_17_L37_disp, Q
VAR	ANON_93_17_L37__u,    Q
VAR	ANON_93_17_L37__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_93_17_L37__dat
	SA  2, ANON_93_17_L37_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_93_17_L37__u
	LVA 2, ANON_93_17_L37_disp

VAR	ANON_93_24_disp, Q
VAR	ANON_93_24__u,    Q
VAR	ANON_93_24__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_93_24__dat
	SA  2, ANON_93_24_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_93_24__u
	LVA 2, ANON_93_24_disp

	LI	2
	CALL	STANDARD.IDL.SEM_PHASE_L11.UARITH. ,U_VAL_L21
	LVA 2,	TEMP_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.UARITH. ,_DIV__L44
	LA
	BLKMOV
	LD 2,	RESULT_disp
	LI	1
	ADD
	SD  2,	RESULT_disp
	BRA	LOOP__2
L36:
	LD 2,	RESULT_disp
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

