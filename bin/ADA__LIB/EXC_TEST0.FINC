EXC_TEST0 = 'EXC_TEST0'
PRO	EXC_TEST0_L1
 hexa_show 'EXC_TEST0_L1 ', $
ELB 1
STR MON_ERREUR__exc, "MON_ERREUR"

if defined LEVE_L2_
PRO	LEVE_L2
 hexa_show 'LEVE_L2 ', $
ELB 2

begin:
	LCA	STANDARD.EXC_TEST0_L1.MON_ERREUR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
ret_lbl:
	UNLINKR 2
	RTD
excep:
endPRO
end if

begin:
namespace	BLOCK__1
ELB 2

begin:
VAR	exc_ctx_L7, q, 10
	LA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	SA  2,	exc_ctx_L7
	LCA	L7
	SA  2,	exc_ctx_L7 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  2,	exc_ctx_L7
	LVA  2,	exc_ctx_L7
	SA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	LCA	STANDARD.EXC_TEST0_L1.MON_ERREUR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	LA 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	LA , 0
	SA 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	BRA	L8
L7:
	LA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	SA  2,	exc_ctx_L7
	LA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.EXC_TEST0_L1.MON_ERREUR__exc.data_ptr
	CEQ
	BT	L10
	BRA	L11
L10:
	BRA	L9
L11:
	BRA	STANDARD.exc_raise_
L9:
L8:
	UNLINKR 2
endPRO
namespace	BLOCK__2
ELB 2

begin:
VAR	exc_ctx_L12, q, 10
	LA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	SA  2,	exc_ctx_L12
	LCA	L12
	SA  2,	exc_ctx_L12 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  2,	exc_ctx_L12
	LVA  2,	exc_ctx_L12
	SA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	CALL	STANDARD.EXC_TEST0_L1. ,LEVE_L2
	LA 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	LA , 0
	SA 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	BRA	L13
L12:
	LA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	SA  2,	exc_ctx_L12
	LA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.CONSTRAINT_ERROR__exc.data_ptr
	CEQ
	BT	L15
	BRA	L16
L15:
	BRA	L14
L16:
	BRA	L14
L14:
L13:
	UNLINKR 2
endPRO
ret_lbl:
	UNLINKR 1
	RTD
excep:
endPRO
