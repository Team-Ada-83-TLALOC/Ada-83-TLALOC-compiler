ELB 3
_OP_CLASS = '_OP_CLASS'
namespace _OP_CLASS
VAR use__info, Q
VAR SIZ__, D
	LVA	3, SIZ__
	SA	3, use__info
VAR FST, B
VAR LST, B
	LI	8
	SD	3, SIZ__
	LI	0
	SB	3, FST
	LI	20
	SB	3, LST
VAR PARENT__u, Q
	LA 3	, STANDARD.IDL.SEM_PHASE_L11.FIX_WITH.FIX_WITH_CLAUSES_L49.ADD_BLTN_IDS_TO_TABLE_L11._OP_CLASS.use__info
	SA	3, PARENT__u
