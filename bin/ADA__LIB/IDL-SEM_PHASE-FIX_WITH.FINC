begin:
LOOP__1:
	LI	0
	LVA 3,	ID_LIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L14
	LVA  3,	STANDARD.IDL.SEM_PHASE_L11.FIX_WITH.FIX_WITH_CLAUSES_L49.ADD_BLTN_IDS_TO_TABLE_L11.ID_disp
	LVA  3,	STANDARD.IDL.SEM_PHASE_L11.FIX_WITH.FIX_WITH_CLAUSES_L49.ADD_BLTN_IDS_TO_TABLE_L11.ID_LIST_disp
	CALL	STANDARD.IDL. ,POP_L24

	LA	3, STANDARD.IDL.SEM_PHASE_L11.FIX_WITH.FIX_WITH_CLAUSES_L49.ADD_BLTN_IDS_TO_TABLE_L11.ID_disp
	LD
	LI	24
	LI	8
	UBFX
	LI	40
	CEQ
	BF	L16
	LVA 3,	SYMREP_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_82_12_disp, Q
VAR	ANON_82_12__u,    Q
VAR	ANON_82_12__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_82_12__dat
	SA  3, ANON_82_12_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  3, ANON_82_12__u
	LVA 3, ANON_82_12_disp

	LVA 3,	ID_disp
	LI  13
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV

	LA	3, STANDARD.IDL.SEM_PHASE_L11.FIX_WITH.FIX_WITH_CLAUSES_L49.ADD_BLTN_IDS_TO_TABLE_L11.SYMREP_disp
	LD
	LI	24
	LI	8
	UBFX
	LI	1
	CEQ
	BF	L18
	LVA 3,	SYMREP_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_84_14_disp, Q
VAR	ANON_84_14__u,    Q
VAR	ANON_84_14__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_84_14__dat
	SA  3, ANON_84_14_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  3, ANON_84_14__u
	LVA 3, ANON_84_14_disp

VAR	ANON_84_26_disp, Q
VAR	ANON_84_26__u,   Q
namespace ANON_84_26_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
	LVA 3, ANON_84_26_info.SIZ__
	SA  3, ANON_84_26__u
	LVA 3, ANON_84_26_disp
	LVA 3,	SYMREP_disp
	CALL	STANDARD.IDL. ,PRINT_NAME_L25
	CALL	STANDARD.IDL.IDL_MAN. ,STORE_SYM_L40
	LA
	BLKMOV

	LVA 3,	SYMREP_disp
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	LI	1
	OUX
	BF	L20
	LVA 3,	SYMREP_disp
	LVA 3,	ID_disp
	LI  13
	CALL	STANDARD.IDL. ,D_L16
	BRA	L19
L20:
L19:
	BRA	L17
L18:
L17:

	LVA 3,	SYMREP_disp
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	LI	1
	OUX
	BF	L22
	LA	 1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY_disp
	LI	0
	LVA 3,	ID_disp
	LI  152
	CALL	STANDARD.IDL. ,DI_L21
	DUP
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.FST_1
	SUB
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.COMP_SIZ
	LI	3
	SAR
	MUL
	ADD
	LI	STANDARD.IDL._TREE.size
	LVA 3,	ID_disp
	LA
	BLKMOV
	BRA	L21
L22:
L21:
	BRA	L15
L16:
L15:
	BRA	LOOP__1
L14:
ret_lbl:
	UNLINKR 3
	RTD	prm_siz
excep:
endPRO
end if

