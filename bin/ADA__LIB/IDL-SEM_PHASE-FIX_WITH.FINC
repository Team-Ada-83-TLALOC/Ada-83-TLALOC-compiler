FIX_WITH = 'FIX_WITH'
namespace FIX_WITH


if defined STORE_SYM_L1_
PRO	STORE_SYM_L1
 hexa_show 'STORE_SYM_L1 ', $
PRMS
	PRM TXTREP_ofs
	PRM result__ofs
endPRMS
ELB 2

begin:
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL._TREE.size
VAR	ANON_21_17_disp, Q
VAR	ANON_21_17__u,    Q
VAR	ANON_21_17__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_21_17__dat
	SA  2, ANON_21_17_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_21_17__u
	LVA 2, ANON_21_17_disp

VAR	ANON_21_29_disp, Q
VAR	ANON_21_29__u,   Q
namespace ANON_21_29_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
	LVA 2, ANON_21_29_info.SIZ__
	SA  2, ANON_21_29__u
	LVA 2, ANON_21_29_disp
	LA  2,	-TXTREP_ofs
	CALL	STANDARD.IDL. ,PRINT_NAME_L25
	CALL	STANDARD.IDL.IDL_MAN. ,STORE_SYM_L40
	LA
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

if defined MAKE_DEF_FOR_ID_L4_
PRO	MAKE_DEF_FOR_ID_L4
 hexa_show 'MAKE_DEF_FOR_ID_L4 ', $
PRMS
	PRM ID_ofs
	PRM REGION_DEF_ofs
	PRM IN_SPEC_ofs
	PRM result__ofs
endPRMS
ELB 2
 hexa_show 'var elab H ', $
VAR H_disp, Q
VAR H__u, Q
VAR H__dat, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.size
	LVA	2, H__dat
	SA	2, H_disp
	LVA	2, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.SIZ__
	SA	2, H__u
	LA 2, H_disp
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.REGION_DEF
	LI	STANDARD.IDL._TREE.size
	LA  2,	-REGION_DEF_ofs
	LA
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.LEX_LEVEL
	LI	0
	SD
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.IS_IN_SPEC
	ULB  2,	-IN_SPEC_ofs
	SB
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.IS_IN_BODY
	LI	0
	SB
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.SUBP_SYMREP
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.RETURN_TYPE
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.ENCLOSING_LOOP_ID
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	BLKMOV
	DROP

 hexa_show ' disp ', H_disp

begin:

	LA  2,	-REGION_DEF_ofs
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	LI	1
	OUX
	BF	L8
	LIVA 	2, STANDARD.IDL.SEM_PHASE_L11.FIX_WITH.MAKE_DEF_FOR_ID_L4.H_disp, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.LEX_LEVEL
	LI	0
	LA  2,	-REGION_DEF_ofs
	LI  171
	CALL	STANDARD.IDL. ,DI_L21
	SD
	BRA	L7
L8:
L7:

VAR	ANON_44_14_disp, Q
VAR	ANON_44_14__u,    Q
VAR	ANON_44_14__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_44_14__dat
	SA  2, ANON_44_14_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_44_14__u
	LVA 2, ANON_44_14_disp

	LA  2,	-ID_ofs
	LI  13
	CALL	STANDARD.IDL. ,D_L17
	LA
	LD
	LI	24
	LI	8
	UBFX
	LI	1
	CEQ
	BF	L10
VAR	ANON_45_21_disp, Q
VAR	ANON_45_21__u,    Q
VAR	ANON_45_21__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_45_21__dat
	SA  2, ANON_45_21_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_45_21__u
	LVA 2, ANON_45_21_disp

VAR	ANON_45_32_disp, Q
VAR	ANON_45_32__u,    Q
VAR	ANON_45_32__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_45_32__dat
	SA  2, ANON_45_32_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_45_32__u
	LVA 2, ANON_45_32_disp

	LA  2,	-ID_ofs
	LI  13
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.SEM_PHASE_L11.FIX_WITH. ,STORE_SYM_L1
	LA  2,	-ID_ofs
	LI  13
	CALL	STANDARD.IDL. ,D_L16
	BRA	L9
L10:
L9:
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL._TREE.size
VAR	ANON_48_17_disp, Q
VAR	ANON_48_17__u,    Q
VAR	ANON_48_17__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_48_17__dat
	SA  2, ANON_48_17_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_48_17__u
	LVA 2, ANON_48_17_disp

	LVA 2,	H_disp
	LA  2,	-ID_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,MAKE_DEF_FOR_ID_L52
	LA
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
end if

