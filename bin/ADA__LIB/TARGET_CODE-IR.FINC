STATOFS MNEMO, 8, 8
STATOFS SCOPE, 4, 4
STATOFS LAZY, 8, 8
STATOFS FIRST_OP, 4, 4
STATOFS LAST_OP, 4, 4
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace
