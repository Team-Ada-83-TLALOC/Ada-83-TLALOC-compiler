STR ANON_60_15_L13_G, "TARGET_CODE.IR : "
	LCA	ANON_60_15_L13_G.data_ptr
	SA  2, ANON_60_15_L13_G_data
	LA  2,	-MSG_ofs
	SA  2, ANON_60_37_L13_D_data
	LVA 2, ANON_60_15_L13_R_info.SIZ__
	SA  2, ANON_60_15_L13_R__u
	LVA 2, ANON_60_15_L13_R_disp
	LA  2, ANON_60_37_L13_D_data
	LA  2, ANON_60_15_L13_G_data
