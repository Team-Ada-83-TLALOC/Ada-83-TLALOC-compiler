_ASM_OPCODE = '_ASM_OPCODE'
namespace _ASM_OPCODE
VAR use__info, Q
BEGIN_BLOC_DEF
db 0, 2, "ET"
db 1, 2, "OU"
db 2, 3, "NON"
db 3, 3, "OUX"
db 4, 7, "SYSCALL"
db 5, 17, "SYS_CLOCK_GETTIME"
db 6, 12, "SYS_PUT_CHAR"
db 7, 11, "SYS_PUT_STR"
db 8, 12, "SYS_GET_CHAR"
db 9, 11, "SYS_GET_STR"
db 10, 15, "SYS_FILE_CREATE"
db 11, 13, "SYS_FILE_OPEN"
