_ASM_OP_0 = '_ASM_OP_0'
namespace _ASM_OP_0
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
USEINFO 0, OPCODE, 	LA 0, STANDARD.MACHINE_CODE._ASM_OPCODE_0.use__info
virtual at 0
STATOFS OPCODE, 1, 1
size = $
end virtual
	LI	 size*8
	SD	0, SIZ__
end namespace
_ASM_OP_1 = '_ASM_OP_1'
namespace _ASM_OP_1
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
