db 13, 16, "SYS_FILE_GET_POS"
db 14, 17, "SYS_FILE_GET_SIZE"
db 15, 14, "SYS_FILE_WRITE"
db 16, 13, "SYS_FILE_READ"
db 17, 14, "SYS_FILE_CLOSE"
db 18, 15, "SYS_FILE_DELETE"
db 19, 2, "DB"
db 20, 2, "LI"
db 21, 3, "LIF"
db 22, 3, "LCA"
db 23, 4, "LINK"
db 24, 6, "UNLINK"
db 25, 3, "LVA"
db 26, 2, "LB"
db 27, 2, "LW"
db 28, 2, "LD"
db 29, 2, "LQ"
db 30, 2, "LA"
db 31, 2, "SB"
