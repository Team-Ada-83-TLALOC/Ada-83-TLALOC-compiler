db 40, 3, "LIA"
db 41, 3, "SIB"
db 42, 3, "SIW"
db 43, 3, "SID"
db 44, 3, "SIQ"
db 45, 3, "SIA"
END_BLOC_DEF 8, 0, 45

	LCA	SIZ
	SA	0, use__info
end namespace
_ASM_OPCODE_0 = '_ASM_OPCODE_0'
namespace _ASM_OPCODE_0
