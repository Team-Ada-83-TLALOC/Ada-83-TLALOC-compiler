	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,IS_SAME_PARAMETER_PROFILE_L64
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO
