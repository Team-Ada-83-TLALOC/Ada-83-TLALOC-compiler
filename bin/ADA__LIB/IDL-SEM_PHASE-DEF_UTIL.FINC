	ULB 2,	KIND_1_disp
	ULB	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_SUBP_ENTRY_HEADER.FST
	CGE
	ULB	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_SUBP_ENTRY_HEADER.LST
	ULB 2,	KIND_1_disp
	CGE
	ET
	LI	1
	OUX
	DUP
	BT	L6
	DROP
	LA  2,	-PARAM_S_2_ofs
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
L6:
	BF	L5
	LI	1
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L4
L5:
L4:

	ULB 2,	KIND_1_disp
	LI	165
	CEQ
	LA  2,	-RESULT_TYPE_2_ofs
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	LI	1
	OUX
	OUX
	BF	L8
	LI	0
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L7
L8:
L7:

	ULB 2,	KIND_1_disp
	LI	165
	CEQ
	BF	L10

VAR	ANON_36_10_disp, Q
VAR	ANON_36_10__u,    Q
VAR	ANON_36_10__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_36_10__dat
	SA  2, ANON_36_10_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_36_10__u
	LVA 2, ANON_36_10_disp

VAR	ANON_36_25_disp, Q
VAR	ANON_36_25__u,    Q
VAR	ANON_36_25__dat, STANDARD.IDL._TREE.size
