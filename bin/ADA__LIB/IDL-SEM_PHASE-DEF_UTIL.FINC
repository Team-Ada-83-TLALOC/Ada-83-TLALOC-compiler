	LI  48
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,GET_BASE_TYPE_L71
	LA
	LD
VAR	ANON_36_53_disp, Q
VAR	ANON_36_53__u,    Q
VAR	ANON_36_53__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_36_53__dat
	SA  2, ANON_36_53_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_36_53__u
	LVA 2, ANON_36_53_disp

	LA  2,	-RESULT_TYPE_2_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,GET_BASE_TYPE_L71
	LA
	LD
	CEQ
	LI	1
	OUX
	BF	L12
	LI	0
	SQ  2,	-result__ofs
	BRA ret_lbl
	BRA	L11
L12:
L11:
	BRA	L9
L10:
L9:
	LI	0
	LA  2,	-PARAM_S_2_ofs
VAR	ANON_41_39_disp, Q
VAR	ANON_41_39__u,    Q
VAR	ANON_41_39__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_41_39__dat
	SA  2, ANON_41_39_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_41_39__u
