	LA  2,	-ID_ofs
	LVA 2,	DEF_disp
	LI  35
	CALL	STANDARD.IDL. ,D_L16
	VAR SELARG_L19_disp, q
	VAR SELARG_L19__u, q
	LA 2, -H_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.REGION_DEF
	SA	2, SELARG_L19_disp
	LA 0, STANDARD.IDL._TREE.use__info
	SA	2, SELARG_L19__u
	LVA 2, SELARG_L19_disp
	LVA 2,	DEF_disp
	LI  169
	CALL	STANDARD.IDL. ,D_L16
	LA 2, -H_ofs
	ULIB	, 0, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.IS_IN_SPEC
	LVA 2,	DEF_disp
	LI  170
	CALL	STANDARD.IDL. ,DB_L18
	LI  0
	LVA 2,	DEF_disp
	LI  172
	CALL	STANDARD.IDL. ,DB_L18
	LI	0
	LVA 2,	DEF_disp
	LI  171
	CALL	STANDARD.IDL. ,DI_L20
