if defined HEADER_IS_HOMOGRAPH_L1_
PRO	HEADER_IS_HOMOGRAPH_L1
 hexa_show 'HEADER_IS_HOMOGRAPH_L1 ', $
PRMS
	PRM HEADER_1_ofs
	PRM PARAM_S_2_ofs
	PRM RESULT_TYPE_2_ofs
	PRM result__ofs
endPRMS
ELB 2
 hexa_show 'var elab KIND_1 ', $
VAR KIND_1_disp, B
	LA 2, -HEADER_1_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	SB  2,	KIND_1_disp

 hexa_show ' disp ', KIND_1_disp

