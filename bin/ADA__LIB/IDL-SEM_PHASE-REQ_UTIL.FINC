end if

begin:
	LA  2,	-DEFSET_ofs
	LA  2,	-EXP_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.REQ_UTIL.REQUIRE_FUNCTION_OR_ENUMERATION_DEF_L146. ,N_REQUIRE_FUNCTION_OR_ENUMERATION_DEF_L293
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO
end if
begin:
end namespace 
