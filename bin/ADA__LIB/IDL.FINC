if defined OPEN_IDL_TREE_FILE_L9_
PRO	OPEN_IDL_TREE_FILE_L9
 hexa_show 'OPEN_IDL_TREE_FILE_L9 ', $
PRMS
	PRM PAGE_FILE_NAME_ofs
endPRMS
ELB 1

begin:
	LA  1,	-PAGE_FILE_NAME_ofs
	CALL	STANDARD.IDL.PAGE_MAN. ,OPEN_PAGE_MANAGER_L19
namespace	BLOCK__9
ELB 2

begin:
VAR	exc_ctx_L116, q, 10
	LA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	SA  2,	exc_ctx_L116
	LCA	L116
	SA  2,	exc_ctx_L116 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  2,	exc_ctx_L116
	LVA  2,	exc_ctx_L116
	SA	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
STR STR_L118, "diana"
	LCA	STR_L118.data_ptr
	CALL	STANDARD.IDL.IDL_TBL. ,READ_SPEC_L61
	LA 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	LA , 0
	SA 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	BRA	L117
L116:
	LA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	SA  2,	exc_ctx_L116
	LA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.IO_EXCEPTIONS.NAME_ERROR__exc.data_ptr
	CEQ
	BT	L120
	BRA	L121
L120:
STR STR_L122, "diana.bin FILE MISSING"
	LCA	STR_L122.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L119
L121:
	BRA	STANDARD.exc_raise_
L119:
L117:
	UNLINKR 2
endPRO
ret_lbl:
	UNLINKR 1
	RTD	prm_siz
excep:
endPRO
end if

