begin:
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE.EVAL_EXP_TYPES_L215.IS_SUBTYPE_disp
	LA  2,	-TYPESET_ofs
	LA  2,	-EXP_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE. ,EVAL_EXP_SUBTYPE_TYPES_L216

	ULB 2,	IS_SUBTYPE_disp
	BF	L16
STR STR_L17, "EXPRESSION (NOT SUBTYPE) REQUIRED"
	LCA	STR_L17.data_ptr
VAR	ANON_86_14_disp, Q
VAR	ANON_86_14__u,    Q
VAR	ANON_86_14__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_86_14__dat
	SA  2, ANON_86_14_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_86_14__u
	LVA 2, ANON_86_14_disp

	LA  2,	-EXP_ofs
	LI  154
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.IDL_MAN. ,ERROR_L45
	LA  2,	-TYPESET_ofs
	LA
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.size
