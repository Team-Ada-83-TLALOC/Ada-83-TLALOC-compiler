	LA  2, TYPE_SPEC_disp
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', TYPE_SPEC_disp

begin:
LOOP__1:
	LI	0
	LVA 2,	TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,IS_EMPTY_L74
	LI	1
	OUX
	BF	L4
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE.REDUCE_EXP_TYPES_L1.DEFINTERP_disp
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE.REDUCE_EXP_TYPES_L1.TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,POP_L75
	LVA 2,	TYPE_SPEC_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_34_20_disp, Q
VAR	ANON_34_20__u,    Q
VAR	ANON_34_20__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_34_20__dat
	SA  2, ANON_34_20_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_34_20__u
	LVA 2, ANON_34_20_disp

VAR	ANON_34_38_disp, Q
VAR	ANON_34_38__u,    Q
VAR	ANON_34_38__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_34_38__dat
	SA  2, ANON_34_38_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_34_38__u
	LVA 2, ANON_34_38_disp

	LVA 2,	DEFINTERP_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,GET_DEF_L82
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,GET_DEF_EXP_TYPE_L70
	LA
	BLKMOV

	LVA 2,	TYPE_SPEC_disp
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	LI	1
	OUX
	BF	L6
VAR	ANON_37_49_disp, Q
VAR	ANON_37_49__u,    Q
VAR	ANON_37_49__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
	LVA 2, ANON_37_49__dat
	SA  2, ANON_37_49_disp
	LA  1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.use__info
	SA  2, ANON_37_49__u
	LVA 2, ANON_37_49_disp

	LVA 2,	DEFINTERP_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,GET_EXTRAINFO_L84
	LVA 2,	TYPE_SPEC_disp
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE.REDUCE_EXP_TYPES_L1.NEW_TYPESET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,ADD_TO_TYPESET_L92
	BRA	L5
L6:
L5:
	BRA	LOOP__1
L4:
	LA  2,	-TYPESET_ofs
	LA
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.size
	LVA 2,	NEW_TYPESET_disp
	LA
	BLKMOV
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO
end if

