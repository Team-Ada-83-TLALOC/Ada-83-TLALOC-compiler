;-----------------------------------------------------------------------------------------------------------------------
;		C O D I   H X  --  T L A L O C   A D A   H A R D W A R E   E X E C U T O R
;
;	Codi BINAIRE EXACT de la machine TAHX, selon LLIR_hardware_support (V3). Derive de codi_TX :
;	memes noms de macros, memes parametres, donc les .FINC et .FAS du front end s'assemblent
;	sans modification.
;
;	ENCODAGE
;	  - opcode sur 1 octet, puis complement de 0 a 8 octets ; la longueur ne depend que de
;	    l'opcode (invariant de decodage) ;
;	  - complement range OCTET DE POIDS FORT EN TETE, dans l'ordre de la notation des formats :
;	    le champ lvl occupe ainsi toujours les bits 7..4 de l'octet qui suit l'opcode ;
;	  - format minimal : FMT 00 si lvl = -1 et disp (et ofs) nuls, sinon B16/C24, puis B24/C32 ;
;	  - LI : imm4 non signe (0..15), puis D8, D16, D32, D64 etendus en signe ;
;	  - branches BRA/BT/BF : BR8..BR32 recalcules a chaque passe depuis BR8 (pas de memoire
;	    par branche, cf. HX_BRANCHE) ;
;	  - CALL D24, RTD D24 ou RTD 0, TRAP/UNLINK/UNLINKR D8, EXC_RAISE D24, UBFXI.. D8_8 ;
;	  - replis des champs trop etroits (ofs > 255) : sequences de LLIR_hardware_support.
;
;	IMAGE
;	  0x400000       en-tete de 0x78 octets, celui des images TX de format 3, signature 'TLALOCHX'
;	  0x400078       point d'entree, puis code et donnees statiques melanges comme en x86
;	  fin            table des instructions (un dd par instruction HX, adresse relative a 0x400000 ;
;	                 bit 31 SUITE : l'instruction prolonge l'instruction LLIR precedente (repli,
;	                 SYS_EXIT, sequence CHK) ; bit 30 VIDE : reserve, plus produit (LVA -1,0
;	                 n'est emis par aucun codi))
;	                 facultative : HX_SANS_TABLE = 1 avant l'include du codi la supprime (l'image
;	                 ne contient alors que code et donnees, comme pour la machine reelle ; en-tete
;	                 +56 et +64 a zero ; l'executeur ne peut plus verifier les debuts d'instruction)
;	Les donnees en ligne (images d'enumeres) restent protegees par BRA.
;
;	L'initialisation machine (piles, display, co-pile, tas) est faite par l'executeur.
;
;		fasmg PROG.HXFAS PROG.hx      puis      tx_run PROG.hx
;-----------------------------------------------------------------------------------------------------------------------

postpone						; sera fait en toute toute fin car c'est le premier postpone
  ASM_SIZE = $-0x400078
end postpone

;	Table des instructions : adresse (relative a 0x400000) de chaque instruction HX, dans
;	l'ordre du code. La machine l'ignore ; l'executeur s'en sert pour separer instructions et
;	donnees en ligne et pour verifier que tout PC atteint est un debut d'instruction (en HX,
;	l'octet 0 est un opcode valide : ET). Ce postpone s'execute juste avant le precedent.
virtual at 0
  HX_TABLE::
end virtual
if definite HX_SANS_TABLE
postpone
  HX_TABLE_ADR = 0
  HX_TABLE_NB = 0
end postpone
else
postpone
  db ((8 - ($ and 7)) and 7) dup 0
  HX_TABLE_ADR = $
  virtual HX_TABLE
    HX_TABLE_TAILLE = $ - $$
  end virtual
  HX_TABLE_NB = HX_TABLE_TAILLE / 4
  repeat HX_TABLE_NB / 2, k:0
    load HX_Mot_Table : 8 from HX_TABLE : k * 8
    dq HX_Mot_Table
  end repeat
  if HX_TABLE_NB mod 2
    load HX_Mot_Table : 4 from HX_TABLE : HX_TABLE_TAILLE - 4
    dd HX_Mot_Table
  end if
end postpone
end if

macro show description, value				; pour debogage
  repeat 1, d:value
    display description,`d,13,10
  end repeat
end macro

macro hexa_show description, value			; adresse hexa pour la carto de debogage
  local x, digit
  x = value
  display description, '0', 'x'
  repeat 16, n:0
    digit = (x shr ((15 - n) shl 2)) and 0Fh
    if digit < 10
      display '0' + digit
    else
      display 'A' + digit - 10
    end if
  end repeat
  display 13, 10
end macro
;			-------------------------------------------------------------------
;			.......
macro			align_b?
;			.......
end macro

;			.......
macro			align_w?
;			.......
  desalign = $ mod 2
  if desalign <> 0
    repeat 2-desalign
      db 0x90
    end repeat
  end if
end macro

;			.......
macro			align_d?
;			.......
  desalign = $ mod 4
  if desalign <> 0
    repeat 4-desalign
      db 0x90
    end repeat
  end if
end macro

;			.......
macro			align_q?
;			.......
  desalign = $ mod 8
  if desalign <> 0
    repeat 8-desalign
      db 0x90
    end repeat
  end if
end macro


;			----------------------
macro			PRO	sub_name_lbl			; Debut de procedure declaree
;			----------------------
  namespace sub_name_lbl						; definir son espace de noms
  BRA post							; contournement de l'elaboration autour de la procedure
end macro

;			----
macro			PRMS					; En tete de la definition des parametres
;			----
  virtual at 8							; La pile de travail croit vers les adresses hautes, les parametres sont au dessus du FP dynamique
    PRMzone::							; donc 8 octets (adresses 64 bits) au dessus du FP
  end virtual

end macro

;			------------------
macro			PRM	name_ofs				; Definition d'un parametre
;			------------------
  virtual PRMzone
    name_ofs = $
    dq ?
  end virtual

end macro

;			-------
macro			endPRMS					; Fin de la definition des parametres adjust = 8 pour fonction
;			-------
  virtual PRMzone
    prm_siz = $-8							; Calcul de la taille du parametrage
  end virtual

end macro

;			-------------
macro			ELB	lvl				; En tete de la partie elaboration de procedure
;			-------------
elab:
  virtual at 8							; Commence 8 octets apres le FP dynamique
    VARzone::
  end virtual
	LINK lvl, loc_siz

end macro

;			--------------
macro			BEGIN_BLOC_DEF				; Debut du bloc d'images d'un enumere
;			--------------
;	Donnees inline protegees par BRA (pattern des thunks LD_/ST_, sain
;	sous "if defined"). Macros ordinaires, noms FIXES : la paire vit dans
;	le namespace _TYPE de l'enumere, unicite garantie par construction.
;	Ni struc coupee, ni postpone, ni "!", ni local inter-macros.
  BRA	IMAGES.skip
IMAGES.data = $							; les db d'images suivent, inline
end macro

;			---------------------------------
macro			END_BLOC_DEF	siz, fst, lst		; Fin : pose le ENUM_USE_INFO etendu
;			---------------------------------
;	CONTRAT (record ENUM_USE_INFO du prelude + doublet images) :
;	  SIZ @0 (dd) | FST @+4 | LST @+8 | pad | data_ptr @+16 | info_ptr @+24
;	  use__info pointe SIZ ; TEXT_IO (GET_ENUM_IMAGES) lit le doublet a __u+16.
IMAGES.data_end = $							; fin des octets d'images (avant info/scalaires)
  align_q
IMAGES.info = $
	dd 8*(IMAGES.data_end - IMAGES.data), 8, 1, IMAGES.data_end - IMAGES.data
SIZ = $
	dd siz
FST = $
	dd fst
LST = $
	dd lst
	dd 0
IMAGES.data_ptr = $
	dq IMAGES.data
IMAGES.info_ptr = $
	dq IMAGES.info
IMAGES.skip:
end macro

;	Une chaine Ada est un tableau d'octets caracteres, c'est a dire un descripteur [ PTR_TO CHARS qword | CAR_SIZE dword | FIRST dword | LAST dword ]
; et des caracteres qui pointes par PTR_TO_CHARS peuvent etre detaches du descripteur. Ici, cas de constante, les caracteres sont juste apres le descripteur.
;	On décompose en deux parties la constitution d'une chaîne pour pouvoir insérer tous les octets voulus.

;			---------------------
macro			STR	name, bytes			; Definition d'une constante chaine au format d'un tableau de caracteres (pour traitement homogene des chaines)
;			---------------------
;	Une chaine Ada est un tableau d'octets caracteres, c'est a dire un descripteur [ PTR_TO CHARS qword | CAR_SIZE dword | FIRST dword | LAST dword ]
; et des caracteres qui pointes par PTR_TO_CHARS peuvent etre detaches du descripteur. Ici, cas de constante, les caracteres sont juste apres le descripteur.
;
  postpone
    local data
    local info
    local str_bit_size
    align_q							; aligner le descripteur sur un quadword

  namespace name

  data_ptr = $							; adresse de la constante STRING (en fait double pointeur)
    dq	data							; offset 0 : adresse des caracteres (juste apres dans le cas present)
  info_ptr = $							;
    dq	info							; offset 8 : adresse des infos TOT_SIZ, COMP_SIZ, FST_1, LST_1
  info = $							; use info
    dd	str_bit_size, 8, 1, str_bit_size/8				; offset 16 : TOT_SIZ=str_bit_size ; offset 20 :  COMP_SIZ=8bits ; offset	24 : FST=1 ; offset 28 : LST=str_byte_size
    virtual at 0							; definition des offsets sur le useinfo
    SIZ = $
    rd 1
    COMP_SIZ = $
    rd 1
    FST_1 = $
    rd 1
    LST_1 = $
    end virtual
  data = $							; pour une constante les caracteres suivent (pour une chaine variable ce n'est pas le cas, les octets sont dans la co-pile)
    db	bytes
    str_bit_size =  8*($ - data)					; Calculer la longueur effective en bits
  end namespace

  end postpone
end macro

;			-----------------------------------------
macro			CST	name_cst:_nil_, sizChar:b, val&	; Definition d'une constante
;			-----------------------------------------
  postpone
    align_#sizChar							; aligner en fonction de l'unite de reservation
    name_cst = $							;
    d#sizChar val							; reservation
  end postpone
end macro

;			----------------------------------------
macro			USEINFO	lvl, field_name, load_instruc&	; Reference a un __u use info
;			----------------------------------------
  virtual VARzone
    align_q							; aligner en fonction de l'unite de reservation
    field_name#__u = $						; lieu ptr use info
    rq 1
  end virtual
  load_instruc
  SA lvl, field_name#__u
end macro

;			---------------------------
macro			STATOFS	name, siz, algn:0			; Definition de l'offset statique (pour un record statique, dans une virtual at 0)
;			---------------------------
; algn = alignement du COMPOSANT elementaire en octets (1/2/4/8), passe par
; l'expander. algn 0 : compatibilite, ancienne regle par taille totale.
  if algn = 8
    align_q
  else if algn = 4
    align_d
  else if algn = 2
    align_w
  else if algn = 1
								; octets : pas d'alignement
  else								; algn 0 : ancienne regle
    if siz > 4
      align_q
    else if siz > 2
      align_d
    else if siz > 1
      align_w
    end if
  end if
name = $								; nom offset du champ
  rb siz								; reservation
end macro

;			-----------------------------------
macro			VAR	name_disp, sizChar, siz:1		; Definition d'un lieu de variable
;			-----------------------------------
  virtual VARzone
     if `sizChar = 'B'  |  `sizChar = 'b'
      align_b
      name_disp = $							; displacement des data de variable
      rb siz							; reservation
    else if `sizChar = 'W'  |  `sizChar = 'w'
      align_w
      name_disp = $
      rw siz
    else if `sizChar = 'D'  |  `sizChar = 'd'
      align_d
      name_disp = $
      rd siz
    else if `sizChar = 'Q'  |  `sizChar = 'q'
      align_q
      name_disp = $
      rq siz
    else
      align_q							; assurer l'alignement de pile dans tous les cas possibles
      name_disp = $							; displacement des data de variable
      rb sizChar							; taille numerique en octets
    end if
  end virtual
end macro


;			------
macro			endPRO					; Fin de procedure
;			------
post:
  virtual VARzone
    align_q
    loc_siz = $							; Ce n'est que la que l'on calcule la taille des locales qui sera retropropagee au LINK du ELAB
  end virtual
  end namespace
end macro

;-----------------------------------------------------------------------------------------------------------------------
;		O P C O D E S   H X   (LLIR_hardware_support V3, table des opcodes)
;-----------------------------------------------------------------------------------------------------------------------

;	famille A : un octet
HX_ET		= 00h
HX_OU		= 01h
HX_OUX		= 02h
HX_NON		= 03h
HX_SHL		= 04h
HX_SHR		= 05h
HX_SAR		= 06h
HX_CLAMP0	= 07h
HX_NEG		= 08h
HX_CGT		= 09h
HX_CLT		= 0Ah
HX_CNE		= 0Bh
HX_CEQ		= 0Ch
HX_CGE		= 0Dh
HX_CLE		= 0Eh
HX_ABS		= 0Fh
HX_ADD		= 10h
HX_INC		= 11h
HX_SUB		= 12h
HX_DEC		= 13h
HX_MUL		= 14h
HX_DIV		= 15h
HX_REMI		= 16h
HX_MODI		= 17h
HX_UBFX		= 18h
HX_SBFX		= 19h
HX_BFI		= 1Ah
HX_CVTIX	= 1Ch
HX_CVTXI	= 1Dh
HX_FADD		= 20h
HX_FSUB		= 21h
HX_FMUL		= 22h
HX_FDIV		= 23h
HX_FEXP		= 24h
HX_CVTIF	= 25h
HX_CVTFI	= 26h
HX_CVTFIR	= 27h
HX_FNEG		= 28h
HX_FCGT		= 29h
HX_FCLT		= 2Ah
HX_FCNE		= 2Bh
HX_FCEQ		= 2Ch
HX_FCGE		= 2Dh
HX_FCLE		= 2Eh
HX_FABS		= 2Fh
HX_DROP		= 30h
HX_DUP		= 31h
HX_OVER		= 32h
HX_CALLI	= 33h
HX_BLKMOV	= 34h
HX_BLKCMP	= 35h
HX_CO_VAR	= 38h
HX_HEAP_ALLOC	= 39h
HX_BLKAND	= 3Ch
HX_BLKOU	= 3Dh
HX_BLKOUX	= 3Eh
HX_BLKNOT	= 3Fh

;	familles B (01) et C (10) : OP = famille MODE FMT SZ
HX_FAM_B	= 40h
HX_FAM_C	= 80h
HX_MODE_SPEC	= 0			; LINK, EXC_MACH, LVA / LIVA
HX_MODE_LS	= 1			; chargement signe
HX_MODE_ST	= 2			; rangement
HX_MODE_LU	= 3			; chargement non signe
HX_SZ_LINK	= 0
HX_SZ_EXC_MACH	= 1
HX_SZ_VA	= 3			; LVA / LIVA
HX_FMT_00	= 0
HX_FMT_01	= 1			; B16 / C24
HX_FMT_10	= 2			; B24 / C32
HX_FMT_CHK	= 3			; CHK B24 / CHKI C32

;	famille D
HX_LI8		= 0C0h
HX_LI16		= 0C1h
HX_LI32		= 0C2h
HX_LI64		= 0C3h
HX_UBFXI	= 0C4h
HX_SBFXI	= 0C5h
HX_BFII		= 0C6h
HX_LEXCMP	= 0C8h			; + 4 si non signe, + SZ
HX_LI4		= 0D0h			; + imm4 (0..15)
HX_BRA		= 0E0h			; + SZ
HX_BT		= 0E4h
HX_BF		= 0E8h
HX_TRAP		= 0F0h
HX_CALL		= 0F2h
HX_RTD		= 0F6h
HX_RTD0		= 0F7h
HX_UNLINK	= 0F8h
HX_UNLINKR	= 0F9h
HX_EXC_RAISE	= 0FEh
HX_RTX		= 0FFh

;	Services TRAP (numerotation de LLIR_hardware_support)
HX_SYS_EXIT		= 0
HX_SYS_CLOCK_GETTIME	= 1
HX_SYS_PUT_CHAR		= 2
HX_SYS_PUT_STR		= 3
HX_SYS_GET_CHAR		= 4
HX_SYS_GET_STR		= 5
HX_SYS_FILE_CREATE	= 6
HX_SYS_FILE_OPEN	= 7
HX_SYS_FILE_SET_POS	= 8
HX_SYS_FILE_GET_POS	= 9
HX_SYS_FILE_GET_SIZE	= 10
