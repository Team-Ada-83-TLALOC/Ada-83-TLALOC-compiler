HX_SYS_FILE_READ	= 12
HX_SYS_FILE_CLOSE	= 13
HX_SYS_FILE_DELETE	= 14

;-----------------------------------------------------------------------------------------------------------------------
;		E M I S S I O N
;-----------------------------------------------------------------------------------------------------------------------

;	v tient-il dans un champ signe de n bits ?  (resultat dans la constante nommee)
macro HX_TIENT res*, v*, n*
  if (v) >= -(1 shl ((n)-1)) & (v) < (1 shl ((n)-1))
    res = 1
  else
    res = 0
  end if
end macro

;	entree de la table des instructions (appelee depuis les instructions CALM)
HX_DRAPEAU_SUITE = 80000000h
HX_DRAPEAU_VIDE  = 40000000h

;	Groupes : les instructions HX emises pour une seule instruction LLIR (repli, SYS_EXIT,
;	sequence CHK) ; toutes sauf la premiere portent SUITE dans la table. L'etat vit dans
;	une zone virtuelle etiquetee :: , globale par construction (une affectation ordinaire
;	irait dans l'espace de noms courant). +0 profondeur des groupes, +8 premiere emise.
virtual at 0
  HX_ETAT:: dq 0, 0
end virtual
macro HX_GROUPE_DEBUT
  local p
  load p:8 from HX_ETAT:0
  if p = 0
    store 0:8 at HX_ETAT:8
  end if
  store p+1:8 at HX_ETAT:0
end macro
macro HX_GROUPE_FIN
  local p
  load p:8 from HX_ETAT:0
  store p-1:8 at HX_ETAT:0
end macro

if definite HX_SANS_TABLE
  macro HX_TABLE_ENTREE a*
  end macro
  macro HX_TABLE_VIDE a*
  end macro
else
  macro HX_TABLE_ENTREE a*
    local p, e, f
    f = 0
    load p:8 from HX_ETAT:0
    if p > 0
      load e:8 from HX_ETAT:8
      if e
        f = HX_DRAPEAU_SUITE
      else
        store 1:8 at HX_ETAT:8
      end if
    end if
    virtual HX_TABLE
      dd a or f
    end virtual
  end macro
  macro HX_TABLE_VIDE a*
    virtual HX_TABLE
      dd a or HX_DRAPEAU_VIDE
    end virtual
  end macro
end if

;	une instruction : opcode, puis complement de n octets, poids fort en tete
macro HX_INSTR op*, compl:0, n:0
  local adresse
  adresse = $ - 0x400000
  HX_TABLE_ENTREE adresse
  db op
  repeat n, k:0
    db ((compl) shr (8*((n)-1-k))) and 0FFh
  end repeat
end macro

;	LI : format le plus etroit ; la valeur est prise modulo 2^64, puis lue signee
macro HX_LI val*
  local v
  v = (val) and 0FFFFFFFFFFFFFFFFh
  if v >= 8000000000000000h
    v = v - 10000000000000000h
  end if
  if v >= 0 & v <= 15
    HX_INSTR HX_LI4 + v
  else if v >= -80h & v < 80h
    HX_INSTR HX_LI8, v, 1
  else if v >= -8000h & v < 8000h
    HX_INSTR HX_LI16, v, 2
  else if v >= -80000000h & v < 80000000h
    HX_INSTR HX_LI32, v, 4
  else
    HX_INSTR HX_LI64, v, 8
  end if
end macro

;	branche relaxee : BR8..BR32, recalculee a chaque passe depuis BR8.
;	  Cible en arriere : distance exacte (cible deja placee dans cette passe).
;	  Cible en avant : la position predite de la cible inclut la taille qu'avait la branche
;	  a la passe precedente ; la distance est donc d = cible - ($ + taille precedente),
;	  independante de la taille essayee (sinon une branche BR16 a 127 octets de sa cible
;	  se verrait a 128 en BR8 et resterait BR16 : point fixe non minimal).
;	  Debut et fin de la branche sont memorises sous le nom de la CIBLE, avec le rang de la
;	  branche parmi celles qui visent cette cible dans la passe : les symboles locaux ne
;	  conviennent pas, fasmg les retrouve par l'ordre des invocations, que l'assemblage
;	  paresseux des procedures decale. Un rang decale ne fausse qu'une passe.
macro HX_BRANCHE base*, cible*
  local s, d, adresse
  adresse = $ - 0x400000
  HX_TABLE_ENTREE adresse
  s = 1
  HX_CIBLE_SIMPLE = 1						; la memoire par cible exige un nom
  irp op, +,-,*,/,(,)
    match =op, cible
      HX_CIBLE_SIMPLE = 0
    end match
    match any =op more, cible
      HX_CIBLE_SIMPLE = 0
    end match
    match any =op, cible
      HX_CIBLE_SIMPLE = 0
    end match
  end irp
  if defined cible & (cible) <= $
    d = (cible) - ($ + 2)					; en arriere : distance exacte
    if d < -80h
      s = 2
      if d - 1 < -8000h
        s = 3
        if d - 2 < -800000h
          s = 4
        end if
      end if
    end if
  else if HX_CIBLE_SIMPLE = 0					; cible calculee (lbl+k) : sans memoire
    repeat 3
      d = (cible) - ($ + 1 + s)
      if s < 4 & ( d < -(1 shl (8*s-1)) | d >= (1 shl (8*s-1)) )
        s = s + 1
      end if
    end repeat
  else								; en avant (ou cible encore inconnue)
    if definite cible.__hx_n
      cible.__hx_n = cible.__hx_n + 1
    else
      cible.__hx_n = 0
    end if
    repeat 1, r:cible.__hx_n
      if defined cible & defined cible.__hx_deb#r & defined cible.__hx_fin#r
        d = (cible) - ($ + cible.__hx_fin#r - cible.__hx_deb#r)	; taille de la passe precedente
        if d >= 80h
          s = 2
          if d >= 8000h
            s = 3
            if d >= 800000h
              s = 4
            end if
          end if
        end if
      else if defined cible
        repeat 3
          d = (cible) - ($ + 1 + s)
          if s < 4 & ( d < -(1 shl (8*s-1)) | d >= (1 shl (8*s-1)) )
            s = s + 1
          end if
        end repeat
      end if
      cible.__hx_deb#r := $
      cible.__hx_fin#r := $ + 1 + s
    end repeat
  end if
  d = (cible) - ($ + 1 + s)
  assert d >= -80000000h & d < 80000000h
  if s = 1
    db base, d and 0FFh
  else if s = 2
    db base + 1, (d shr 8) and 0FFh, d and 0FFh
  else if s = 3
    db base + 2, (d shr 16) and 0FFh, (d shr 8) and 0FFh, d and 0FFh
  else
    db base + 3, (d shr 24) and 0FFh, (d shr 16) and 0FFh, (d shr 8) and 0FFh, d and 0FFh
  end if
end macro

;	famille B : lvl, disp ; FMT 00 si lvl = -1 et disp = 0
macro HX_B mode*, sz*, lvl*, disp*
  local t12, t20, l
  assert (lvl) >= -1 & (lvl) <= 14
  l = (lvl) and 0Fh
  HX_TIENT t12, disp, 12
  HX_TIENT t20, disp, 20
  if (lvl) = -1 & (disp) = 0
    HX_INSTR HX_FAM_B + (mode) shl 4 + HX_FMT_00 shl 2 + (sz)
  else if t12 = 1
    HX_INSTR HX_FAM_B + (mode) shl 4 + HX_FMT_01 shl 2 + (sz), l shl 12 + (disp) and 0FFFh, 2
  else if t20 = 1
    HX_INSTR HX_FAM_B + (mode) shl 4 + HX_FMT_10 shl 2 + (sz), l shl 20 + (disp) and 0FFFFFh, 3
  else
    err 'HX : deplacement hors du format B24 (cf. LLIR_hardware_support [Q5])'
  end if
end macro

;	famille C, formats directs : FMT 00, C24, C32 (le repli est fait par HX_C)
macro HX_C_DIRECT mode*, sz*, lvl*, disp*, ofs*
  local t16, t20, l
  l = (lvl) and 0Fh
  HX_TIENT t16, disp, 16
  HX_TIENT t20, disp, 20
  if (lvl) = -1 & (disp) = 0 & (ofs) = 0
    if (mode) = HX_MODE_SPEC
      HX_B HX_MODE_LS, 3, -1, 0					; LIVA -1,0,0 = LQ -1,0 (code reserve)
    else
      HX_INSTR HX_FAM_C + (mode) shl 4 + HX_FMT_00 shl 2 + (sz)
    end if
  else if (ofs) >= 0 & (ofs) <= 15 & t16 = 1
    HX_INSTR HX_FAM_C + (mode) shl 4 + HX_FMT_01 shl 2 + (sz), l shl 20 + (ofs) shl 16 + (disp) and 0FFFFh, 3
  else if (ofs) >= 0 & (ofs) <= 255 & t20 = 1
    HX_INSTR HX_FAM_C + (mode) shl 4 + HX_FMT_10 shl 2 + (sz), l shl 28 + (ofs) shl 20 + (disp) and 0FFFFFh, 4
  else
    err 'HX : deplacement ou ofs hors format (cf. LLIR_hardware_support [Q5])'
  end if
end macro

;	famille C : lvl, disp, ofs ; le champ ofs est non signe (0..255) ; hors de 0..255
;	(ofs > 255, ou ofs negatif [Q9]), repli par un acces B dont le disp signe porte ofs :
;	  LIVA, chargements	LIVA lvl,disp,0 ; Lx 1111,ofs
;	  rangement, lvl >= 0	LIVA lvl,disp,0 ; OVER ; Sx 1111,ofs ; DROP
;	  rangement, lvl = -1	OVER ; LIVA 1111,disp,0 ; OVER ; Sx 1111,ofs ; DROP ; DROP
macro HX_C mode*, sz*, lvl*, disp*, ofs*
  local t20, o20
  assert (lvl) >= -1 & (lvl) <= 14
  HX_TIENT t20, disp, 20
  HX_TIENT o20, ofs, 20
  if ((ofs) >= 0 & (ofs) <= 255) | t20 = 0 | o20 = 0
    HX_C_DIRECT mode, sz, lvl, disp, ofs
  else if (mode) <> HX_MODE_ST
    HX_GROUPE_DEBUT
    HX_C_DIRECT HX_MODE_SPEC, HX_SZ_VA, lvl, disp, 0
    HX_B mode, sz, -1, ofs
    HX_GROUPE_FIN
  else if (lvl) <> -1
    HX_GROUPE_DEBUT
    HX_C_DIRECT HX_MODE_SPEC, HX_SZ_VA, lvl, disp, 0
    HX_INSTR HX_OVER
    HX_B mode, sz, -1, ofs
    HX_INSTR HX_DROP
    HX_GROUPE_FIN
  else
    HX_GROUPE_DEBUT
    HX_INSTR HX_OVER
    HX_C_DIRECT HX_MODE_SPEC, HX_SZ_VA, -1, disp, 0
    HX_INSTR HX_OVER
    HX_B mode, sz, -1, ofs
    HX_INSTR HX_DROP
    HX_INSTR HX_DROP
    HX_GROUPE_FIN
  end if
end macro

;-----------------------------------------------------------------------------------------------------------------------
;		A U X I L I A I R E S   x 8 6   N E U T R A L I S E E S   (au cas ou un .FINC les emploierait)
;-----------------------------------------------------------------------------------------------------------------------

macro PUSH_RAX
  err 'PUSH_RAX : macro x86 sans equivalent HX'
end macro
macro POP_RAX
  err 'POP_RAX : macro x86 sans equivalent HX'
end macro

;-----------------------------------------------------------------------------------------------------------------------
;		I N S T R U C T I O N S   L L I R
;-----------------------------------------------------------------------------------------------------------------------

;	Les instructions les plus frequentes (famille A, LI, acces B et C) sont des
;	calminstruction : fasmg les execute sans developpement de texte, deux a trois fois
;	plus vite que des macros imbriquees. Les cas rares (replis, CHK, LINK, branches)
;	restent des macros.

;	--- famille A : operations sans complement
iterate op, DROP, DUP, OVER, ET, OU, OUX, NON, SHL, SHR, SAR, CLAMP0, NEG, ABS, ADD, SUB, INC, DEC, \
	    MUL, DIV, REMI, MODI, UBFX, SBFX, BFI, CVTIX, CVTXI, FADD, FSUB, FMUL, FDIV, FNEG, FABS, FEXP, \
	    CVTIF, CVTFI, CVTFIR, CEQ, CNE, CGT, CGE, CLT, CLE, FCEQ, FCNE, FCGT, FCGE, FCLT, FCLE, \
	    CALLI, CO_VAR, HEAP_ALLOC, BLKMOV, BLKCMP, BLKAND, BLKOU, BLKOUX, BLKNOT
  calminstruction op
    local a
    compute a, $ - 0x400000
    arrange a, =HX_TABLE_ENTREE a
    assemble a
    emit 1, HX_#op
  end calminstruction
end iterate

;	--- immediats et adresses constantes
calminstruction LI val*
  local a, v
  compute v, val
  check v >= -8000000000000000h & v < 8000000000000000h
  jyes dans_intervalle
  err 'LI : immediat hors de [-2^63, 2^63) (LLIR_hardware_support V7)'
 dans_intervalle:
  compute v, (val) and 0FFFFFFFFFFFFFFFFh
  compute a, $ - 0x400000
  arrange a, =HX_TABLE_ENTREE a
  assemble a
  check v >= 8000000000000000h
  jno positif
  compute v, v - 10000000000000000h
 positif:
  check v >= 0 & v <= 15
  jyes imm4
  check v >= -80h & v < 80h
  jyes d8
  check v >= -8000h & v < 8000h
  jyes d16
  check v >= -80000000h & v < 80000000h
  jyes d32
  emit 1, HX_LI64
  emit 1, (v shr 56) and 0FFh
  emit 1, (v shr 48) and 0FFh
  emit 1, (v shr 40) and 0FFh
  emit 1, (v shr 32) and 0FFh
 e32:
  emit 1, (v shr 24) and 0FFh
  emit 1, (v shr 16) and 0FFh
 e16:
  emit 1, (v shr 8) and 0FFh
 e8:
  emit 1, v and 0FFh
  exit
 imm4:
  emit 1, HX_LI4 + v
  exit
 d8:
  emit 1, HX_LI8
  jump e8
 d16:
  emit 1, HX_LI16
  jump e16
 d32:
  emit 1, HX_LI32
  jump e32
end calminstruction
macro LIF val					; motif IEEE 754 double du litteral, puis LI le plus etroit
  local motif, signe
  virtual at 0
    dq val
    load motif : 8 from 0
  end virtual
  if motif >= 8000000000000000h			; motif lu non signe : le ramener dans [-2^63, 2^63)
    signe = motif - 10000000000000000h
  else
    signe = motif
  end if
  LI signe
end macro
macro LCA ptr, disp:0
  LI ptr+disp
end macro
macro LSPA prefix, subname
  if ~ definite prefix#subname#.__appel_postpone		; un seul postpone par procedure et par passe
    prefix#subname#.__appel_postpone = 1			; (leur cout croit comme leur nombre au carre)
    postpone
      if ~definite prefix#subname#_
        prefix#subname#_ = prefix#subname#.elab
      end if
    end postpone
  end if
  LI prefix#subname#_
end macro

;	--- adresses de variables
calminstruction LVA lvl:-1, disp:0			; LVA -1,0 : identite, rien n'est emis (comme en TX et x86)
    local a, l
    compute lvl, lvl
    compute disp, disp
    check lvl >= -1 & lvl <= 14
    jno mauvais_niveau
    compute a, $ - 0x400000
    check lvl = -1 & disp = 0
    jyes vide
    arrange a, =HX_TABLE_ENTREE a
    assemble a
    compute l, lvl and 0Fh
    check disp >= -800h & disp < 800h
    jyes b16
    check disp >= -80000h & disp < 80000h
    jyes b24
    err 'HX : deplacement hors du format B24 (cf. LLIR_hardware_support [Q5])'
    exit
   b16:
    emit 1, HX_FAM_B + HX_MODE_SPEC shl 4 + HX_FMT_01 shl 2 + HX_SZ_VA
    emit 1, l shl 4 + (disp shr 8) and 0Fh
    emit 1, disp and 0FFh
    exit
   b24:
    emit 1, HX_FAM_B + HX_MODE_SPEC shl 4 + HX_FMT_10 shl 2 + HX_SZ_VA
    emit 1, l shl 4 + (disp shr 16) and 0Fh
    emit 1, (disp shr 8) and 0FFh
    emit 1, disp and 0FFh
    exit
   vide:
    exit
   mauvais_niveau:
    err 'HX : lvl hors de -1..14'
end calminstruction

;	--- chargements et rangements : SZ 0 = B, 1 = W, 2 = D, 3 = Q
;	    famille B : FMT 00 si lvl = -1 et disp = 0, sinon B16 (disp 12 bits), sinon B24
iterate <op, mode, sz>, LB,HX_MODE_LS,0, LW,HX_MODE_LS,1, LD,HX_MODE_LS,2, LQ,HX_MODE_LS,3, LA,HX_MODE_LS,3, \
			ULB,HX_MODE_LU,0, ULW,HX_MODE_LU,1, ULD,HX_MODE_LU,2, \
			SB,HX_MODE_ST,0, SW,HX_MODE_ST,1, SD,HX_MODE_ST,2, SQ,HX_MODE_ST,3, SA,HX_MODE_ST,3
  calminstruction op lvl:-1, disp:0
    local a, l
    compute lvl, lvl
    compute disp, disp
    check lvl >= -1 & lvl <= 14
    jno mauvais_niveau
    compute a, $ - 0x400000
    arrange a, =HX_TABLE_ENTREE a
    assemble a
    compute l, lvl and 0Fh
    check lvl = -1 & disp = 0
    jyes f00
    check disp >= -800h & disp < 800h
    jyes b16
    check disp >= -80000h & disp < 80000h
    jyes b24
    err 'HX : deplacement hors du format B24 (cf. LLIR_hardware_support [Q5])'
    exit
   f00:
    emit 1, HX_FAM_B + mode shl 4 + sz
    exit
   b16:
    emit 1, HX_FAM_B + mode shl 4 + HX_FMT_01 shl 2 + sz
    emit 1, l shl 4 + (disp shr 8) and 0Fh
    emit 1, disp and 0FFh
    exit
   b24:
    emit 1, HX_FAM_B + mode shl 4 + HX_FMT_10 shl 2 + sz
    emit 1, l shl 4 + (disp shr 16) and 0Fh
    emit 1, (disp shr 8) and 0FFh
    emit 1, disp and 0FFh
    exit
   mauvais_niveau:
    err 'HX : lvl hors de -1..14'
  end calminstruction
end iterate

;	    famille C : FMT 00 si lvl = -1, disp = 0 et ofs = 0 ; C24 si ofs 0..15 et disp 16 bits ;
;	    C32 si ofs 0..255 et disp 20 bits ; sinon repli (macro HX_C)
iterate <op, mode, sz>, LIB,HX_MODE_LS,0, LIW,HX_MODE_LS,1, LID,HX_MODE_LS,2, LIQ,HX_MODE_LS,3, LIA,HX_MODE_LS,3, \
			ULIB,HX_MODE_LU,0, ULIW,HX_MODE_LU,1, ULID,HX_MODE_LU,2, \
			SIB,HX_MODE_ST,0, SIW,HX_MODE_ST,1, SID,HX_MODE_ST,2, SIQ,HX_MODE_ST,3, SIA,HX_MODE_ST,3, \
			LIVA,HX_MODE_SPEC,HX_SZ_VA
  calminstruction op lvl:-1, disp:0, ofs:0
    local a, l, lv, dp, of
    compute lv, lvl
    compute dp, disp
    compute of, ofs
    check lv >= -1 & lv <= 14
    jno mauvais_niveau
    check of >= 0 & of <= 255 & dp >= -80000h & dp < 80000h
    jno repli
    check lv = -1 & dp = 0 & of = 0 & mode = HX_MODE_SPEC
    jyes liva_lq
    compute a, $ - 0x400000
    arrange a, =HX_TABLE_ENTREE a
    assemble a
    compute l, lv and 0Fh
    check lv = -1 & dp = 0 & of = 0
    jyes f00
    check of <= 15 & dp >= -8000h & dp < 8000h
    jyes c24
    emit 1, HX_FAM_C + mode shl 4 + HX_FMT_10 shl 2 + sz
    emit 1, l shl 4 + of shr 4
    emit 1, (of and 0Fh) shl 4 + (dp shr 16) and 0Fh
    emit 1, (dp shr 8) and 0FFh
    emit 1, dp and 0FFh
    exit
   f00:
    emit 1, HX_FAM_C + mode shl 4 + sz
    exit
   c24:
    emit 1, HX_FAM_C + mode shl 4 + HX_FMT_01 shl 2 + sz
    emit 1, l shl 4 + of
    emit 1, (dp shr 8) and 0FFh
    emit 1, dp and 0FFh
    exit
   liva_lq:
    arrange a, =LQ -1, 0				; LIVA -1,0,0 = LQ -1,0 (code reserve)
    assemble a
    exit
   repli:
    arrange a, =HX_C mode, sz, lvl, disp, ofs
    assemble a
    exit
   mauvais_niveau:
    err 'HX : lvl hors de -1..14'
  end calminstruction
end iterate

;	--- controle de flot : deplacements relatifs a l'instruction suivante
macro BRA lbl
  HX_BRANCHE HX_BRA, lbl
end macro
macro BT lbl
  HX_BRANCHE HX_BT, lbl
end macro
macro BF lbl
  HX_BRANCHE HX_BF, lbl
end macro
macro CALL prefix, subname
  local d
  if ~ definite prefix#subname#.__appel_postpone		; un seul postpone par procedure et par passe
    prefix#subname#.__appel_postpone = 1			; (leur cout croit comme leur nombre au carre)
    postpone
      if ~definite prefix#subname#_
        prefix#subname#_ = prefix#subname#.elab
      end if
    end postpone
  end if
  d = prefix#subname#_ - ($ + 4)
  assert d >= -800000h & d < 800000h
  HX_INSTR HX_CALL, d and 0FFFFFFh, 3
end macro
calminstruction RTD param_size:0
    local a
    compute param_size, param_size
    check param_size >= 0 & param_size < 1000000h
    jno trop
    compute a, $ - 0x400000
    arrange a, =HX_TABLE_ENTREE a
    assemble a
    check param_size = 0
    jyes zero
    emit 1, HX_RTD
    emit 1, (param_size shr 16) and 0FFh
    emit 1, (param_size shr 8) and 0FFh
    emit 1, param_size and 0FFh
    exit
   zero:
    emit 1, HX_RTD0
    exit
   trop:
    err 'HX : RTD hors de 0..16 Mio'
end calminstruction

;	--- frames
calminstruction LINK lvl*, alloc*
    local a
    compute lvl, lvl
    compute alloc, alloc
    check lvl >= 0 & lvl <= 14 & alloc >= 0
    jno mauvais
    compute a, $ - 0x400000
    arrange a, =HX_TABLE_ENTREE a
    assemble a
    check alloc < 1000h
    jyes b16
    check alloc < 100000h
    jyes b24
    err 'HX : LINK de plus de 1 Mio (cf. LLIR_hardware_support [Q5])'
    exit
   b16:
    emit 1, HX_FAM_B + HX_MODE_SPEC shl 4 + HX_FMT_01 shl 2 + HX_SZ_LINK
    emit 1, lvl shl 4 + (alloc shr 8)
    emit 1, alloc and 0FFh
    exit
   b24:
    emit 1, HX_FAM_B + HX_MODE_SPEC shl 4 + HX_FMT_10 shl 2 + HX_SZ_LINK
    emit 1, lvl shl 4 + (alloc shr 16)
    emit 1, (alloc shr 8) and 0FFh
    emit 1, alloc and 0FFh
    exit
   mauvais:
    err 'HX : LINK, lvl hors de 0..14 ou taille negative'
end calminstruction
iterate op, UNLINK, UNLINKR
  calminstruction op lvl*
    local a
    compute lvl, lvl
    check lvl >= 0 & lvl <= 14
    jno mauvais
    compute a, $ - 0x400000
    arrange a, =HX_TABLE_ENTREE a
    assemble a
    emit 1, HX_#op
    emit 1, lvl
    exit
   mauvais:
    err 'HX : lvl hors de 0..14'
  end calminstruction
end iterate

;	--- exceptions
macro EXC_MACH lvl, ctx
  local t12, t20
  assert (lvl) >= 0 & (lvl) <= 14
  HX_TIENT t12, ctx, 12
  HX_TIENT t20, ctx, 20
  if t12 = 1
    HX_INSTR HX_FAM_B + HX_MODE_SPEC shl 4 + HX_FMT_01 shl 2 + HX_SZ_EXC_MACH, (lvl) shl 12 + (ctx) and 0FFFh, 2
  else if t20 = 1
    HX_INSTR HX_FAM_B + HX_MODE_SPEC shl 4 + HX_FMT_10 shl 2 + HX_SZ_EXC_MACH, (lvl) shl 20 + (ctx) and 0FFFFFh, 3
  else
    err 'HX : EXC_MACH hors du format B24'
  end if
end macro
macro EXC_RAISE top
  assert (top) >= 0 & (top) < 1000000h
  HX_INSTR HX_EXC_RAISE, top, 3
end macro

;	--- comparaison lexicographique : sgn = 1 composants signes ; SZ = log2 (siz)
macro LEXCMP siz*, sgn*
  local sz, u
  assert siz = 1 | siz = 2 | siz = 4 | siz = 8
  sz = bsf siz
  if sgn = 0 & siz < 8
    u = 4
  else
    u = 0
  end if
  HX_INSTR HX_LEXCMP + u + sz
end macro

;	--- controles d'intervalle ( v -- v ) : bornes FST, LST consecutives
;	    forme B en DISPLAY[lvl]+disp (B24), forme C en [DISPLAY[lvl]+disp]+ofs (C32) ; echec vers CEV
;	    hors format : sequence de remplacement DUP / Lt / CLT / BT / DUP / Lt / CGT / BT
macro HX_CHK_B mode*, sz*, charge*, taille*, lvl*, disp*
  local t20
  assert (lvl) >= 0 & (lvl) <= 14
  HX_TIENT t20, disp, 20
  if t20 = 1
    HX_INSTR HX_FAM_B + (mode) shl 4 + HX_FMT_CHK shl 2 + (sz), (lvl) shl 20 + (disp) and 0FFFFFh, 3
  else
    HX_GROUPE_DEBUT
    DUP
    charge lvl, disp
    CLT
    BT STANDARD.ce_raise_
    DUP
    charge lvl, disp+taille
    CGT
    BT STANDARD.ce_raise_
    HX_GROUPE_FIN
  end if
end macro
macro HX_CHK_C mode*, sz*, charge*, taille*, lvl*, disp*, ofs*
  local t20
  assert (lvl) >= 0 & (lvl) <= 14
  HX_TIENT t20, disp, 20
  if t20 = 1 & (ofs) >= 0 & (ofs) <= 255
    HX_INSTR HX_FAM_C + (mode) shl 4 + HX_FMT_CHK shl 2 + (sz), (lvl) shl 28 + (ofs) shl 20 + (disp) and 0FFFFFh, 4
  else
    HX_GROUPE_DEBUT
    DUP
    charge lvl, disp, ofs
    CLT
    BT STANDARD.ce_raise_
    DUP
    charge lvl, disp, ofs+taille
    CGT
    BT STANDARD.ce_raise_
    HX_GROUPE_FIN
  end if
end macro
iterate <op, mode, sz, charge, taille>, CHKB,HX_MODE_LS,0,LB,1, CHKW,HX_MODE_LS,1,LW,2, CHKD,HX_MODE_LS,2,LD,4, \
		CHKQ,HX_MODE_LS,3,LQ,8, CHKUB,HX_MODE_LU,0,ULB,1, CHKUW,HX_MODE_LU,1,ULW,2, CHKUD,HX_MODE_LU,2,ULD,4
  calminstruction op lvl*, disp*
    local a, lv, dp
    compute lv, lvl
    compute dp, disp
    check lv >= 0 & lv <= 14 & dp >= -80000h & dp < 80000h
    jno hors_format
    compute a, $ - 0x400000
    arrange a, =HX_TABLE_ENTREE a
    assemble a
    emit 1, HX_FAM_B + mode shl 4 + HX_FMT_CHK shl 2 + sz
    emit 1, lv shl 4 + (dp shr 16) and 0Fh
    emit 1, (dp shr 8) and 0FFh
    emit 1, dp and 0FFh
    exit
   hors_format:
    arrange a, =HX_CHK_B =mode, sz, =charge, taille, lvl, disp
    assemble a
  end calminstruction
end iterate
iterate <op, mode, sz, charge, taille>, CHKIB,HX_MODE_LS,0,LIB,1, CHKIW,HX_MODE_LS,1,LIW,2, CHKID,HX_MODE_LS,2,LID,4, \
		CHKIQ,HX_MODE_LS,3,LIQ,8, CHKUIB,HX_MODE_LU,0,ULIB,1, CHKUIW,HX_MODE_LU,1,ULIW,2, CHKUID,HX_MODE_LU,2,ULID,4
  calminstruction op lvl*, disp*, ofs*
    local a, lv, dp, of
    compute lv, lvl
    compute dp, disp
    compute of, ofs
    check lv >= 0 & lv <= 14 & dp >= -80000h & dp < 80000h & of >= 0 & of <= 255
    jno hors_format
    compute a, $ - 0x400000
    arrange a, =HX_TABLE_ENTREE a
    assemble a
    emit 1, HX_FAM_C + mode shl 4 + HX_FMT_CHK shl 2 + sz
    emit 1, lv shl 4 + of shr 4
    emit 1, (of and 0Fh) shl 4 + (dp shr 16) and 0Fh
    emit 1, (dp shr 8) and 0FFh
    emit 1, dp and 0FFh
    exit
   hors_format:
    arrange a, =HX_CHK_C =mode, sz, =charge, taille, lvl, disp, ofs
    assemble a
  end calminstruction
end iterate

;	--- champs de bits a position et largeur immediates : D8_8, imm = lsb puis Imm = w
macro HX_BF_IMM op*, lsb*, w*
  assert lsb >= 0 & lsb <= 63
  assert w >= 1 & w <= 64
  assert lsb + w <= 64
  HX_INSTR op, (lsb) shl 8 + (w), 2
end macro
iterate op, UBFXI, SBFXI, BFII
  calminstruction op lsb*, w*
    local a
    compute lsb, lsb
    compute w, w
    check lsb >= 0 & lsb <= 63 & w >= 1 & w <= 64 & lsb + w <= 64
    jno mauvais
    compute a, $ - 0x400000
    arrange a, =HX_TABLE_ENTREE a
    assemble a
    emit 1, HX_#op
    emit 1, lsb
    emit 1, w
    exit
   mauvais:
    err 'HX : champ de bits hors de 0..63'
  end calminstruction
end iterate

;	--- appels systeme : TRAP n (D8) ; SYS_EXIT code devient LI code ; TRAP 0
iterate op, CLOCK_GETTIME, PUT_CHAR, PUT_STR, GET_CHAR, GET_STR, FILE_CREATE, FILE_OPEN, FILE_SET_POS, \
	    FILE_GET_POS, FILE_GET_SIZE, FILE_WRITE, FILE_READ, FILE_CLOSE, FILE_DELETE
  calminstruction SYS_#op
    local a
    compute a, $ - 0x400000
    arrange a, =HX_TABLE_ENTREE a
    assemble a
    emit 1, HX_TRAP
    emit 1, HX_SYS_#op
  end calminstruction
end iterate
macro SYS_EXIT code:0
  HX_GROUPE_DEBUT
  LI code
  HX_INSTR HX_TRAP, HX_SYS_EXIT, 1
  HX_GROUPE_FIN
end macro

;-----------------------------------------------------------------------------------------------------------------------
;		E N - T E T E   D E   L ' I M A G E   H X
;-----------------------------------------------------------------------------------------------------------------------

org 0x400000

HX_Header:
	db	'TLALOCHX'				; +0  signature
	dq	1					; +8  version du format HX
	dq	0x400000				; +16 adresse de chargement de l'image
	dq	0x400078				; +24 point d'entree
	dq	ASM_SIZE				; +32 octets de code et donnees depuis 0x400078
	dq	0					; +40 sans objet (TX : taille d'un enregistrement)
    if defined STANDARD.ce_raise_
	dq	STANDARD.ce_raise_			; +48 vecteur CEV : echec des CHK
    else
	dq	0					; +48 pas de ce_raise_ : un CHK en echec est une faute
    end if
	dq	HX_TABLE_ADR				; +56 table des instructions (adresse)
	dq	HX_TABLE_NB				; +64 nombre d'instructions
	db	(0x400078 - $) dup 0			; completer jusqu'a 0x78

;-----------------------------------------------------------------------------------------------------------------------
