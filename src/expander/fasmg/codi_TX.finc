macro LEXCMP siz*, sgn*
  assert siz = 1 | siz = 2 | siz = 4 | siz = 8
  TX_REC TX_LEXCMP, sgn, siz
end macro

;	--- controles d'intervalle ( v -- v ) : bornes FST, LST consecutives
;	    forme B en DISPLAY[lvl]+disp, forme C en [DISPLAY[lvl]+disp]+ofs ; echec vers CEV
macro TX_CHK_B op*, lvl*, disp*
  assert lvl >= 0 & lvl <= 14
  TX_REC op, lvl, 0, disp
end macro
macro TX_CHK_C op*, lvl*, disp*, ofs*
  assert lvl >= 0 & lvl <= 14
  assert ofs >= -80000000h & ofs <= 7FFFFFFFh
  TX_REC op, lvl, ofs, disp
end macro
macro CHKB lvl*, disp*
  TX_CHK_B TX_CHKB, lvl, disp
end macro
macro CHKW lvl*, disp*
  TX_CHK_B TX_CHKW, lvl, disp
end macro
macro CHKD lvl*, disp*
  TX_CHK_B TX_CHKD, lvl, disp
end macro
macro CHKQ lvl*, disp*
  TX_CHK_B TX_CHKQ, lvl, disp
end macro
macro CHKUB lvl*, disp*
