;-----------------------------------------------------------------------------------------------------------------------
;		E M I S S I O N   D ' U N   E N R E G I S T R E M E N T
;-----------------------------------------------------------------------------------------------------------------------

macro TX_REC op*, lvl:0, ofs:0, val:0
  local adresse
  adresse = $ - 0x400000
  virtual TX_TABLE
    dd adresse
  end virtual
  db op
  db (lvl) and 0FFh
  dw 0
  dd (ofs) and 0FFFFFFFFh
  dq (val) and 0FFFFFFFFFFFFFFFFh
end macro

macro TX_B op*, lvl, disp				; famille B : lvl, disp
  assert lvl >= -1 & lvl <= 127
  TX_REC op, lvl, 0, disp
end macro

macro TX_C op*, lvl, disp, ofs			; famille C : lvl, disp, ofs
  assert lvl >= -1 & lvl <= 127
  assert ofs >= -80000000h & ofs <= 7FFFFFFFh
  TX_REC op, lvl, ofs, disp
end macro

;-----------------------------------------------------------------------------------------------------------------------
;		A U X I L I A I R E S   x 8 6   N E U T R A L I S E E S   (au cas ou un .FINC les emploierait)
;-----------------------------------------------------------------------------------------------------------------------

macro PUSH_RAX
  err 'PUSH_RAX : macro x86 sans equivalent TX'
end macro
macro POP_RAX
  err 'POP_RAX : macro x86 sans equivalent TX'
end macro

;-----------------------------------------------------------------------------------------------------------------------
;		I N S T R U C T I O N S   L L I R
;-----------------------------------------------------------------------------------------------------------------------

;	--- pile
macro DROP
  TX_REC TX_DROP
end macro
macro DUP
  TX_REC TX_DUP
end macro
macro OVER
  TX_REC TX_OVER
end macro

;	--- immediats et adresses constantes
macro LI val
  if (val) < -8000000000000000h | (val) >= 8000000000000000h
    err 'LI : immediat hors de [-2^63, 2^63) (LLIR_hardware_support V7)'
  end if
  TX_REC TX_LI, 0, 0, val
end macro
macro LIF val					; le litteral flottant est converti par fasmg en IEEE 754 double
  local adresse
  adresse = $ - 0x400000
  virtual TX_TABLE
    dd adresse
  end virtual
  db TX_LIF, 0
  dw 0
  dd 0
  dq val
end macro
macro LCA ptr, disp:0
  TX_REC TX_LCA, 0, 0, ptr+disp
end macro
macro LSPA prefix, subname
  if ~ definite prefix#subname#.__appel_postpone		; un seul postpone par procedure et par passe
    prefix#subname#.__appel_postpone = 1			; (leur cout croit comme leur nombre au carre)
    postpone
      if ~definite prefix#subname#_
        prefix#subname#_ = prefix#subname#.elab
      end if
    end postpone
  end if
  TX_REC TX_LSPA, 0, 0, prefix#subname#_
end macro

;	--- adresses de variables
macro LVA lvl:-1, disp:0
  if (lvl) = -1 & (disp) = 0			; identite ( @ -- @ ) : rien n'est emis (comme codi_HX)
  else
    TX_B TX_LVA, lvl, disp
  end if
end macro
macro LIVA lvl:-1, disp:0, ofs:0
  TX_C TX_LIVA, lvl, disp, ofs
end macro

