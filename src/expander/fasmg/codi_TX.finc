end macro

;	--- champs de bits a position et largeur immediates : lsb dans val, w dans ofs
macro TX_BF_IMM op*, lsb*, w*
  assert lsb >= 0 & lsb <= 63
  assert w >= 1 & w <= 64
  assert lsb + w <= 64
  TX_REC op, 0, w, lsb
end macro
macro UBFXI lsb*, w*
  TX_BF_IMM TX_UBFXI, lsb, w
end macro
macro SBFXI lsb*, w*
  TX_BF_IMM TX_SBFXI, lsb, w
end macro
macro BFII lsb*, w*
  TX_BF_IMM TX_BFII, lsb, w
end macro

