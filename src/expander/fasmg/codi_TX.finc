;	--- controle de flot : les cibles sont des adresses absolues
macro BRA lbl
  TX_REC TX_BRA, 0, 0, lbl
end macro
macro BT lbl
  TX_REC TX_BT, 0, 0, lbl
end macro
macro BF lbl
  TX_REC TX_BF, 0, 0, lbl
end macro
macro CALL prefix, subname
  if ~ definite prefix#subname#.__appel_postpone		; un seul postpone par procedure et par passe
    prefix#subname#.__appel_postpone = 1			; (leur cout croit comme leur nombre au carre)
    postpone
      if ~definite prefix#subname#_
        prefix#subname#_ = prefix#subname#.elab
      end if
    end postpone
  end if
  TX_REC TX_CALL, 0, 0, prefix#subname#_
end macro
macro CALLI
  TX_REC TX_CALLI
end macro
macro RTD param_size:0
  assert param_size >= 0
  TX_REC TX_RTD, 0, 0, param_size
end macro

;	--- frames
macro LINK lvl, alloc
  assert alloc >= 0
  TX_REC TX_LINK, lvl, 0, alloc
end macro
macro UNLINK lvl
