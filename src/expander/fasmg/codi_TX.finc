end macro
macro CHKIB lvl*, disp*, ofs*
  TX_CHK_C TX_CHKIB, lvl, disp, ofs
end macro
macro CHKIW lvl*, disp*, ofs*
  TX_CHK_C TX_CHKIW, lvl, disp, ofs
end macro
macro CHKID lvl*, disp*, ofs*
