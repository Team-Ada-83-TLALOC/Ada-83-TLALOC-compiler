postpone						; sera fait en toute toute fin car c'est le premier postpone
  ASM_SIZE = $-0x400078
end postpone

macro show description, value				; pour debogage
  repeat 1, d:value
    display description,`d,13,10
  end repeat
end macro

macro hexa_show description, value			; adresse hexa pour la carto de debogage
  local x, digit
  x = value
  display description, '0', 'x'
  repeat 16, n:0
    digit = (x shr ((15 - n) shl 2)) and 0Fh
    if digit < 10
      display '0' + digit
    else
      display 'A' + digit - 10
    end if
  end repeat
  display 13, 10
end macro
;			-------------------------------------------------------------------
;			S P E C I F I Q U E	  P R O C E S S E U R   I N T E L   x 8 6   6 4
;			-------------------------------------------------------------------


	; sur processeur x86 64 les mouvements de pile se font en 64 bits (qword)
	; mais on a choisi de faire les operations arithmetiques en 32 bits pour rester comme sur une
	; architecture 32 bits

	; QUANT A LA PILE : ON A DECIDE DE LA FAIRE CROITRE VERS LES ADRESSES HAUTES CAR LE SENS HABITUEL DESCENDANT
	; EST INGERABLE POUR CERTAINES VARIABLES LOCALES STRUCTUREES
	; Donc pas possible d'utiliser les push et pop du processeur, on utilise le RBP comme pointeur de pile avec
	; des LEA pour le mettre a jour en essayant de recouvrir les operations
	; d'acces memoire et de mise a jour du pointeur de pile RBP.
	; Le ESP reste tout en bas de pile pour gerer une micro-pile descendante des adresses de CALL/RET uniquement.
	; Attention : le EBP pointe sur la derniere valeur empilee comme qword
	; AUTRE PROBLEME DE PILE : Les variables dont on connaît la taille a la compilation s'accomodent bien a
	; la pile usuelle, les offsets sont determine a la compilation
	; MAIS, si l'on a comme en Ada des variables (tableau par exemple) dont la taille n'est connue qu'a
	; l'execution (indices eux-memes variables)
	; on ne peut pas mettre ces variables sur la pile normale. Mettre ces variables dans le tas n'est pas tres
	; satisfaisant car la gestion de la desallocation va poser probleme.
	; On invente donc la Co-Pile qui est une suite de blocs alloues dynamiquement pour un niveau d'execution
	; et qui est desallouee a la maniere de la pile usuelle.
	; De la sorte, il n'y a pas de melange avec les allocations de taille statique.
	; r14 est le pointeur de sommet de Co-Pile (l'analogue de RBP pour la pile standard, ou de RSP pour la
	; micro-pile des retours/bricolages locaux en assembleur.

	; R15 pointeur de base display des frame pointers
	; R14 pointeur de haut de co-pile (lieu d'allocation)
	; R13 pointeur de debut de chaine de frame de co-pile (pour desallocation)
	; R12 pointeur post haut de tas (zone de tas allouée sur la pile en début d'exécution expansion vers le bas)
	; R11 pointeur de bloc tas libre (pointe un doublet de quadwords : taille/adresse bloc suivant.
	;     gestion simple du tas : taille positive = bloc libre ; taille négative = bloc réservé data pointée
	; après le quadword de taille.


;.......................................................................................................................
;   M A C R O S   A N C I L L A I R E S	  ( P A S	  U T I L I S E E S	  P A R	L E   C O D E _ G E N   T L A L O C
;.......................................................................................................................

;			........
macro			PUSH_RAX
;			........
  db 0x48, 0x89, 0x45, 0x08				; mov QWORD PTR [rbp+8], rax		(ecrire RAX a l'emplacement libre en haut de pile, au dessus du rbp)
  db 0x48, 0x8D, 0x6D, 0x08				; lea rbp, [rbp+0x8]		(puis MONTER le rbp sur la valeur ecrite car pile croissante vers adresses hautes)

end macro

;			........
macro			PUSH_RDX
;			........
  db 0x48, 0x89, 0x55, 0x08				; mov QWORD PTR [rbp+8], rdx		(ecrire RDX a l'emplacement libre en haut de pile, au dessus du rbp)
  db 0x48, 0x8D, 0x6D, 0x08				; lea rbp, [rbp+0x8]		(puis MONTER le rbp sur la valeur ecrite car pile croissante vers adresses hautes)

end macro

;			.......
macro			POP_RAX
;			.......
  db 0x48, 0x8B, 0x45, 0x00				; mov rax, QWORD PTR [rbp]		(lire dans RAX la valeur top sur le rbp)
  db 0x48, 0x8D, 0x6D, 0xF8				; lea rbp, [rbp-0x8]		(puis DESCENDRE le rbp car pile croissante vers adresses hautes)

end macro

;			.......
macro			POP_RBX
;			.......
  db 0x48, 0x8B, 0x5D, 0x00				; mov rbx, QWORD PTR [rbp]		(lire dans RBX la valeur top sur le rbp)
  db 0x48, 0x8D, 0x6D, 0xF8				; lea rbp, [rbp-0x8]		(puis DESCENDRE le rbp car pile croissante vers adresses hautes)

end macro

;			.......
macro			POP_RCX
;			.......
  db 0x48, 0x8B, 0x4D, 0x00				; mov rcx, QWORD PTR [rbp]		(lire dans RCX la valeur top sur le rbp)
  db 0x48, 0x8D, 0x6D, 0xF8				; lea rbp, [rbp-0x8]		(puis DESCENDRE le rbp car pile croissante vers adresses hautes)

end macro

;			.......
macro			POP_RDX
;			.......
  db 0x48, 0x8B, 0x55, 0x00				; mov rdx, QWORD PTR [rbp]		(lire dans RDX la valeur top sur le rbp)
  db 0x48, 0x8D, 0x6D, 0xF8				; lea rbp, [rbp-0x8]		(puis DESCENDRE le rbp car pile croissante vers adresses hautes)

end macro

;			.......
macro			POP_RSI
;			.......
  db 0x48, 0x8B, 0x75, 0x00				; mov rsi, QWORD PTR [rbp]		(lire dans RSI la valeur top sur le rbp)
  db 0x48, 0x8D, 0x6D, 0xF8				; lea rbp, [rbp-0x8]		(puis DESCENDRE le rbp car pile croissante vers adresses hautes)

end macro

;			.......
macro			POP_RDI
;			.......
  db 0x48, 0x8B, 0x7D, 0x00				; mov rdi, QWORD PTR [rbp]		(lire dans RDI la valeur top sur le rbp)
  db 0x48, 0x8D, 0x6D, 0xF8				; lea rbp, [rbp-0x8]		(puis DESCENDRE le rbp car pile croissante vers adresses hautes)

end macro

;			....
macro			DROP
;			....
  db 0x48, 0x8D, 0x6D, 0xF8				; lea rbp, [rbp-0x8]		(DESCENDRE le rbp car pile croissante vers adresses hautes)

end macro

;			...
macro			DUP
;			...
  db 0x48, 0x8B, 0x45, 0x00				; mov rax, QWORD PTR [rbp]		(amener le TOS dans RAX)
  db 0x48, 0x89, 0x45, 0x08				; mov QWORD PTR [rbp+8], rax		(dupliquer)
  db 0x48, 0x8D, 0x6D, 0x08				; lea rbp, [rbp+0x8]		(puis MONTER le rbp sur la valeur ecrite car pile croissante vers adresses hautes)
end macro

;			....
macro			OVER
;			....
  db 0x48, 0x8B, 0x45, 0xF8				; mov rax, QWORD PTR [rbp-8]		(amener le NOS dans RAX)
  db 0x48, 0x89, 0x45, 0x08				; mov QWORD PTR [rbp+8], rax		(empîler)
  db 0x48, 0x8D, 0x6D, 0x08				; lea rbp, [rbp+0x8]		(puis MONTER le rbp sur la valeur ecrite car pile croissante vers adresses hautes)
end macro

;			.......
macro			align_b?
;			.......
end macro

;			.......
macro			align_w?
;			.......
  desalign = $ mod 2
  if desalign <> 0
    repeat 2-desalign
      db 0x90
    end repeat
  end if
end macro

;			.......
macro			align_d?
;			.......
  desalign = $ mod 4
  if desalign <> 0
    repeat 4-desalign
      db 0x90
    end repeat
  end if
end macro

;			.......
macro			align_q?
;			.......
  desalign = $ mod 8
  if desalign <> 0
    repeat 8-desalign
      db 0x90
    end repeat
  end if
end macro

;			.......................
macro			FP_IN_RAX		lvl
;			.......................
  assert lvl >= 0 & lvl <= 31
  if lvl = 0
    db 0x49, 0x8B, 0x07						; mov rax, [r15]		(aller chercher le frame pointer du lvl dans le display pointe par r15)
  else if lvl <= 15
    db 0x49, 0x8B, 0x47, 8*lvl					; mov rax, [r15 + 8*lvl]	(aller chercher le frame pointer du lvl dans le display pointe par r15)
  else
    db 0x49, 0x8B, 0x87						; mov rax, [r15 + 8*lvl]	(aller chercher le frame pointer du lvl dans le display pointe par r15)
    dd 8*lvl
  end if

; optim_RAX_ON_TOP = 0
end macro

;			.......................
macro			RAX_IN_FP		lvl
;			.......................
  assert lvl >= 0 & lvl <= 31
  if lvl = 0
    db 0x49, 0x89, 0x07						; mov [r15], rax
  else if lvl <= 15
    db 0x49, 0x89, 0x47, 8*lvl					; mov [r15 + 8*lvl], rax	(aller chercher le frame pointer du lvl dans le display pointe par r15)
  else
    db 0x49, 0x89, 0x87						; mov [r15 + 8*lvl], rax	(aller chercher le frame pointer du lvl dans le display pointe par r15)
    dd 8*lvl
  end if
end macro

;			.......................
macro			FP_IN_RBP		lvl
;			.......................
  assert lvl >= 0 & lvl <= 31
  if lvl = 0
    db 0x49, 0x8B, 0x2F						; mov rbp, [r15]	(aller chercher le frame pointer du lvl dans le display pointe par r15)
  else if lvl <= 15
    db 0x49, 0x8B, 0x6F, 8*lvl					; mov rbp, [r15 + 8*lvl]	(aller chercher le frame pointer du lvl dans le display pointe par r15)
  else
    db 0x49, 0x8B, 0xAF						; mov rbp, [r15 + 8*lvl]	(aller chercher le frame pointer du lvl dans le display pointe par r15)
    dd 8*lvl
  end if
end macro

;			.......................
macro			BASE_IN_RAX	lvl			; 1 ou 2 instr
;			.......................
  assert lvl >= -1 & lvl <= 31
  if lvl = -1							; octet range n'importe où : adresse stockage empilee
    POP_RAX							; 2 instr : (adress for data)
  else
    FP_IN_RAX	lvl						; 1 instr : FP(lvl) base
  end if
end macro

;			.......................................
macro			INDIRECT_BASE_IN_RAX	lvl, disp		; 1 ou 2 instr
;			.......................................
  assert lvl >= -1 & lvl <= 31
  if lvl = -1							; top stacked adress of adress
    POP_RAX							; pop rax	  adress of adress for data
    if disp = 0
      db 0x48, 0x8B, 0x00						; mov rax, qword ptr [rax]   fetch adress of data
    else if disp >= -128 & disp < 128
      db 0x48, 0x8B, 0x40, disp					; mov rax, qword ptr [rax + ofs8]
    else
      db 0x48, 0x8B, 0x80						; mov rax, qword ptr [rax + ofs32]
      dd disp
    end if

  else								; regular framed adress of byte
    FP_IN_RAX	lvl
    FETCH_QWORD	disp						; le FP( lvl ) + disp est dans rax
  end if
end macro

;			........................
macro			FETCH_BYTE_U	disp
;			........................
  if disp = 0
    db 0x48, 0x0F, 0xB6, 0x00						; movzx rax, byte ptr [rax]
  else if disp >= -128 & disp < 128
    db 0x48, 0x0F, 0xB6, 0x40, disp					; movzx rax, byte ptr [rax + ofs8]
  else
    db 0x48, 0x0F, 0xB6, 0x80						; movzx rax, byte ptr [rax + ofs32]
    dd disp
  end if

end macro

;			........................
macro			FETCH_WORD_U	disp
;			........................
  if disp = 0
    db 0x48, 0x0F, 0xB7, 0x00						; movzx rax, word ptr [rax]
  else if disp >= -128 & disp < 128
    db 0x48, 0x0F, 0xB7, 0x40, disp					; movzx rax, word ptr [rax + ofs8]
  else
    db 0x48, 0x0F, 0xB7, 0x80						; movzx rax, word ptr [rax + ofs32]
    dd disp
  end if

end macro

;			........................
macro			FETCH_DWORD_U	disp
;			........................
; Pas de movzx dword sur x86-64 : inutile, un mov 32 bits (sans REX.W)
; zero-etend implicitement rax. Un octet plus court que le movsxd signe.
  if disp = 0
    db 0x8B, 0x00							; mov eax, dword ptr [rax]		(zero-etend rax)
  else if disp >= -128 & disp < 128
    db 0x8B, 0x40, disp						; mov eax, dword ptr [rax + ofs8]
  else
    db 0x8B, 0x80							; mov eax, dword ptr [rax + ofs32]
    dd disp
  end if

end macro

;			........................
macro			FETCH_BYTE	disp
;			........................
  if disp = 0
    db 0x48, 0x0F, 0xBE, 0x00						; movsx rax, byte ptr [rax]
  else if disp >= -128 & disp < 128
    db 0x48, 0x0F, 0xBE, 0x40, disp					; movsx rax, byte ptr [rax + ofs8]
  else
    db 0x48, 0x0F, 0xBE, 0x80						; movsx rax, byte ptr [rax + ofs32]
    dd disp
  end if

end macro

;			........................
macro			FETCH_WORD	disp
;			........................
  if disp = 0
    db 0x48, 0x0F, 0xBF, 0x00						; movsx rax, word ptr [rax]
  else if disp >= -128 & disp < 128
    db 0x48, 0x0F, 0xBF, 0x40, disp					; movsx rax, word ptr [rax + ofs8]
  else
    db 0x48, 0x0F, 0xBF, 0x80						; movsx rax, word ptr [rax + ofs32]
    dd disp
  end if

end macro

;			........................
macro			FETCH_DWORD	disp
;			........................
  if disp = 0
    db 0x48, 0x63, 0x00						; movsx rax, dword ptr [rax]
  else if disp >= -128 & disp < 128
    db 0x48, 0x63, 0x40, disp						; movsx rax, dword ptr [rax + ofs8]
  else
    db 0x48, 0x63, 0x80						; movsx rax, dword ptr [rax + ofs32]
    dd disp
  end if

end macro

;			........................
macro			FETCH_QWORD	disp
;			........................
  if disp = 0
    db 0x48, 0x8B, 0x00						; mov rax, qword ptr [rax]
  else if disp >= -128 & disp < 128
    db 0x48, 0x8B, 0x40, disp						; mov rax, qword ptr [rax + ofs8]
  else
    db 0x48, 0x8B, 0x80						; mov rax, qword ptr [rax + ofs32]
    dd disp
  end if

end macro

;			........................
macro			STORE_BYTE	disp
;			........................
  if disp = 0
    db 0x88, 0x18							; mov byte ptr [rax], BL   (store)
  else if disp >= -128 & disp < 128
    db 0x88, 0x58							; mov byte ptr [rax + ofs8], BL   store
    db disp
  else
    db 0x88, 0x98							; mov byte ptr [rax + ofs32], BL   (store)
    dd disp
  end if
end macro

;			........................
macro			STORE_WORD	disp
;			........................
  if disp = 0
    db 0x66, 0x89, 0x18						; mov word ptr [rax], BX   (store)
  else if disp >= -128 & disp < 128
      db 0x66, 0x89, 0x58, disp					; mov word ptr [rax + ofs8], BX
    else
      db 0x66, 0x89, 0x98						; mov word ptr [rax + ofs32], BX
      dd disp
    end if
end macro

;			........................
macro			STORE_DWORD	disp
;			........................
  if disp = 0
    db 0x89, 0x18							; mov dword ptr [rax], EBX
  else if disp >= -128 & disp < 128
      db 0x89, 0x58, disp						; mov dword ptr [rax + ofs8], EBX
    else
      db 0x89, 0x98							; mov dword ptr [rax + ofs32], EBX
      dd disp
    end if
end macro

;			........................
macro			STORE_QWORD	disp
;			........................
  if disp = 0
    db 0x48, 0x89, 0x18						; mov qword ptr [rax], RBX
  else if disp >= -128 & disp < 128
      db 0x48, 0x89, 0x58, disp					; mov qword ptr [rax + ofs8], RBX
    else
      db 0x48, 0x89, 0x98						; mov qword ptr [rax + ofs32], RBX
      dd disp
    end if
end macro


;-----------------------------------------------------------------------------------------------------------------------
;			L O A D	C O N S T A N T E S	  I M M E D I A T E S
;-----------------------------------------------------------------------------------------------------------------------

;			-------------
macro			LI	val				; Load Integer
;			-------------
  if (val) < -8000000000000000h | (val) >= 8000000000000000h
    err 'LI : immediat hors de [-2^63, 2^63) (LLIR_hardware_support V7)'
  end if
  db 0x48, 0xB8							; mov rax, quadval
  dq val
  PUSH_RAX
end macro

;			-------------
macro			LIF	val				; Load Immediate Float (IEEE 754 double 64 bits sur la pile entiere)
;			-------------
  db 0x48, 0xB8							; movabs rax, imm64
  dq val								; fasmg convertit le litteral flottant en 8 octets IEEE 754 double
  PUSH_RAX
end macro


;-----------------------------------------------------------------------------------------------------------------------
;			L O A D	C O N S T A N T  /  V A R I A B L E   A D R E S S E
;-----------------------------------------------------------------------------------------------------------------------

;			---------------------
macro			LCA	ptr, disp:0			; Load Constant Address
;			---------------------
  db 0x48, 0xB8							; movabs rax, ptr
  dq ptr+disp
  PUSH_RAX
end macro

;			--------------------------
macro			LSPA	prefix, subname			; Load SubProgram Address de .elab, en armant l'assemblage lazy
;			--------------------------
  if ~ definite prefix#subname#.__appel_postpone		; un seul postpone par procedure et par passe
    prefix#subname#.__appel_postpone = 1			; (leur cout croit comme leur nombre au carre)
    postpone
      if ~definite prefix#subname#_
        prefix#subname#_ = prefix#subname#.elab				; le nom finissant en _ determine l'assemblage de la routine
      end if
    end postpone
  end if

  db 0x48, 0xB8							; movabs rax, imm64
  dq prefix#subname#_
  PUSH_RAX
end macro

;			------------------------
macro			LVA	lvl:-1, disp:0			; Load Variable Address pour lvl et disp (empile l'adresse de la variable au deplacement disp du frame de lvl donne)
;			------------------------
 if lvl = -1 & disp = 0						; identite ( @ -- @ ) : rien n'est emis (comme codi_HX)
 else
  BASE_IN_RAX	lvl
  if disp = 0
;    db 0x48, 0x8D, 0x00						; lea rax, [rax] (nop)
  else if disp >= -128 & disp < 128
    db 0x48, 0x8D, 0x40, disp						; lea rax, [rax + ofs8]
  else
    db 0x48, 0x8D, 0x80						; lea rax, qword ptr [rax + ofs32]
    dd disp
  end if
  PUSH_RAX
 end if
end macro

;			-------------------------------
macro			LIVA	lvl:-1, disp:0, ofs:0		; Load Indirect Variable Address pour lvl et disp (empile l'adresse de la variable pointee par l adresse au deplacement disp du frame de lvl donne)
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  if ofs = 0
;    db 0x48, 0x8D, 0x00						; lea rax, [rax] (nop)
  else if ofs >= -128 & ofs < 128
    db 0x48, 0x8D, 0x40, ofs						; lea rax, [rax + ofs8]
  else
    db 0x48, 0x8D, 0x80						; lea rax, qword ptr [rax + ofs32]
    dd ofs
  end if
  PUSH_RAX
end macro


;-----------------------------------------------------------------------------------------------------------------------
;					L O A D	D A T A		(unsigned/signed)
;-----------------------------------------------------------------------------------------------------------------------

;			------------------------
macro			ULB	lvl:-1, disp:0			; Unsigned Load Byte 8 bits (zero extension)
;			------------------------
  BASE_IN_RAX	lvl						; 1 ou 2 instr
  FETCH_BYTE_U	disp
  PUSH_RAX							; 2 instr
end macro
;			------------------------
macro			ULW	lvl:-1, disp:0			; Unsigned Load Word 16 bits
;			------------------------
  BASE_IN_RAX	lvl
  FETCH_WORD_U	disp
  PUSH_RAX
end macro
;			------------------------
macro			ULD	lvl:-1, disp:0			; Unsigned Load doubleword 32 bits
;			------------------------
  BASE_IN_RAX	lvl
  FETCH_DWORD_U	disp
  PUSH_RAX
end macro
;			------------------------
macro			LB	lvl:-1, disp:0			; 4 ou 5 instr : Load Byte 8 bits
;			------------------------
  BASE_IN_RAX	lvl						; 1 ou 2 instr
  FETCH_BYTE	disp
  PUSH_RAX							; 2 instr
end macro
;			------------------------
macro			LW	lvl:-1, disp:0			; Load Word 16 bits
;			------------------------
  BASE_IN_RAX	lvl
  FETCH_WORD	disp
  PUSH_RAX
end macro
;			------------------------
macro			LD	lvl:-1, disp:0			; Load doubleword 32 bits
;			------------------------
  BASE_IN_RAX	lvl
  FETCH_DWORD	disp
  PUSH_RAX
end macro
;			------------------------
macro			LQ	lvl:-1, disp:0			; Load quadword 64 bits
;			------------------------
  BASE_IN_RAX	lvl
  FETCH_QWORD	disp
  PUSH_RAX
end macro
;			------------------------
macro			LA	lvl:-1, disp:0			; Load Address 64 bits
;			------------------------
  LQ lvl, disp
end macro

;			-------------------------------
macro			ULIB	lvl:-1, disp:0, ofs:0		; Unsigned Load Indirect byte (la variable en frame ou empilee est une adresse, octet zero-etendu)
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_BYTE_U		ofs
  PUSH_RAX							; empiler la donnee
end macro
;			-------------------------------
macro			ULIW	lvl:-1, disp:0, ofs:0		; Unsigned Load Indirect word
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_WORD_U		ofs
  PUSH_RAX
end macro
;			-------------------------------
macro			ULID	lvl:-1, disp:0, ofs:0		; Unsigned Load Indirect doubleword
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_DWORD_U		ofs
  PUSH_RAX
end macro
;			-------------------------------
macro			LIB	lvl:-1, disp:0, ofs:0		; Load Indirect byte (la variable en frame ou empilee est une adresse, adresse a laquelle on va chercher l'octet avec offset)
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_BYTE		ofs
  PUSH_RAX							; empiler la donnee
end macro
;			-------------------------------
macro			LIW	lvl:-1, disp:0, ofs:0		; Load Indirect word
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_WORD		ofs
  PUSH_RAX
end macro
;			-------------------------------
macro			LID	lvl:-1, disp:0, ofs:0		; Load Indirect doubleword
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_DWORD		ofs
  PUSH_RAX
end macro
;			-------------------------------
macro			LIQ	lvl:-1, disp:0, ofs:0		; Load Indirect quadword
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_QWORD		ofs
  PUSH_RAX
end macro
;			-------------------------------
macro			LIA	lvl:-1, disp:0, ofs:0		; Load Address 64 bits Indirect
;			-------------------------------
  LIQ lvl, disp, ofs
end macro


;-----------------------------------------------------------------------------------------------------------------------
;					S T O R E	  D A T A
;-----------------------------------------------------------------------------------------------------------------------

;			------------------------
macro			SB	lvl:-1, disp:0			; Store byte 8 bits
;			------------------------
  POP_RBX								; (data)
  BASE_IN_RAX	lvl
  STORE_BYTE	disp
end macro
;			------------------------
macro			SW	lvl:-1, disp:0			; Store word 16 bits
;			------------------------
  POP_RBX								; (data)
  BASE_IN_RAX	lvl
  STORE_WORD	disp
end macro
;			------------------------
macro			SD	lvl:-1, disp:0			; Store doubleword 32 bits
;			------------------------
  POP_RBX								; (data)
  BASE_IN_RAX	lvl
  STORE_DWORD	disp
end macro
;			------------------------
macro			SQ	lvl:-1, disp:0			; Store Quadword 64 bits
;			------------------------
  POP_RBX								; (data)
  BASE_IN_RAX	lvl
  STORE_QWORD	disp
end macro
;			------------------------
macro			SA	lvl:-1, disp:0			; Store Address 64 bits
;			------------------------
  SQ lvl, disp
end macro


;			-------------------------------
macro			SIB	lvl:-1, disp:0, ofs:0		; Store Indirect byte
;			-------------------------------
  POP_RBX								; (data)
  INDIRECT_BASE_IN_RAX	lvl, disp
  STORE_BYTE		ofs
end macro
;			-------------------------------
macro			SIW	lvl:-1, disp:0, ofs:0		; Store Indirect word
;			-------------------------------
  POP_RBX								; (data)
  INDIRECT_BASE_IN_RAX	lvl, disp
  STORE_WORD		ofs
end macro
;			-------------------------------
macro			SID	lvl:-1, disp:0, ofs:0		; Store Indirect doubleword
;			-------------------------------
  POP_RBX								; (data)
  INDIRECT_BASE_IN_RAX	lvl, disp
  STORE_DWORD		ofs
end macro
;			-------------------------------
macro			SIQ	lvl:-1, disp:0, ofs:0		; Store Indirect quadword
;			-------------------------------
  POP_RBX								; (data)
  INDIRECT_BASE_IN_RAX	lvl, disp
  STORE_QWORD		ofs
end macro
;			-------------------------------
macro			SIA	lvl:-1, disp:0, ofs:0		; Store Address 64 bits Indirect
;			-------------------------------
  SIQ lvl, disp, ofs
end macro


;-----------------------------------------------------------------------------------------------------------------------
;				O P E R A T I O N S	  L O G I Q U E S
;-----------------------------------------------------------------------------------------------------------------------

;			--
macro			ET
;			--
  POP_RAX
  db 0x48, 0x21, 0x45, 0x00						; and qword ptr [rbp], rax
end macro
;			--
macro			OU
;			--
  POP_RAX
  db 0x48, 0x09, 0x45, 0x00						; or qword ptr [rbp], rax
end macro
;			---
macro			NON
;			---
  db 0x48, 0xF7, 0x55, 0x00						; not qword ptr [rbp]
end macro
;			---
macro			OUX
;			---
  POP_RAX
  db 0x48, 0x31, 0x45, 0x00						; xor qword ptr [rbp], rax
end macro
;			---
macro			SHL					; decalage gauche
;			---
  POP_RCX								; nombre de positions de decalage
  db 0x48, 0x83, 0xF9, 0x3F, 0x76, 0x02, 0x0F, 0x0B			; cmp rcx, 63 ; jbe +2 ; ud2	compte >= 64 : faute 137 (V7)
  db 0x48, 0xD3, 0x65, 0x00						; shl qword ptr [rbp], cl
end macro
;			---
macro			SHR					; decalage droit
;			---
  POP_RCX								; nombre de positions de decalage
  db 0x48, 0x83, 0xF9, 0x3F, 0x76, 0x02, 0x0F, 0x0B			; cmp rcx, 63 ; jbe +2 ; ud2	compte >= 64 : faute 137 (V7)
  db 0x48, 0xD3, 0x6D, 0x00						; shr qword ptr [rbp], cl
end macro


;-----------------------------------------------------------------------------------------------------------------------
;		O P E R A T I O N S	  B I T	F I E L D S
;-----------------------------------------------------------------------------------------------------------------------

;			----
macro			UBFX					; unsigned bit field extract
;			----
  POP_RDX								; rdx = Width
  POP_RCX								; rcx = LSB
  db 0x48, 0x8B, 0x45, 0x00						; mov rax, qword ptr [rbp]	valeur source
  db 0x48, 0xD3, 0xE8						; shr rax, cl		rax := valeur >> LSB
  db 0x48, 0x89, 0xD1						; mov rcx, rdx		rcx = Width
  db 0x48, 0xF7, 0xD9						; neg rcx			cl = -Width, soit 64 - Width modulo 64
  db 0x6A, 0xFF							; push -1
  db 0x5A								; pop rdx			rdx = tous les bits a 1
  db 0x48, 0xD3, 0xEA						; shr rdx, cl		rdx = mask (Width = 64 : mot entier, V7)
  db 0x48, 0x21, 0xD0						; and rax, rdx		rax = field non signe
  db 0x48, 0x89, 0x45, 0x00						; mov qword ptr [rbp], rax
end macro
;			----
macro			SBFX					; signed bit field extract
;			----

  POP_RDX								; rdx = Width
  POP_RCX								; rcx = LSB
  db 0x48, 0x8B, 0x45, 0x00						; mov rax, qword ptr [rbp]	valeur source
  db 0x48, 0xD3, 0xE8						; shr rax, cl		rax := valeur >> LSB
  db 0x6A, 0x40							; push 64
  db 0x59								; rcx = 64
  db 0x48, 0x29, 0xD1						; sub rcx, rdx		rcx = 64 - Width
  db 0x48, 0xD3, 0xE0						; shl rax, cl		signe du champ en bit 63
  db 0x48, 0xD3, 0xF8						; sar rax, cl		extension de signe
  db 0x48, 0x89, 0x45, 0x00						; mov qword ptr [rbp], rax
end macro
;			---
macro			BFI					; bit field insert in stacked value
;			---
  POP_RCX								; rcx = Width
  POP_RDX								; rdx = LSB
  POP_RAX								; rax = valeur a inserer
								;  MAKE MASK
  db 0x48, 0xF7, 0xD9						; neg rcx			cl = -Width, soit 64 - Width modulo 64
  db 0x6A, 0xFF							; push -1
  db 0x5B								; pop rbx			rbx = tous les bits a 1
  db 0x48, 0xD3, 0xEB						; shr rbx, cl		mask (Width = 64 : mot entier, V7)
								;  CUT SHIFT INSERTION
  db 0x48, 0x21, 0xD8						; and rax, rbx		inserted &= mask
  db 0x48, 0x89, 0xD1						; mov rcx, rdx		CL = LSB
  db 0x48, 0xD3, 0xE0						; shl rax, cl		inserted <<= LSB
								;  SHIFT INVERT MASK
  db 0x48, 0xD3, 0xE3						; shl rbx, cl		mask <<= LSB
  db 0x48, 0xF7, 0xD3						; not rbx			~shifted_mask
								;  CLEAR INSERT FIELD
  db 0x48, 0x21, 0x5D, 0x00						; and qword [rbp], rbx	clear field in old_quad
  db 0x48, 0x09, 0x45, 0x00						; or  qword [rbp], rax	insert field

end macro

;	CHAMPS DE BITS A POSITION ET LARGEUR IMMEDIATES
;	UBFXI lsb, w : ( v -- champ )   SBFXI lsb, w : ( v -- champ signe )
;	BFII  lsb, w : ( old ins -- new )    lsb 0..63, w 1..64, lsb + w <= 64
;	En x86 chaque macro redonne exactement LI lsb / LI w / UBFX (SBFX, BFI).

;			----------------------------
macro			BF_IMM_CTRL	lsb*, w*
  assert lsb >= 0 & lsb <= 63
  assert w >= 1 & w <= 64
  assert lsb + w <= 64
end macro
;			------------------
macro			UBFXI	lsb*, w*
  BF_IMM_CTRL lsb, w
  LI lsb
  LI w
  UBFX
end macro
;			------------------
macro			SBFXI	lsb*, w*
  BF_IMM_CTRL lsb, w
  LI lsb
  LI w
  SBFX
end macro
;			------------------
macro			BFII	lsb*, w*
  BF_IMM_CTRL lsb, w
  LI lsb
  LI w
  BFI
end macro


;-----------------------------------------------------------------------------------------------------------------------
;		O P E R A T I O N S	  A R I T H M E T I Q U E   E N T I E R E
;-----------------------------------------------------------------------------------------------------------------------

;			---
macro			DEC
;			---
  db 0x48, 0xFF, 0x4D, 0x00						; dec qword ptr [rbp]
  db 0x71, 0x02, 0x0F, 0x0B						; jno +2 ; ud2		debordement signe : faute 129 (V7)
end macro
;			---
macro			INC
;			---
  db 0x48, 0xFF, 0x45, 0x00						; inc qword ptr [rbp]
  db 0x71, 0x02, 0x0F, 0x0B						; jno +2 ; ud2		debordement signe : faute 129 (V7)
end macro
;			---
macro			NEG
;			---
  db 0x48, 0xF7, 0x5D, 0x00						; neg qword ptr [rbp]
  db 0x71, 0x02, 0x0F, 0x0B						; jno +2 ; ud2		debordement signe : faute 129 (V7)
end macro
;			---
macro			ABS
;			---
  db 0x48, 0x8B, 0x45, 0x00						; mov rax, QWORD PTR [rbp]		(lire dans RAX la valeur top X sur le rbp)
  db 0x48, 0xC1, 0xF8, 0x3F						; sar rax, 63			(RAX = tout bit de signe = allsign)
  db 0x48, 0x31, 0x45, 0x00						; xor QWORD PTR [rbp], rax		(X xor allsign)
  db 0x48, 0x29, 0x45, 0x00						; sub QWORD PTR [rbp], rax		( (X xor allsign) - allsign )
  db 0x71, 0x02, 0x0F, 0x0B						; jno +2 ; ud2		debordement signe : faute 129 (V7)
end macro
;			------
macro			CLAMP0					; sommet := max( 0, sommet )		(compte d'elements : intervalle nul -> 0)
;			------
  db 0x48, 0x8B, 0x45, 0x00						; mov rax, QWORD PTR [rbp]		(lire dans RAX la valeur top X sur le rbp)
  db 0x48, 0xC1, 0xF8, 0x3F						; sar rax, 63			(RAX = tout bit de signe = allsign)
  db 0x48, 0xF7, 0xD0						; not rax				(RAX = masque : 0 si X<0, tout-a-un si X>=0)
  db 0x48, 0x21, 0x45, 0x00						; and QWORD PTR [rbp], rax		(X and masque = max(0, X))
end macro
;			---
macro			ADD
;			---
  POP_RAX
  db 0x48, 0x01, 0x45, 0x00						; add qword ptr [rbp], rax
  db 0x71, 0x02, 0x0F, 0x0B						; jno +2 ; ud2		debordement signe : faute 129 (V7)
end macro
;			---
macro			SUB
;			---
  POP_RAX
  db 0x48, 0x29, 0x45, 0x00						; sub qword ptr [rbp], rax
  db 0x71, 0x02, 0x0F, 0x0B						; jno +2 ; ud2		debordement signe : faute 129 (V7)
end macro
;			---
macro			MUL
;			---
  POP_RAX
  db 0x48, 0xF7, 0x6D, 0x00						; imul qword ptr [rbp]
  db 0x71, 0x02, 0x0F, 0x0B						; jno +2 ; ud2		debordement signe : faute 129 (V7)
  DROP
  PUSH_RAX
end macro
;			---
macro			DIV
;			---
  POP_RBX
  POP_RAX
  db 0x48, 0x99							; cqo : extension signee RAX -> RDX:RAX
  db 0x48, 0xF7, 0xFB						; idiv rbx
  PUSH_RAX
end macro
;			----
macro			REMI					; A rem B	  (reste division tronquee, signe du dividende)
;			----
  POP_RBX								; depiler B (diviseur) dans RBX
  POP_RAX								; depiler A (dividende) dans RAX
  db 0x48, 0x99							; cqo   (sign-extend RAX into RDX:RAX)
  db 0x48, 0xF7, 0xFB						; idiv rbx   (RAX=quotient, RDX=reste)
  db 0x48, 0x89, 0xD0						; mov rax, rdx   (resultat = reste)
  PUSH_RAX
end macro
;			----
macro			MODI					; A mod B	  (modulo mathematique, signe du diviseur)
;			----
  POP_RBX								; depiler B (diviseur) dans RBX
  POP_RAX								; depiler A (dividende) dans RAX
  db 0x48, 0x99							; cqo   (sign-extend RAX into RDX:RAX)
  db 0x48, 0xF7, 0xFB						; idiv rbx   (RAX=quotient, RDX=reste)
  db 0x48, 0x89, 0xD0						; mov rax, rdx   (resultat = reste)
  db 0x48, 0x85, 0xC0						; test rax, rax   (reste = 0 ?)
  db 0x74, 0x0B							; jz done	  (si reste=0, pas d ajustement)
  db 0x48, 0x89, 0xC1						; mov rcx, rax   (copie reste dans rcx)
  db 0x48, 0x31, 0xD9						; xor rcx, rbx   (test si signes differents)
  db 0x79, 0x03							; jns done   (meme signe, pas d ajustement)
  db 0x48, 0x01, 0xD8						; add rax, rbx   (ajuster : reste += diviseur)
; done:
  PUSH_RAX
end macro
;			---
macro			SAR					; decalage arithmetique droit
;			---
  POP_RCX								; nombre de positions de decalage
  db 0x48, 0x83, 0xF9, 0x3F, 0x76, 0x02, 0x0F, 0x0B			; cmp rcx, 63 ; jbe +2 ; ud2	compte >= 64 : faute 137 (V7)
  db 0x48, 0xD3, 0x7D, 0x00						; sar qword ptr [rbp], cl
end macro


;-----------------------------------------------------------------------------------------------------------------------
;	O P E R A T I O N S	  A R I T H M E T I Q U E   F L O T T A N T E   ( S S E 2	d o u b l e )
;-----------------------------------------------------------------------------------------------------------------------

;  Convention : les flottants IEEE 754 double 64 bits transitent par la pile entiere (qword)
;  Les macros flottantes utilisent movsd (F2 0F 10/11) pour les transferts pile <-> xmm.
;  movsd est toujours 64 bits, sans ambiguite movd/movq.
;  Sur ARM : vadd.f64 / vsub.f64 / vmul.f64 / vdiv.f64   Sur RISC-V : fadd.d / fsub.d / fmul.d / fdiv.d

;			----
macro			FADD
;			----
  db 0xF2, 0x0F, 0x10, 0x4D, 0x00					; movsd xmm1, [rbp]		(B = TOS dans xmm1)
  DROP									; descendre pile (consommer B)
  db 0xF2, 0x0F, 0x10, 0x45, 0x00					; movsd xmm0, [rbp]		(A = nouveau TOS dans xmm0)
  db 0xF2, 0x0F, 0x58, 0xC1						; addsd xmm0, xmm1		(xmm0 = A + B)
  db 0xF2, 0x0F, 0x11, 0x45, 0x00					; movsd [rbp], xmm0		(ecraser A par le resultat)
end macro
;			----
macro			FSUB
;			----
  db 0xF2, 0x0F, 0x10, 0x4D, 0x00					; movsd xmm1, [rbp]		(B = TOS)
  DROP
  db 0xF2, 0x0F, 0x10, 0x45, 0x00					; movsd xmm0, [rbp]		(A)
  db 0xF2, 0x0F, 0x5C, 0xC1						; subsd xmm0, xmm1		(xmm0 = A - B)
  db 0xF2, 0x0F, 0x11, 0x45, 0x00					; movsd [rbp], xmm0
end macro
;			----
macro			FMUL
;			----
  db 0xF2, 0x0F, 0x10, 0x4D, 0x00					; movsd xmm1, [rbp]		(B = TOS)
  DROP
  db 0xF2, 0x0F, 0x10, 0x45, 0x00					; movsd xmm0, [rbp]		(A)
  db 0xF2, 0x0F, 0x59, 0xC1						; mulsd xmm0, xmm1		(xmm0 = A * B)
  db 0xF2, 0x0F, 0x11, 0x45, 0x00					; movsd [rbp], xmm0
end macro
;			----
macro			FDIV
;			----
  db 0xF2, 0x0F, 0x10, 0x4D, 0x00					; movsd xmm1, [rbp]		(B = TOS = diviseur)
  DROP
  db 0xF2, 0x0F, 0x10, 0x45, 0x00					; movsd xmm0, [rbp]		(A = dividende)
  db 0xF2, 0x0F, 0x5E, 0xC1						; divsd xmm0, xmm1		(xmm0 = A / B)
  db 0xF2, 0x0F, 0x11, 0x45, 0x00					; movsd [rbp], xmm0
end macro
;			----
macro			FNEG						; negation flottante : complement du bit de signe IEEE 754 (bit 63)
;			----
  db 0x80, 0x75, 0x07, 0x80						; xor byte ptr [rbp+7], 0x80  (complementer bit 7 de l'octet haut = bit 63 du qword = signe IEEE 754)
end macro
;			----
macro			FABS						; valeur absolue flottante : mise a zero du bit de signe IEEE 754 (bit 63)
;			----
  db 0x80, 0x65, 0x07, 0x7F						; and byte ptr [rbp+7], 0x7F  (effacer bit 7 de l'octet haut = bit 63 du qword = signe IEEE 754)
end macro

;			----
macro			FEXP						; exponentiation flottante A ** B  (B entier positif sur la pile)
;			----
  POP_RCX								; depiler N (exposant entier)
  db 0xF2, 0x0F, 0x10, 0x45, 0x00					; movsd xmm0, [rbp]		(xmm0 = base)
									; charger 1.0 dans xmm1 (accumulateur)
  db 0x48, 0xB8							; movabs rax, imm64
  dq 1.0								; 1.0 en IEEE 754
  db 0x66, 0x48, 0x0F, 0x6E, 0xC8					; movq xmm1, rax		(xmm1 = 1.0 accumulateur)
  db 0x48, 0x85, 0xC9						; test rcx, rcx		(N = 0 ?)
  db 0x74, 0x09							; jz done			(si N=0, resultat = 1.0, sauter 9 octets)
; loop_exp:
  db 0xF2, 0x0F, 0x59, 0xC8						; mulsd xmm1, xmm0		(accum *= base)
  db 0x48, 0xFF, 0xC9						; dec rcx
  db 0x75, 0xF7							; jnz loop_exp		(boucler N fois)
; done:
  db 0xF2, 0x0F, 0x11, 0x4D, 0x00					; movsd [rbp], xmm1		(ecraser TOS par le resultat)
end macro


;-----------------------------------------------------------------------------------------------------------------------
;	C O N V E R S I O N S   E N T I E R  <->  F L O T T A N T
;-----------------------------------------------------------------------------------------------------------------------

;			-----
macro			CVTIF					; Conversion entier signe 64 bits -> double IEEE 754
;			-----
  db 0x48, 0x8B, 0x45, 0x00						; mov rax, [rbp]		(entier signe depuis la pile)
  db 0xF2, 0x48, 0x0F, 0x2A, 0xC0					; cvtsi2sd xmm0, rax		(convertir entier -> double)
  db 0xF2, 0x0F, 0x11, 0x45, 0x00					; movsd [rbp], xmm0		(ecraser l'entier par le double)
end macro
;			-----
macro			CVTFI					; Conversion double IEEE 754 -> entier signe 64 bits (troncature vers zero)
;			-----
  db 0xF2, 0x0F, 0x10, 0x45, 0x00					; movsd xmm0, [rbp]		(double depuis la pile dans xmm0)
  db 0xF2, 0x48, 0x0F, 0x2C, 0xC0					; cvttsd2si rax, xmm0	(convertir double -> entier avec troncature)
  db 0x48, 0x89, 0x45, 0x00						; mov [rbp], rax		(ecraser le double par l'entier)
end macro

;			------
macro			CVTFIR					; Float -> Integer, arrondi Ada
;			------
  db 0xF2, 0x0F, 0x10, 0x45, 0x00					; movsd xmm0, [rbp]		(double depuis la pile dans xmm0)
  db 0xF2, 0x48, 0x0F, 0x2D, 0xC0					; cvtsd2si rax, xmm0
  db 0x48, 0x89, 0x45, 0x00						; mov qword [rbp], rax
end macro

;-----------------------------------------------------------------------------------------------------------------------
;	C O N V E R S I O N S   E N T I E R  <->  F I X E D
;-----------------------------------------------------------------------------------------------------------------------

;			-----
macro			CVTIX					; Conversion de l'entier I en FIXED X de SMALL = NUMER/DENOM
;			-----					; Sont empilés I puis DENOM puis NUMER (I.D.N)
  POP_RBX								; rbx = NUMER : diviseur
  POP_RCX								; rcx = DENOM : multiplicateur
  POP_RAX								; rax = I : multiplicande
  db 0x48, 0xF7, 0xE9						; imul rcx : RDX:RAX = RAX * RCX
  db 0x48, 0xF7, 0xFB						; idiv rbx : RAX = (RDX:RAX) / RBX
  PUSH_RAX							; Resultat FIXED X sur 64 bits
end macro
;			-----
macro			CVTXI					; Conversion du FIXED X de SMALL = NUMER/DENOM en INTEGER I
;			-----					; Sont empilés X puis NUMER puis DENOM (X.N.D)
  POP_RBX								; rbx = DENOM : diviseur
  POP_RCX								; rcx = NUMER : multiplicateur
  POP_RAX								; rax = X : multiplicande
  db 0x48, 0xF7, 0xE9			     ; imul rcx
  db 0x48, 0xF7, 0xFB			     ; idiv rbx

  db 0x48, 0x89, 0xD1			     ; mov rcx, rdx
  db 0x48, 0xC1, 0xF9, 0x3F			     ; sar rcx, 63
  db 0x48, 0x31, 0xCA			     ; xor rdx, rcx
  db 0x48, 0x29, 0xCA			     ; sub rdx, rcx

  db 0x48, 0xD1, 0xEB			     ; shr rbx, 1
  db 0x48, 0x83, 0xD3, 0x00			     ; adc rbx, 0

  db 0x48, 0x39, 0xDA			     ; cmp rdx, rbx
  db 0x72, 0x07				     ; jb no_round

  db 0x48, 0x83, 0xC9, 0x01			     ; or rcx, 1
  db 0x48, 0x01, 0xC8			     ; add rax, rcx
  PUSH_RAX							; Resultat INTEGER I sur 64 bits
end macro

;-----------------------------------------------------------------------------------------------------------------------
;				C O M P A R A I S O N S
;-----------------------------------------------------------------------------------------------------------------------

;			---
macro			CEQ
;			---
  POP_RBX
  db 0x48, 0x39, 0x5D, 0x00						; cmp [rbp], rbx   (NXT > TOP ?)
  db 0x0F, 0x94, 0x45, 0x00						; sete [rbp]
end macro
;			---
macro			CNE					; A /= B	 A empile puis B
;			---
  POP_RBX								; depiler le B dans RBX
  db 0x48, 0x39, 0x5D, 0x00						; cmp [rbp], rbx   (comparer avec A, calcule A-B)
  db 0x0F, 0x95, 0x45, 0x00						; setne [rbp]
end macro
;			---
macro			CGT					; A > B A empile puis B (note pour avoir "A less than B" intervertir A et B)
;			---
  POP_RBX								; depiler le B dans RBX
  db 0x48, 0x39, 0x5D, 0x00						; cmp [rbp], rbx   (comparer avec A, calcule B-A)
  db 0x0F, 0x9F, 0x45, 0x00						; setg [rbp]
end macro
;			---
macro			CGE					; A >= B A empile puis B (note pour avoir "A less or equal than B" intervertir A et B)
;			---
  POP_RBX								; depiler le B dans RBX
  db 0x48, 0x39, 0x5D, 0x00						; cmp [rbp], rbx   (comparer avec A, calcule B-A)
  db 0x0F, 0x9D, 0x45, 0x00						; setge [rbp]
end macro
;			---
macro			CLT					; A < B	A empile puis B
;			---
  POP_RBX								; depiler le B dans RBX
  db 0x48, 0x39, 0x5D, 0x00						; cmp [rbp], rbx   (comparer avec A, calcule A-B)
  db 0x0F, 0x9C, 0x45, 0x00						; setl [rbp]
end macro
;			---
macro			CLE					; A <= B	 A empile puis B
;			---
  POP_RBX								; depiler le B dans RBX
  db 0x48, 0x39, 0x5D, 0x00						; cmp [rbp], rbx   (comparer avec A, calcule A-B)
  db 0x0F, 0x9E, 0x45, 0x00						; setle [rbp]
end macro

;-----------------------------------------------------------------------------------------------------------------------
;				C O N T R O L E S   D ' I N T E R V A L L E
;-----------------------------------------------------------------------------------------------------------------------
;	CHKt lvl, disp : bornes FST et LST consecutives en DISPLAY[lvl]+disp (forme B)
;	CHKIt lvl, disp, ofs : bornes en [DISPLAY[lvl]+disp]+ofs (forme C)
;	t = B W D Q (bornes signees) ou UB UW UD (non signees), comme la charge qui les lirait.
;	Echec : CONSTRAINT_ERROR par STANDARD.ce_raise_.
;	En x86 chaque macro redonne exactement la sequence de 8 instructions LLIR d'avant.

;			-------------------------------------------------
macro			CHK_SEQ_B		charge*, taille*, lvl*, disp*
;			-------------------------------------------------
  DUP
  charge lvl, disp
  CLT
  BT STANDARD.ce_raise_
  DUP
  charge lvl, disp+taille
  CGT
  BT STANDARD.ce_raise_
end macro
;			-------------------------------------------------------
macro			CHK_SEQ_C		charge*, taille*, lvl*, disp*, ofs*
;			-------------------------------------------------------
  DUP
  charge lvl, disp, ofs
  CLT
  BT STANDARD.ce_raise_
  DUP
  charge lvl, disp, ofs+taille
  CGT
  BT STANDARD.ce_raise_
end macro
;			---------------------
macro			CHKB	lvl*, disp*
  CHK_SEQ_B LB, 1, lvl, disp
end macro
macro			CHKW	lvl*, disp*
  CHK_SEQ_B LW, 2, lvl, disp
end macro
macro			CHKD	lvl*, disp*
  CHK_SEQ_B LD, 4, lvl, disp
end macro
macro			CHKQ	lvl*, disp*
  CHK_SEQ_B LQ, 8, lvl, disp
end macro
;			---------------------
macro			CHKUB	lvl*, disp*
  CHK_SEQ_B ULB, 1, lvl, disp
end macro
macro			CHKUW	lvl*, disp*
  CHK_SEQ_B ULW, 2, lvl, disp
end macro
macro			CHKUD	lvl*, disp*
  CHK_SEQ_B ULD, 4, lvl, disp
end macro
;			---------------------------
macro			CHKIB	lvl*, disp*, ofs*
  CHK_SEQ_C LIB, 1, lvl, disp, ofs
end macro
macro			CHKIW lvl*, disp*, ofs*
  CHK_SEQ_C LIW, 2, lvl, disp, ofs
end macro
macro			CHKID lvl*, disp*, ofs*
  CHK_SEQ_C LID, 4, lvl, disp, ofs
end macro
macro			CHKIQ lvl*, disp*, ofs*
  CHK_SEQ_C LIQ, 8, lvl, disp, ofs
end macro
;			---------------------------
macro			CHKUIB	lvl*, disp*, ofs*
  CHK_SEQ_C ULIB, 1, lvl, disp, ofs
end macro
macro			CHKUIW	lvl*, disp*, ofs*
  CHK_SEQ_C ULIW, 2, lvl, disp, ofs
end macro
macro			CHKUID	lvl*, disp*, ofs*
  CHK_SEQ_C ULID, 4, lvl, disp, ofs
end macro

;-----------------------------------------------------------------------------------------------------------------------
;		C O M P A R A I S O N S   F L O T T A N T E S   ( S S E 2	d o u b l e )
;-----------------------------------------------------------------------------------------------------------------------

;  Convention : A empile puis B. ucomisd positionne les flags ZF/CF (comparaison non ordonnee)
;  setae = above or equal (CF=0), seta = above (CF=0 et ZF=0), etc.
;  Attention : ucomisd est une comparaison non signee des flags, pas signee comme cmp entier.
;  NaN : si un operande est NaN, tous les setXX ci-dessous donneront 0 (comportement Ada : False)
;  sauf FCNE qui donnera 1 (NaN /= x est True).
;  Sur ARM : vcmp.f64 + vmrs APSR   Sur RISC-V : feq.d / flt.d / fle.d

;			----
macro			FCEQ						; A = B  flottant
;			----
  db 0xF2, 0x0F, 0x10, 0x4D, 0x00					; movsd xmm1, [rbp]		(B = TOS)
  DROP
  db 0xF2, 0x0F, 0x10, 0x45, 0x00					; movsd xmm0, [rbp]		(A)
  db 0x66, 0x0F, 0x2E, 0xC1						; ucomisd xmm0, xmm1
  db 0x0F, 0x94, 0x45, 0x00						; sete [rbp]			(ZF=1 si egal)
  db 0x0F, 0x9B, 0xC0						; setnp al			(PF=0 si pas NaN)
  db 0x20, 0x45, 0x00						; and [rbp], al		(result = equal ET pas NaN)
end macro
;			----
macro			FCNE						; A /= B  flottant
;			----
  db 0xF2, 0x0F, 0x10, 0x4D, 0x00					; movsd xmm1, [rbp]		(B = TOS)
  DROP
  db 0xF2, 0x0F, 0x10, 0x45, 0x00					; movsd xmm0, [rbp]		(A)
  db 0x66, 0x0F, 0x2E, 0xC1						; ucomisd xmm0, xmm1
  db 0x0F, 0x95, 0x45, 0x00						; setne [rbp]			(ZF=0 si different)
  db 0x0F, 0x9A, 0xC0						; setp al			(PF=1 si NaN)
  db 0x08, 0x45, 0x00						; or [rbp], al			(result = different OU NaN)
end macro
;			----
macro			FCGT						; A > B  flottant
;			----
  db 0xF2, 0x0F, 0x10, 0x4D, 0x00					; movsd xmm1, [rbp]		(B = TOS)
  DROP
  db 0xF2, 0x0F, 0x10, 0x45, 0x00					; movsd xmm0, [rbp]		(A)
  db 0x66, 0x0F, 0x2E, 0xC1						; ucomisd xmm0, xmm1
  db 0x0F, 0x97, 0x45, 0x00						; seta [rbp]			(A above B)
end macro
;			----
macro			FCGE						; A >= B  flottant
;			----
  db 0xF2, 0x0F, 0x10, 0x4D, 0x00					; movsd xmm1, [rbp]		(B = TOS)
  DROP
  db 0xF2, 0x0F, 0x10, 0x45, 0x00					; movsd xmm0, [rbp]		(A)
  db 0x66, 0x0F, 0x2E, 0xC1						; ucomisd xmm0, xmm1
  db 0x0F, 0x93, 0x45, 0x00						; setae [rbp]			(A above or equal B)
end macro
;			----
macro			FCLT						; A < B  flottant
;			----
  db 0xF2, 0x0F, 0x10, 0x4D, 0x00					; movsd xmm1, [rbp]		(B = TOS)
  DROP
  db 0xF2, 0x0F, 0x10, 0x45, 0x00					; movsd xmm0, [rbp]		(A)
  db 0x66, 0x0F, 0x2E, 0xC8						; ucomisd xmm1, xmm0		(INVERSER : B vs A)
  db 0x0F, 0x97, 0x45, 0x00						; seta [rbp]			(B above A = A below B)
end macro
;			----
macro			FCLE						; A <= B  flottant
;			----
  db 0xF2, 0x0F, 0x10, 0x4D, 0x00					; movsd xmm1, [rbp]		(B = TOS)
  DROP
  db 0xF2, 0x0F, 0x10, 0x45, 0x00					; movsd xmm0, [rbp]		(A)
  db 0x66, 0x0F, 0x2E, 0xC8						; ucomisd xmm1, xmm0		(INVERSER : B vs A)
  db 0x0F, 0x93, 0x45, 0x00						; setae [rbp]			(B above or equal A = A below or equal B)
end macro


;-----------------------------------------------------------------------------------------------------------------------
;			O P E R A T I O N S	  C O N T R O L E	D E   F L O T
;-----------------------------------------------------------------------------------------------------------------------

;			-------------
macro			BRA	lbl				; inconditionnel
;			-------------
  local disp
;  if disp >= -128 & disp <= 127
;    db 0xEB							; jmp rel8
;    db disp
;  else
    db 0xE9							; jmp rel32
    dd disp
;  end if
  disp = lbl-$
end macro
;			-------------
macro			BT	lbl				; branch true
;			-------------
  POP_RAX
  db 0x08, 0xC0							; or AL, AL
  local disp
;  if disp	>= -128 & disp <= 127
;    db 0x75							; jnz rel8
;    db disp
;  else
    db 0x0F, 0x85							; jnz rel32
    dd disp
;  end if
  disp = lbl-$
end macro
;			-------------
macro			BF	lbl				; branch false
;			-------------
  POP_RAX
  db 0x08, 0xC0							; or AL, AL
  local disp
;  if disp	>= -128 & disp <= 127
;    db 0x74							; jz rel8
;    db disp
;  else
    db 0x0F, 0x84							; jz rel32
    dd disp
;  end if
  disp = lbl-$
end macro
;			-------------------------
macro			CALL	prefix, subname			; CALL par offset
;			-------------------------
  if ~ definite prefix#subname#.__appel_postpone		; un seul postpone par procedure et par passe
    prefix#subname#.__appel_postpone = 1			; (leur cout croit comme leur nombre au carre)
    postpone
      if ~definite prefix#subname#_
        prefix#subname#_ = prefix#subname#.elab				; le nom finissant en _ determine l'assemblage de la routine
      end if
    end postpone
  end if

  local ofs
  db 0xE8								; CALL empile sur la micro-pile des adresses de retour (qui croit vers le bas)
  dd ofs
  ofs = prefix#subname#_ - $
end macro
;			---------------------------
macro			CALLI					; CALL indirect par RAX
;			---------------------------
;  postpone
;    if ~definite prefix#subname#_
;      prefix#subname#_ = prefix#subname#.elab				; le nom finissant en _ determine l'assemblage de la routine
;    end if
;  end postpone

  POP_RAX
  db 0xFF, 0xD0							; CALL RAX empile sur la micro-pile des adresses de retour (qui	croit vers le bas)
end macro
;			----------------------
macro			RTD	param_size:0
;			----------------------
  prm_size = param_size
  assert prm_size >= 0						; la taille de desallocation est donnee positive
  if prm_size <> 0							; s'il y a une desallocation
    if prm_size < 128						; de petite taille
      db 0x48, 0x8D, 0x6D, -prm_size					; lea rbp, [rbp - alloc8]
    else								; de grande taille
      db 0x48, 0x8D, 0xAD						; lea rbp, [rbp - alloc32]
      dd -prm_size
    end if
  end if
  db 0xC3								; simple return avec l'adresse sur la micro-pile geree par rsp
end macro


;-----------------------------------------------------------------------------------------------------------------------
;			O P E R A T I O N S	  G E S T I O N   D E   P I L E
;-----------------------------------------------------------------------------------------------------------------------

;			--------------------
macro			LINK	lvl, alloc			; ALLOCATION POUR VARIABLES LOCALES APRES FRAME PTR
;			--------------------
  if lvl > 0							; ATTENTION : rien au lvl 0
    FP_IN_RAX	lvl						; store FP(lvl) le pointeur de pile RBP reste a pointer sur l'empile
    PUSH_RAX
    if	lvl <= 15							; 15 niveaux suivants, petit offset dans le display
      db 0x49, 0x89, 0x6F, 8*lvl					; mov qword ptr [r15 + 8*lvl], rbp   update FP le FP pointe sur l'adresse de sauvegarde du FP anterieur
    else
      db 0x49, 0x89, 0xAF
      dd 8*lvl							; mov qword ptr [r15 + 8*lvl], rbp   update FP le FP pointe sur l'adresse de sauvegarde du FP anterieur
    end if
  end if
			; Faire l'allocation sur la pile de travail standard
  assert alloc >= 0
  if alloc <> 0
    if 8*((alloc+7)/8) < 128
      db 0x48, 0x8D, 0x6D, 8*((alloc+7)/8)				; lea rbp, [rbp + alloc8]
    else
      db 0x48, 0x8D, 0xAD						; lea rbp, [rbp + alloc32]
      dd 8*((alloc+7)/8)
    end if
  end if
			; Gerer la co-pile au cas où on en aurait besoin

  db 0x4D, 0x89, 0x2E						; mov [r14], r13		empiler le frame pointer de co-pile sur celle-ci
  db 0x4D, 0x89, 0xF5						; mov r13, r14		(mettre a jour le frame pointer de co-pile)
  db 0x4D, 0x8D, 0x76, 0x08						; lea r14, [r14 + 8]	(monter le haut de co-pile sur le premier lieu libre)
end macro

;			-------------
macro			UNLINK	lvl				; DISPOSE VARS LOCALES ET RESTORE FRAME PTR
;			-------------
  FP_IN_RBP	lvl						; (throw locals)
  POP_RAX
  RAX_IN_FP	lvl						; (restore stored FP)
			; La co-pile N'EST PAS rendue ici (n 147, contrat d'evasion) : les donnees d'un
			; resultat de fonction TABLEAU vivent dans la region de ce frame et sont consommees
			; par l'appelant APRES le retour. La variante UNLINKR ci-dessous rend la co-pile ;
			; c'est l'EXPANDER qui choisit (EXIT_UNLINK_MNEMONIC) selon le type de resultat.

  db 0x4D, 0x8B, 0x6D, 0x00						; mov r13, [r13]
end macro

;			--------------
macro			UNLINKR	lvl				; UNLINK + LIBERATION DE LA CO-PILE (r14 redescend a la cellule LINK de ce frame)
;			--------------
  FP_IN_RBP	lvl						; (throw locals)
  POP_RAX
  RAX_IN_FP	lvl						; (restore stored FP)
			; Chantier co-pile (n 163) : rendre TOUT ce que ce frame a alloue, cellule LINK comprise.
			; INTERDIT pour un frame de fonction a resultat TABLEAU (contrat d'evasion n 147) :
			; l'expander n'emet UNLINKR que si le resultat est copie chez l'appelant avant l'epilogue.
  db 0x4D, 0x89, 0xEE						; mov r14, r13	(sommet := cellule LINK de ce frame = r14 d'avant LINK)
  db 0x4D, 0x8B, 0x6D, 0x00						; mov r13, [r13]	(frame de co-pile anterieur)
end macro

;			----------------------
macro			PRO	sub_name_lbl			; Debut de procedure declaree
;			----------------------
  namespace sub_name_lbl						; definir son espace de noms
  BRA post							; contournement de l'elaboration autour de la procedure
end macro

;			----
macro			PRMS					; En tete de la definition des parametres
;			----
  virtual at 8							; La pile de travail croit vers les adresses hautes, les parametres sont au dessus du FP dynamique
    PRMzone::							; donc 8 octets (adresses 64 bits) au dessus du FP
  end virtual

end macro

;			------------------
macro			PRM	name_ofs				; Definition d'un parametre
;			------------------
  virtual PRMzone
    name_ofs = $
    dq ?
  end virtual

end macro

;			-------
macro			endPRMS					; Fin de la definition des parametres adjust = 8 pour fonction
;			-------
  virtual PRMzone
    prm_siz = $-8							; Calcul de la taille du parametrage
  end virtual

end macro

;			-------------
macro			ELB	lvl				; En tete de la partie elaboration de procedure
;			-------------
elab:
  virtual at 8							; Commence 8 octets apres le FP dynamique
    VARzone::
  end virtual
	LINK lvl, loc_siz

end macro

;			--------------
macro			BEGIN_BLOC_DEF				; Debut du bloc d'images d'un enumere
;			--------------
;	Donnees inline protegees par BRA (pattern des thunks LD_/ST_, sain
;	sous "if defined"). Macros ordinaires, noms FIXES : la paire vit dans
;	le namespace _TYPE de l'enumere, unicite garantie par construction.
;	Ni struc coupee, ni postpone, ni "!", ni local inter-macros.
  BRA	IMAGES.skip
IMAGES.data = $							; les db d'images suivent, inline
end macro

;			---------------------------------
macro			END_BLOC_DEF	siz, fst, lst		; Fin : pose le ENUM_USE_INFO etendu
;			---------------------------------
;	CONTRAT (record ENUM_USE_INFO du prelude + doublet images) :
;	  SIZ @0 (dd) | FST @+4 | LST @+8 | pad | data_ptr @+16 | info_ptr @+24
;	  use__info pointe SIZ ; TEXT_IO (GET_ENUM_IMAGES) lit le doublet a __u+16.
IMAGES.data_end = $							; fin des octets d'images (avant info/scalaires)
  align_q
IMAGES.info = $
	dd 8*(IMAGES.data_end - IMAGES.data), 8, 1, IMAGES.data_end - IMAGES.data
SIZ = $
	dd siz
FST = $
	dd fst
LST = $
	dd lst
	dd 0
IMAGES.data_ptr = $
	dq IMAGES.data
IMAGES.info_ptr = $
	dq IMAGES.info
IMAGES.skip:
end macro

;	Une chaine Ada est un tableau d'octets caracteres, c'est a dire un descripteur [ PTR_TO CHARS qword | CAR_SIZE dword | FIRST dword | LAST dword ]
; et des caracteres qui pointes par PTR_TO_CHARS peuvent etre detaches du descripteur. Ici, cas de constante, les caracteres sont juste apres le descripteur.
;	On décompose en deux parties la constitution d'une chaîne pour pouvoir insérer tous les octets voulus.

;			---------------------
macro			STR	name, bytes			; Definition d'une constante chaine au format d'un tableau de caracteres (pour traitement homogene des chaines)
;			---------------------
;	Une chaine Ada est un tableau d'octets caracteres, c'est a dire un descripteur [ PTR_TO CHARS qword | CAR_SIZE dword | FIRST dword | LAST dword ]
; et des caracteres qui pointes par PTR_TO_CHARS peuvent etre detaches du descripteur. Ici, cas de constante, les caracteres sont juste apres le descripteur.
;
  postpone
    local data
    local info
    local str_bit_size
    align_q							; aligner le descripteur sur un quadword

  namespace name

  data_ptr = $							; adresse de la constante STRING (en fait double pointeur)
    dq	data							; offset 0 : adresse des caracteres (juste apres dans le cas present)
  info_ptr = $							;
    dq	info							; offset 8 : adresse des infos TOT_SIZ, COMP_SIZ, FST_1, LST_1
  info = $							; use info
    dd	str_bit_size, 8, 1, str_bit_size/8				; offset 16 : TOT_SIZ=str_bit_size ; offset 20 :  COMP_SIZ=8bits ; offset	24 : FST=1 ; offset 28 : LST=str_byte_size
    virtual at 0							; definition des offsets sur le useinfo
    SIZ = $
    rd 1
    COMP_SIZ = $
    rd 1
    FST_1 = $
    rd 1
    LST_1 = $
    end virtual
  data = $							; pour une constante les caracteres suivent (pour une chaine variable ce n'est pas le cas, les octets sont dans la co-pile)
    db	bytes
    str_bit_size =  8*($ - data)					; Calculer la longueur effective en bits
  end namespace

  end postpone
end macro

;			-----------------------------------------
macro			CST	name_cst:_nil_, sizChar:b, val&	; Definition d'une constante
;			-----------------------------------------
  postpone
    align_#sizChar							; aligner en fonction de l'unite de reservation
    name_cst = $							;
    d#sizChar val							; reservation
  end postpone
end macro

;			----------------------------------------
macro			USEINFO	lvl, field_name, load_instruc&	; Reference a un __u use info
;			----------------------------------------
  virtual VARzone
    align_q							; aligner en fonction de l'unite de reservation
    field_name#__u = $						; lieu ptr use info
    rq 1
  end virtual
  load_instruc
  SA lvl, field_name#__u
end macro

;			---------------------------
macro			STATOFS	name, siz, algn:0			; Definition de l'offset statique (pour un record statique, dans une virtual at 0)
;			---------------------------
; algn = alignement du COMPOSANT elementaire en octets (1/2/4/8), passe par
; l'expander. algn 0 : compatibilite, ancienne regle par taille totale.
  if algn = 8
    align_q
  else if algn = 4
    align_d
  else if algn = 2
    align_w
  else if algn = 1
								; octets : pas d'alignement
  else								; algn 0 : ancienne regle
    if siz > 4
      align_q
    else if siz > 2
      align_d
    else if siz > 1
      align_w
    end if
  end if
name = $								; nom offset du champ
  rb siz								; reservation
end macro

;			-----------------------------------
macro			VAR	name_disp, sizChar, siz:1		; Definition d'un lieu de variable
;			-----------------------------------
  virtual VARzone
     if `sizChar = 'B'  |  `sizChar = 'b'
      align_b
      name_disp = $							; displacement des data de variable
      rb siz							; reservation
    else if `sizChar = 'W'  |  `sizChar = 'w'
      align_w
      name_disp = $
      rw siz
    else if `sizChar = 'D'  |  `sizChar = 'd'
      align_d
      name_disp = $
      rd siz
    else if `sizChar = 'Q'  |  `sizChar = 'q'
      align_q
      name_disp = $
      rq siz
    else
      align_q							; assurer l'alignement de pile dans tous les cas possibles
      name_disp = $							; displacement des data de variable
      rb sizChar							; taille numerique en octets
    end if
  end virtual
end macro

;			------
macro			CO_VAR					; Allocation d'un bloc sur la co-pile taille en octets sur la pile standard, laisse l'adresse de debut de bloc sur la pile
;			------
  POP_RAX								; la taille d'allocation a ete empilee, la mettre dans rax
  db 0x4C, 0x89, 0x75, 0x08						; mov QWORD PTR [rbp+8], r14		(empiler le haut de co-pile R14 sur la pile standard)
  db 0x48, 0x8D, 0x6D, 0x08						; lea rbp, [rbp+0x8]		(puis MONTER le rbp sur la valeur ecrite car pile croissante vers adresses hautes)
  db 0x48, 0x83, 0xC0, 0x07						; add rax, 7
  db 0x48, 0xC1, 0xF8, 0x03						; sar rax, 3			(diviser par 8, rax est positif normalement)
  db 0x4D, 0x8D, 0x34, 0xC6						; lea r14, [r14 + 8*rax]		(mettre le sommet de co-pile aligne sur qword)
end macro

;			----------
macro			HEAP_ALLOC				; Allocation bump-pointer pour Ada new : taille en octets sur pile, laisse @bloc
;			----------
  POP_RAX								; rax = taille demandee
  db 0x48, 0x83, 0xC0, 0x07						; add rax, 7
  db 0x48, 0xC1, 0xF8, 0x03						; sar rax, 3	nombre de qwords
  db 0x48, 0xC1, 0xE0, 0x03						; shl rax, 3	taille alignee en octets
  db 0x49, 0x29, 0xC4						; sub r12, rax	tas descendant depuis le haut reserve
  db 0x4C, 0x89, 0xE0						; mov rax, r12	adresse du nouveau bloc
  PUSH_RAX
end macro

;			------
macro			endPRO					; Fin de procedure
;			------
post:
  virtual VARzone
    align_q
    loc_siz = $							; Ce n'est que la que l'on calcule la taille des locales qui sera retropropagee au LINK du ELAB
  end virtual
  end namespace
end macro

;			----------------------------
macro			EXC_MACH		lvl, ctx			; PILIER 11 : photographie de l'etat machine cache
;			----------------------------			; dans le contexte de reprise a [FP(lvl) + ctx].
		; Remplit +16.. : RBP (pile de travail, etat courant),
		; RSP (micro-pile), R13/R14 (co-pile), nlvl = lvl+1,
		; puis le prefixe display FP(0..lvl).
		; Le PROTOCOLE (prev, dispatch, EXC_TOP) est de la
		; LLIR ordinaire emise par l'expander -- pas ici.
		; Clobbere RAX, RCX, RSI, RDI (registres de travail).
		; Chemin froid (une fois par entree de frame porteur
		; de handlers) : deplacements disp32 uniformes.
  assert lvl >= 0 & lvl <= 31
  FP_IN_RAX lvl							; rax := FP(lvl)
  db 0x48, 0x89, 0xA8						; mov [rax + ctx+16], rbp
  dd ctx + 16
  db 0x48, 0x89, 0xA0						; mov [rax + ctx+24], rsp
  dd ctx + 24
  db 0x4C, 0x89, 0xA8						; mov [rax + ctx+32], r13
  dd ctx + 32
  db 0x4C, 0x89, 0xB0						; mov [rax + ctx+40], r14
  dd ctx + 40
  db 0x48, 0xC7, 0x80						; mov qword [rax + ctx+48], lvl+1   (nlvl)
  dd ctx + 48
  dd lvl + 1
  db 0x48, 0x8D, 0xB8						; lea rdi, [rax + ctx+56]   (destination du prefixe)
  dd ctx + 56
  db 0x4C, 0x89, 0xFE						; mov rsi, r15	(source : le display)
  db 0xB9								; mov ecx, lvl+1
  dd lvl + 1
  db 0xF3, 0x48, 0xA5						; rep movsq     (FP(0..lvl) -> ctx+56..)
end macro

;			-----------------------
macro			EXC_RAISE		top			; PILIER 11 : deroulage. Corps de l'INSTANCE UNIQUE,
;			-----------------------			; posee par le wrapper sous le label exc_raise_ ;
			; top = deplacement VARzone niveau 0 du sommet de
			; pile des contextes (EXCEPTIONS_TOP_CTX_disp).
			; Precondition : EXCEPTIONS_CURRENT pose.
			; POP AVANT dispatch (LRM 11.4.1 : raise dans un
			; handler -> appelant ; fond de dispatch -> re-BRA).
			; Atteint par BRA, jamais par CALL.
  db 0x49, 0x8B, 0x1F						; mov rbx, [r15]		(rbx := FP(0))
  db 0x48, 0x8B, 0x83						; mov rax, [rbx + top]	(rax := contexte sommet)
  dd top
  db 0x48, 0x8B, 0x08						; mov rcx, [rax]		(PREV_CTX)
  db 0x48, 0x89, 0x8B						; mov [rbx + top], rcx	(POP avant dispatch)
  dd top
  db 0x4C, 0x8B, 0x68, 0x20						; mov r13, [rax+32]		(frame pointer co-pile)
  db 0x4C, 0x8B, 0x70, 0x28						; mov r14, [rax+40]		(sommet co-pile : balaye
			  ;  frames abandonnes et temporaires d'instruction)
  db 0x48, 0x8B, 0x60, 0x18						; mov rsp, [rax+24]		(micro-pile : jette les
			  ;  adresses de retour des frames deroules)
  db 0x48, 0x8B, 0x48, 0x30						; mov rcx, [rax+48]		(NXT_LVL)
  db 0x48, 0x8D, 0x70, 0x38						; lea rsi, [rax+56]
  db 0x4C, 0x89, 0xFF						; mov rdi, r15
  db 0xF3, 0x48, 0xA5						; rep movsq		(restaurer FP(0..lvl))
  db 0x48, 0x8B, 0x68, 0x10						; mov rbp, [rax+16]		(pile de travail)
  db 0xFF, 0x60, 0x08						; jmp [rax+8]		(DISPATCH du frame porteur)
end macro

;-----------------------------------------------------------------------------------------------------------------------
;		O P E R A T I O N S	  L O G I Q U E S	D E   B L O C   (LRM 4.5.1) -- lot D3
;-----------------------------------------------------------------------------------------------------------------------
; Composants BOOLEAN : un octet par composant (CD_IMPL_SIZE 1 bit arrondi au
; STORAGE_UNIT, piege n 56), valeurs 0/1 -> l'operation octet a octet est exacte.
; Convention binaire, miroir de BLKMOV : pile = @DST, LEN, @SRC ; [DST] op= [SRC].
; La destination a deja recu la copie de l'operande GAUCHE par BLKMOV.
; LEN en octets, borne a 0 par CLAMP0 en amont (piege n 52) -- garde jz neanmoins.
; Detruit RAX (al), RCX, RSI, RDI.

;			------------------------
macro			BLK_OP_OCTET	opc*			; usine interne : opc = octet d'opcode "op r/m8, r8"
;			------------------------
  local  boucle, fin
  POP_RSI								; @SRC (operande droit)
  POP_RCX								; LEN (octets)
  POP_RDI								; @DST (copie de l'operande gauche)
  db 0x48, 0x85, 0xC9						; test rcx, rcx
  db 0x74, fin - $ - 1						; jz  fin		(LEN = 0 : tableau nul)
boucle:
  db 0x8A, 0x06							; mov al, [rsi]
  db opc,  0x07							; op  [rdi], al		(and=0x20, or=0x08, xor=0x30)
  db 0x48, 0xFF, 0xC6						; inc rsi
  db 0x48, 0xFF, 0xC7						; inc rdi
  db 0xE2, boucle - $ - 1						; loop boucle		(decremente rcx)
fin:
end macro
;			------
macro			BLKAND					; [DST] and= [SRC] octet a octet
;			------
  BLK_OP_OCTET 0x20
end macro
;			-----
macro			BLKOU					; [DST] or= [SRC] octet a octet
;			-----
  BLK_OP_OCTET 0x08
end macro
;			------
macro			BLKOUX					; [DST] xor= [SRC] octet a octet
;			------
  BLK_OP_OCTET 0x30
end macro
;			------
macro			BLKNOT					; NOT composite : chaque octet ^= 1
;			------
; Pile = @DST, LEN.  xor avec 1 et non 0xFF : c'est le NOT booleen 0/1
; (piege n 5) applique par octet.  La destination a deja recu la copie
; de l'operande par BLKMOV.
  local  boucle, fin
  POP_RCX								; LEN (octets)
  POP_RDI								; @DST
  db 0x48, 0x85, 0xC9						; test rcx, rcx
  db 0x74, fin - $ - 1						; jz  fin
boucle:
  db 0x80, 0x37, 0x01						; xor byte [rdi], 1
  db 0x48, 0xFF, 0xC7						; inc rdi
  db 0xE2, boucle - $ - 1						; loop boucle
fin:
end macro
;			------
macro			BLKMOV					; Copie de bloc sans recouvrement
;			------
  POP_RSI								; adresse source
  POP_RCX								; nombre octets
  POP_RDI								; adresse destination
  db 0x48, 0x85, 0xC9						; test rcx, rcx
  db 0x74, 0x05							; jz +5  (skip la boucle)
  db 0xFC								; cld			(direction flag montant)
  db 0xAC								; lods al, BYTE PTR ds:[rsi]
  db 0xAA								; stos BYTE PTR es:[rdi], al
  db 0xE2, 0xFC							; loop transfer		(transfere ecx octets
end macro
;			------
macro			BLKCMP					; Comparaison de blocs : empile 1 si egaux, 0 sinon (LEN=0 -> 1)
;			------
  POP_RSI								; adresse B
  POP_RCX								; nombre octets
  POP_RDI								; adresse A
  db 0x31, 0xC0							; xor eax, eax		(RAX=0 et ZF=1 : blocs vides egaux)
  db 0x48, 0x85, 0xC9						; test rcx, rcx
  db 0x74, 0x03							; jz +3			(saute cld + repe cmpsb, ZF=1 conserve)
  db 0xFC								; cld			(direction flag montant)
  db 0xF3, 0xA6							; repe cmpsb		(ZF=1 ssi tous octets egaux)
  db 0x0F, 0x94, 0xC0						; sete al			(AL=1 si ZF)
  PUSH_RAX
end macro
;			-----------------
macro			LEXCMP siz*, sgn*				; Comparaison lexicographique de tableaux (LRM 4.5.2) -- lot D2
;			-----------------
; Pile a l'entree : @G, LEN_G, @D, LEN_D	(longueurs en OCTETS, bornees a 0 par CLAMP0 -- piege n 52)
; Empile : -1 / 0 / +1 (qword signe), a confronter a LI 0 par CLT/CLE/CGT/CGE cote expander.
; Parametres :	siz = octets par composant (1, 2, 4, 8)
;		sgn = 1 composant signe (INTEGER), 0 non signe (enumeres, CHARACTER, BOOLEAN)
;
; repe cmpsb inutilisable : composants multi-octets little-endian, et signes possibles.
; NORMALISATION : chaque composant est etendu a 64 bits (movsx si sgn, movzx sinon) ;
; apres quoi UNE SEULE comparaison signee 64 bits est correcte dans les deux cas.
; Regle du prefixe (4.5.2) : a l'epuisement sans difference, resultat = sign(reste_G - reste_D)
; -- couvre aussi les tableaux nuls (0 itération, restes compares directement).
; Detruit RAX, RBX, RCX, RDX, RSI, RDI (comme BLKMOV/BLKCMP).

  local  boucle, epuise, differe, plus, egal, moins, empile

  POP_RDX								; LEN_D (octets)
  POP_RSI								; @D
  POP_RCX								; LEN_G (octets)
  POP_RDI								; @G

boucle:
  db 0x48, 0x85, 0xC9						; test rcx, rcx		G epuise ?
  db 0x74, epuise - $ - 1						; jz  epuise
  db 0x48, 0x85, 0xD2						; test rdx, rdx		D epuise ?
  db 0x74, epuise - $ - 1						; jz  epuise

if siz = 1
  if sgn = 1
    db 0x48, 0x0F, 0xBE, 0x07						; movsx rax, byte [rdi]
    db 0x48, 0x0F, 0xBE, 0x1E						; movsx rbx, byte [rsi]
  else
    db 0x0F, 0xB6, 0x07						; movzx eax, byte [rdi]
    db 0x0F, 0xB6, 0x1E						; movzx ebx, byte [rsi]
  end if
else if siz = 2
  if sgn = 1
    db 0x48, 0x0F, 0xBF, 0x07						; movsx rax, word [rdi]
    db 0x48, 0x0F, 0xBF, 0x1E						; movsx rbx, word [rsi]
  else
    db 0x0F, 0xB7, 0x07						; movzx eax, word [rdi]
    db 0x0F, 0xB7, 0x1E						; movzx ebx, word [rsi]
  end if
else if siz = 4
  if sgn = 1
    db 0x48, 0x63, 0x07						; movsxd rax, dword [rdi]
    db 0x48, 0x63, 0x1E						; movsxd rbx, dword [rsi]
  else
    db 0x8B, 0x07							; mov eax, [rdi]	(zero-etend en 64 bits)
    db 0x8B, 0x1E							; mov ebx, [rsi]
  end if
else if siz = 8
    db 0x48, 0x8B, 0x07						; mov rax, [rdi]	(signe indifferent : pleine largeur)
    db 0x48, 0x8B, 0x1E						; mov rbx, [rsi]
else
  err 'LEXCMP : taille de composant non supportee'
end if

  db 0x48, 0x39, 0xD8						; cmp rax, rbx		(signee 64 bits, operandes normalises)
  db 0x75, differe - $ - 1						; jne differe

  db 0x48, 0x83, 0xC7, siz						; add rdi, siz		composant suivant
  db 0x48, 0x83, 0xC6, siz						; add rsi, siz
  db 0x48, 0x83, 0xE9, siz						; sub rcx, siz
  db 0x48, 0x83, 0xEA, siz						; sub rdx, siz
  db 0xEB, boucle - $ - 1						; jmp boucle

epuise:								; prefixe commun : sign(reste_G - reste_D) tranche
  db 0x48, 0x29, 0xD1						; sub rcx, rdx
  db 0x74, egal  - $ - 1						; jz  egal		longueurs egales -> 0
  db 0x78, moins - $ - 1						; js  moins		G prefixe strict -> -1
plus:
  db 0x6A, 0x01							; push 1
  db 0x58								; pop  rax		rax := +1
  db 0xEB, empile - $ - 1						; jmp empile
differe:								; flags encore armes par le cmp rax, rbx
  db 0x7C, moins - $ - 1						; jl  moins
  db 0xEB, plus - $ - 1						; jmp plus
egal:
  db 0x31, 0xC0							; xor eax, eax		rax := 0
  db 0xEB, empile - $ - 1						; jmp empile
moins:
  db 0x6A, 0xFF							; push -1		(imm8 etendu de signe en qword)
  db 0x58								; pop  rax		rax := -1
empile:
  PUSH_RAX
end macro

;				------------------------------
;				SPECIFIQUE  L I N U X   X86-64
;				------------------------------


;-----------------------------------------------------------------------
; SYS_CLOCK_GETTIME -- @timespec_buffer →
;
; Lit l'horloge UTC (CLOCK_REALTIME). Le paramètre est dépilé : c'est
; l'adresse d'une zone de 16 octets (struct timespec : qword tv_sec,
; qword tv_nsec) qui sera remplie par le noyau.
;
; Syscall 228 (sys_clock_gettime), CLOCK_REALTIME = 0.
; ABI Linux x86-64 : RAX=syscall_no, RDI=arg1, RSI=arg2, syscall.
; Détruit RAX, RCX, RDX, RDI, RSI, R11 (convention syscall Linux).
;-----------------------------------------------------------------------

;			-----------------
macro			SYS_CLOCK_GETTIME
;			-----------------
  POP_RSI								; RSI = @timespec_buffer
  db 0x48, 0x31, 0xFF						; xor rdi, rdi	RDI = CLOCK_REALTIME
  db 0x68, 0xE4, 0x00, 0x00, 0x00					; push 228	sys_clock_gettime
  db 0x58								; pop rax
  db 0x0F, 0x05							; syscall
end macro


;			------------
macro			SYS_PUT_CHAR				; affiche un seul caractere sur stdout
;			------------

  db 0x48, 0x89, 0xEE						; mov rsi, rbp	(ADRESSE du caractere empile sur la pile)
  db 0x6A, 0x01							; push 1
  db 0x58								; pop rax		(rax=1=sys_write )
  db 0x48, 0x89, 0xC2						; mov rdx, rax	(rdx=length=1)
  db 0x48, 0x89, 0xC7						; mov rdi, rax	(rdi=stdout=1)
  db 0x0F, 0x05							; syscall
  DROP								; caractere consomme
end macro


;			-----------
macro			SYS_PUT_STR				; affiche tout une chaine sur stdout
;			-----------
  POP_RSI								;			(l'adresse du doublet @DATA | @USEINFO a ete empilee)
  db 0x48, 0x8B, 0x46, 0x08						; mov rax, [rsi+8]		(rax contient l'adresse du USEINFO
  db 0x8B, 0x50, 0x0C						; mov edx, dword ptr[rax+12]  (edx=last)
  db 0xFF, 0xC2							; inc edx			(last+1)
  db 0x2B, 0x50, 0x08						; sub edx, dword ptr[rax+8]	edx=length (=last+1 - first)
  db 0x6A, 0x01							; push 1
  db 0x58								; pop rax			(rax=1=sys_write )
  db 0x48, 0x89, 0xC7						; mov rdi, rax		(rdi=stdout=1)
  db 0x48, 0x8B, 0x36						; mov rsi, [rsi]		(rsi est maintenant l'adresse des caracteres)
  db 0x0F, 0x05							; syscall
end macro


; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
;	Pour le GET de caractere on veut obtenir chaque caractere tape immediatement, il faut modifier le comportement du terminal
;struc termios{
;        .c_iflag	rd 1						; 0 input mode flags
;        .c_oflag	rd 1						; 4 output mode flags
;        .c_cflag	rd 1						; 8 control mode flags
;        .c_lflag	rd 1						; 12 local mode flags
;        .c_line	rb 1						; line discipline
;        .c_cc	rb 32						; control characters
;        .c_ispeed  rd 1						; input speed
;        .c_ospeed  rd 1						; output speed
;}
;			------------
macro			SYS_GET_CHAR				; lit un seul caractere sur stdin en mode non canonique
;			------------
			; reserver le termios sur la micro-pile du rsp
  db 0x48, 0x83, 0xEC, 0x40						; sub rsp, 64 (espace large pour le termios)
			; amener le termios
  db 0x6A, 0x10							; push 16
  db 0x58								; pop rax		(rax=16=sys_ioctl)
  db 0x48, 0x31, 0xFF						; xor rdi, rdi	(rdi=stdin=0)
  db 0x48, 0xC7, 0xC6, 0x01, 0x54, 0x00, 0x00				; mov rsi, 0x5401	(TCGETS)
  db 0x48, 0x89, 0xE2						; mov rdx, rsp	(adresse du termios temporaire)
  db 0x0F, 0x05							; syscall		(copier le termios)
			; modifier le termios
  db 0x83, 0x64, 0x24, 0x0C, 0xF5					; and dword ptr [rsp+12], 0xFFFFFFF5	(ICANON bit 1 de c_lflag mis a 0 et bit 3 ECHO a 0)
			; renvoyer le termios modifie
  db 0x6A, 0x10							; push 16
  db 0x58								; pop rax		(rax=16=sys_ioctl)
  db 0x48, 0x31, 0xFF						; xor rdi, rdi	(rdi=stdin=0)
  db 0x48, 0xC7, 0xC6, 0x02, 0x54, 0x00, 0x00				; mov rsi, 0x5402	(TCSETS)
  db 0x48, 0x89, 0xE2						; mov rdx, rsp	(adresse du termios temporaire)
  db 0x0F, 0x05							; syscall		(envoyer le termios modifie)
			; lire le caractere en mode non canonique
  POP_RSI								;		(l'adresse destination a ete empilee sur la pile croissante)
  db 0x6A, 0x00							; push 0
  db 0x58								; pop rax		(rax=0=sys_read)
  db 0x48, 0x89, 0xC7						; mov rdi, rax	(rdi=stdin=0)
  db 0x6A, 0x01							; push 1
  db 0x5A								; pop rdx		(rdx=length=1 caractere)
  db 0x0F, 0x05							; syscall

  db 0x83, 0x4C, 0x24, 0x0C, 0x0A					; or dword ptr [rsp+12], 0xA  (ICANON bit 1 de c_lflag remis a 1 et ECHO bit 3)
			; renvoyer le termios modifie
  db 0x6A, 0x10							; push 16
  db 0x58								; pop rax		(rax=16=sys_ioctl)
  db 0x48, 0x31, 0xFF						; xor rdi, rdi	(rdi=stdin=0)
  db 0x48, 0xC7, 0xC6, 0x02, 0x54, 0x00, 0x00				; mov rsi, 0x5402	(TCSETS)
  db 0x48, 0x89, 0xE2						; mov rdx, rsp	(adresse du termios temporaire)
  db 0x0F, 0x05							; syscall		(envoyer le termios modifie)
			; remettre le pointeur de micro-pile a sa place initiale
  db 0x48, 0x83, 0xC4, 0x40						; add rsp, 64
end macro

;			-----------
macro			SYS_GET_STR				; lit une ligne sur stdin
;			-----------
  POP_RSI								;			(l'adresse du doublet @DATA | @USEINFO a ete empilee)
  db 0x48, 0x8B, 0x46, 0x08						; mov rax, [rsi+8]		(rax contient l'adresse du USEINFO
  db 0x8B, 0x50, 0x0C						; mov edx, dword ptr[rax+12]  (edx=last)
  db 0xFF, 0xC2							; inc edx			(last+1)
  db 0x2B, 0x50, 0x08						; sub edx, dword ptr[rax+8]	edx=length (=last+1 - first)
  db 0x31, 0xC0							; xor eax, eax		(rax=0=sys_read )
  db 0x31, 0xFF							; xor edi, edi		(rdi=stdin=0)
  db 0x48, 0x8B, 0x36						; mov rsi, [rsi]		(rsi est maintenant l'adresse des caracteres)
  db 0x0F, 0x05							; syscall
  POP_RSI								;			(sur la pile croissante, adresse de la longueur effectivement lue qui peut etre inferieure a la longueur de string)
  db 0xFF, 0xC8							; dec eax			(diminuer la longueur rendue = retirer le caractere de fin)
  db 0x89, 0x06							; mov dword ptr[rsi], eax	(reporter la longueur effectivement lue retournee par syscall dans eax)
end macro

;			----------------------
macro			COPY_STRING_APPEND_NUL			; donne le descripteur pointe par RSI, copie la chaine sur la pile montante et ajoute un NUL de fin
;			----------------------
  db 0x48, 0x8B, 0x46, 0x08						; mov rax, [rsi+8]		(rax contient l'adresse du USEINFO

  db 0x8B, 0x48, 0x0C						; mov ecx, dword ptr[rax+12]  (ecx=last)
  db 0xFF, 0xC1							; inc ecx			(last+1)
  db 0x2B, 0x48, 0x08						; sub ecx, dword ptr[rax+8]	(ecx= nombre de caracteres =last+1 - first)
  db 0x48, 0x8B, 0x36						; mov rsi, qword ptr[rsi]	(rsi= adresse des caracteres)
  db 0x48, 0x8D, 0x7D, 0x08						; lea rdi, [rbp+0x8]	(on va empiler la chaine sur la pile)
  db 0xFC								; cld			(direction flag montant)
; transfer:
  db 0xAC								; lods al, BYTE PTR ds:[rsi]
  db 0xAA								; stos BYTE PTR es:[rdi], al
  db 0xE2, 0xFC							; loop transfer		(transfere ecx octets
  db 0xC6, 0x07, 0x00						; mov BYTE PTR[rdi], 0	(caractere NUL de fin chaine C)
  db 0x48, 0x8D, 0x7D, 0x08						; lea rdi, [rbp+0x8]	(remettre RDI sur le debut de chaine)
end macro

;			---------------
macro			SYS_FILE_CREATE				; FONCTION creation d'un fichier	rax=2 rdi=ptr_name rsi=flags(O_CREAT) rdx=mode(S_IRWXU) retour rax=ID
;			---------------
  POP_RSI								; adresse du descripteur de chaine Ada
  COPY_STRING_APPEND_NUL						; faire une copie sur pile avec NUL en fin pointee par RDI
  db 0x6A, 0x02							; push 2
  db 0x58								; pop rax			(rax=2=sys_open )
  db 0xBE, 0x42, 0x02, 0x00, 0x00					; mov esi, 0x242		(rsi=0x242=O_CREAT+O_RDWR+O_TRUNC)
  db 0xBA, 0xC0, 0x01, 0x00, 0x00					; mov edx, 0x1C0		(rdx=b111_000_000=u+rwx)
  db 0x0F, 0x05							; syscall
  db 0x48, 0x89, 0x45, 0x00						; mov QWORD PTR [rbp], rax	(ATTENTION PAS PUSH ! ID de fichier rendu sur le lieu result de la fonction)
end macro

;			-------------
macro			SYS_FILE_OPEN				; FONCTION ouverture d'un fichier
;			-------------
  POP_RSI								; adresse du descripteur de chaine Ada
  COPY_STRING_APPEND_NUL						; faire une copie sur pile avec NUL en fin pointee par RDI
  db 0x6A, 0x02							; push 2
  db 0x58								; pop rax			(rax=2=sys_open )
  db 0x6A, 0x02							; push 2
  db 0x5E								; pop rsi			(rsi=2=flags=RDWR)
  db 0x48, 0x31, 0xD2						; xor rdx,rdx		(mode= 0 sans importance)
  db 0x0F, 0x05							; syscall
  db 0x48, 0x89, 0x45, 0x00						; mov QWORD PTR [rbp], rax	(ATTENTION PAS PUSH ! ID de fichier rendu sur le lieu result de la fonction)
end macro

;			----------------
macro			SYS_FILE_SET_POS				; positionnement sur un fichier
;			----------------
  POP_RDI								;		(rdi = FILE_ID)
  POP_RSI								;		(rsi = offset du début)
  db 0x48, 0x31, 0xD2						; xor rdx, rdx	(rdx = 0 = SEEK_SET = position du début
  db 0x6A, 0x08							; push 8
  db 0x58								; pop rax		(rax = 8= lseek)
  db 0x0F, 0x05							; syscall
  db 0x48, 0x89, 0x45, 0x00						; mov QWORD PTR [rbp], rax	(ATTENTION PAS PUSH ! ID de fichier rendu sur le lieu result de la fonction)
end macro

;			----------------
macro			SYS_FILE_GET_POS				; position courante dans un fichier (lseek SEEK_CUR avec offset 0)
;			----------------
  POP_RDI								;		(rdi = FILE_ID)
  db 0x48, 0x31, 0xF6						; xor rsi, rsi	(rsi = 0  = offset)
  db 0x6A, 0x01							; push 1
  db 0x5A								; pop rdx		(rdx = 1  = SEEK_CUR : ne change rien, lseek rend la position courante)
  db 0x6A, 0x08							; push 8
  db 0x58								; pop rax		(rax = 8  = lseek)
  db 0x0F, 0x05							; syscall
  db 0x48, 0x89, 0x45, 0x00						; mov QWORD PTR [rbp], rax	(position courante en octets rendue sur le lieu result de la fonction)
end macro

;			-----------------
macro			SYS_FILE_GET_SIZE				; taille d'un fichier en octets (lseek SEEK_END puis SEEK_SET pour preserver la position courante)
;			-----------------
  POP_RDI								;		(rdi = FILE_ID)
  ; --- 1. Sauver la position courante : lseek(fd, 0, SEEK_CUR) -> rax = position courante
  db 0x48, 0x31, 0xF6						; xor rsi, rsi	(rsi = 0  = offset)
  db 0x6A, 0x01							; push 1
  db 0x5A								; pop rdx		(rdx = 1  = SEEK_CUR)
  db 0x6A, 0x08							; push 8
  db 0x58								; pop rax		(rax = 8  = lseek)
  db 0x0F, 0x05							; syscall
  db 0x49, 0x89, 0xC0						; mov r8,  rax	(r8  = position courante a restaurer)
  ; --- 2. Lire la taille : lseek(fd, 0, SEEK_END) -> rax = taille
  db 0x48, 0x31, 0xF6						; xor rsi, rsi	(rsi = 0  = offset)
  db 0x6A, 0x02							; push 2
  db 0x5A								; pop rdx		(rdx = 2  = SEEK_END)
  db 0x6A, 0x08							; push 8
  db 0x58								; pop rax		(rax = 8  = lseek)
  db 0x0F, 0x05							; syscall
  db 0x49, 0x89, 0xC1						; mov r9,  rax	(r9  = taille du fichier)
  ; --- 3. Restaurer la position : lseek(fd, r8, SEEK_SET)
  db 0x4C, 0x89, 0xC6						; mov rsi, r8
  db 0x48, 0x31, 0xD2						; xor rdx, rdx	(rdx = 0  = SEEK_SET)
  db 0x6A, 0x08							; push 8
  db 0x58								; pop rax		(rax = 8  = lseek)
  db 0x0F, 0x05							; syscall
  ; --- 4. Resultat = taille (r9) sur le lieu result
  db 0x4C, 0x89, 0x4D, 0x00						; mov QWORD PTR [rbp], r9	(taille en octets rendue sur le lieu result de la fonction)
end macro

;			--------------
macro			SYS_FILE_WRITE				; ecriture sur un fichier
;			--------------
  POP_RDI								;		(rdi = FILE_ID)
  POP_RSI								;		(rsi = ADRESSE du tampon source)
  POP_RDX								;		(rdx = LONGUEUR du transfert)
  db 0x6A, 0x01							; push 1
  db 0x58								; pop rax		(rax = 1= sys_write)
  db 0x0F, 0x05							; syscall
  db 0x48, 0x89, 0x45, 0x00						; mov QWORD PTR [rbp], rax	(ATTENTION PAS PUSH ! ID de fichier rendu sur le lieu result de la fonction)
end macro

;			-------------
macro			SYS_FILE_READ				; lecture sur un fichier
;			-------------
  POP_RDI								;		(rdi = FILE_ID)
  POP_RSI								;		(rsi = ADRESSE du tampon source)
  POP_RDX								;		(rdx = LONGUEUR du transfert)
  db 0x6A, 0x00							; push 0
  db 0x58								; pop rax		(rax = 0 = sys_read)
  db 0x0F, 0x05							; syscall
  db 0x48, 0x89, 0x45, 0x00						; mov QWORD PTR [rbp], rax	(ATTENTION PAS PUSH ! ID de fichier rendu sur le lieu result de la fonction)
end macro

;			--------------
macro			SYS_FILE_CLOSE				; fermeture d'un fichier
;			--------------
  POP_RDI								; ID fichier empile
  db 0x6A, 0x03							; push 3
  db 0x58								; pop rax			(rax=3=sys_close )
  db 0x0F, 0x05							; syscall
  db 0x48, 0x89, 0x45, 0x00						; mov QWORD PTR [rbp], rax	(ATTENTION PAS PUSH ! ID de fichier rendu sur le lieu result de la fonction)
end macro

;			---------------
macro			SYS_FILE_DELETE				; destruction d'un fichier
;			---------------
  POP_RSI								; ptr au doublet @data/@info
  COPY_STRING_APPEND_NUL						; faire une copie sur pile avec NUL en fin pointee par RDI
  db 0xB8, 0x57, 0x00, 0x00, 0x00					; mov eax, 87			(rax=87=sys_unlink )
  db 0x0F, 0x05							; syscall
  db 0x48, 0x89, 0x45, 0x00						; mov QWORD PTR [rbp], rax	(ATTENTION PAS PUSH ! ID de fichier rendu sur le lieu result de la fonction)
end macro

;			----------------
macro			SYS_EXIT	code:0				; retour au systeme
;			----------------
  db 0x6A, 0x3C							; push x3C  (sys_exit rax=60)
  db 0x58								; pop rax
if code = 0
  db 0x31, 0xFF							; xor edi, edi (err_code=0)
else
  db 0xBF								; mov edi, imm32	    (err_code)
  dd code
end if
  db 0x0F, 0x05							; syscall
end macro


;				---------------------------------------------
;				MISE EN PLACE ENTETE ELF 64 POUR LINUX X86-64
;				---------------------------------------------

ELFCLASS64	= 2
ELFDATA2LSB	= 1
EV_CURRENT	= 1
ET_EXEC		= 2
SYSTEM_V		= 0
EM_X86_64		= 62
TAILLE_COPILE	= 16*1024*1024*1024					; COPILE = 16 Go

org 0x400000							; adresse entree programme linux

Elf64_Header:
	e_ident		db 0x7F,'ELF', ELFCLASS64, ELFDATA2LSB, EV_CURRENT, SYSTEM_V, (0x400010-$) dup 0
	e_type		dw ET_EXEC
	e_machine		dw EM_X86_64
	e_version		dd EV_CURRENT
	e_entry		dq 0x00400078
	e_phoff		dq 64
	e_shoff		dq 0
	e_flags		dd 0
	e_ehsize		dw 64
	e_phentsize	dw 56
	e_phnum		dw 1
	e_shentsize	dw 0
	e_shnum		dw 0
	e_shstrndx	dw 0
Elf64_Phdr:
	p_type		dd 1					; PT_LOAD
	p_flags		dd 7					; RWX
	p_offset		dq 0x78
	p_vaddr		dq 0x00400078
	p_paddr		dq 0
	p_filesz		dq ASM_SIZE				; juste le necessaire code/constantes dans le fichier
	p_memsz		dq ASM_SIZE + TAILLE_COPILE			; TAILLE_COPILE au dessus du code et des constantes (pour la co-pile)
	p_align		dq 4096


;		METTRE EN PLACE LA PILE CROISSANTE ET LE DISPLAY

  db 0x48, 0x31, 0xC0						; xor rax,rax			pour point d'arret debogage

;		METTRE EN PLACE LE TAS SEPARE (mmap anonyme de 512 Mo)	ATTENTION AJOUTER UN TEST DE REUSSITE DU MMAP

TAILLE_TAS = 64*1024*1024						; TAS = 64 Mo

  db 0x48, 0x31, 0xFF						; xor rdi, rdi		(addr = NULL, le noyau choisit)
  db 0xBE								; mov esi, TAILLE_TAS
  dd TAILLE_TAS
  db 0x6A, 0x03							; push 3
  db 0x5A								; pop rdx			(rdx = 3 = PROT_READ|PROT_WRITE)
  db 0x41, 0xBA, 0x22, 0x00, 0x00, 0x00					; mov r10d, 0x22		(MAP_PRIVATE|MAP_ANONYMOUS)
  db 0x49, 0xC7, 0xC0, 0xFF, 0xFF, 0xFF, 0xFF				; mov r8, -1		(fd = -1)
  db 0x45, 0x31, 0xC9						; xor r9d, r9d		(offset = 0)
  db 0x6A, 0x09							; push 9
  db 0x58								; pop rax			(rax = 9 = sys_mmap)
  db 0x0F, 0x05							; syscall
  db 0x4C, 0x8D, 0xA0						; lea r12, [rax + TAILLE_TAS]		(r12 = fin de zone = haut du tas descendant)
  dd TAILLE_TAS

;		METTRE EN PLACE LA PILE MONTANTE

  db 0x48, 0x8D, 0xA4, 0x24, 0x00, 0x00, 0xC0, 0xFF			; lea rsp, [rsp - 4*1024*1024]	(caler rsp a 4 Mo sous le depart)
  db 0x49, 0x89, 0xE7						; mov r15, rsp			(debut du display de 32 frame pointers)
  db 0x48, 0x8D, 0xAC, 0x24, 0x00, 0x01, 0x00, 0x00			; lea rbp, [rsp + 8*32]		(bas de pile croissante au dessus du display)
  db 0x49, 0x89, 0x2F						; mov [r15], rbp			(frame pointer level 0)

;		METTRE EN PLACE LA CO-PILE

  db 0x4C, 0x8D, 0x34, 0x25						; lea r14, [0x00400078 + 8*((ASM_SIZE+7)/8)]	(bas de la co-pile, ou pile-tas au dessus du code et des constantes)
  dd 0x00400078 + 8*((ASM_SIZE+7)/8)
  db 0x4D, 0x89, 0x36						; mov [r14], r14			(empiler le premier "frame" de co-pile)
  db 0x4D, 0x89, 0xF5						; mov r13, r14			(R13 est le "frame pointer" de co-pile)
  db 0x4D, 0x8D, 0x76, 0x08						; lea r14, [r14 + 8]		(monter le haut de co-pile sur le premier lieu libre)

;-----------------------------------------------------------------------------------------------------------------------
;	1	2	3	4	5	6	7	8	9	0	1	2
