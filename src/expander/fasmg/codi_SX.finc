macro			BRA	lbl		; inconditionnel
  local sx_src_op, sx_src_arg
  SX_TICK 80, 1, 0
  load sx_src_op:8 from SX_TBL:SX_PCOP*8
  load sx_src_arg:8 from SX_TBL:(2*SX_NB+3)*8
  postpone
    SX_TARGET_PAIR SX_BPAIR, lbl, sx_src_op, sx_src_arg, 1
  end postpone
end macro
macro			BT	lbl		; branch true
  local sx_src_op, sx_src_arg
  SX_TICK 81, 1, 0
  load sx_src_op:8 from SX_TBL:SX_PCOP*8
  load sx_src_arg:8 from SX_TBL:(2*SX_NB+3)*8
  postpone
    SX_TARGET_PAIR SX_BPAIR, lbl, sx_src_op, sx_src_arg, 1
  end postpone
end macro
macro			BF	lbl		; branch false
  local sx_src_op, sx_src_arg
  SX_TICK 82, 1, 0
  load sx_src_op:8 from SX_TBL:SX_PCOP*8
  load sx_src_arg:8 from SX_TBL:(2*SX_NB+3)*8
  postpone
    SX_TARGET_PAIR SX_BPAIR, lbl, sx_src_op, sx_src_arg, 1
  end postpone
end macro
macro			CALL	prefix, subname		; CALL par offset
  local sx_src_op, sx_src_arg
  SX_TICK 83, 1, 0
  load sx_src_op:8 from SX_TBL:SX_PCOP*8
  load sx_src_arg:8 from SX_TBL:(2*SX_NB+3)*8
  postpone
    if ~definite prefix#subname#_
      prefix#subname#_ = prefix#subname#.elab
    end if
    SX_TARGET_PAIR SX_CPAIR, prefix#subname#_, sx_src_op, sx_src_arg, 0
  end postpone
end macro
macro			CALLI		; CALL indirect par RAX
  SX_TICK 84, 0, 0
end macro
macro			RTD	param_size:0
  if param_size = 0
    SX_TICK 85, 0, 0			; format A
  else
    SX_TICK 85, 1, 0			; format D
  end if
end macro
macro			LINK	lvl, alloc		; ALLOCATION POUR VARIABLES LOCALES APRES FRAME PTR
  SX_TICK 86, 1, 0
end macro
macro			UNLINK	lvl		; DISPOSE VARS LOCALES ET RESTORE FRAME PTR
  SX_TICK 87, 1, 0
end macro
macro			UNLINKR	lvl		; UNLINK + LIBERATION DE LA CO-PILE (r14 redescend a la cellule LI
  SX_TICK 88, 1, 0
end macro
macro			CO_VAR		; Allocation d'un bloc sur la co-pile taille en octets sur la pile
  SX_TICK 89, 0, 2
end macro
macro			HEAP_ALLOC		; Allocation bump-pointer pour Ada new : taille en octets sur pile
  SX_TICK 90, 0, 2
end macro
macro			EXC_MACH		lvl, ctx		; PILIER 11 : photographie de l'etat machine cache
  SX_TICK 91, 1, 0
end macro
macro			EXC_RAISE		top		; PILIER 11 : deroulage. Corps de l'INSTANCE UNIQUE,
  SX_TICK 92, 1, 0
end macro
macro			BLKAND		; [DST] and= [SRC] octet a octet
  SX_TICK 93, 0, 2
end macro
macro			BLKOU		; [DST] or= [SRC] octet a octet
  SX_TICK 94, 0, 2
end macro
macro			BLKOUX		; [DST] xor= [SRC] octet a octet
  SX_TICK 95, 0, 2
end macro
macro			BLKNOT		; NOT composite : chaque octet ^= 1
  SX_TICK 96, 0, 2
end macro
macro			BLKMOV		; Copie de bloc sans recouvrement
  SX_TICK 97, 0, 2
end macro
macro			BLKCMP		; Comparaison de blocs : empile 1 si egaux, 0 sinon (LEN=0 -> 1)
  SX_TICK 98, 0, 2
end macro
macro			LEXCMP siz*, sgn*		; Comparaison lexicographique de tableaux (LRM 4.5.2) -- lot D2
  SX_TICK 99, 0, 2
end macro
macro			SYS_CLOCK_GETTIME
  SX_TICK 100, 0, 1
end macro
macro			SYS_PUT_CHAR		; affiche un seul caractere sur stdout
  SX_TICK 101, 0, 1
end macro
macro			SYS_PUT_STR		; affiche tout une chaine sur stdout
  SX_TICK 102, 0, 1
end macro
macro			SYS_GET_CHAR		; lit un seul caractere sur stdin en mode non canonique
  SX_TICK 103, 0, 1
end macro
macro			SYS_GET_STR		; lit une ligne sur stdin
  SX_TICK 104, 0, 1
end macro
macro			SYS_FILE_CREATE		; FONCTION creation d'un fichier	rax=2 rdi=ptr_name rsi=flags(O_CR
  SX_TICK 105, 0, 1
end macro
macro			SYS_FILE_OPEN		; FONCTION ouverture d'un fichier
  SX_TICK 106, 0, 1
end macro
macro			SYS_FILE_SET_POS		; positionnement sur un fichier
  SX_TICK 107, 0, 1
end macro
macro			SYS_FILE_GET_POS		; position courante dans un fichier (lseek SEEK_CUR avec offset 0)
  SX_TICK 108, 0, 1
end macro
macro			SYS_FILE_GET_SIZE		; taille d'un fichier en octets (lseek SEEK_END puis SEEK_SET pour
  SX_TICK 109, 0, 1
end macro
macro			SYS_FILE_WRITE		; ecriture sur un fichier
  SX_TICK 110, 0, 1
end macro
macro			SYS_FILE_READ		; lecture sur un fichier
  SX_TICK 111, 0, 1
end macro
macro			SYS_FILE_CLOSE		; fermeture d'un fichier
  SX_TICK 112, 0, 1
end macro
macro			SYS_FILE_DELETE		; destruction d'un fichier
  SX_TICK 113, 0, 1
end macro
macro			SYS_EXIT	code:0		; retour au systeme
  SX_TICK 114, 0, 1
end macro

;			E M I S S I O N   D U   R A P P O R T

postpone
  SX_DATA = $
  SX_NM = 0
  SX_NS = 0
  SX_NH = 0
  SX_NA = 0
  load SX_NM:8 from SX_TBL:(2*SX_NB+0)*8
  load SX_NS:8 from SX_TBL:(2*SX_NB+1)*8
  load SX_NH:8 from SX_TBL:(2*SX_NB+2)*8
  load SX_NA:8 from SX_TBL:(2*SX_NB+3)*8
  SX_TXT '========================================================================'
  SX_TXT 'TLALOC  --  CODI SX : statistiques d''emission LLIR'
  SX_TXT '========================================================================'
  SX_TXT ''
  db 'instructions du repertoire materiel : '
  SX_NUM SX_NM
  SX_TXT ''
  db 'mots de 64 bits du flux des operandes: '
  SX_NUM SX_NA
  SX_TXT ''
  db 'instructions a zero adresse         : '
  SX_NUM SX_NM - SX_NA
  SX_TXT ''
  SX_TXT ''
  db 'appels systeme                       : '
  SX_NUM SX_NS
  SX_TXT ''
  db 'operations hors support materiel     : '
  SX_NUM SX_NH
  SX_TXT ''
  db 'octets de donnees statiques          : '
  SX_NUM SX_DATA - SX_NM
  SX_TXT ''
  SX_TXT ''
  SX_TXT 'VOLUME DES DEUX FLUX'
  db '  flux des opcodes   1 octet/instr   : '
  SX_NUM SX_NM
  db ' octets'
  SX_TXT ''
  db '  flux des operandes 8 octets/mot    : '
  SX_NUM SX_NA*8
  db ' octets'
  SX_TXT ''
  db '  total du code                      : '
  SX_NUM SX_NM+SX_NA*8
  db ' octets'
  SX_TXT ''
  SX_TXT ''
  SX_TXT 'HISTOGRAMME        mnemonique / occurrences / mots d''operande'
  SX_TXT '--- repertoire materiel ---'
  SX_ROW 'DROP            ', 0
  SX_ROW 'DUP             ', 1
  SX_ROW 'OVER            ', 2
  SX_ROW 'LI              ', 3
  SX_ROW 'LIF             ', 4
  SX_ROW 'LCA             ', 5
  SX_ROW 'LSPA            ', 6
  SX_ROW 'LVA             ', 7
  SX_ROW 'LIVA            ', 8
  SX_ROW 'ULB             ', 9
  SX_ROW 'ULW             ', 10
  SX_ROW 'ULD             ', 11
  SX_ROW 'LB              ', 12
  SX_ROW 'LW              ', 13
  SX_ROW 'LD              ', 14
  SX_ROW 'LQ              ', 15
  SX_ROW 'LA              ', 16
  SX_ROW 'ULIB            ', 17
  SX_ROW 'ULIW            ', 18
  SX_ROW 'ULID            ', 19
  SX_ROW 'LIB             ', 20
  SX_ROW 'LIW             ', 21
  SX_ROW 'LID             ', 22
  SX_ROW 'LIQ             ', 23
  SX_ROW 'LIA             ', 24
  SX_ROW 'SB              ', 25
  SX_ROW 'SW              ', 26
  SX_ROW 'SD              ', 27
  SX_ROW 'SQ              ', 28
  SX_ROW 'SA              ', 29
  SX_ROW 'SIB             ', 30
  SX_ROW 'SIW             ', 31
  SX_ROW 'SID             ', 32
  SX_ROW 'SIQ             ', 33
  SX_ROW 'ET              ', 35
  SX_ROW 'OU              ', 36
  SX_ROW 'NON             ', 37
  SX_ROW 'OUX             ', 38
  SX_ROW 'SHL             ', 39
  SX_ROW 'SHR             ', 40
  SX_ROW 'UBFX            ', 41
  SX_ROW 'SBFX            ', 42
  SX_ROW 'BFI             ', 43
  SX_ROW 'DEC             ', 44
  SX_ROW 'INC             ', 45
  SX_ROW 'NEG             ', 46
  SX_ROW 'ABS             ', 47
  SX_ROW 'CLAMP0          ', 48
  SX_ROW 'ADD             ', 49
  SX_ROW 'SUB             ', 50
  SX_ROW 'MUL             ', 51
  SX_ROW 'DIV             ', 52
  SX_ROW 'REMI            ', 53
  SX_ROW 'MODI            ', 54
  SX_ROW 'SAR             ', 55
  SX_ROW 'FADD            ', 56
  SX_ROW 'FSUB            ', 57
  SX_ROW 'FMUL            ', 58
  SX_ROW 'FDIV            ', 59
  SX_ROW 'FNEG            ', 60
  SX_ROW 'FABS            ', 61
  SX_ROW 'FEXP            ', 62
  SX_ROW 'CVTIF           ', 63
  SX_ROW 'CVTFI           ', 64
  SX_ROW 'CVTFIR          ', 65
  SX_ROW 'CVTIX           ', 66
  SX_ROW 'CVTXI           ', 67
  SX_ROW 'CEQ             ', 68
  SX_ROW 'CNE             ', 69
  SX_ROW 'CGT             ', 70
  SX_ROW 'CGE             ', 71
  SX_ROW 'CLT             ', 72
  SX_ROW 'CLE             ', 73
  SX_ROW 'FCEQ            ', 74
  SX_ROW 'FCNE            ', 75
  SX_ROW 'FCGT            ', 76
  SX_ROW 'FCGE            ', 77
  SX_ROW 'FCLT            ', 78
  SX_ROW 'FCLE            ', 79
  SX_ROW 'BRA             ', 80
  SX_ROW 'BT              ', 81
  SX_ROW 'BF              ', 82
  SX_ROW 'CALL            ', 83
  SX_ROW 'CALLI           ', 84
  SX_ROW 'RTD             ', 85
  SX_ROW 'LINK            ', 86
  SX_ROW 'UNLINK          ', 87
  SX_ROW 'UNLINKR         ', 88
  SX_ROW 'EXC_MACH        ', 91
  SX_ROW 'EXC_RAISE       ', 92
  SX_ROW 'CHKB            ', 115
  SX_ROW 'CHKW            ', 116
  SX_ROW 'CHKD            ', 117
  SX_ROW 'CHKQ            ', 118
  SX_ROW 'CHKUB           ', 119
  SX_ROW 'CHKUW           ', 120
  SX_ROW 'CHKUD           ', 121
  SX_ROW 'CHKIB           ', 122
  SX_ROW 'CHKIW           ', 123
  SX_ROW 'CHKID           ', 124
  SX_ROW 'CHKIQ           ', 125
  SX_ROW 'CHKUIB          ', 126
  SX_ROW 'CHKUIW          ', 127
  SX_ROW 'CHKUID          ', 128
  SX_ROW 'UBFXI           ', 129
  SX_ROW 'SBFXI           ', 130
  SX_ROW 'BFII            ', 131
  SX_TXT '--- appels systeme ---'
  SX_ROW 'SYS_CLOCK_GETTIME', 100
  SX_ROW 'SYS_PUT_CHAR    ', 101
  SX_ROW 'SYS_PUT_STR     ', 102
  SX_ROW 'SYS_GET_CHAR    ', 103
  SX_ROW 'SYS_GET_STR     ', 104
  SX_ROW 'SYS_FILE_CREATE ', 105
  SX_ROW 'SYS_FILE_OPEN   ', 106
  SX_ROW 'SYS_FILE_SET_POS', 107
  SX_ROW 'SYS_FILE_GET_POS', 108
  SX_ROW 'SYS_FILE_GET_SIZE', 109
  SX_ROW 'SYS_FILE_WRITE  ', 110
  SX_ROW 'SYS_FILE_READ   ', 111
  SX_ROW 'SYS_FILE_CLOSE  ', 112
  SX_ROW 'SYS_FILE_DELETE ', 113
  SX_ROW 'SYS_EXIT        ', 114
  SX_TXT '--- hors support materiel ---'
  SX_ROW 'SIA             ', 34
  SX_ROW 'CO_VAR          ', 89
  SX_ROW 'HEAP_ALLOC      ', 90
  SX_ROW 'BLKAND          ', 93
  SX_ROW 'BLKOU           ', 94
  SX_ROW 'BLKOUX          ', 95
  SX_ROW 'BLKNOT          ', 96
  SX_ROW 'BLKMOV          ', 97
  SX_ROW 'BLKCMP          ', 98
  SX_ROW 'LEXCMP          ', 99
  SX_TXT ''
  SX_TXT 'LARGEUR UTILE DES OPERANDES   (valeur / nombre d''occurrences)'
  SX_TXT '--- deplacements disp ---'
  db 'nul (implicitable)    '
  SX_BROW SX_BDISP + 0
  db '4 bits non signes     '
  SX_BROW SX_BDISP + 1
  db '8 bits signes         '
  SX_BROW SX_BDISP + 2
  db '12 bits signes        '
  SX_BROW SX_BDISP + 3
  db '16 bits signes        '
  SX_BROW SX_BDISP + 4
  db '24 bits signes        '
  SX_BROW SX_BDISP + 5
  db '32 bits signes        '
  SX_BROW SX_BDISP + 6
  db 'au dela de 32 bits    '
  SX_BROW SX_BDISP + 7
  SX_TXT '--- offsets ofs ---'
  db 'nul (implicitable)    '
  SX_BROW SX_BOFS + 0
  db '4 bits non signes     '
  SX_BROW SX_BOFS + 1
  db '8 bits signes         '
  SX_BROW SX_BOFS + 2
  db '12 bits signes        '
  SX_BROW SX_BOFS + 3
  db '16 bits signes        '
  SX_BROW SX_BOFS + 4
  db '24 bits signes        '
  SX_BROW SX_BOFS + 5
  db '32 bits signes        '
  SX_BROW SX_BOFS + 6
  db 'au dela de 32 bits    '
  SX_BROW SX_BOFS + 7
  SX_TXT '--- litteraux LI ---'
  db 'nul (implicitable)    '
  SX_BROW SX_BLI + 0
  db '4 bits non signes     '
  SX_BROW SX_BLI + 1
  db '8 bits signes         '
  SX_BROW SX_BLI + 2
  db '12 bits signes        '
  SX_BROW SX_BLI + 3
  db '16 bits signes        '
  SX_BROW SX_BLI + 4
  db '24 bits signes        '
  SX_BROW SX_BLI + 5
  db '32 bits signes        '
  SX_BROW SX_BLI + 6
  db 'au dela de 32 bits    '
  SX_BROW SX_BLI + 7
  SX_TXT '--- niveau lexical lvl employe ---'
  db 'niveau 0              '
  SX_BROW SX_BLVL + 0
  db 'niveau 1              '
  SX_BROW SX_BLVL + 1
  db 'niveau 2              '
  SX_BROW SX_BLVL + 2
  db 'niveau 3              '
  SX_BROW SX_BLVL + 3
  db 'niveau 4              '
  SX_BROW SX_BLVL + 4
  db 'niveau 5              '
  SX_BROW SX_BLVL + 5
  db 'niveau 6              '
  SX_BROW SX_BLVL + 6
  db 'niveau 7              '
  SX_BROW SX_BLVL + 7
  db 'niveau 8              '
  SX_BROW SX_BLVL + 8
  db 'niveau 9              '
  SX_BROW SX_BLVL + 9
  db 'niveau 10             '
  SX_BROW SX_BLVL + 10
  db 'niveau 11             '
  SX_BROW SX_BLVL + 11
  db 'niveau 12             '
  SX_BROW SX_BLVL + 12
  db 'niveau 13             '
  SX_BROW SX_BLVL + 13
  db 'niveau 14             '
  SX_BROW SX_BLVL + 14
  db 'niveau 15             '
  SX_BROW SX_BLVL + 15
  SX_TXT '--- portee des branchements (instructions du flux OP abstrait) ---'
  db 'nul (implicitable)    '
  SX_BROW SX_BBR + 0
  db '4 bits non signes     '
  SX_BROW SX_BBR + 1
  db '8 bits signes         '
  SX_BROW SX_BBR + 2
  db '12 bits signes        '
  SX_BROW SX_BBR + 3
  db '16 bits signes        '
  SX_BROW SX_BBR + 4
  db '24 bits signes        '
  SX_BROW SX_BBR + 5
  db '32 bits signes        '
  SX_BROW SX_BBR + 6
  db 'au dela de 32 bits    '
  SX_BROW SX_BBR + 7
  SX_TXT ''
  SX_TXT 'FORMATS CANDIDATS SX3   (classes exclusives sauf mention contraire)'
  SX_TXT '--- format B : lvl4 + disp ---'
  db 'B16  lvl4+disp12       '
  SX_BROW SX_BFORM + 0
  db 'B24  lvl4+disp20       '
  SX_BROW SX_BFORM + 1
  db 'B32  lvl4+disp28       '
  SX_BROW SX_BFORM + 2
  db 'B64  secours           '
  SX_BROW SX_BFORM + 3
  SX_TXT '--- format C : lvl + disp + ofs ---'
  db 'C24  4+16+4            '
  SX_BROW SX_CFORM + 0
  db 'C32  4+20+8            '
  SX_BROW SX_CFORM + 1
  db 'C64  secours           '
  SX_BROW SX_CFORM + 2
  db 'C32-alt 4+16+12 (fit) '
  SX_BROW SX_CALT
  SX_TXT '--- LI : taille minimale du complement ---'
  db 'LI0   aucun complement '
  SX_BROW SX_LIFORM + 0
  db 'LI8   signe            '
  SX_BROW SX_LIFORM + 1
  db 'LI16  signe            '
  SX_BROW SX_LIFORM + 2
  db 'LI32  signe            '
  SX_BROW SX_LIFORM + 3
  db 'LI64                   '
  SX_BROW SX_LIFORM + 4
  SX_TXT '--- delta ARG des BRA/BT/BF (en NOMBRE de mots-operandes) ---'
  db 'nul                    '
  SX_BROW SX_BBARG + 0
  db '4 bits non signes      '
  SX_BROW SX_BBARG + 1
  db '8 bits signes          '
  SX_BROW SX_BBARG + 2
  db '12 bits signes         '
  SX_BROW SX_BBARG + 3
  db '16 bits signes         '
  SX_BROW SX_BBARG + 4
  db '24 bits signes         '
  SX_BROW SX_BBARG + 5
  db '32 bits signes         '
  SX_BROW SX_BBARG + 6
  db 'au dela de 32 bits     '
  SX_BROW SX_BBARG + 7
  SX_TXT '--- couple BRA/BT/BF : meme largeur signee pour deltaOP et deltaARG ---'
  db '8+8 bits   (2 octets)  '
  SX_BROW SX_BPAIR + 0
  db '16+16 bits (4 octets)  '
  SX_BROW SX_BPAIR + 1
  db '24+24 bits (6 octets)  '
  SX_BROW SX_BPAIR + 2
  db '32+32 bits (8 octets)  '
  SX_BROW SX_BPAIR + 3
  db 'au dela                '
  SX_BROW SX_BPAIR + 4
  SX_TXT '--- couple CALL : meme largeur signee pour deltaOP et deltaARG ---'
  db '8+8 bits   (2 octets)  '
  SX_BROW SX_CPAIR + 0
  db '16+16 bits (4 octets)  '
  SX_BROW SX_CPAIR + 1
  db '24+24 bits (6 octets)  '
  SX_BROW SX_CPAIR + 2
  db '32+32 bits (8 octets)  '
  SX_BROW SX_CPAIR + 3
  db 'au dela                '
  SX_BROW SX_CPAIR + 4
  SX_TXT '--- LCA : portee relative dans image SX (mesure indicative) ---'
  db 'nul                    '
  SX_BROW SX_LCAREL + 0
  db '4 bits non signes      '
  SX_BROW SX_LCAREL + 1
  db '8 bits signes          '
  SX_BROW SX_LCAREL + 2
  db '12 bits signes         '
  SX_BROW SX_LCAREL + 3
  db '16 bits signes         '
  SX_BROW SX_LCAREL + 4
  db '24 bits signes         '
  SX_BROW SX_LCAREL + 5
  db '32 bits signes         '
  SX_BROW SX_LCAREL + 6
  db 'au dela de 32 bits     '
  SX_BROW SX_LCAREL + 7
  db 'cibles non cartographiees '
  SX_BROW SX_MAPMISS
  SX_TXT ''
  SX_TXT 'VOLUME ESTIME DES ACCES B/C + LI AVEC CES FORMATS'
  load SX_B16:8 from SX_TBL:(SX_BFORM+0)*8
  load SX_B24:8 from SX_TBL:(SX_BFORM+1)*8
  load SX_B32:8 from SX_TBL:(SX_BFORM+2)*8
  load SX_B64:8 from SX_TBL:(SX_BFORM+3)*8
  load SX_C24:8 from SX_TBL:(SX_CFORM+0)*8
  load SX_C32:8 from SX_TBL:(SX_CFORM+1)*8
  load SX_C64:8 from SX_TBL:(SX_CFORM+2)*8
  load SX_LI0:8 from SX_TBL:(SX_LIFORM+0)*8
  load SX_LI8:8 from SX_TBL:(SX_LIFORM+1)*8
  load SX_LI16:8 from SX_TBL:(SX_LIFORM+2)*8
  load SX_LI32:8 from SX_TBL:(SX_LIFORM+3)*8
  load SX_LI64:8 from SX_TBL:(SX_LIFORM+4)*8
  SX_OLD3 = 8*(SX_B16+SX_B24+SX_B32+SX_B64+SX_C24+SX_C32+SX_C64+SX_LI0+SX_LI8+SX_LI16+SX_LI32+SX_LI64)
  SX_NEW3 = 2*SX_B16+3*SX_B24+4*SX_B32+8*SX_B64 + 3*SX_C24+4*SX_C32+8*SX_C64 + SX_LI8+2*SX_LI16+4*SX_LI32+8*SX_LI64
  db 'ancien, mots 64 bits   '
  SX_NUM SX_OLD3
  db ' octets'
  SX_TXT ''
  db 'candidat variable      '
  SX_NUM SX_NEW3
  db ' octets'
  SX_TXT ''
  db 'gain                   '
  SX_NUM SX_OLD3-SX_NEW3
  db ' octets'
  SX_TXT ''
end postpone
