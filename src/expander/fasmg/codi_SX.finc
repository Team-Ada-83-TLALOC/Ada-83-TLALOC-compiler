;			I N S T R U C T I O N S   --   C O M P T A G E

macro			DROP
  SX_TICK 0, 0, 0
end macro
macro			DUP
  SX_TICK 1, 0, 0
end macro
macro			OVER
  SX_TICK 2, 0, 0
end macro
macro			LI	val		; Load Integer
  SX_TICK 3, 1, 0
  SX_BIN SX_BLI, val
  SX_LIFORMAT val
end macro
macro			LIF	val		; Load Immediate Float (IEEE 754 double 64 bits sur la pile entier
  SX_TICK 4, 1, 0
end macro
macro			LCA	ptr, disp:0		; Load Constant Address (distinguer de LI - qui charge en 32 bits 
  local sx_src
  SX_TICK 5, 1, 0
  sx_src = $
  postpone
    SX_BIN SX_LCAREL, ptr + disp - sx_src
  end postpone
end macro
macro			LSPA	prefix, subname		; Load SubProgram Address de .elab, en armant l'assemblage lazy
  postpone
    if ~definite prefix#subname#_
      prefix#subname#_ = prefix#subname#.elab
    end if
end postpone
  SX_TICK 6, 1, 0
end macro
macro			LVA	lvl:-1, disp:0		; Load Variable Address pour lvl et disp (empile l'adresse de la v
  if lvl = -1 & disp = 0
					; identite : rien n'est emis par les codis, rien n'est compte
  else if lvl = -1
    SX_TICK 7, 0, 0			; adresse deja empilee : format A
  else
    SX_TICK 7, 1, 0			; couple (lvl,disp) : format B
    SX_BIN SX_BDISP, disp
    SX_LVL lvl
    SX_BFORMAT lvl, disp
  end if
end macro
macro			LIVA	lvl:-1, disp:0, ofs:0		; Load Indirect Variable Address pour lvl et disp (empile l'adress
  if lvl = -1
    SX_TICK 8, 0, 0			; adresse deja empilee : format A
  else
    SX_TICK 8, 1, 0			; couple (lvl,disp) : format C
    SX_BIN SX_BDISP, disp
    SX_BIN SX_BOFS, ofs
    SX_LVL lvl
    SX_CFORMAT lvl, disp, ofs
  end if
end macro
macro			ULB	lvl:-1, disp:0		; Unsigned Load Byte 8 bits (zero extension)
  if lvl = -1
    SX_TICK 9, 0, 0			; adresse deja empilee : format A
  else
    SX_TICK 9, 1, 0			; couple (lvl,disp) : format B
    SX_BIN SX_BDISP, disp
    SX_LVL lvl
    SX_BFORMAT lvl, disp
  end if
end macro
