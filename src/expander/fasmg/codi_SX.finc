;			C O N T R O L E S   D ' I N T E R V A L L E   E T   C H A M P S   D E   B I T S
;	Ajoutes pour LLIR_hardware_support V3 : CHKt lvl, disp (forme B, B24) et CHKIt lvl, disp, ofs
;	(forme C, C32) ; UBFXI, SBFXI, BFII lsb, w (D8_8). Un mot d'operande chacun.
macro			CHKB	lvl*, disp*		; controle d'intervalle, bornes en DISPLAY[lvl]+disp
  SX_TICK 115, 1, 0
  SX_BIN SX_BDISP, disp
  SX_LVL lvl
  SX_BFORMAT lvl, disp
end macro
