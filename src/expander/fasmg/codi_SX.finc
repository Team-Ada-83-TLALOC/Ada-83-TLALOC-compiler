;----------------------------------------------------------------------------------------------------------------------
;		C O D I   S X 3 --   S U P P O R T   E X P E R I M E N T A L
;
;	Codi de MESURE, pas d'execution. Derive de codi_x86_64L.finc : memes noms de
;	macros, memes parametres, donc les .FINC et .FAS du front end s'assemblent sans
;	modification. Aucune instruction machine n'est emise : chaque macro de la LLIR
;	incremente des compteurs. Le fichier de sortie de fasmg n'est pas un binaire,
;	c'est le RAPPORT en texte lisible.
;
;		fasmg PROG.SXFAS rapport.txt   puis   cat rapport.txt
;
;	MODELE MESURE  (d'apres LLIR_hardware_support.txt)
;	  format A : [OP]                            0 mot d'operande
;	  format B : [OP] [lvl, disp]                1 mot
;	  format C : [OP] [lvl, disp, offset]        1 mot
;	  format D : [OP] [imm64]                    1 mot
;	B, C et D consomment TOUS exactement un mot de 64 bits, le couple (niveau,
;	deplacement) etant empaquete. Le flux des operandes contient donc 0 ou 1 mot
;	par instruction, jamais davantage.
;
;	CHOIX A vs B/C pour les acces variables : convention du codi d'origine,
;	lvl = -1 signifie que l'adresse est deja sur la pile, donc rien a prelever
;	(format A) ; lvl >= 0 preleve le couple (format B ou C). RTD suit la meme
;	logique sur param_size.
;
;	TROIS FAMILLES COMPTEES SEPAREMENT
;	  materiel : le repertoire candidat
;	  systeme  : les 15 SYS_*, qui ne sont pas des instructions
;	  hors     : operations de bloc (LRM 4.5.1), CO_VAR, HEAP_ALLOC, SIA
;
;	PIEGE RENCONTRE A L'ECRITURE : les compteurs ne peuvent pas etre de simples
;	symboles. Le front end emet son code dans namespace STANDARD, et dans fasmg une
;	definition va TOUJOURS dans l'espace de noms courant : SX_N = SX_N + 1 y
;	definirait STANDARD.SX_N. D'ou la table dans un espace virtuel etiquete ::,
;	global par construction, manipulee par load et store.
;----------------------------------------------------------------------------------------------------------------------

format binary

SX_NB = 132						; mnemoniques suivies (115..131 : CHK et champs de bits immediats)
SX_MAP_LIMIT = 2000000				; adresses SX couvertes par la carte PC_OP -> PC_ARG
SX_MAP_BASE = (2*SX_NB + 4 + 89)*8		; adresse numerique de la carte dans SX_TBL::
; SX3 initialisait ici 18 Mo sous forme de millions d'elements dd/db.
; fasmg leur associe une representation interne beaucoup plus couteuse et pouvait
; epuiser sa memoire sur TLALOC. La version presente utilise rq + store creux.
virtual at 0
  SX_TBL::	dq 2*SX_NB + 4 + 89 dup 0
;			[0 .. NB-1]       occurrences par mnemonique
;			[NB .. 2NB-1]     mots d'operande par mnemonique
;			[2NB+0]           total instructions materielles
;			[2NB+1]           total appels systeme
;			[2NB+2]           total operations hors support
;			[2NB+3]           total mots d'operande
;			[2NB+4  .. +11]   largeur utile des deplacements disp
;			[2NB+12 .. +19]   largeur utile des offsets ofs
;			[2NB+20 .. +27]   largeur utile des litteraux LI
;			[2NB+28 .. +43]   niveau lexical lvl employe (0..15)
;			[2NB+44 .. +51]   portee des branchements, en instructions du flux OP abstrait
;			[2NB+52 .. +55]   formats B choisis : B16/B24/B32/B64
;			[2NB+56 .. +58]   formats C choisis : C24/C32/C64
;			[2NB+59]          C32 alternatif (lvl4/disp16/ofs12), nombre qui tient
;			[2NB+60 .. +64]   LI0/LI8/LI16/LI32/LI64
;			[2NB+65 .. +72]   portee branchements dans le flux ARG (mots)
;			[2NB+73 .. +77]   couple branche (OP,ARG) : 8/16/24/32/>32 bits chacun
;			[2NB+78 .. +82]   couple CALL   (OP,ARG) : 8/16/24/32/>32 bits chacun
;			[2NB+83 .. +90]   portee relative LCA dans l'image SX (indicative)
;			[2NB+91]          cible sans entree dans la carte PC_OP -> PC_ARG
;			[2NB+92]          PC_OP abstrait : nombre de macros LLIR emises, toutes familles
  ; Carte creuse : un enregistrement de 8 octets par adresse SX potentielle.
; IMPORTANT : SX_TBL:: designe l'espace d'adressage virtuel ; l'expression
; apres les deux-points est une adresse absolue dans cet espace. SX_MAP_BASE
; doit donc etre ajoute explicitement aux indices de la carte.
  ; rq reserve l'espace sans materialiser 2 millions de valeurs. Seules les
  ; entrees correspondant effectivement au debut d'une instruction sont ecrites.
  ; [31..0] = PC_ARG avant instruction, [63..32] = PC_OP avant instruction.
  rq SX_MAP_LIMIT
end virtual

macro SX_TICK idx*, nargs:0, fam:0
  local a, b, c, d, e
  load d:8 from SX_TBL:(2*SX_NB+3)*8
  load e:8 from SX_TBL:SX_PCOP*8
  if $ >= 0 & $ < SX_MAP_LIMIT
    store d:4 at SX_TBL:(SX_MAP_BASE + $*8)
    store e:4 at SX_TBL:(SX_MAP_BASE + $*8+4)
  end if
  db 0							; 1 octet par instruction : le flux d'opcodes est reel,
								; donc les etiquettes avancent et la portee des
								; branchements devient mesurable
  load a:8 from SX_TBL:idx*8
  store a+1:8 at SX_TBL:idx*8
  load b:8 from SX_TBL:(SX_NB+idx)*8
  store b+nargs:8 at SX_TBL:(SX_NB+idx)*8
  load c:8 from SX_TBL:(2*SX_NB+fam)*8
  store c+1:8 at SX_TBL:(2*SX_NB+fam)*8
  store d+nargs:8 at SX_TBL:(2*SX_NB+3)*8
  store e+1:8 at SX_TBL:SX_PCOP*8
end macro

SX_BDISP = 2*SX_NB + 4
SX_BOFS  = 2*SX_NB + 12
SX_BLI   = 2*SX_NB + 20
SX_BLVL  = 2*SX_NB + 28
SX_BBR   = 2*SX_NB + 44
SX_BFORM = 2*SX_NB + 52
SX_CFORM = 2*SX_NB + 56
SX_CALT  = 2*SX_NB + 59
SX_LIFORM= 2*SX_NB + 60
SX_BBARG = 2*SX_NB + 65
SX_BPAIR = 2*SX_NB + 73
SX_CPAIR = 2*SX_NB + 78
SX_LCAREL= 2*SX_NB + 83
SX_MAPMISS=2*SX_NB + 91
SX_PCOP  = 2*SX_NB + 92


macro SX_BIN base*, v*					; classe une valeur signee par largeur utile
  local x, b, a
  x = v
  if x = 0
    b = 0						; nul : implicitable
  else if x > 0 & x < 16
    b = 1						; 4 bits non signes
  else if x >= -128 & x < 128
    b = 2						; 8 bits signes
  else if x >= -2048 & x < 2048
    b = 3						; 12 bits signes
  else if x >= -32768 & x < 32768
    b = 4						; 16 bits signes
  else if x >= -8388608 & x < 8388608
    b = 5						; 24 bits signes
  else if x >= -2147483648 & x < 2147483648
    b = 6						; 32 bits signes
  else
    b = 7						; au dela
  end if
  load a:8 from SX_TBL:(base+b)*8
  store a+1:8 at SX_TBL:(base+b)*8
end macro

macro SX_LVL v*						; niveau lexical employe
  local x, a
  x = v
  if x >= 0 & x < 16
    load a:8 from SX_TBL:(SX_BLVL+x)*8
    store a+1:8 at SX_TBL:(SX_BLVL+x)*8
  end if
end macro

; Classe les formats candidats directement, de facon EXCLUSIVE :
; B16 = lvl4 + disp12, B24 = lvl4 + disp20, B32 = lvl4 + disp28, sinon B64.
macro SX_BFORMAT lvl*, disp*
  local b, a
  if lvl >= 0 & lvl < 16 & disp >= -2048 & disp < 2048
    b = 0
  else if lvl >= 0 & lvl < 16 & disp >= -524288 & disp < 524288
    b = 1
  else if lvl >= 0 & lvl < 16 & disp >= -134217728 & disp < 134217728
    b = 2
  else
    b = 3
  end if
  load a:8 from SX_TBL:(SX_BFORM+b)*8
  store a+1:8 at SX_TBL:(SX_BFORM+b)*8
end macro

; C24 = lvl4 + disp16 + ofs4(non signe)
; C32 = lvl4 + disp20 + ofs8(signe), choix provisoire equilibre.
; C64 = secours. On compte aussi independamment le candidat C32-alt
;       lvl4 + disp16 + ofs12(signe), afin de comparer les deux repartitions.
macro SX_CFORMAT lvl*, disp*, ofs*
  local b, a
  if lvl >= 0 & lvl < 16 & disp >= -32768 & disp < 32768 & ofs >= 0 & ofs < 16
    b = 0
  else if lvl >= 0 & lvl < 16 & disp >= -524288 & disp < 524288 & ofs >= -128 & ofs < 128
    b = 1
  else
    b = 2
  end if
  load a:8 from SX_TBL:(SX_CFORM+b)*8
  store a+1:8 at SX_TBL:(SX_CFORM+b)*8
  if lvl >= 0 & lvl < 16 & disp >= -32768 & disp < 32768 & ofs >= -2048 & ofs < 2048
    load a:8 from SX_TBL:SX_CALT*8
    store a+1:8 at SX_TBL:SX_CALT*8
  end if
end macro

; LI : forme sans complement pour zero, puis immediat signe 8/16/32/64 bits.
macro SX_LIFORMAT v*
  local b, a
  if v = 0
    b = 0
  else if v >= -128 & v < 128
    b = 1
  else if v >= -32768 & v < 32768
    b = 2
  else if v >= -2147483648 & v < 2147483648
    b = 3
  else
    b = 4
  end if
  load a:8 from SX_TBL:(SX_LIFORM+b)*8
  store a+1:8 at SX_TBL:(SX_LIFORM+b)*8
end macro

; Couple de deplacements signes. La classe donne la largeur requise POUR CHACUN
; des deux champs : 8, 16, 24, 32 ou >32 bits.
macro SX_PAIR base*, dop*, darg*
  local b, a
  if dop >= -128 & dop < 128 & darg >= -128 & darg < 128
    b = 0
  else if dop >= -32768 & dop < 32768 & darg >= -32768 & darg < 32768
    b = 1
  else if dop >= -8388608 & dop < 8388608 & darg >= -8388608 & darg < 8388608
    b = 2
  else if dop >= -2147483648 & dop < 2147483648 & darg >= -2147483648 & darg < 2147483648
    b = 3
  else
    b = 4
  end if
  load a:8 from SX_TBL:(base+b)*8
  store a+1:8 at SX_TBL:(base+b)*8
end macro

; Mesure un transfert vers target. src_op est le PC_OP abstrait APRES l'opcode
; (une unite par macro LLIR, donnees statiques exclues) et src_arg le PC_ARG
; APRES consommation de son complement. La carte enregistre les deux PC AVANT
; l'opcode cible, ce qui donne le couple de reprise exact.
macro SX_TARGET_PAIR pairbase*, target*, src_op*, src_arg*, count_hists:0
  local targ_arg, targ_op, dop, darg, a
  if target >= 0 & target < SX_MAP_LIMIT
    load targ_arg:4 from SX_TBL:(SX_MAP_BASE + target*8)
    load targ_op:4 from SX_TBL:(SX_MAP_BASE + target*8+4)
    ; Une case rq jamais ecrite reste indefinie. Ceci remplace la gigantesque
    ; table SX_ARGVALID initialisee de SX3.
    if definite targ_arg & definite targ_op
      dop = targ_op - src_op
      darg = targ_arg - src_arg
      if count_hists <> 0
        SX_BIN SX_BBR, dop
        SX_BIN SX_BBARG, darg
      end if
      SX_PAIR pairbase, dop, darg
    else
      load a:8 from SX_TBL:SX_MAPMISS*8
      store a+1:8 at SX_TBL:SX_MAPMISS*8
    end if
  else
    load a:8 from SX_TBL:SX_MAPMISS*8
    store a+1:8 at SX_TBL:SX_MAPMISS*8
  end if
end macro

macro SX_NUM value*, width:8				; entier decimal cadre a droite
  local v, p, dd, seen
  v = value
  p = 1
  repeat width-1
    p = p * 10
  end repeat
  seen = 0
  repeat width, n:0
    dd = (v / p) mod 10
    if dd <> 0
      seen = 1
    end if
    if seen = 0 & n < width-1
      db ' '
    else
      db '0' + dd
    end if
    p = p / 10
  end repeat
end macro

macro SX_TXT txt&
  db txt, 13, 10
end macro

macro SX_BROW slot*
  local a
  load a:8 from SX_TBL:(slot)*8
  SX_NUM a
  SX_TXT ''
end macro

macro SX_ROW name*, idx*
  local a, b
  load a:8 from SX_TBL:idx*8
  load b:8 from SX_TBL:(SX_NB+idx)*8
  db name
  SX_NUM a
  SX_NUM b
  SX_TXT ''
end macro

;			M A C R O S   S T R U C T U R E L L E S   ( reprises telles quelles )
;	Elles ne produisent pas d'instruction : espaces de noms, zones virtuelles de
;	variables, etiquettes, donnees statiques, armement de l'assemblage paresseux.

macro show description, value				; pour debogage
  repeat 1, d:value
    display description,`d,13,10
  end repeat
end macro

macro hexa_show description, value			; adresse hexa pour la carto de debogage
  local x, digit
  x = value
  display description, '0', 'x'
  repeat 16, n:0
    digit = (x shr ((15 - n) shl 2)) and 0Fh
    if digit < 10
      display '0' + digit
    else
      display 'A' + digit - 10
    end if
  end repeat
  display 13, 10
end macro

macro			align_b?
;			.......
end macro

macro			align_w?
;			.......
  desalign = $ mod 2
  if desalign <> 0
    repeat 2-desalign
      db 0x90
    end repeat
  end if
end macro

macro			align_d?
;			.......
  desalign = $ mod 4
  if desalign <> 0
    repeat 4-desalign
      db 0x90
    end repeat
  end if
end macro

macro			align_q?
;			.......
  desalign = $ mod 8
  if desalign <> 0
    repeat 8-desalign
      db 0x90
    end repeat
  end if
end macro

macro			PRO	sub_name_lbl			; Debut de procedure declaree
;			----------------------
  namespace sub_name_lbl						; definir son espace de noms
  BRA post							; contournement de l'elaboration autour de la procedure
end macro

macro			ELB	lvl				; En tete de la partie elaboration de procedure
;			-------------
elab:
  virtual at 8							; Commence 8 octets apres le FP dynamique
    VARzone::
  end virtual
	LINK lvl, loc_siz

end macro

macro			endPRO					; Fin de procedure
;			------
post:
  virtual VARzone
    align_q
    loc_siz = $							; Ce n'est que la que l'on calcule la taille des locales qui sera retropropagee au LINK du ELAB
  end virtual
  end namespace
end macro

macro			PRMS					; En tete de la definition des parametres
;			----
  virtual at 8							; La pile de travail croit vers les adresses hautes, les parametres sont au dessus du FP dynamique
    PRMzone::							; donc 8 octets (adresses 64 bits) au dessus du FP
  end virtual

end macro

macro			PRM	name_ofs				; Definition d'un parametre
;			------------------
  virtual PRMzone
    name_ofs = $
    dq ?
  end virtual

end macro

macro			endPRMS					; Fin de la definition des parametres adjust = 8 pour fonction
;			-------
  virtual PRMzone
    prm_siz = $-8							; Calcul de la taille du parametrage
  end virtual

end macro

macro			VAR	name_disp, sizChar, siz:1		; Definition d'un lieu de variable
;			-----------------------------------
  virtual VARzone
     if `sizChar = 'B'  |  `sizChar = 'b'
      align_b
      name_disp = $							; displacement des data de variable
      rb siz							; reservation
    else if `sizChar = 'W'  |  `sizChar = 'w'
      align_w
      name_disp = $
      rw siz
    else if `sizChar = 'D'  |  `sizChar = 'd'
      align_d
      name_disp = $
      rd siz
    else if `sizChar = 'Q'  |  `sizChar = 'q'
      align_q
      name_disp = $
      rq siz
    else
      align_q							; assurer l'alignement de pile dans tous les cas possibles
      name_disp = $							; displacement des data de variable
      rb sizChar							; taille numerique en octets
    end if
  end virtual
end macro

macro			STATOFS	name, siz, algn:0			; Definition de l'offset statique (pour un record statique, dans une virtual at 0)
;			---------------------------
; algn = alignement du COMPOSANT elementaire en octets (1/2/4/8), passe par
; l'expander. algn 0 : compatibilite, ancienne regle par taille totale.
  if algn = 8
    align_q
  else if algn = 4
    align_d
  else if algn = 2
    align_w
  else if algn = 1
								; octets : pas d'alignement
  else								; algn 0 : ancienne regle
    if siz > 4
      align_q
    else if siz > 2
      align_d
    else if siz > 1
      align_w
    end if
  end if
name = $								; nom offset du champ
  rb siz								; reservation
end macro

macro			CST	name_cst:_nil_, sizChar:b, val&	; Definition d'une constante
;			-----------------------------------------
  postpone
    align_#sizChar							; aligner en fonction de l'unite de reservation
    name_cst = $							;
    d#sizChar val							; reservation
end postpone
end macro

macro			USEINFO	lvl, field_name, load_instruc&	; Reference a un __u use info
;			----------------------------------------
  virtual VARzone
    align_q							; aligner en fonction de l'unite de reservation
    field_name#__u = $						; lieu ptr use info
    rq 1
  end virtual
  load_instruc
  SA lvl, field_name#__u
end macro

macro			BEGIN_BLOC_DEF				; Debut du bloc d'images d'un enumere
;			--------------
;	Donnees inline protegees par BRA (pattern des thunks LD_/ST_, sain
;	sous "if defined"). Macros ordinaires, noms FIXES : la paire vit dans
;	le namespace _TYPE de l'enumere, unicite garantie par construction.
;	Ni struc coupee, ni postpone, ni "!", ni local inter-macros.
  BRA	IMAGES.skip
IMAGES.data = $							; les db d'images suivent, inline
end macro

macro			END_BLOC_DEF	siz, fst, lst		; Fin : pose le ENUM_USE_INFO etendu
;			---------------------------------
;	CONTRAT (record ENUM_USE_INFO du prelude + doublet images) :
;	  SIZ @0 (dd) | FST @+4 | LST @+8 | pad | data_ptr @+16 | info_ptr @+24
;	  use__info pointe SIZ ; TEXT_IO (GET_ENUM_IMAGES) lit le doublet a __u+16.
IMAGES.data_end = $							; fin des octets d'images (avant info/scalaires)
  align_q
IMAGES.info = $
	dd 8*(IMAGES.data_end - IMAGES.data), 8, 1, IMAGES.data_end - IMAGES.data
SIZ = $
	dd siz
FST = $
	dd fst
LST = $
	dd lst
	dd 0
IMAGES.data_ptr = $
	dq IMAGES.data
IMAGES.info_ptr = $
	dq IMAGES.info
IMAGES.skip:
end macro

macro			STR	name, bytes			; Definition d'une constante chaine au format d'un tableau de caracteres (pour traitement homogene des chaines)
;			---------------------
;	Une chaine Ada est un tableau d'octets caracteres, c'est a dire un descripteur [ PTR_TO CHARS qword | CAR_SIZE dword | FIRST dword | LAST dword ]
; et des caracteres qui pointes par PTR_TO_CHARS peuvent etre detaches du descripteur. Ici, cas de constante, les caracteres sont juste apres le descripteur.
;
  postpone
    local data
    local info
    local str_bit_size
    align_q							; aligner le descripteur sur un quadword

  namespace name

  data_ptr = $							; adresse de la constante STRING (en fait double pointeur)
    dq	data							; offset 0 : adresse des caracteres (juste apres dans le cas present)
  info_ptr = $							;
    dq	info							; offset 8 : adresse des infos TOT_SIZ, COMP_SIZ, FST_1, LST_1
  info = $							; use info
    dd	str_bit_size, 8, 1, str_bit_size/8				; offset 16 : TOT_SIZ=str_bit_size ; offset 20 :  COMP_SIZ=8bits ; offset	24 : FST=1 ; offset 28 : LST=str_byte_size
    virtual at 0							; definition des offsets sur le useinfo
    SIZ = $
    rd 1
    COMP_SIZ = $
    rd 1
    FST_1 = $
    rd 1
    LST_1 = $
    end virtual
  data = $							; pour une constante les caracteres suivent (pour une chaine variable ce n'est pas le cas, les octets sont dans la co-pile)
    db	bytes
    str_bit_size =  8*($ - data)					; Calculer la longueur effective en bits
  end namespace

end postpone
end macro

