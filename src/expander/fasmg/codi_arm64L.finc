;		-------------------------------------------------------------------------------
;		M A C R O	S   F A S	M G   P O	U R   B A	C K E N D	  A D A 8	3   /   T	L A L O C
;		-------------------------------------------------------------------------------
;
;	VERSION ARM64 / AArch64 -  Linux  -  Raspberry Pi et autres SBC
;
;	Le portage conserve a l'identique la semantique LLIR definie pour x86-64.
;	L'EXPANDER produit le meme code de macros, seul le contenu binaire emis
;	par chaque macro change. Toutes les instructions ARM64 font 32 bits, on
;	les emet par 'dd 0xXXXXXXXX' tout comme on emettait des octets 'db' sur x86-64.
;
;	Convention de portage des registres :
;	  RBP -> x29  (pile de travail croissante)
;	  RSP -> sp   (micro-pile descendante des adresses de retour CALL/RET)
;	  R15 -> x28  (display des frame pointers)
;	  R14 -> x27  (sommet de co-pile)
;	  R13 -> x26  (frame pointer co-pile)
;	  R12 -> x25  (haut du tas)
;	  R11 -> x24  (bloc libre tas)
;	  RAX -> x0   (registre de travail principal et retour syscall)
;	  RBX -> x1   (registre de travail secondaire)
;	  RCX -> x2   (compteur)
;	  RDX -> x3   (auxiliaire)
;	  RSI -> x4   (param syscall - transfere vers x1 pour l'appel)
;	  RDI -> x5   (param syscall - transfere vers x0 pour l'appel)
;	  x30 n'est pas utilise par CALL/RTD : la LLIR maintient une micro-pile explicite sur sp
;	  scratch interne : x16, x17 (IP0/IP1 conventionnellement libres)

postpone							; sera fait en toute toute fin car c'est le premier postpone
  ASM_SIZE = $-0x400078
end postpone

macro show description, value					; pour debogage
  repeat 1, d:value
    display description,`d,13,10
  end repeat
end macro


macro hexa_show description, value			; adresse hexa pour la carto de debogage
  local x, digit
  x = value
  display description, '0', 'x'
  repeat 16, n:0
    digit = (x shr ((15 - n) shl 2)) and 0Fh
    if digit < 10
      display '0' + digit
    else
      display 'A' + digit - 10
    end if
  end repeat
  display 13, 10
end macro
;			-------------------------------------------------------------------
;			S P E C I	F I Q U E	  P R O C	E S S E U	R   A R M   6 4
;			-------------------------------------------------------------------


	; sur processeur ARM64 les mouvements de pile se font en 64 bits (qword)
	; mais on a choisi de faire les operations arithmetiques en 32 bits pour rester comme sur une
	; architecture 32 bits (note : sur ARM64 la difference ne se voit qu'au niveau du flag sf
	; dans l'encodage des instructions ; ici on reste en 64 bits par defaut, c'est plus simple).

	; QUANT A LA PILE : ON A DECIDE DE LA FAIRE CROITRE VERS LES ADRESSES HAUTES CAR LE SENS HABITUEL DESCENDANT
	; EST INGERABLE POUR CERTAINES VARIABLES LOCALES STRUCTUREES
	; Le SP processeur reste en bas de pile pour gerer une micro-pile descendante des adresses de CALL/RET uniquement.
	; ATTENTION : sur ARM64, SP doit etre aligne sur 16 octets sous peine de SIGBUS.
	; On reserve donc 16 octets par CALL au lieu de 8 (sur les 16 octets, seul un qword sert
	; effectivement a stocker LR, l'autre est du padding d'alignement).
	;
	; Attention : x29 pointe sur la derniere valeur empilee (qword)
	; AUTRE PROBLEME DE PILE : Les variables dont on connaît la taille a la compilation s'accomodent bien a
	; la pile usuelle, les offsets sont determines a la compilation
	; MAIS, si l'on a comme en Ada des variables (tableau par exemple) dont la taille n'est connue qu'a
	; l'execution (indices eux-memes variables)
	; on ne peut pas mettre ces variables sur la pile normale. Mettre ces variables dans le tas n'est pas tres
	; satisfaisant car la gestion de la desallocation va poser probleme.
	; On invente donc la Co-Pile qui est une suite de blocs alloues dynamiquement pour un niveau d'execution
	; et qui est desallouee a la maniere de la pile usuelle.
	; De la sorte, il n'y a pas de melange avec les allocations de taille statique.
	; x27 est le pointeur de sommet de Co-Pile (l'analogue de x29 pour la pile standard).

	; x28 pointeur de base display des frame pointers
	; x27 pointeur de haut de co-pile (lieu d'allocation)
	; x26 pointeur de debut de chaine de frame de co-pile (pour desallocation)
	; x25 pointeur post haut de tas (zone de tas allouee sur la pile en debut d'execution expansion vers le bas)
	; x24 pointeur de bloc tas libre


;.......................................................................................................................
;   M A C	R O S   A	N C I L L	A I R E S	  ( P A S	  U T I L	I S E E S	  P A R	L E   C O	D E _ G E	N   T L A	L O C
;.......................................................................................................................
;
; Sur ARM64, "PUSH" et "POP" ne sont pas des instructions matérielles. On les simule par
; un store unsigned-offset a [x29, #8] suivi d'un add x29, x29, #8 pour empiler ;
; et par un load suivi d'un sub x29, x29, #8 pour depiler.
; On utilise la forme "post-incremented" quand c'est commode, sinon STUR/LDR + ADD/SUB.

;			........
macro			PUSH_RAX
;			........
  dd 0xF80083A0							; stur x0, [x29, #8]
  dd 0x910023BD							; add  x29, x29, #8
end macro
;			........
macro			PUSH_RDX
;			........
  dd 0xF80083A3							; stur x3, [x29, #8]
  dd 0x910023BD							; add  x29, x29, #8
end macro
;			.......
macro			POP_RAX
;			.......
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0xD10023BD							; sub x29, x29, #8
end macro
;			.......
macro			POP_RBX
;			.......
  dd 0xF94003A1							; ldr x1, [x29]
  dd 0xD10023BD							; sub x29, x29, #8
end macro
;			.......
macro			POP_RCX
;			.......
  dd 0xF94003A2							; ldr x2, [x29]
  dd 0xD10023BD							; sub x29, x29, #8
end macro
;			.......
macro			POP_RDX
;			.......
  dd 0xF94003A3							; ldr x3, [x29]
  dd 0xD10023BD							; sub x29, x29, #8
end macro
;			.......
macro			POP_RSI
;			.......
  dd 0xF94003A4							; ldr x4, [x29]    (RSI -> x4)
  dd 0xD10023BD							; sub x29, x29, #8
end macro
;			.......
macro			POP_RDI
;			.......
  dd 0xF94003A5							; ldr x5, [x29]    (RDI -> x5)
  dd 0xD10023BD							; sub x29, x29, #8
end macro
;			....
macro			DROP
;			....
  dd 0xD10023BD							; sub x29, x29, #8
end macro
;			...
macro			DUP
;			...
  dd 0xF94003A0							; ldr x0, [x29]		amener le TOS dans x0
  dd 0xF80083A0							; stur x0, [x29, #8]	dupliquer
  dd 0x910023BD							; add  x29, x29, #8
end macro
;			....
macro			OVER
;			....
  dd 0xF85F83A0							; ldur x0, [x29, #-8]	amener le NOS dans x0
  dd 0xF80083A0							; stur x0, [x29, #8]	empiler
  dd 0x910023BD							; add  x29, x29, #8
end macro

;			.......
macro			align_b?
;			.......
end macro

;			.......
macro			align_w?
;			.......
  desalign = $ mod 2
  if desalign <> 0
    repeat 2-desalign
      db 0x00							; padding zero (data, not code)
    end repeat
  end if
end macro

;			.......
macro			align_d?
;			.......
  desalign = $ mod 4
  if desalign <> 0
    repeat 4-desalign
      db 0x00							; padding zero (data, not code)
    end repeat
  end if
end macro

;			.......
macro			align_q?
;			.......
  desalign = $ mod 8
  if desalign <> 0
    repeat 8-desalign
      db 0x00							; padding zero (data, not code)
    end repeat
  end if
end macro

;			...............................
macro			LOAD_QUAD		ofs, Ra, Rd		; load qword Rd depuis [Ra + imm]
;			...............................
;	Choix automatique entre LDR (offset positif scale par 8, 0..32760)
;	ou LDUR (offset signe -256..255 non scale) ; sinon materialisation dans x17.
;	Sans symbole local : ofs est substitue textuellement, d'ou (ofs) partout
;	(precedence fasmg : shr/and/mod lient plus fort que + - *).
  if (ofs) >= 0  &  (ofs) <= 32760  &  ((ofs) mod 8) = 0
    dd 0xF9400000  or  (((ofs) shr 3) shl 10)  or  (Ra shl 5)  or  Rd		; ldr Rd, [Ra, #ofs]
  else if (ofs) >= -256 & (ofs) <= 255
    dd 0xF8400000  or  (((ofs) and 0x1FF) shl 12)  or  (Ra shl 5)  or  Rd	; ldur Rd, [Ra, #ofs]
  else
    QUAD_CONST	17, (ofs)
    dd 0xF8606800  or  (17 shl 16)  or  (Ra shl 5)  or  Rd			; ldr Rd, [Ra, x17]
  end if
end macro

;			...............................
macro			STORE_QUAD	ofs, Ra, Rs		; store qword Rs vers [Ra + ofs]
;			...............................
  if (ofs) >= 0  &  (ofs) <= 32760  &  ((ofs) mod 8) = 0
    dd 0xF9000000  or  (((ofs) shr 3) shl 10)  or  (Ra shl 5)  or  Rs		; str Rs, [Ra, #ofs]
  else if (ofs) >= -256 & (ofs) <= 255
    dd 0xF8000000  or  (((ofs) and 0x1FF) shl 12)  or  (Ra shl 5)  or  Rs	; stur Rs, [Ra, #ofs]
  else
    QUAD_CONST	17, (ofs)
    dd 0xF8206800  or  (17 shl 16)  or  (Ra shl 5)  or  Rs			; str Rs, [Ra, x17]
  end if
end macro

;			...........................
macro			QUAD_CONST	Rd, val
;			...........................
;	Materialise une valeur entiere 64 bits (IMMEDIAT connu des la passe 1) dans Rd.
;	Chemins rapides : 0..0xFFFF -> movz ; -0x10000..-1 -> movn (une instruction).
;	Sinon, sur le motif 64 bits de val : vue movz (chunks nuls implicites) ou vue
;	movn (chunks 0xFFFF implicites), la moins chere ; premier chunk explicite par
;	movz/movn, les suivants par movk. Taille = max(1, min(nz, nf)) : fonction de
;	val seule, calculable au parse par TARGET_CODE (val est dans le texte).
;	Pour une ADRESSE (reference avant, valeur inconnue en passe 1) : QUAD_ADDR,
;	de taille fixe (contrat SIZE_OF = ENCODE, piege n. 88 : jamais de taille
;	dependant d'une valeur de la passe precedente).
;	Precedence fasmg : and/or/shl/shr/mod lient plus fort que + - * ; les parametres
;	de macro sont substitues TEXTUELLEMENT, d'ou les parentheses (val) partout.
  if (val) >= 0 & (val) <= 0xFFFF
    dd 0xD2800000  or  ((val) shl 5)  or  Rd				; movz Rd, #val
  else if (val) < 0 & (val) >= -0x10000
    dd 0x92800000  or  ((-(val) - 1) shl 5)  or  Rd			; movn Rd, #(not val)
  else
    local emitted, chunk, nz, nf
    nz = 0							; chunks non nuls   (cout de la vue movz+movk)
    nf = 0							; chunks /= 0xFFFF  (cout de la vue movn+movk)
    repeat 4, idx:0
      chunk = ((val) shr (16*idx)) and 0xFFFF
      if chunk <> 0
        nz = nz + 1
      end if
      if chunk <> 0xFFFF
        nf = nf + 1
      end if
    end repeat
    emitted = 0
    repeat 4, idx:0
      chunk = ((val) shr (16*idx)) and 0xFFFF
      if nz <= nf							; vue movz : les chunks nuls sont implicites
        if chunk <> 0
          if emitted = 0
            dd 0xD2800000  or  (idx shl 21)  or  (chunk shl 5)  or  Rd	; movz Rd, #chunk, lsl #(16*idx)
            emitted = 1
          else
            dd 0xF2800000  or  (idx shl 21)  or  (chunk shl 5)  or  Rd	; movk Rd, #chunk, lsl #(16*idx)
          end if
        end if
      else							; vue movn : les chunks 0xFFFF sont implicites
        if chunk <> 0xFFFF
          if emitted = 0
            dd 0x92800000  or  (idx shl 21)  or  ((chunk xor 0xFFFF) shl 5)  or  Rd	; movn Rd, #(not chunk), lsl #(16*idx)
            emitted = 1
          else
            dd 0xF2800000  or  (idx shl 21)  or  (chunk shl 5)  or  Rd	; movk Rd, #chunk, lsl #(16*idx)
          end if
        end if
      end if
    end repeat
    if emitted = 0							; tous les chunks implicites : 0 (vue movz) ou -1 (vue movn)
      if nz <= nf
        dd 0xD2800000  or  Rd						; movz Rd, #0
      else
        dd 0x92800000  or  Rd						; movn Rd, #0  (Rd = -1)
      end if
    end if
  end if
end macro

;			..........................
macro			QUAD_ADDR	Rd, val
;			..........................
;	Materialise une ADRESSE (symbole, reference avant possible) dans Rd.
;	TAILLE FIXE : movz + movk, 32 bits (image ELF chargee sous 4 Go, comme sur
;	x86-64 ou movabs est lui aussi de taille fixe). L'assert garde l'hypothese ;
;	si elle tombait un jour, passer a trois instructions (48 bits), toujours fixes.
  assert (val) >= 0 & (val) <= 0xFFFFFFFF
  dd 0xD2800000  or  (((val) and 0xFFFF) shl 5)  or  Rd			; movz Rd, #lo16
  dd 0xF2A00000  or  ((((val) shr 16) and 0xFFFF) shl 5)  or  Rd		; movk Rd, #hi16, lsl #16
end macro

;			.......................
macro			FP_IN_RAX		lvl
;			.......................
;	Aller chercher le frame pointer du niveau lvl dans le display pointe par x28.
;	Encodage direct (imm12 = lvl, scale 8) : une ligne au lieu du passage par LOAD_QUAD.
  assert (lvl) >= 0 & (lvl) <= 31
  dd 0xF9400380  or  ((lvl) shl 10)					; ldr x0, [x28, #8*lvl]
end macro

;			.......................
macro			RAX_IN_FP		lvl
;			.......................
  assert (lvl) >= 0 & (lvl) <= 31
  dd 0xF9000380  or  ((lvl) shl 10)					; str x0, [x28, #8*lvl]
end macro

;			.......................
macro			FP_IN_RBP	lvl
;			.......................
  assert (lvl) >= 0 & (lvl) <= 31
  dd 0xF940039D  or  ((lvl) shl 10)					; ldr x29, [x28, #8*lvl]
end macro

;			.......................
macro			BASE_IN_RAX	lvl
;			.......................
  assert lvl >= -1 & lvl <= 31
  if lvl = -1							; adresse stockage empilee
    POP_RAX							; (adresse data)
  else
    FP_IN_RAX	lvl						; FP(lvl) base
  end if
end macro

;			.......................................
macro			INDIRECT_BASE_IN_RAX	lvl, disp
;			.......................................
  assert lvl >= -1 & lvl <= 31
  if lvl = -1							; top stacked address of address
    POP_RAX							; pop x0 = adresse pointant sur l'adresse de la donnee
    FETCH_QWORD	disp						; fetch adresse de la donnee
  else								; framed address of qword
    FP_IN_RAX	lvl
    FETCH_QWORD	disp						; le FP(lvl) + disp est dans x0
  end if
end macro


;-----------------------------------------------------------------------------------------------------------------------
;					F E T C H	  /   S T	O R E   I	N T E R N	E
;-----------------------------------------------------------------------------------------------------------------------
;
;	Charge une valeur (avec extension de signe) depuis [x0 + disp] dans x0.
;	Sur ARM64 : LDRSB / LDRSH / LDRSW / LDR (la version 64 bits du LDR fait
;	juste un load qword sans signe, mais c'est ce qu'il faut pour qword).
;	Plages d'imm12 :
;	  byte:  imm12 = disp        (0..4095)
;	  half:  imm12 = disp/2      (disp 0..8190 par pas de 2)
;	  word:  imm12 = disp/4      (disp 0..16380 par pas de 4)
;	  qword: imm12 = disp/8      (disp 0..32760 par pas de 8)
;	Pour les offsets negatifs ou non alignes, on utilise LDUR (imm9 signe -256..255).

;			........................
macro			FETCH_BYTE_U	disp
;			........................
; Charge un octet sans signe dans x0 (zero-extension).
  if (disp) = 0
    dd 0x39400000							; ldrb w0, [x0]
  else if (disp) > 0  &  (disp) <= 4095
    dd 0x39400000 or ((disp) shl 10)					; ldrb w0, [x0, #disp]
  else if (disp) >= -256 & (disp) <= 255
    dd 0x38400000 or (((disp) and 0x1FF) shl 12)			; ldurb w0, [x0, #disp]
  else
    QUAD_CONST	17, (disp)
    dd 0x38606800 or (17 shl 16)					; ldrb w0, [x0, x17]
  end if
end macro

;			........................
macro			FETCH_WORD_U	disp
;			........................
; Charge un mot 16 bits sans signe dans x0 (zero-extension).
  if (disp) = 0
    dd 0x79400000							; ldrh w0, [x0]
  else if (disp) >= 0  &  (disp) <= 8190  &  ((disp) mod 2) = 0
    dd 0x79400000 or (((disp) shr 1) shl 10)				; ldrh w0, [x0, #disp]
  else if (disp) >= -256 & (disp) <= 255
    dd 0x78400000 or (((disp) and 0x1FF) shl 12)			; ldurh w0, [x0, #disp]
  else
    QUAD_CONST	17, (disp)
    dd 0x78606800 or (17 shl 16)					; ldrh w0, [x0, x17]
  end if
end macro

;			........................
macro			FETCH_DWORD_U	disp
;			........................
; Charge un dword 32 bits sans signe dans x0. Un ecriture dans w0 met implicitement
; a zero les 32 bits hauts de x0, exactement comme mov eax,[...] sur x86-64.
  if (disp) = 0
    dd 0xB9400000							; ldr w0, [x0]
  else if (disp) >= 0  &  (disp) <= 16380  &  ((disp) mod 4) = 0
    dd 0xB9400000 or (((disp) shr 2) shl 10)				; ldr w0, [x0, #disp]
  else if (disp) >= -256 & (disp) <= 255
    dd 0xB8400000 or (((disp) and 0x1FF) shl 12)			; ldur w0, [x0, #disp]
  else
    QUAD_CONST	17, (disp)
    dd 0xB8606800 or (17 shl 16)					; ldr w0, [x0, x17]
  end if
end macro

;			........................
macro			FETCH_BYTE	disp
;			........................
  if (disp) = 0
    dd 0x39800000							; ldrsb x0, [x0]
  else if (disp) > 0  &  (disp) <= 4095
    dd 0x39800000 or ((disp) shl 10)					; ldrsb x0, [x0, #disp]
  else if (disp) >= -256 & (disp) <= 255
    dd 0x38800000 or (((disp) and 0x1FF) shl 12)			; ldursb x0, [x0, #disp]
  else
    QUAD_CONST	17, (disp)					; x17 = disp
    dd 0x38A06800 or (17 shl 16)					; ldrsb x0, [x0, x17]
  end if
end macro

;			........................
macro			FETCH_WORD	disp
;			........................
  if (disp) = 0
    dd 0x79800000							; ldrsh x0, [x0]
  else if (disp) >= 0  &  (disp) <= 8190  &  ((disp) mod 2) = 0
    dd 0x79800000 or (((disp) shr 1) shl 10)				; ldrsh x0, [x0, #disp]
  else if (disp) >= -256 & (disp) <= 255
    dd 0x78800000 or (((disp) and 0x1FF) shl 12)			; ldursh x0, [x0, #disp]
  else
    QUAD_CONST	17, (disp)
    dd 0x78A06800 or (17 shl 16)					; ldrsh x0, [x0, x17]
  end if

end macro

;			........................
macro			FETCH_DWORD	disp
;			........................
  if (disp) = 0
    dd 0xB9800000							; ldrsw x0, [x0]
  else if (disp) >= 0  &  (disp) <= 16380  &  ((disp) mod 4) = 0
    dd 0xB9800000 or (((disp) shr 2) shl 10)				; ldrsw x0, [x0, #disp]
  else if (disp) >= -256 & (disp) <= 255
    dd 0xB8800000 or (((disp) and 0x1FF) shl 12)			; ldursw x0, [x0, #disp]
  else
    QUAD_CONST	17, (disp)
    dd 0xB8A06800 or (17 shl 16)					; ldrsw x0, [x0, x17]
  end if

end macro

;			........................
macro			FETCH_QWORD	disp
;			........................
  LOAD_QUAD	disp, 0, 0					; ldr x0, [x0, #disp] (avec choix scale/lefty/scratch)
end macro

;			........................
macro			STORE_BYTE	disp
;			........................
;	Range x1 (vue w1 32 bits basse) en byte vers [x0 + disp]
  if (disp) = 0
    dd 0x39000001							; strb w1, [x0]
  else if (disp) > 0  &  (disp) <= 4095
    dd 0x39000001 or ((disp) shl 10)					; strb w1, [x0, #disp]
  else if (disp) >= -256 & (disp) <= 255
    dd 0x38000001 or (((disp) and 0x1FF) shl 12)			; sturb w1, [x0, #disp]
  else
    QUAD_CONST	17, (disp)
    dd 0x38206800 or (17 shl 16) or 1					; strb w1, [x0, x17]
  end if
end macro

;			........................
macro			STORE_WORD	disp
;			........................
  if (disp) = 0
    dd 0x79000001							; strh w1, [x0]
  else if (disp) >= 0  &  (disp) <= 8190  &  ((disp) mod 2) = 0
    dd 0x79000001 or (((disp) shr 1) shl 10)				; strh w1, [x0, #disp]
  else if (disp) >= -256 & (disp) <= 255
    dd 0x78000001 or (((disp) and 0x1FF) shl 12)			; sturh w1, [x0, #disp]
  else
    QUAD_CONST	17, (disp)
    dd 0x78206800 or (17 shl 16) or 1					; strh w1, [x0, x17]
  end if
end macro

;			........................
macro			STORE_DWORD	disp
;			........................
  if (disp) = 0
    dd 0xB9000001							; str w1, [x0]
  else if (disp) >= 0  &  (disp) <= 16380  &  ((disp) mod 4) = 0
    dd 0xB9000001 or (((disp) shr 2) shl 10)				; str w1, [x0, #disp]
  else if (disp) >= -256 & (disp) <= 255
    dd 0xB8000001 or (((disp) and 0x1FF) shl 12)			; stur w1, [x0, #disp]
  else
    QUAD_CONST	17, (disp)
    dd 0xB8206800 or (17 shl 16) or 1					; str w1, [x0, x17]
  end if
end macro

;			........................
macro			STORE_QWORD	disp
;			........................
  STORE_QUAD	disp, 0, 1					; str x1, [x0, #disp]
end macro


;-----------------------------------------------------------------------------------------------------------------------
;			L O A D	C O N S T	A N T E S	  I M M E	D I A T E	S
;-----------------------------------------------------------------------------------------------------------------------

;			-------------
macro			LI	val				; Load Integer (32 bits etendu signe vers 64)
;			-------------
;	Sur x86-64 : movabs rax, imm64 (dq val). Sur ARM64 : jusqu'a 4 movz/movk,
;	QUAD_CONST saute les chunks nuls ; val est un entier 64 bits signe, comme sur x86.
  QUAD_CONST 0, val
  PUSH_RAX
end macro

;			-------------
macro			LIF	val				; Load Immediate Float (IEEE 754 double 64 bits sur la pile entiere)
;			-------------
;	Sur x86-64 c'etait : movabs rax, imm64 ; PUSH_RAX (avec dq val pour la conversion).
;	Sur ARM64 il n'y a pas d'instruction de load 64 bits litteral en une fois ; 
;	on materialise la valeur via 4 movz/movk dans x0, puis on l'empile.
;	Pour obtenir le pattern de bits 64 du flottant, on utilise une zone virtuelle :
;	  - on emet 'dq val' dans un buffer virtuel (fasmg fait la conversion IEEE 754)
;	  - on relit les 8 octets vers une variable entiere
;	  - on materialise cette entiere par movz/movk
  local bits
  virtual at 0
    dq val
    load bits:qword from 0
  end virtual
  QUAD_CONST 0, bits
  PUSH_RAX
end macro


;-----------------------------------------------------------------------------------------------------------------------
;			L O A D	C O N S T	A N T  /	V A R I A	B L E   A	D R E S S	E
;-----------------------------------------------------------------------------------------------------------------------

;			---------------------
macro			LCA	ptr, disp:0			; Load Constant Address
;			---------------------
;	Materialise une adresse dans x0 (QUAD_ADDR, taille fixe : 2 instructions) et l'empile.
  QUAD_ADDR	0, ptr+disp
  PUSH_RAX
end macro


;			--------------------------
macro			LSPA	prefix, subname			; Load SubProgram Address de .elab, en armant l'assemblage lazy
;			--------------------------
  postpone
    if ~definite prefix#subname#_
      prefix#subname#_ = prefix#subname#.elab				; le nom finissant en _ determine l'assemblage de la routine
    end if
  end postpone

  QUAD_ADDR	0, prefix#subname#_					; adresse absolue du sous-programme dans x0 (taille fixe)
  PUSH_RAX
end macro
;			------------------------
macro			LVA	lvl:-1, disp:0			; Load Variable Address pour lvl et disp
;			------------------------
;	Empile l'adresse de la variable au deplacement disp du frame de niveau lvl.
;	x86 : lea rax, [base + disp] ; ARM64 : add x0, base, #disp (immediat 12 bits ; sinon
;	via movz/movk + add).
  BASE_IN_RAX	lvl
  if (disp) = 0
;	x0 deja a la bonne valeur, rien a faire
  else if (disp) >= -4095 & (disp) <= 4095
    if (disp) >= 0
      dd 0x91000000 or ((disp) shl 10) or (0 shl 5) or 0			; add x0, x0, #disp
    else
      dd 0xD1000000 or ((-(disp)) shl 10) or (0 shl 5) or 0			; sub x0, x0, #(-disp)
    end if
  else
    QUAD_CONST	17, (disp)
    dd 0x8B110000							; add x0, x0, x17
  end if
  PUSH_RAX
end macro

;			-------------------------------
macro			LIVA	lvl:-1, disp:0, ofs:0		; Load Indirect Variable Address
;			-------------------------------
;	Empile l'adresse de la variable pointee par l adresse au deplacement disp du frame de lvl,
;	a laquelle on ajoute ofs.
  INDIRECT_BASE_IN_RAX	lvl, disp
  if (ofs) = 0
;	x0 deja a la bonne valeur
  else if (ofs) >= -4095 & (ofs) <= 4095
    if (ofs) >= 0
      dd 0x91000000 or ((ofs) shl 10)					; add x0, x0, #ofs
    else
      dd 0xD1000000 or ((-(ofs)) shl 10)					; sub x0, x0, #(-ofs)
    end if
  else
    QUAD_CONST	17, (ofs)
    dd 0x8B110000							; add x0, x0, x17
  end if
  PUSH_RAX
end macro


;-----------------------------------------------------------------------------------------------------------------------
;					L O A D	D A T A
;-----------------------------------------------------------------------------------------------------------------------

;			------------------------
macro			ULB	lvl:-1, disp:0			; Unsigned Load Byte 8 bits (zero extension)
;			------------------------
  BASE_IN_RAX	lvl
  FETCH_BYTE_U	disp
  PUSH_RAX
end macro
;			------------------------
macro			ULW	lvl:-1, disp:0			; Unsigned Load Word 16 bits
;			------------------------
  BASE_IN_RAX	lvl
  FETCH_WORD_U	disp
  PUSH_RAX
end macro
;			------------------------
macro			ULD	lvl:-1, disp:0			; Unsigned Load doubleword 32 bits
;			------------------------
  BASE_IN_RAX	lvl
  FETCH_DWORD_U	disp
  PUSH_RAX
end macro
;			------------------------
macro			LB	lvl:-1, disp:0			; Load Byte 8 bits
;			------------------------
  BASE_IN_RAX	lvl
  FETCH_BYTE	disp
  PUSH_RAX
end macro
;			------------------------
macro			LW	lvl:-1, disp:0			; Load Word 16 bits
;			------------------------
  BASE_IN_RAX	lvl
  FETCH_WORD	disp
  PUSH_RAX
end macro
;			------------------------
macro			LD	lvl:-1, disp:0			; Load doubleword 32 bits
;			------------------------
  BASE_IN_RAX	lvl
  FETCH_DWORD	disp
  PUSH_RAX
end macro
;			------------------------
macro			LQ	lvl:-1, disp:0			; Load quadword 64 bits
;			------------------------
  BASE_IN_RAX	lvl
  FETCH_QWORD	disp
  PUSH_RAX
end macro
;			------------------------
macro			LA	lvl:-1, disp:0			; Load Address 64 bits
;			------------------------
  LQ lvl, disp
end macro

;			-------------------------------
macro			ULIB	lvl:-1, disp:0, ofs:0		; Unsigned Load Indirect byte
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_BYTE_U		ofs
  PUSH_RAX
end macro
;			-------------------------------
macro			ULIW	lvl:-1, disp:0, ofs:0		; Unsigned Load Indirect word
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_WORD_U		ofs
  PUSH_RAX
end macro
;			-------------------------------
macro			ULID	lvl:-1, disp:0, ofs:0		; Unsigned Load Indirect doubleword
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_DWORD_U		ofs
  PUSH_RAX
end macro

macro			LIB	lvl:-1, disp:0, ofs:0		; Load Indirect byte
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_BYTE		ofs
  PUSH_RAX
end macro
;			-------------------------------
macro			LIW	lvl:-1, disp:0, ofs:0		; Load Indirect word
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_WORD		ofs
  PUSH_RAX
end macro
;			-------------------------------
macro			LID	lvl:-1, disp:0, ofs:0		; Load Indirect doubleword
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_DWORD		ofs
  PUSH_RAX
end macro
;			-------------------------------
macro			LIQ	lvl:-1, disp:0, ofs:0		; Load Indirect quadword
;			-------------------------------
  INDIRECT_BASE_IN_RAX	lvl, disp
  FETCH_QWORD		ofs
  PUSH_RAX
end macro
;			-------------------------------
macro			LIA	lvl:-1, disp:0, ofs:0		; Load Address 64 bits Indirect
;			-------------------------------
  LIQ lvl, disp, ofs
end macro


;-----------------------------------------------------------------------------------------------------------------------
;					S T O R E	  D A T A
;-----------------------------------------------------------------------------------------------------------------------

;			------------------------
macro			SB	lvl:-1, disp:0			; Store byte 8 bits
;			------------------------
  POP_RBX							; (data dans x1)
  BASE_IN_RAX	lvl
  STORE_BYTE	disp
end macro
;			------------------------
macro			SW	lvl:-1, disp:0			; Store word 16 bits
;			------------------------
  POP_RBX
  BASE_IN_RAX	lvl
  STORE_WORD	disp
end macro
;			------------------------
macro			SD	lvl:-1, disp:0			; Store doubleword 32 bits
;			------------------------
  POP_RBX
  BASE_IN_RAX	lvl
  STORE_DWORD	disp
end macro
;			------------------------
macro			SQ	lvl:-1, disp:0			; Store Quadword 64 bits
;			------------------------
  POP_RBX
  BASE_IN_RAX	lvl
  STORE_QWORD	disp
end macro
;			------------------------
macro			SA	lvl:-1, disp:0			; Store Address 64 bits
;			------------------------
  SQ lvl, disp
end macro


;			-------------------------------
macro			SIB	lvl:-1, disp:0, ofs:0		; Store Indirect byte
;			-------------------------------
  POP_RBX
  INDIRECT_BASE_IN_RAX	lvl, disp
  STORE_BYTE		ofs
end macro
;			-------------------------------
macro			SIW	lvl:-1, disp:0, ofs:0		; Store Indirect word
;			-------------------------------
  POP_RBX
  INDIRECT_BASE_IN_RAX	lvl, disp
  STORE_WORD		ofs
end macro
;			-------------------------------
macro			SID	lvl:-1, disp:0, ofs:0		; Store Indirect doubleword
;			-------------------------------
  POP_RBX
  INDIRECT_BASE_IN_RAX	lvl, disp
  STORE_DWORD		ofs
end macro
;			-------------------------------
macro			SIQ	lvl:-1, disp:0, ofs:0		; Store Indirect quadword
;			-------------------------------
  POP_RBX
  INDIRECT_BASE_IN_RAX	lvl, disp
  STORE_QWORD		ofs
end macro
;			------------------------
macro			SIA	lvl, disp, ofs			; Store Address 64 bits Indirect
;			------------------------
  SIQ lvl, disp, ofs
end macro


;-----------------------------------------------------------------------------------------------------------------------
;				O P E R A	T I O N S	  L O G I	Q U E S
;-----------------------------------------------------------------------------------------------------------------------
;
; Sur ARM64 il n'y a pas d'operation read-modify-write memoire comme sur x86 ;
; chaque operation devient ldr / op / str.

;			--
macro			ET
;			--
  POP_RAX								; x0 = B
  dd 0xF94003A1							; ldr x1, [x29]	x1 = A
  dd 0x8A000021							; and x1, x1, x0	x1 = A and B
  dd 0xF90003A1							; str x1, [x29]
end macro
;			--
macro			OU
;			--
  POP_RAX
  dd 0xF94003A1							; ldr x1, [x29]
  dd 0xAA000021							; orr x1, x1, x0
  dd 0xF90003A1							; str x1, [x29]
end macro
;			---
macro			NON
;			---
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0xAA2003E0							; mvn x0, x0
  dd 0xF90003A0							; str x0, [x29]
end macro
;			---
macro			OUX
;			---
  POP_RAX
  dd 0xF94003A1							; ldr x1, [x29]
  dd 0xCA000021							; eor x1, x1, x0
  dd 0xF90003A1							; str x1, [x29]
end macro
;			---
macro			SHL					; decalage gauche
;			---
  POP_RCX								; nombre de positions de decalage dans x2
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0x9AC22000							; lslv x0, x0, x2
  dd 0xF90003A0							; str x0, [x29]
end macro

;			---
macro			SHR					; decalage droit logique
;			---
  POP_RCX								; nombre de positions de decalage dans x2
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0x9AC22400							; lsrv x0, x0, x2
  dd 0xF90003A0							; str x0, [x29]
end macro


;-----------------------------------------------------------------------------------------------------------------------
;		O P E R A	T I O N S	  B I T   F I E L D S
;-----------------------------------------------------------------------------------------------------------------------

;			----
macro			UBFX					; unsigned bit field extract
;			----
  POP_RDX								; x3 = Width
  POP_RCX								; x2 = LSB
  dd 0xF94003A0							; ldr x0, [x29]	valeur source
  dd 0x9AC22400							; lsrv x0, x0, x2	x0 := valeur >> LSB
  dd 0xD2800021							; movz x1, #1
  dd 0x9AC32021							; lslv x1, x1, x3	x1 = 1 << Width
  dd 0xD1000421							; sub x1, x1, #1	x1 = mask
  dd 0x8A010000							; and x0, x0, x1	x0 = field non signe
  dd 0xF90003A0							; str x0, [x29]
end macro
;			----
macro			SBFX					; signed bit field extract
;			----
  POP_RDX								; x3 = Width
  POP_RCX								; x2 = LSB
  dd 0xF94003A0							; ldr x0, [x29]	valeur source
  dd 0x9AC22400							; lsrv x0, x0, x2	x0 := valeur >> LSB
  dd 0xD2800802							; movz x2, #64
  dd 0xCB030042							; sub x2, x2, x3	x2 = 64 - Width
  dd 0x9AC22000							; lslv x0, x0, x2	signe du champ en bit 63
  dd 0x9AC22800							; asrv x0, x0, x2	extension de signe
  dd 0xF90003A0							; str x0, [x29]
end macro
;			---
macro			BFI					; bit field insert in stacked value
;			---
  POP_RCX								; x2 = Width
  POP_RDX								; x3 = LSB
  POP_RAX								; x0 = valeur a inserer
								; MAKE MASK
  dd 0xD2800021							; movz x1, #1
  dd 0x9AC22021							; lslv x1, x1, x2	1 << Width
  dd 0xD1000421							; sub x1, x1, #1	mask = (1 << Width) - 1
								; CUT SHIFT INSERTION
  dd 0x8A010000							; and x0, x0, x1	inserted &= mask
  dd 0x9AC32000							; lslv x0, x0, x3	inserted <<= LSB
								; SHIFT INVERT MASK
  dd 0x9AC32021							; lslv x1, x1, x3	mask <<= LSB
  dd 0xAA2103E1							; mvn x1, x1		~shifted_mask
								; CLEAR INSERT FIELD
  dd 0xF94003B0							; ldr x16, [x29]	old_quad
  dd 0x8A010210							; and x16, x16, x1	clear field in old_quad
  dd 0xAA000210							; orr x16, x16, x0	insert field
  dd 0xF90003B0							; str x16, [x29]
end macro

;	CHAMPS DE BITS A POSITION ET LARGEUR IMMEDIATES
;	UBFXI lsb, w : ( v -- champ )   SBFXI lsb, w : ( v -- champ signe )
;	BFII  lsb, w : ( old ins -- new )    lsb 0..63, w 1..64, lsb + w <= 64
;	En x86 chaque macro redonne exactement LI lsb / LI w / UBFX (SBFX, BFI).

;			----------------------------
macro			BF_IMM_CTRL	lsb*, w*
  assert lsb >= 0 & lsb <= 63
  assert w >= 1 & w <= 64
  assert lsb + w <= 64
end macro
;			------------------
macro			UBFXI	lsb*, w*
  BF_IMM_CTRL lsb, w
  LI lsb
  LI w
  UBFX
end macro
;			------------------
macro			SBFXI	lsb*, w*
  BF_IMM_CTRL lsb, w
  LI lsb
  LI w
  SBFX
end macro
;			------------------
macro			BFII	lsb*, w*
  BF_IMM_CTRL lsb, w
  LI lsb
  LI w
  BFI
end macro


;-----------------------------------------------------------------------------------------------------------------------
;		O P E R A	T I O N S	  A R I T	H M E T I	Q U E   E	N T I E R	E
;-----------------------------------------------------------------------------------------------------------------------

;			---
macro			DEC
;			---
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0xD1000400							; sub x0, x0, #1
  dd 0xF90003A0							; str x0, [x29]
end macro
;			---
macro			INC
;			---
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0x91000400							; add x0, x0, #1
  dd 0xF90003A0							; str x0, [x29]
end macro
;			---
macro			NEG
;			---
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0xCB0003E0							; neg x0, x0  (alias de sub x0, xzr, x0)
  dd 0xF90003A0							; str x0, [x29]
end macro
;			---
macro			ABS
;			---
;	Valeur absolue : si x0 < 0 alors x0 = -x0, sinon x0 inchange.
;	ARM64 dispose de CNEG : "conditional negate".
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0xF100001F							; cmp x0, #0   (alias de subs xzr, x0, #0)
  dd 0xDA805400							; cneg x0, x0, mi  (mi = N=1 = negatif)
  dd 0xF90003A0							; str x0, [x29]
end macro

;			------
macro			CLAMP0					; sommet := max( 0, sommet )
;			------
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0xF100001F							; cmp x0, #0
  dd 0x9A9FA000							; csel x0, x0, xzr, ge
  dd 0xF90003A0							; str x0, [x29]
end macro
;			---
macro			ADD
;			---
  POP_RAX								; x0 = B
  dd 0xF94003A1							; ldr x1, [x29]	x1 = A
  dd 0x8B000021							; add x1, x1, x0
  dd 0xF90003A1							; str x1, [x29]
end macro
;			---
macro			SUB
;			---
  POP_RAX								; x0 = B
  dd 0xF94003A1							; ldr x1, [x29]	x1 = A
  dd 0xCB000021							; sub x1, x1, x0
  dd 0xF90003A1							; str x1, [x29]
end macro
;			---
macro			MUL
;			---
  POP_RAX								; x0 = B
  dd 0xF94003A1							; ldr x1, [x29]	x1 = A
  dd 0x9B007C21							; mul x1, x1, x0    (alias de madd x1, x1, x0, xzr)
  dd 0xF90003A1							; str x1, [x29]
end macro
;			---
macro			DIV
;			---
  POP_RBX								; x1 = B (diviseur)
  POP_RAX								; x0 = A (dividende)
  dd 0x9AC10C00							; sdiv x0, x0, x1
  PUSH_RAX
end macro
;			----
macro			REMI					; A rem B (reste division tronquee, signe du dividende)
;			----
  POP_RBX								; x1 = B (diviseur)
  POP_RAX								; x0 = A (dividende)
  dd 0x9AC10C02							; sdiv x2, x0, x1     (quotient dans x2)
  dd 0x9B018040							; msub x0, x2, x1, x0 (x0 = x0 - (x2 * x1) = reste)
  PUSH_RAX
end macro
;			----
macro			MODI					; A mod B (modulo mathematique, signe du diviseur)
;			----
;	Calculer d'abord le reste tronque (comme REMI), puis ajuster :
;	si reste != 0 et si signes du reste et du diviseur different, ajouter le diviseur.
;	En ARM64 : reste dans x0, diviseur dans x1.
;	  cbz x0, .end       si reste = 0, fini
;	  eor x2, x0, x1     XOR pour comparer les signes (bit 63)
;	  tbz x2, #63, .end  si bit 63 de x2 = 0, memes signes, fini
;	  add x0, x0, x1     ajustement
;	.end:
;
  POP_RBX								; x1 = B
  POP_RAX								; x0 = A
  dd 0x9AC10C02							; sdiv x2, x0, x1     (quotient dans x2)
  dd 0x9B018040							; msub x0, x2, x1, x0 (reste dans x0)
  dd 0xB4000080							; cbz x0, .end (saut +16 octets = 4 instr)
  dd 0xCA010002							; eor x2, x0, x1
  dd 0xB6F80042							; tbz x2, #63, .end (saut +8 octets = 2 instr)
  dd 0x8B010000							; add x0, x0, x1
;.end:
  PUSH_RAX
end macro

;			---
macro			SAR					; decalage arithmetique droit
;			---
  POP_RCX								; nombre de positions de decalage dans x2
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0x9AC22800							; asrv x0, x0, x2
  dd 0xF90003A0							; str x0, [x29]
end macro


;-----------------------------------------------------------------------------------------------------------------------
;	O P E R A	T I O N S	  A R I T	H M E T I	Q U E   F	L O T T A	N T E   (	A R M 6 4   N E O N / F P )
;-----------------------------------------------------------------------------------------------------------------------

;  Convention : les flottants IEEE 754 double 64 bits transitent par la pile entiere (qword).
;  Sur ARM64, les operations flottantes utilisent les registres scalaires d0..d31 (vue 64 bits).
;  Transfers pile <-> Dn via 'ldr d0, [x29]' / 'str d0, [x29]' (encodage SIMD/FP load-store).

;			----
macro			FADD
;			----
  dd 0xFD4003A1							; ldr d1, [x29]	(B = TOS dans d1)
  DROP								; descendre pile (consommer B)
  dd 0xFD4003A0							; ldr d0, [x29]	(A = nouveau TOS dans d0)
  dd 0x1E612800							; fadd d0, d0, d1	(d0 = A + B)
  dd 0xFD0003A0							; str d0, [x29]	(ecraser A par le resultat)
end macro
;			----
macro			FSUB
;			----
  dd 0xFD4003A1							; ldr d1, [x29]
  DROP
  dd 0xFD4003A0							; ldr d0, [x29]
  dd 0x1E613800							; fsub d0, d0, d1	(d0 = A - B)
  dd 0xFD0003A0							; str d0, [x29]
end macro
;			----
macro			FMUL
;			----
  dd 0xFD4003A1							; ldr d1, [x29]
  DROP
  dd 0xFD4003A0							; ldr d0, [x29]
  dd 0x1E610800							; fmul d0, d0, d1	(d0 = A * B)
  dd 0xFD0003A0							; str d0, [x29]
end macro
;			----
macro			FDIV
;			----
  dd 0xFD4003A1							; ldr d1, [x29]	(B = diviseur)
  DROP
  dd 0xFD4003A0							; ldr d0, [x29]	(A = dividende)
  dd 0x1E611800							; fdiv d0, d0, d1	(d0 = A / B)
  dd 0xFD0003A0							; str d0, [x29]
end macro
;			----
macro			FNEG					; negation flottante
;			----
;	ARM64 dispose d'une instruction native FNEG (qui complemente le bit de signe IEEE).
  dd 0xFD4003A0							; ldr d0, [x29]
  dd 0x1E614000							; fneg d0, d0
  dd 0xFD0003A0							; str d0, [x29]
end macro
;			----
macro			FABS					; valeur absolue flottante
;			----
;	ARM64 dispose d'une instruction native FABS.
  dd 0xFD4003A0							; ldr d0, [x29]
  dd 0x1E60C000							; fabs d0, d0
  dd 0xFD0003A0							; str d0, [x29]
end macro

;			----
macro			FEXP					; exponentiation flottante A ** N (N entier POSITIF REQUIS sur la pile)
;			----
;	N est sur la pile (au-dessus de A). On le depile dans x2.
;	Puis on charge A dans d0, on initialise d1 = 1.0, et on boucle N fois : d1 = d1 * d0.
  POP_RCX								; depiler N (exposant) dans x2
  dd 0xFD4003A0							; ldr d0, [x29]	(d0 = base)
;	Charger 1.0 dans d1 (accumulateur). 1.0 IEEE 754 double = 0x3FF0000000000000.
  QUAD_CONST 0, 0x3FF0000000000000					; x0 = 1.0 en IEEE 754 (utilise x0 temporairement)
  dd 0x9E670001							; fmov d1, x0	(d1 = 1.0 accumulateur)
  dd 0xB4000082							; cbz x2, .end (+16)(si N=0, resultat = 1.0, sauter +16 octets = 3 instr)
;.loop:
  dd 0x1E600821							; fmul d1, d1, d0	(accum *= base)
  dd 0xD1000442							; sub x2, x2, #1
  dd 0xB5FFFFC2							; cbnz x2, .loop	(saut -8 octets = -2 instr)
;.end:
  dd 0xFD0003A1							; str d1, [x29]	(ecraser TOS par le resultat)
;	Note : on a ecrase x0 ; pas grave, x0 n'a pas de valeur a preserver ici.
end macro


;-----------------------------------------------------------------------------------------------------------------------
;	C O N V E	R S I O N	S   E N T	I E R  <->  F L O T	T A N T
;-----------------------------------------------------------------------------------------------------------------------

;			-----
macro			CVTIF					; Conversion entier signe 64 bits -> double IEEE 754
;			-----
  dd 0xF94003A0							; ldr x0, [x29]		(entier signe depuis la pile)
  dd 0x9E620000							; scvtf d0, x0		(convertir entier -> double)
  dd 0xFD0003A0							; str d0, [x29]		(ecraser l'entier par le double)
end macro
;			-----
macro			CVTFI					; Conversion double IEEE 754 -> entier signe 64 bits (troncature vers zero)
;			-----
  dd 0xFD4003A0							; ldr d0, [x29]		(double depuis la pile dans d0)
  dd 0x9E780000							; fcvtzs x0, d0		(convertir double -> entier avec troncature ; ftype=01 double, 0x9EF8.... etait h0)
  dd 0xF90003A0							; str x0, [x29]		(ecraser le double par l'entier)
end macro


;			------
macro			CVTFIR					; Float -> Integer, arrondi Ada
;			------
  dd 0xFD4003A0							; ldr d0, [x29]		(double depuis la pile dans d0)
  dd 0x9E600000							; fcvtns x0, d0		nearest, ties-to-even (identique x86-64)
;  dd 0x9E640000							; fcvtas x0, d0		(arrondi au plus proche, demi loin de zero)
  dd 0xF90003A0							; str x0, [x29]		(ecraser le double par l'entier)
end macro

;-----------------------------------------------------------------------------------------------------------------------
;	C O N V E	R S I O N	S   E N T	I E R  <->  F I X E D
;-----------------------------------------------------------------------------------------------------------------------

;			--------------
macro			SDIV128_64_POS				; Division signee 128/64 : (x3:x0) / x1, avec x1 > 0
;			--------------				; Sortie : x0 = quotient signe, x3 = reste signe ; x1 preserve
;	Chemin rapide si x3:x0 est deja l'extension de signe d'un entier 64 bits.
;	Sinon division non signee des valeurs absolues sur 64 iterations, puis restauration du signe.
;	Clobbers : x2, x16, x17.
  local slow, boucle, soustraire, suite, fin
  local d_slow, d_fin, d_sub, d_suite, d_loop

; Produit deja representable sur 64 bits signes ?
  dd 0x937FFC10							; asr x16, x0, #63
  dd 0xEB10007F							; cmp x3, x16
  dd 0x54000001 or (((d_slow shr 2) and 0x7FFFF) shl 5)			; b.ne slow
  d_slow = slow - $ + 4

; Chemin rapide : division materielle 64/64, reste par MSUB.
  dd 0x9AC10C02							; sdiv x2, x0, x1
  dd 0x9B018043							; msub x3, x2, x1, x0
  dd 0xAA0203E0							; mov x0, x2
  dd 0x14000000 or ((d_fin shr 2) and 0x3FFFFFF)				; b fin
  d_fin = fin - $ + 4

slow:
; Masque de signe du dividende 128, puis valeur absolue 128 bits.
  dd 0x937FFC70							; asr x16, x3, #63
  dd 0xCA100000							; eor x0, x0, x16
  dd 0xCA100063							; eor x3, x3, x16
  dd 0xEB100000							; subs x0, x0, x16
  dd 0xDA100063							; sbc x3, x3, x16

; Division non signee 128/64.
; x3 = reste courant, x2 = bits bas du dividende, x0 = quotient.
  dd 0xAA0003E2							; mov x2, x0
  dd 0xD2800000							; mov x0, #0
  dd 0xD2800811							; mov x17, #64

boucle:
  dd 0xAB020042							; adds x2, x2, x2
  dd 0xBA030063							; adcs x3, x3, x3
  dd 0xD37FF800							; lsl x0, x0, #1

  dd 0x54000002 or (((d_sub shr 2) and 0x7FFFF) shl 5)		; b.cs soustraire
  d_sub = soustraire - $ + 4

  dd 0xEB01007F							; cmp x3, x1
  dd 0x54000003 or (((d_suite shr 2) and 0x7FFFF) shl 5)		; b.lo suite
  d_suite = suite - $ + 4

soustraire:
  dd 0xCB010063							; sub x3, x3, x1
  dd 0xB2400000							; orr x0, x0, #1

suite:
  dd 0xF1000631							; subs x17, x17, #1
  dd 0x54000001 or (((d_loop shr 2) and 0x7FFFF) shl 5)		; b.ne boucle
  d_loop = boucle - $ + 4

; Restaurer le signe du quotient et du reste.
  dd 0xCA100000							; eor x0, x0, x16
  dd 0xCB100000							; sub x0, x0, x16
  dd 0xCA100063							; eor x3, x3, x16
  dd 0xCB100063							; sub x3, x3, x16

fin:
end macro
;			-----
macro			CVTIX					; Conversion de l'entier I en FIXED X de SMALL = NUMER/DENOM
;			-----					; Sont empiles I puis DENOM puis NUMER (I.D.N)
  POP_RBX								; x1 = NUMER : diviseur
  POP_RCX								; x2 = DENOM : multiplicateur
  POP_RAX								; x0 = I : multiplicande
  dd 0x9B427C03							; smulh x3, x0, x2
  dd 0x9B027C00							; mul   x0, x0, x2
  SDIV128_64_POS
  PUSH_RAX							; Resultat FIXED X sur 64 bits
end macro

;			-----
macro			CVTXI					; Conversion du FIXED X de SMALL = NUMER/DENOM en INTEGER I
;			-----					; Sont empiles X puis NUMER puis DENOM (X.N.D)
  POP_RBX								; x1 = DENOM : diviseur
  POP_RCX								; x2 = NUMER : multiplicateur
  POP_RAX								; x0 = X : multiplicande

  dd 0x9B427C03							; smulh x3, x0, x2
  dd 0x9B027C00							; mul   x0, x0, x2
  SDIV128_64_POS							; x0 = quotient, x3 = reste

  dd 0x937FFC64							; asr x4, x3, #63	x4 = masque signe du reste
  dd 0xCA040063							; eor x3, x3, x4
  dd 0xCB040063							; sub x3, x3, x4	x3 = abs(reste)

  dd 0x91000421							; add x1, x1, #1
  dd 0xD341FC21							; lsr x1, x1, #1	x1 = ceil(DENOM / 2)

  dd 0xEB01007F							; cmp x3, x1
  dd 0x54000063							; b.lo no_round	(skip 2 instr)

  dd 0xB2400084							; orr x4, x4, #1	(+1 ou -1 selon signe du reste)
  dd 0x8B040000							; add x0, x0, x4
; no_round:
  PUSH_RAX							; Resultat INTEGER I sur 64 bits
end macro

;-----------------------------------------------------------------------------------------------------------------------
;				C O M P A	R A I S O	N S
;-----------------------------------------------------------------------------------------------------------------------
;
; Sur ARM64, on utilise CMP + CSET. Resultat 0/1 strict sur 64 bits dans x0,
; range proprement par STR (alors que x86 setXX [rbp] ne touchait que l'octet bas).

;			---
macro			CEQ
;			---
  POP_RBX								; x1 = B
  dd 0xF94003A0							; ldr x0, [x29]	x0 = A
  dd 0xEB01001F							; subs xzr, x0, x1	(cmp x0, x1)
  dd 0x9A9F17E0							; cset x0, eq
  dd 0xF90003A0							; str x0, [x29]
end macro
;			---
macro			CNE					; A /= B (A empile puis B)
;			---
  POP_RBX
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0xEB01001F							; cmp x0, x1
  dd 0x9A9F07E0							; cset x0, ne
  dd 0xF90003A0							; str x0, [x29]
end macro
;			---
macro			CGT					; A > B
;			---
  POP_RBX
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0xEB01001F							; cmp x0, x1
  dd 0x9A9FD7E0							; cset x0, gt
  dd 0xF90003A0							; str x0, [x29]
end macro
;			---
macro			CGE					; A >= B
;			---
  POP_RBX
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0xEB01001F							; cmp x0, x1
  dd 0x9A9FB7E0							; cset x0, ge
  dd 0xF90003A0							; str x0, [x29]
end macro
;			---
macro			CLT					; A < B
;			---
  POP_RBX
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0xEB01001F							; cmp x0, x1
  dd 0x9A9FA7E0							; cset x0, lt
  dd 0xF90003A0							; str x0, [x29]
end macro
;			---
macro			CLE					; A <= B
;			---
  POP_RBX
  dd 0xF94003A0							; ldr x0, [x29]
  dd 0xEB01001F							; cmp x0, x1
  dd 0x9A9FC7E0							; cset x0, le
  dd 0xF90003A0							; str x0, [x29]
end macro

;-----------------------------------------------------------------------------------------------------------------------
;				C O N T R O L E S   D ' I N T E R V A L L E
;-----------------------------------------------------------------------------------------------------------------------
;	CHKt lvl, disp : bornes FST et LST consecutives en DISPLAY[lvl]+disp (forme B)
;	CHKIt lvl, disp, ofs : bornes en [DISPLAY[lvl]+disp]+ofs (forme C)
;	t = B W D Q (bornes signees) ou UB UW UD (non signees), comme la charge qui les lirait.
;	Echec : CONSTRAINT_ERROR par STANDARD.ce_raise_.
;	En x86 chaque macro redonne exactement la sequence de 8 instructions LLIR d'avant.

;			-------------------------------------------------
macro			CHK_SEQ_B		charge*, taille*, lvl*, disp*
;			-------------------------------------------------
  DUP
  charge lvl, disp
  CLT
  BT STANDARD.ce_raise_
  DUP
  charge lvl, disp+taille
  CGT
  BT STANDARD.ce_raise_
end macro
;			-------------------------------------------------------
macro			CHK_SEQ_C		charge*, taille*, lvl*, disp*, ofs*
;			-------------------------------------------------------
  DUP
  charge lvl, disp, ofs
  CLT
  BT STANDARD.ce_raise_
  DUP
  charge lvl, disp, ofs+taille
  CGT
  BT STANDARD.ce_raise_
end macro
;			---------------------
macro			CHKB	lvl*, disp*
  CHK_SEQ_B LB, 1, lvl, disp
end macro
macro			CHKW	lvl*, disp*
  CHK_SEQ_B LW, 2, lvl, disp
end macro
macro			CHKD	lvl*, disp*
  CHK_SEQ_B LD, 4, lvl, disp
end macro
macro			CHKQ	lvl*, disp*
  CHK_SEQ_B LQ, 8, lvl, disp
end macro
;			---------------------
macro			CHKUB	lvl*, disp*
  CHK_SEQ_B ULB, 1, lvl, disp
end macro
macro			CHKUW	lvl*, disp*
  CHK_SEQ_B ULW, 2, lvl, disp
end macro
macro			CHKUD	lvl*, disp*
  CHK_SEQ_B ULD, 4, lvl, disp
end macro
;			---------------------------
macro			CHKIB	lvl*, disp*, ofs*
  CHK_SEQ_C LIB, 1, lvl, disp, ofs
end macro
macro			CHKIW lvl*, disp*, ofs*
  CHK_SEQ_C LIW, 2, lvl, disp, ofs
end macro
macro			CHKID lvl*, disp*, ofs*
  CHK_SEQ_C LID, 4, lvl, disp, ofs
end macro
macro			CHKIQ lvl*, disp*, ofs*
  CHK_SEQ_C LIQ, 8, lvl, disp, ofs
end macro
;			---------------------------
macro			CHKUIB	lvl*, disp*, ofs*
  CHK_SEQ_C ULIB, 1, lvl, disp, ofs
end macro
macro			CHKUIW	lvl*, disp*, ofs*
  CHK_SEQ_C ULIW, 2, lvl, disp, ofs
end macro
macro			CHKUID	lvl*, disp*, ofs*
  CHK_SEQ_C ULID, 4, lvl, disp, ofs
end macro

;-----------------------------------------------------------------------------------------------------------------------
;		C O M P A	R A I S O	N S   F L	O T T A N	T E S
;-----------------------------------------------------------------------------------------------------------------------
;
;  Convention : A empile puis B. fcmp d0, d1 positionne les flags NZCV selon la
;  semantique IEEE 754. Les conditions ARM64 'eq', 'ne', 'gt' (=GT scalaire),
;  'ge', 'mi' (=less than), 'ls' (=less or equal) suivent la semantique attendue.
;  NaN : si un operande est NaN, fcmp positionne C=1, V=1 (unordered).
;  Comportement Ada : NaN /= x est True (FCNE), toutes autres comparaisons False.

;			----
macro			FCEQ					; A = B  flottant
;			----
  dd 0xFD4003A1							; ldr d1, [x29]	(B = TOS)
  DROP
  dd 0xFD4003A0							; ldr d0, [x29]	(A)
  dd 0x1E612000							; fcmp d0, d1
  dd 0x9A9F17E0							; cset x0, eq
  dd 0xF90003A0							; str x0, [x29]
end macro
;			----
macro			FCNE					; A /= B flottant
;			----
  dd 0xFD4003A1							; ldr d1, [x29]
  DROP
  dd 0xFD4003A0							; ldr d0, [x29]
  dd 0x1E612000							; fcmp d0, d1
  dd 0x9A9F07E0							; cset x0, ne
  dd 0xF90003A0							; str x0, [x29]
end macro
;			----
macro			FCGT					; A > B flottant
;			----
  dd 0xFD4003A1							; ldr d1, [x29]
  DROP
  dd 0xFD4003A0							; ldr d0, [x29]
  dd 0x1E612000							; fcmp d0, d1
  dd 0x9A9FD7E0							; cset x0, gt
  dd 0xF90003A0							; str x0, [x29]
end macro
;			----
macro			FCGE					; A >= B flottant
;			----
  dd 0xFD4003A1							; ldr d1, [x29]
  DROP
  dd 0xFD4003A0							; ldr d0, [x29]
  dd 0x1E612000							; fcmp d0, d1
  dd 0x9A9FB7E0							; cset x0, ge
  dd 0xF90003A0							; str x0, [x29]
end macro
;			----
macro			FCLT					; A < B flottant
;			----
;	Sur ARM64, fcmp d0, d1 positionne les flags ; pour A<B on utilise la condition mi
;	(N=1 = strictement inferieur). Pas besoin d'inverser comme sur SSE2.
  dd 0xFD4003A1							; ldr d1, [x29]
  DROP
  dd 0xFD4003A0							; ldr d0, [x29]
  dd 0x1E612000							; fcmp d0, d1
  dd 0x9A9F57E0							; cset x0, mi  (= less than en flottant)
  dd 0xF90003A0							; str x0, [x29]
end macro
;			----
macro			FCLE					; A <= B flottant
;			----
  dd 0xFD4003A1							; ldr d1, [x29]
  DROP
  dd 0xFD4003A0							; ldr d0, [x29]
  dd 0x1E612000							; fcmp d0, d1
  dd 0x9A9F87E0							; cset x0, ls  (= lower or same en flottant)
  dd 0xF90003A0							; str x0, [x29]
end macro



;-----------------------------------------------------------------------------------------------------------------------
;			O P E R A	T I O N S	  C O N T	R O L E	D E   F L	O T
;-----------------------------------------------------------------------------------------------------------------------

;			-------------
macro			BRA	lbl				; inconditionnel
;			-------------
;	B label : opcode 0x14000000 + (offset/4) sur 26 bits signe.
;	Plage : ±128 Mo. Offset = lbl - position_de_l_instruction.
;	Convention fasmg : '$' apres une emission designe la position suivante,
;	donc la position de l'instruction qu'on vient d'emettre est ($ - 4).
;	Pour ARM64 PC-relative : offset = lbl - ($ - 4) = lbl - $ + 4.
;	On utilise une variable locale forward-referencee pour permettre la resolution.
  local disp
  dd 0x14000000 or ((disp shr 2) and 0x3FFFFFF)
  disp = lbl - $ + 4
  assert (disp mod 4) = 0 & disp >= -134217728 & disp <= 134217724
end macro

;			-------------
macro			BT	lbl				; branch true
;			-------------
;	POP x0 puis saut par INVERSION : CBZ x0, +8 enjambe le B ; B lbl.
;	Un CBNZ direct n'offre que +-1 Mo (imm19) : insuffisant pour le compilateur
;	entier (BT STANDARD.ne_raise_ hors plage). Le B offre +-128 Mo (imm26),
;	comme BRA, dont on reutilise la macro (et son assert de plage).
;	Forme longue SYSTEMATIQUE : jamais de choix de taille inter-passes
;	(pieges n. 82 et 88 : decision non monotone = oscillation fasmg).
;	Cout : une instruction (4 octets) de plus par BT/BF.
  POP_RAX
  dd 0xB4000040							; cbz x0, +8	(x0 = 0 : enjambe le B, pas de saut)
  BRA lbl								; b lbl		(x0 /= 0 : saut)
end macro

;			-------------
macro			BF	lbl				; branch false
;			-------------
;	Symetrique de BT : CBNZ x0, +8 enjambe le B ; B lbl.
  POP_RAX
  dd 0xB5000040							; cbnz x0, +8	(x0 /= 0 : enjambe le B, pas de saut)
  BRA lbl								; b lbl		(x0 = 0 : saut)
end macro

;			-------------------------
macro			CALL	prefix, subname			; CALL par offset
;			-------------------------
; AArch64 n'empile pas l'adresse de retour. Pour conserver EXACTEMENT le modele
; LLIR/x86, on gere explicitement la micro-pile par SP : chaque appel reserve
; 16 octets (alignement AArch64), range l'adresse de retour a [sp], puis branche.
; RTD depile cette adresse. Ainsi une restauration de SP par EXC_RAISE deroule
; aussi les retours des frames abandonnes, sans avoir a sauver x30 dans le contexte.
; L'adresse de retour est PC-relative (adr x16, .+16 : la 4e instruction apres
; l'adr) : taille fixe de 16 octets par CALL, aucun label, aucune dependance
; a une valeur de passe precedente (contrat SIZE_OF = ENCODE).
  postpone
    if ~definite prefix#subname#_
      prefix#subname#_ = prefix#subname#.elab
    end if
  end postpone

  dd 0x10000090							; adr x16, .+16	(adresse de retour = apres le b)
  dd 0xD10043FF							; sub sp, sp, #16
  dd 0xF90003F0							; str x16, [sp]
  BRA prefix#subname#_
end macro

;			-----
macro			CALLI					; CALL indirect par valeur empilee
;			-----
  POP_RAX								; x0 = adresse cible
  dd 0x10000090							; adr x16, .+16	(adresse de retour = apres le br)
  dd 0xD10043FF							; sub sp, sp, #16
  dd 0xF90003F0							; str x16, [sp]
  dd 0xD61F0000							; br x0
end macro
;			--------------------
macro			RTD	param_size:0
;			----------------------
  prm_size = param_size
  assert prm_size >= 0
  if prm_size <> 0
    if prm_size <= 4095
      dd 0xD1000000 or (prm_size shl 10) or (29 shl 5) or 29		; sub x29, x29, #prm_size
    else if prm_size <= 16777215  &  (prm_size mod 4096) = 0
      dd 0xD1400000 or ((prm_size shr 12) shl 10) or (29 shl 5) or 29	; sub x29, x29, #prm_size, lsl #12
    else
      QUAD_CONST	17, prm_size
      dd 0xCB1103BD							; sub x29, x29, x17
    end if
  end if
  dd 0xF94003F0							; ldr x16, [sp]   adresse de retour LLIR
  dd 0x910043FF							; add sp, sp, #16
  dd 0xD61F0200							; br x16
end macro
;-----------------------------------------------------------------------------------------------------------------------
;			O P E R A	T I O N S	  G E S T	I O N   D	E   P I L	E
;-----------------------------------------------------------------------------------------------------------------------

;			--------------------
macro			LINK	lvl, alloc			; ALLOCATION POUR VARIABLES LOCALES APRES FRAME PTR
;			--------------------
;	Pour lvl > 0 : sauvegarder l'ancien FP du niveau dans la pile de travail,
;	puis mettre a jour l'entree du display.
;	Allouer ensuite alloc octets pour les variables locales.
;	Creer un frame de co-pile.
  if lvl > 0
    FP_IN_RAX	lvl						; x0 = ancien FP du niveau
    PUSH_RAX							; pousser sur la pile de travail
;	Mettre a jour l'entree lvl du display avec le RBP courant (=x29)
    STORE_QUAD 8*lvl, 28, 29						; str x29, [x28, #8*lvl]
  end if
  assert alloc >= 0
  if alloc <> 0
    local alloc8
    alloc8 = 8*((alloc+7)/8)						; arrondir a multiple de 8
    if alloc8 <= 4095
      dd 0x91000000 or (alloc8 shl 10) or (29 shl 5) or 29			; add x29, x29, #alloc8
    else if alloc8 <= 16777215  &  (alloc8 mod 4096) = 0
      dd 0x91400000 or ((alloc8 shr 12) shl 10) or (29 shl 5) or 29		; add x29, x29, #alloc8, lsl #12
    else
      QUAD_CONST	17, alloc8
      dd 0x8B1103BD							; add x29, x29, x17
    end if
  end if
;	Gerer la co-pile
;	mov [x27], x26   (empiler le frame pointer de co-pile sur celle-ci)
  dd 0xF900037A							; str x26, [x27]
;	mov x26, x27     (mettre a jour le frame pointer de co-pile)
  dd 0xAA1B03FA							; mov x26, x27  (alias de orr x26, xzr, x27)
;	add x27, x27, #8 (monter le haut de co-pile sur le premier lieu libre)
  dd 0x9100237B							; add x27, x27, #8
end macro

;			-------------
macro			UNLINK	lvl				; DISPOSE VARS LOCALES ET RESTORE FRAME PTR
;			-------------
  FP_IN_RBP	lvl						; throw locals : x29 = FP(lvl)
  POP_RAX								; depiler l'ancien FP sauvegarde
  RAX_IN_FP	lvl						; restaurer l'entree lvl du display
;	Liberer le frame de co-pile : mov x26, [x26]
  dd 0xF940035A							; ldr x26, [x26]
end macro

;			-------------
macro			UNLINKR	lvl				; DISPOSE VARS LOCALES ET RESTORE FRAME PTR
;			-------------
  FP_IN_RBP	lvl						; throw locals : x29 = FP(lvl)
  POP_RAX								; depiler l'ancien FP sauvegarde
  RAX_IN_FP	lvl						; restaurer l'entree lvl du display
;	Liberer le frame de co-pile : mov x26, [x26]

  dd 0xAA1A03FB							; mov x27, x26	(sommet := cellule LINK de ce frame = x27 d'avant LINK)
  dd 0xF940035A							; ldr x26, [x26]
end macro

;			----------------------
macro			PRO	sub_name_lbl			; Debut de procedure declaree
;			----------------------
  namespace sub_name_lbl						; definir son espace de noms
  BRA post							; contournement de l'elaboration autour de la procedure
end macro

;			----
macro			PRMS					; En tete de la definition des parametres
;			----
  virtual at 8							; La pile de travail croit vers les adresses hautes, les parametres sont au dessus du FP dynamique
    PRMzone::							; donc 8 octets (adresses 64 bits) au dessus du FP
  end virtual
end macro

;			------------------
macro			PRM	name_ofs				; Definition d'un parametre
;			------------------
  virtual PRMzone
    name_ofs = $
    dq ?
  end virtual
end macro

;			-------
macro			endPRMS					; Fin de la definition des parametres
;			-------
  virtual PRMzone
    prm_siz = $-8							; Calcul de la taille du parametrage
  end virtual
end macro

;			-------------
macro			ELB	lvl				; En tete de la partie elaboration de procedure
;			-------------
elab:
  virtual at 8							; Commence 8 octets apres le FP dynamique
    VARzone::
  end virtual
  LINK lvl, loc_siz
end macro

;			--------------
macro			BEGIN_BLOC_DEF				; Debut du bloc d'images d'un enumere
;			--------------
; Donnees inline protegees par BRA. Les noms fixes vivent dans le namespace
; du type enumere ; pas de struc coupee ni de postpone inter-macros.
  BRA	IMAGES.skip
IMAGES.data = $
end macro

;			------------
macro			END_BLOC_DEF	siz, fst, lst		; Fin : pose le ENUM_USE_INFO etendu
;			------------
; CONTRAT : SIZ @0 | FST @+4 | LST @+8 | pad | data_ptr @+16 | info_ptr @+24.
IMAGES.data_end = $
  align_q
IMAGES.info = $
  dd 8*(IMAGES.data_end - IMAGES.data), 8, 1, IMAGES.data_end - IMAGES.data
SIZ = $
  dd siz
FST = $
  dd fst
LST = $
  dd lst
  dd 0
IMAGES.data_ptr = $
  dq IMAGES.data
IMAGES.info_ptr = $
  dq IMAGES.info
IMAGES.skip:
end macro

;	Une chaine Ada est un tableau d'octets caracteres, c'est a dire un descripteur
;	[ PTR_TO_CHARS qword | PTR_TO_INFO qword ] et un bloc info [ TOT_SIZ dword | COMP_SIZ dword | FIRST dword | LAST dword ].
;	Les caracteres pointes par PTR_TO_CHARS peuvent etre detaches du descripteur.
;	Ici, cas de constante, les caracteres sont juste apres le descripteur.

;			---------------------
macro			STR	name, bytes			; Definition d'une constante chaine
;			---------------------
  postpone
    local data
    local info
    local str_bit_size
    align_q							; aligner le descripteur sur un quadword

  namespace name

  data_ptr = $							; adresse de la constante STRING (en fait double pointeur)
    dq data							; offset 0 : adresse des caracteres (juste apres dans le cas present)
  info_ptr = $
    dq info							; offset 8 : adresse des infos TOT_SIZ, COMP_SIZ, FST_1, LST_1
  info = $							; use info
    dd str_bit_size, 8, 1, str_bit_size/8				; offset 16 : TOT_SIZ ; offset 20 : COMP_SIZ=8 ; offset 24 : FST=1 ; offset 28 : LST
    virtual at 0
    SIZ = $
    rd 1
    COMP_SIZ = $
    rd 1
    FST_1 = $
    rd 1
    LST_1 = $
    end virtual
  data = $
    db bytes
    str_bit_size = 8*($ - data)					; Calculer la longueur effective en bits
  end namespace

  end postpone
end macro

;			-----------------------------------------
macro			CST	name_cst:_nil_, sizChar:b, val&	; Definition d'une constante
;			-----------------------------------------
  postpone
    align_#sizChar							; aligner en fonction de l'unite de reservation
    name_cst = $
    d#sizChar val							; reservation
  end postpone
end macro

;			----------------------------------------
macro			USEINFO	lvl, field_name, load_instruc&	; Reference a un __u use info
;			----------------------------------------
  virtual VARzone
    align_q
    field_name#__u = $						; lieu ptr use info
    rq 1								; reservation
  end virtual
  load_instruc
  SA lvl, field_name#__u
end macro
;			-------------------
macro			STATOFS	name, siz, algn:0			; Definition de l'offset statique
;			---------------------------
; algn = alignement du composant elementaire en octets (1/2/4/8).
; algn 0 conserve l'ancienne regle derivee de la taille totale.
  if algn = 8
    align_q
  else if algn = 4
    align_d
  else if algn = 2
    align_w
  else if algn = 1
  else
    if siz > 4
      align_q
    else if siz > 2
      align_d
    else if siz > 1
      align_w
    end if
  end if
name = $
  rb siz
end macro
;			-----------------------------------
macro			VAR	name_disp, sizChar, siz:1		; Definition d'un lieu de variable
;			-----------------------------------
  virtual VARzone
     if `sizChar = 'B'  |  `sizChar = 'b'
      align_b
      name_disp = $							; displacement des data de variable
      rb siz							; reservation
    else if `sizChar = 'W'  |  `sizChar = 'w'
      align_w
      name_disp = $
      rw siz
    else if `sizChar = 'D'  |  `sizChar = 'd'
      align_d
      name_disp = $
      rd siz
    else if `sizChar = 'Q'  |  `sizChar = 'q'
      align_q
      name_disp = $
      rq siz
    else
      align_q							; assurer l'alignement de pile dans tous les cas possibles
      name_disp = $							; displacement des data de variable
      rb sizChar							; taille numerique en octets
    end if
  end virtual
end macro

;			------
macro			CO_VAR					; Allocation d'un bloc sur la co-pile, taille en octets sur la pile standard, laisse l'adresse de debut de bloc sur la pile
;			------
  POP_RAX								; x0 = taille demandee
;	Empiler le sommet courant de co-pile (x27) sur la pile standard
  dd 0xF80083BB							; stur x27, [x29, #8]
  dd 0x910023BD							; add  x29, x29, #8
;	Arrondir x0 a multiple de 8 : x0 = (x0 + 7) >> 3, puis multiplier par 8 indirectement
;	en utilisant 'add x27, x27, x0, lsl #3'
  dd 0x91001C00							; add x0, x0, #7
  dd 0x9343FC00							; asr x0, x0, #3        (lsr serait pareil ici car x0 >= 0)
;	add x27, x27, x0, lsl #3
  dd 0x8B000F7B							; add x27, x27, x0, lsl #3
end macro


;			----------
macro			HEAP_ALLOC				; Allocation bump-pointer pour Ada new
;			----------
; x25 est le haut du tas mmap separe. La taille demandee est arrondie a 8,
; le tas croit vers les adresses basses et l'adresse du bloc est empilee.
  POP_RAX
  dd 0x91001C00							; add x0, x0, #7
  dd 0xD343FC00							; lsr x0, x0, #3
  dd 0xD37DF000							; lsl x0, x0, #3
  dd 0xCB000339							; sub x25, x25, x0
  dd 0xAA1903E0							; mov x0, x25
  PUSH_RAX
end macro
;			------
macro			endPRO					; Fin de procedure
;			------
post:
  virtual VARzone
    align_q
    loc_siz = $							; taille des locales retropropagee au LINK du ELAB
  end virtual
  end namespace
end macro

;			----------------------------
macro			EXC_MACH		lvl, ctx			; photographie de l'etat machine cache
;			----------------------------
; Layout identique a la reference x86 :
; +16 x29 (pile travail), +24 sp (micro-pile retours), +32 x26, +40 x27,
; +48 nlvl=lvl+1, +56 prefixe display FP(0..lvl).
  assert lvl >= 0 & lvl <= 31
  FP_IN_RAX lvl							; x0 := FP(lvl), base du contexte
  STORE_QUAD	ctx + 16, 0, 29
  dd 0x910003F0							; mov x16, sp
  STORE_QUAD	ctx + 24, 0, 16
  STORE_QUAD	ctx + 32, 0, 26
  STORE_QUAD	ctx + 40, 0, 27
  QUAD_CONST	16, lvl + 1
  STORE_QUAD	ctx + 48, 0, 16
  repeat lvl + 1, n:0
    LOAD_QUAD	8*n, 28, 16
    STORE_QUAD	ctx + 56 + 8*n, 0, 16
  end repeat
end macro

;			-----------------------
macro			EXC_RAISE		top			; deroulage vers le contexte sommet
;			-----------------------
; Atteint par BRA, jamais par CALL. Le POP du contexte est fait avant dispatch,
; afin qu'un raise execute dans un handler remonte au contexte appelant.
  local boucle, d_boucle
  LOAD_QUAD	0, 28, 1						; x1 := FP(0)
  LOAD_QUAD	top, 1, 0						; x0 := contexte sommet
  dd 0xAA0003E3							; mov x3, x0   conserver ctx
  LOAD_QUAD	0, 3, 2						; x2 := PREV_CTX
  STORE_QUAD	top, 1, 2					; POP avant dispatch

  LOAD_QUAD	32, 3, 26						; restaurer frame co-pile
  LOAD_QUAD	40, 3, 27						; restaurer sommet co-pile
  LOAD_QUAD	24, 3, 16						; micro-pile retours sauvegardee
  dd 0x9100021F							; mov sp, x16
  LOAD_QUAD	48, 3, 2						; x2 := NXT_LVL / nombre d'entrees display
  dd 0x9100E064							; add x4, x3, #56  source prefixe
  dd 0xAA1C03E5							; mov x5, x28      destination display
boucle:
  dd 0xF9400090							; ldr x16, [x4]
  dd 0xF90000B0							; str x16, [x5]
  dd 0x91002084							; add x4, x4, #8
  dd 0x910020A5							; add x5, x5, #8
  dd 0xD1000442							; sub x2, x2, #1
  dd 0xB5000002 or (((d_boucle shr 2) and 0x7FFFF) shl 5)		; cbnz x2, boucle
  d_boucle = boucle - $ + 4

  LOAD_QUAD	16, 3, 29						; restaurer pile de travail
  LOAD_QUAD	8, 3, 16						; DISPATCH
  dd 0xD61F0200							; br x16
end macro
;-----------------------------------------------------------------------------------------------------------------------
;		O P E R A T I O N S   L O G I Q U E S   D E   B L O C   (LRM 4.5.1)
;-----------------------------------------------------------------------------------------------------------------------
; pile binaire = @DST, LEN, @SRC ; [DST] op= [SRC]. LEN en octets.

;			------------------------
macro			BLK_OP_OCTET	opc*				; usine interne, opc miroir x86 20/08/30
;			------------------------
  local boucle, fin, d_fin, d_boucle
  POP_RSI								; x4 = @SRC
  POP_RCX								; x2 = LEN
  POP_RDI								; x5 = @DST
  dd 0xB4000002 or (((d_fin shr 2) and 0x7FFFF) shl 5)			; cbz x2, fin
  d_fin = fin - $ + 4
boucle:
  dd 0x39400090							; ldrb w16, [x4]
  dd 0x394000B1							; ldrb w17, [x5]
  if opc = 0x20
    dd 0x0A100231							; and w17, w17, w16
  else if opc = 0x08
    dd 0x2A100231							; orr w17, w17, w16
  else if opc = 0x30
    dd 0x4A100231							; eor w17, w17, w16
  else
    err 'BLK_OP_OCTET : operation non supportee'
  end if
  dd 0x390000B1							; strb w17, [x5]
  dd 0x91000484							; add x4, x4, #1
  dd 0x910004A5							; add x5, x5, #1
  dd 0xD1000442							; sub x2, x2, #1
  dd 0xB5000002 or (((d_boucle shr 2) and 0x7FFFF) shl 5)		; cbnz x2, boucle
  d_boucle = boucle - $ + 4
fin:
end macro
;			------
macro			BLKAND
;			------
  BLK_OP_OCTET 0x20
end macro
;			-----
macro			BLKOU
;			-----
  BLK_OP_OCTET 0x08
end macro
;			------
macro			BLKOUX
;			------
  BLK_OP_OCTET 0x30
end macro

;			------
macro			BLKNOT					; NOT composite : chaque octet ^= 1
;			------
  local boucle, fin, d_fin, d_boucle
  POP_RCX								; x2 = LEN
  POP_RDI								; x5 = @DST
  dd 0xB4000002 or (((d_fin shr 2) and 0x7FFFF) shl 5)
  d_fin = fin - $ + 4
boucle:
  dd 0x394000B0							; ldrb w16, [x5]
  dd 0x52000210							; eor w16, w16, #1
  dd 0x390000B0							; strb w16, [x5]
  dd 0x910004A5							; add x5, x5, #1
  dd 0xD1000442							; sub x2, x2, #1
  dd 0xB5000002 or (((d_boucle shr 2) and 0x7FFFF) shl 5)
  d_boucle = boucle - $ + 4
fin:
end macro

;			------
macro			BLKMOV					; Copie de bloc sans recouvrement
;			------
;	Depile src (x4), count (x2), dst (x5) ; copie octet par octet via boucle.
;	Utilise w16 comme registre de transit (scratch IP0).
  POP_RSI								; x4 = adresse source
  POP_RCX								; x2 = nombre d'octets
  POP_RDI								; x5 = adresse destination
  dd 0xB40000A2							; cbz x2, .end (saut +20 octets = 5 instr)
;.loop:
  dd 0x38401490							; ldrb w16, [x4], #1   (post-increment src)
  dd 0x380014B0							; strb w16, [x5], #1   (post-increment dst)
  dd 0xD1000442							; sub x2, x2, #1
  dd 0xB5FFFFA2							; cbnz x2, .loop (saut -12 octets = -3 instr)
;.end:
end macro

;			------
macro			BLKCMP					; Comparaison de blocs : 1 si egaux, 0 sinon
;			------
  local boucle, different, fin, d_fin0, d_diff, d_loop, d_fin1
  POP_RSI								; x4 = @B
  POP_RCX								; x2 = LEN
  POP_RDI								; x5 = @A
  dd 0xD2800020							; mov x0, #1 (LEN=0 => egal)
  dd 0xB4000002 or (((d_fin0 shr 2) and 0x7FFFF) shl 5)
  d_fin0 = fin - $ + 4
boucle:
  dd 0x39400090							; ldrb w16, [x4]
  dd 0x394000B1							; ldrb w17, [x5]
  dd 0x6B11021F							; cmp w16, w17
  dd 0x54000001 or (((d_diff shr 2) and 0x7FFFF) shl 5)			; b.ne different
  d_diff = different - $ + 4
  dd 0x91000484							; add x4, x4, #1
  dd 0x910004A5							; add x5, x5, #1
  dd 0xD1000442							; sub x2, x2, #1
  dd 0xB5000002 or (((d_loop shr 2) and 0x7FFFF) shl 5)
  d_loop = boucle - $ + 4
  BRA fin
different:
  dd 0xD2800000							; mov x0, #0
fin:
  PUSH_RAX
end macro

;			-----------------
macro			LEXCMP siz*, sgn*				; Comparaison lexicographique de tableaux
;			-----------------
; Entree : @G, LEN_G, @D, LEN_D ; longueurs en octets. Sortie : -1/0/+1.
  local boucle, epuise, differe, plus, egal, moins, empile
  local d_g0, d_d0, d_ne, d_loop, d_eq, d_ltpre, d_lt, d_plus1, d_plus2, d_eqend

  POP_RDX								; x3 = LEN_D
  POP_RSI								; x4 = @D
  POP_RCX								; x2 = LEN_G
  POP_RDI								; x5 = @G
boucle:
  dd 0xB4000002 or (((d_g0 shr 2) and 0x7FFFF) shl 5)			; cbz x2, epuise
  d_g0 = epuise - $ + 4
  dd 0xB4000003 or (((d_d0 shr 2) and 0x7FFFF) shl 5)			; cbz x3, epuise
  d_d0 = epuise - $ + 4

if siz = 1
  if sgn = 1
    dd 0x398000A0							; ldrsb x0, [x5]
    dd 0x39800081							; ldrsb x1, [x4]
  else
    dd 0x394000A0							; ldrb w0, [x5]
    dd 0x39400081							; ldrb w1, [x4]
  end if
else if siz = 2
  if sgn = 1
    dd 0x798000A0							; ldrsh x0, [x5]
    dd 0x79800081							; ldrsh x1, [x4]
  else
    dd 0x794000A0							; ldrh w0, [x5]
    dd 0x79400081							; ldrh w1, [x4]
  end if
else if siz = 4
  if sgn = 1
    dd 0xB98000A0							; ldrsw x0, [x5]
    dd 0xB9800081							; ldrsw x1, [x4]
  else
    dd 0xB94000A0							; ldr w0, [x5]
    dd 0xB9400081							; ldr w1, [x4]
  end if
else if siz = 8
    dd 0xF94000A0							; ldr x0, [x5]
    dd 0xF9400081							; ldr x1, [x4]
else
  err 'LEXCMP : taille de composant non supportee'
end if

  dd 0xEB01001F							; cmp x0, x1
  dd 0x54000001 or (((d_ne shr 2) and 0x7FFFF) shl 5)			; b.ne differe
  d_ne = differe - $ + 4

  if siz <= 4095
    dd 0x910000A5 or (siz shl 10)					; add x5, x5, #siz
    dd 0x91000084 or (siz shl 10)					; add x4, x4, #siz
    dd 0xD1000042 or (siz shl 10)					; sub x2, x2, #siz
    dd 0xD1000063 or (siz shl 10)					; sub x3, x3, #siz
  end if
  BRA boucle

epuise:
  dd 0xEB030042							; subs x2, x2, x3   (reste_G - reste_D, drapeaux pour b.eq / b.lt)
  dd 0x54000000 or (((d_eq shr 2) and 0x7FFFF) shl 5)			; b.eq egal
  d_eq = egal - $ + 4
  dd 0x5400000B or (((d_ltpre shr 2) and 0x7FFFF) shl 5)			; b.lt moins
  d_ltpre = moins - $ + 4
plus:
  dd 0xD2800020							; mov x0, #1
  BRA empile
differe:
  dd 0x5400000B or (((d_lt shr 2) and 0x7FFFF) shl 5)			; b.lt moins (flags du cmp)
  d_lt = moins - $ + 4
  BRA plus
egal:
  dd 0xD2800000							; mov x0, #0
  BRA empile
moins:
  dd 0x92800000							; mov x0, #-1
empile:
  PUSH_RAX
end macro
;				------------------------------
;				SPECIFIQUE  L I N U X   ARM64
;				------------------------------
;
;	Convention syscall AArch64 Linux :
;	  x8       = numero de syscall
;	  x0..x5   = arguments (jusqu'a 6)
;	  retour   = x0
;	  instruction = svc #0
;
;	Numeros de syscall ARM64 (differents de x86-64) :
;	  read     = 63
;	  write    = 64
;	  close    = 57
;	  openat   = 56  (remplace open ; AT_FDCWD = -100 en arg 1)
;	  unlinkat = 35  (remplace unlink ; AT_FDCWD en arg 1, flag = 0)
;	  lseek    = 62
;	  ioctl    = 29
;	  clock_gettime = 113
;	  exit     = 93
;
;	Constantes ioctl identiques x86/ARM (ce sont des constantes du noyau Linux) :
;	  TCGETS = 0x5401
;	  TCSETS = 0x5402


;			-----------------
macro			SYS_CLOCK_GETTIME
;			-----------------
  POP_RSI								; x4 = @timespec_buffer
  dd 0xAA0403E1							; mov x1, x4		(arg2 = buffer)
  dd 0xD2800000							; movz x0, #0		(arg1 = CLOCK_REALTIME)
  dd 0xD2800E28							; movz x8, #113		(sys_clock_gettime)
  dd 0xD4000001							; svc #0
end macro


;			------------
macro			SYS_PUT_CHAR				; affiche un seul caractere sur stdout
;			------------
;	Le caractere est sur la pile en sommet (a l'adresse [x29]).
;	syscall : write(fd=1, buf=&caractere, count=1)
;	  x0 = fd = 1
;	  x1 = adresse caractere = x29
;	  x2 = count = 1
;	  x8 = 64 (sys_write)

  dd 0xAA1D03E1							; mov x1, x29		(adresse du caractere = sommet de pile)
  dd 0xD2800020							; movz x0, #1		(fd = stdout)
  dd 0xD2800022							; movz x2, #1		(count = 1)
  dd 0xD2800808							; movz x8, #64		(sys_write)
  dd 0xD4000001							; svc #0
  DROP								; caractere consomme
end macro

;			-----------
macro			SYS_PUT_STR				; affiche tout une chaine sur stdout
;			-----------
;	En entree : adresse du descripteur Ada (doublet @data | @info) sur la pile.
;	Le descripteur pointe vers data (offset 0) et info (offset 8).
;	Le bloc info contient : SIZ@0, COMP_SIZ@4, FST@8, LST@12 (dwords).
;	Longueur a ecrire = LST + 1 - FST.
;
;	  x4 = pop (adresse descripteur)
;	  x0 = ldr [x4, 8]   adresse info
;	  w3 = ldr [x0, 12]  LST (en dword signe)
;	  add x3, x3, #1     LST + 1
;	  w17 = ldr [x0, 8]  FST
;	  sub x3, x3, x17    longueur effective
;	  x1 = ldr [x4]      adresse des caracteres
;	  x0 = movz #1       fd = stdout
;	  x8 = movz #64      sys_write
;	  svc #0
  POP_RSI								; x4 = adresse descripteur
  dd 0xF9400480							; ldr x0, [x4, #8]    (x0 = adresse info)
  dd 0xB9400C02							; ldr w2, [x0, #12]   (w2 = LST)
  dd 0x91000442							; add x2, x2, #1
  dd 0xB9400811							; ldr w17, [x0, #8]   (w17 = FST)
  dd 0xCB110042							; sub x2, x2, x17     (x2 = longueur)
  dd 0xF9400081							; ldr x1, [x4]        (x1 = adresse caracteres)
  dd 0xD2800020							; movz x0, #1         (fd = stdout)
  dd 0xD2800808							; movz x8, #64        (sys_write)
  dd 0xD4000001							; svc #0
end macro


; - - - -	- - - - -	- - - - -	- - - - -	- - - - -	- - - - -
;	Pour le GET de caractere on veut obtenir chaque caractere tape immediatement,
;	il faut modifier le comportement du terminal via ioctl(TCGETS/TCSETS) sur stdin.
;
;	struc termios {
;	  c_iflag  rd 1     0  input mode flags
;	  c_oflag  rd 1     4  output mode flags
;	  c_cflag  rd 1     8  control mode flags
;	  c_lflag  rd 1     12 local mode flags    <-- on modifie ICANON (bit 1) et ECHO (bit 3)
;	  c_line   rb 1     16
;	  c_cc     rb 32    17
;	  c_ispeed rd 1
;	  c_ospeed rd 1
;	}
;	On reserve 64 octets sur sp (multiple de 16, alignement OK).

;			------------
macro			SYS_GET_CHAR				; lit un seul caractere sur stdin en mode non canonique
;			------------
;	1. Reserver 64 octets sur sp pour le termios.
  dd 0xD10103FF							; sub sp, sp, #64
;	2. ioctl(stdin=0, TCGETS=0x5401, &termios) : recupere les attributs courants
  dd 0xD2800000							; movz x0, #0		(fd = stdin)
  dd 0xD28A8021							; movz x1, #0x5401	(TCGETS)
  dd 0x910003E2							; add x2, sp, #0	(adresse du termios temporaire = sp)
  dd 0xD28003A8							; movz x8, #29		(sys_ioctl)
  dd 0xD4000001							; svc #0
;	3. Modifier c_lflag : effacer ICANON (bit 1) et ECHO (bit 3) -> mask = ~0xA = 0xFFFFFFF5
  dd 0xB9400FE0							; ldr w0, [sp, #12]	(charger c_lflag)
  dd 0x12800151							; movn w17, #0xA	(w17 = 0xFFFFFFF5)
  dd 0x0A110000							; and w0, w0, w17	(masquer ICANON et ECHO)
  dd 0xB9000FE0							; str w0, [sp, #12]	(remettre c_lflag)
;	4. ioctl(stdin, TCSETS=0x5402, &termios) : applique les nouveaux attributs
  dd 0xD2800000							; movz x0, #0		(fd = stdin)
  dd 0xD28A8041							; movz x1, #0x5402	(TCSETS)
  dd 0x910003E2							; add x2, sp, #0
  dd 0xD28003A8							; movz x8, #29		(sys_ioctl)
  dd 0xD4000001							; svc #0
;	5. Lire le caractere : read(stdin, &dest, 1)
  POP_RDI								; x5 = adresse destination (depilee de la pile de travail)
  dd 0xAA0503E1							; mov x1, x5		(buf)
  dd 0xD2800000							; movz x0, #0		(fd = stdin)
  dd 0xD2800022							; movz x2, #1		(count = 1)
  dd 0xD28007E8							; movz x8, #63		(sys_read)
  dd 0xD4000001							; svc #0
;	6. Restaurer le mode canonique : remettre ICANON (bit 1) et ECHO (bit 3)
  dd 0xB9400FE0							; ldr w0, [sp, #12]
  dd 0x52800151							; movz w17, #0xA
  dd 0x2A110000							; orr w0, w0, w17	(remettre ICANON et ECHO)
  dd 0xB9000FE0							; str w0, [sp, #12]
;	7. ioctl(stdin, TCSETS, &termios) : reapplique le mode canonique
  dd 0xD2800000							; movz x0, #0
  dd 0xD28A8041							; movz x1, #0x5402
  dd 0x910003E2							; add x2, sp, #0
  dd 0xD28003A8							; movz x8, #29
  dd 0xD4000001							; svc #0
;	8. Liberer la zone termios sur sp
  dd 0x910103FF							; add sp, sp, #64
end macro

;			-----------
macro			SYS_GET_STR				; lit une ligne sur stdin
;			-----------
;	En entree : adresse d'un descripteur Ada de chaine (doublet @data | @info).
;	Lecture jusqu'a la longueur LST+1-FST. On retourne aussi la longueur effectivement
;	lue dans un dword adresse par un second pop.
;	read(fd=stdin=0, buf=@data, count=longueur)
;	Retour rax = longueur lue (incluant le \n eventuel).
  POP_RSI								; x4 = adresse descripteur
  dd 0xF9400480							; ldr x0, [x4, #8]
  dd 0xB9400C02							; ldr w2, [x0, #12]   (w2 = LST)
  dd 0x91000442							; add x2, x2, #1
  dd 0xB9400811							; ldr w17, [x0, #8]   (w17 = FST)
  dd 0xCB110042							; sub x2, x2, x17     (x2 = count)
  dd 0xF9400081							; ldr x1, [x4]
  dd 0xD2800000							; movz x0, #0         (fd = stdin)
  dd 0xD28007E8							; movz x8, #63        (sys_read)
  dd 0xD4000001							; svc #0
;	x0 contient maintenant la longueur lue.
;	On depile l'adresse de stockage de la longueur effective et on y range x0 - 1
;	(retirer le \n final).
  POP_RSI								; x4 = adresse longueur effective
  dd 0xD1000400							; sub x0, x0, #1
  dd 0xB9000080							; str w0, [x4]
end macro

;			----------------------
macro			COPY_STRING_APPEND_NUL			; descripteur dans x4, copie sur la pile montante avec NUL final
;			----------------------
;	En entree : x4 pointe sur le descripteur Ada (apres POP_RSI).
;	En sortie : x5 pointe sur le debut de la copie (sur la pile [rbp+8]).
;	Sur ARM64 :
;	  x0 = ldr [x4, 8]    adresse info
;	  w2 = ldr [x0, 12]   LST
;	  add x2, x2, #1
;	  w17 = ldr [x0, 8]   FST
;	  sub x2, x2, x17     count
;	  x4 = ldr [x4]       adresse caracteres source
;	  add x5, x29, #8     destination = juste au-dessus de TOS
;	Boucle :
;	  ldrb w16, [x4], #1
;	  strb w16, [x5], #1
;	  sub x2, x2, #1
;	  cbnz x2, .loop
;	  strb wzr, [x5]      NUL final
;	  add x5, x29, #8     remettre x5 sur le debut

  dd 0xF9400480							; ldr x0, [x4, #8]	(adresse info)
  dd 0xB9400C02							; ldr w2, [x0, #12]	(LST)
  dd 0x91000442							; add x2, x2, #1
  dd 0xB9400811							; ldr w17, [x0, #8]	(FST)
  dd 0xCB110042							; sub x2, x2, x17	(count)
  dd 0xF9400084							; ldr x4, [x4]		(adresse caracteres source)
  dd 0x910023A5							; add x5, x29, #8	(destination)
  dd 0xB40000A2							; cbz x2, .end (saut +20 octets = 5 instr) - cas pathologique chaine vide
;.loop:
  dd 0x38401490							; ldrb w16, [x4], #1
  dd 0x380014B0							; strb w16, [x5], #1
  dd 0xD1000442							; sub x2, x2, #1
  dd 0xB5FFFFA2							; cbnz x2, .loop (saut -12 octets)
;.end:
  dd 0x390000BF							; strb wzr, [x5]	(NUL final)
  dd 0x910023A5							; add x5, x29, #8	(remettre x5 au debut de la copie)
end macro

;			---------------
macro			SYS_FILE_CREATE				; openat(AT_FDCWD, name, O_CREAT|O_RDWR, 0700)
;			---------------
;	x86-64 utilisait sys_open (rax=2) ; ARM64 utilise sys_openat (x8=56).
;	openat prend AT_FDCWD = -100 en premier argument pour reproduire le sens 'open'.
;	Args : x0=AT_FDCWD=-100, x1=path, x2=flags=0x42 (O_CREAT|O_RDWR), x3=mode=0700=0x1C0

  POP_RSI								; x4 = descripteur de chaine Ada
  COPY_STRING_APPEND_NUL						; x5 = adresse copie NUL-terminee
  dd 0x92800C60							; movn x0, #99	(x0 = AT_FDCWD = -100)
  dd 0xAA0503E1							; mov x1, x5	(path)
  dd 0xD2804842							; movz x2, #0x242	(O_CREAT | O_RDWR | O_TRUNC)
  dd 0xD2803803							; movz x3, #0x1C0	(mode = 0700)
  dd 0xD2800708							; movz x8, #56	(sys_openat)
  dd 0xD4000001							; svc #0
  dd 0xF90003A0							; str x0, [x29]	(ATTENTION PAS PUSH ! ID rendu sur le lieu result de la fonction)
end macro

;			-------------
macro			SYS_FILE_OPEN				; openat(AT_FDCWD, name, O_RDWR, 0)
;			-------------
  POP_RSI
  COPY_STRING_APPEND_NUL
  dd 0x92800C60							; movn x0, #99	(AT_FDCWD)
  dd 0xAA0503E1							; mov x1, x5
  dd 0xD2800042							; movz x2, #2	(O_RDWR)
  dd 0xD2800003							; movz x3, #0	(mode = 0)
  dd 0xD2800708							; movz x8, #56	(sys_openat)
  dd 0xD4000001							; svc #0
  dd 0xF90003A0							; str x0, [x29]
end macro

;			----------------
macro			SYS_FILE_SET_POS				; lseek(fd, offset, SEEK_SET=0)
;			----------------
  POP_RDI								; x5 = FILE_ID
  POP_RSI								; x4 = offset
  dd 0xAA0503E0							; mov x0, x5	(fd)
  dd 0xAA0403E1							; mov x1, x4	(offset)
  dd 0xD2800002							; movz x2, #0	(SEEK_SET)
  dd 0xD28007C8							; movz x8, #62	(sys_lseek)
  dd 0xD4000001							; svc #0
  dd 0xF90003A0							; str x0, [x29]
end macro

;			----------------
macro			SYS_FILE_GET_POS				; lseek(fd, 0, SEEK_CUR=1) - position courante
;			----------------
  POP_RDI								; x5 = FILE_ID
  dd 0xAA0503E0							; mov x0, x5
  dd 0xD2800001							; movz x1, #0	(offset = 0)
  dd 0xD2800022							; movz x2, #1	(SEEK_CUR)
  dd 0xD28007C8							; movz x8, #62
  dd 0xD4000001							; svc #0
  dd 0xF90003A0							; str x0, [x29]
end macro

;			-----------------
macro			SYS_FILE_GET_SIZE				; taille fichier (lseek SEEK_END puis SEEK_SET pour preserver)
;			-----------------
  POP_RDI								; x5 = FILE_ID
;	1. Sauver la position courante : lseek(fd, 0, SEEK_CUR) -> x0 = position
  dd 0xAA0503E0							; mov x0, x5
  dd 0xD2800001							; movz x1, #0
  dd 0xD2800022							; movz x2, #1	(SEEK_CUR)
  dd 0xD28007C8							; movz x8, #62
  dd 0xD4000001							; svc #0
  dd 0xAA0003E6							; mov x6, x0	(x6 = position courante a restaurer)
;	2. Lire la taille : lseek(fd, 0, SEEK_END) -> x0 = taille
  dd 0xAA0503E0							; mov x0, x5
  dd 0xD2800001							; movz x1, #0
  dd 0xD2800042							; movz x2, #2	(SEEK_END)
  dd 0xD28007C8							; movz x8, #62
  dd 0xD4000001							; svc #0
  dd 0xAA0003E7							; mov x7, x0	(x7 = taille du fichier)
;	3. Restaurer la position : lseek(fd, x6, SEEK_SET)
  dd 0xAA0503E0							; mov x0, x5
  dd 0xAA0603E1							; mov x1, x6
  dd 0xD2800002							; movz x2, #0	(SEEK_SET)
  dd 0xD28007C8							; movz x8, #62
  dd 0xD4000001							; svc #0
;	4. Resultat = x7 (taille) sur le lieu result
  dd 0xF90003A7							; str x7, [x29]
end macro

;			--------------
macro			SYS_FILE_WRITE				; write(fd, buf, count)
;			--------------
  POP_RDI								; x5 = FILE_ID
  POP_RSI								; x4 = adresse tampon
  POP_RDX								; x3 = longueur
  dd 0xAA0503E0							; mov x0, x5	(fd)
  dd 0xAA0403E1							; mov x1, x4	(buf)
  dd 0xAA0303E2							; mov x2, x3	(count)
  dd 0xD2800808							; movz x8, #64	(sys_write)
  dd 0xD4000001							; svc #0
  dd 0xF90003A0							; str x0, [x29]
end macro

;			-------------
macro			SYS_FILE_READ				; read(fd, buf, count)
;			-------------
  POP_RDI								; x5 = FILE_ID
  POP_RSI								; x4 = adresse tampon
  POP_RDX								; x3 = longueur
  dd 0xAA0503E0							; mov x0, x5
  dd 0xAA0403E1							; mov x1, x4
  dd 0xAA0303E2							; mov x2, x3
  dd 0xD28007E8							; movz x8, #63	(sys_read)
  dd 0xD4000001							; svc #0
  dd 0xF90003A0							; str x0, [x29]
end macro

;			--------------
macro			SYS_FILE_CLOSE				; close(fd)
;			--------------
  POP_RDI								; x5 = FILE_ID
  dd 0xAA0503E0							; mov x0, x5
  dd 0xD2800728							; movz x8, #57	(sys_close)
  dd 0xD4000001							; svc #0
  dd 0xF90003A0							; str x0, [x29]
end macro

;			---------------
macro			SYS_FILE_DELETE				; unlinkat(AT_FDCWD, name, 0)
;			---------------
;	x86-64 utilisait sys_unlink (rax=87) ; ARM64 utilise sys_unlinkat (x8=35).

  POP_RSI								; x4 = descripteur chaine
  COPY_STRING_APPEND_NUL						; x5 = adresse copie NUL-terminee
  dd 0x92800C60							; movn x0, #99	(AT_FDCWD)
  dd 0xAA0503E1							; mov x1, x5	(path)
  dd 0xD2800002							; movz x2, #0	(flag)
  dd 0xD2800468							; movz x8, #35	(sys_unlinkat)
  dd 0xD4000001							; svc #0
  dd 0xF90003A0							; str x0, [x29]
end macro

;			----------------
macro			SYS_EXIT	code:0				; retour au systeme
;			----------------
  if code = 0
    dd 0xD2800000							; movz x0, #0
  else
    QUAD_CONST	0, code
  end if
  dd 0xD2800BA8							; movz x8, #93 (sys_exit)
  dd 0xD4000001							; svc #0
end macro
;				---------------------------------------------
;				MISE EN PLACE ENTETE ELF 64 POUR LINUX ARM64
;				---------------------------------------------

ELFCLASS64	= 2
ELFDATA2LSB	= 1
EV_CURRENT	= 1
ET_EXEC		= 2
SYSTEM_V		= 0
EM_AARCH64	= 183						; e_machine pour ARM64 (au lieu de 62 pour x86-64)
TAILLE_COPILE	= 4096*1024*1024					; COPILE = 4 Go

org 0x400000							; adresse entree programme linux

Elf64_Header:
	e_ident		db 0x7F,'ELF', ELFCLASS64, ELFDATA2LSB,	EV_CURRENT, SYSTEM_V, (0x400010-$) dup 0
	e_type		dw ET_EXEC
	e_machine		dw EM_AARCH64
	e_version		dd EV_CURRENT
	e_entry		dq 0x00400078
	e_phoff		dq 64
	e_shoff		dq 0
	e_flags		dd 0
	e_ehsize		dw 64
	e_phentsize	dw 56
	e_phnum		dw 1
	e_shentsize	dw 0
	e_shnum		dw 0
	e_shstrndx	dw 0
Elf64_Phdr:
	p_type		dd 1					; PT_LOAD
	p_flags		dd 7					; RWX
	p_offset		dq 0x78
	p_vaddr		dq 0x00400078
	p_paddr		dq 0
	p_filesz		dq ASM_SIZE				; juste le necessaire code/constantes dans le fichier
	p_memsz		dq ASM_SIZE + TAILLE_COPILE			; TAILLE_COPILE au dessus du code et des constantes (pour la co-pile)
	p_align		dq 4096


;		METTRE EN PLACE LA PILE CROISSANTE ET LE DISPLAY
;
;		METTRE EN PLACE LE TAS SEPARE (mmap anonyme de 64 Mo)
;
; mmap(NULL, 64MiB, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
; ABI Linux AArch64 : x8=222, arguments x0..x5, retour x0.
TAILLE_TAS = 64*1024*1024
  dd 0xD2800000							; mov x0, #0
  dd 0xD2800801							; mov x1, #64
  dd 0xD36CAC21							; lsl x1, x1, #20 = 64 MiB
  dd 0xD2800062							; mov x2, #3   PROT_READ|PROT_WRITE
  dd 0xD2800443							; mov x3, #0x22 MAP_PRIVATE|MAP_ANONYMOUS
  dd 0x92800004							; mov x4, #-1
  dd 0xD2800005							; mov x5, #0
  dd 0xD2801BC8							; mov x8, #222  sys_mmap
  dd 0xD4000001							; svc #0
  dd 0xD2A08010							; movz x16, #0x400, lsl #16 = 64 MiB
  dd 0x8B100019							; add x25, x0, x16  haut du tas descendant

;		METTRE EN PLACE LA PILE MONTANTE ET LE DISPLAY
; Comme sur x86-64, le point de depart de la micro-pile est cale 4 MiB sous le
; SP initial. Le display commence a ce SP, la pile de travail a display+256.
  dd 0xD2A00810							; movz x16, #0x40, lsl #16 = 4 MiB
  dd 0xCB3063FF							; sub sp, sp, x16
  dd 0x910003FC							; mov x28, sp
  dd 0x9104039D							; add x29, x28, #256
  dd 0xF900039D							; str x29, [x28]  FP(0)

;		METTRE EN PLACE LA CO-PILE
;
;	La co-pile commence juste apres le code et les constantes, alignee qword.
;	Adresse calculee dynamiquement : 0x400078 + 8*((ASM_SIZE+7)/8).
;	Sur ARM64, materialiser une adresse 64 bits demande 4 instructions movz/movk.
;	A l'execution, ces 4 instructions seront patchees avec les chunks de la
;	valeur finale resolue par fasmg lors de la passe d'assemblage.

;  local co_pile_start
  co_pile_start = 0x400078 + 8*((ASM_SIZE+7)/8)
  dd 0xD2800000 or ((co_pile_start and 0xFFFF) shl 5) or 27	; movz x27, #imm0
  dd 0xF2A00000 or ((((co_pile_start) shr 16) and 0xFFFF) shl 5) or 27	; movk x27, #imm1, lsl #16
  dd 0xF2C00000 or ((((co_pile_start) shr 32) and 0xFFFF) shl 5) or 27	; movk x27, #imm2, lsl #32
  dd 0xF2E00000 or ((((co_pile_start) shr 48) and 0xFFFF) shl 5) or 27	; movk x27, #imm3, lsl #48

  dd 0xF900037B							; str x27, [x27]	(empiler le premier "frame" de co-pile)
  dd 0xAA1B03FA							; mov x26, x27	(R13 = "frame pointer" de co-pile)
  dd 0x9100237B							; add x27, x27, #8	(monter le haut de co-pile sur le premier lieu libre)

;-----------------------------------------------------------------------------------------------------------------------
;	1	2	3	4	5	6	7	8	9	0	1	2
